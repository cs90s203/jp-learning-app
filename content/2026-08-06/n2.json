  "translations": [
    [ { "text": "隨著雙薪家庭的增加，能在夜間或清晨寄放小孩的托育機構需求正在提高。", "word": "需要" } ],
    [ { "text": "以往的托兒所大多以傍晚前的使用為主，但近年也逐漸增加了能因應到深夜的設施。", "word": "対応する" } ],
    [ { "text": "對於在醫療、餐飲業等從事不規律工作型態的家長來說，這樣的服務是不可或缺的存在。", "word": "欠かせない" } ],
    [ { "text": "另一方面，也有人指出，負責夜間托育的保育員並不容易確保，人力不足的問題正日趨嚴重。", "word": "深刻化する" } ],
    [ { "text": "要打造能安心寄放孩子的環境，行政機關充實相關支援可說是不可或缺的。", "word": "不可欠" } ]
  ],
