  "translations": [
    [ { "text": "去年冬天，我在朋友的婚禮上聽到三味線的演奏，完全被那音色迷住了。", "word": "魅了する" } ],
    [ { "text": "以此為契機，我開始去附近的教室上課。", "word": "きっかけ" } ],
    [ { "text": "一開始手指怎麼也不聽使喚，連簡單的曲子都很吃力。", "word": "苦労する" } ],
    [ { "text": "即便如此，我想起老師說過「持之以恆就是力量」，於是每天堅持練習一點點。", "word": "続ける" } ],
    [ { "text": "半年過去的現在，簡單的民謠已經能彈奏了，練習變得非常令人期待。", "word": "楽しみ" } ]
  ],
