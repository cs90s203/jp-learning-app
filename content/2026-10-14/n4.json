  "translations": [
    [ { "text": "前幾天和姊姊一起去上了料理教室。", "word": "料理教室" } ],
    [ { "text": "做了義大利麵，又做了甜點，度過了非常充實的時光。", "word": "作る" } ],
    [ { "text": "因為是第一次所以有點緊張，不過老師教得很親切，讓我安心了下來。", "word": "安心する" } ],
    [ { "text": "明明看起來是很難的食譜，卻出乎意料地簡單就做出來了，很開心。", "word": "簡単" } ],
    [ { "text": "因為是自己一個人絕對做不出來的料理，所以成了很好的經驗。", "word": "経験" } ],
    [ { "text": "下次也想在家裡試著做做看。", "word": "思う" } ]
