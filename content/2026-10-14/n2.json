  "translations": [
    [ { "text": "對於懷有育兒煩惱的家庭來說，智慧型手機上的育兒支援APP正逐漸成為貼近生活的存在。", "word": "子育て支援アプリ" } ],
    [ { "text": "包括自動提醒預防接種時程的功能，能一次確認地方政府相關育兒資訊的這一點，都受到使用者的好評。", "word": "確認する" } ],
    [ { "text": "以往，這類資訊一般是透過公家機關的窗口或紙本手冊取得，但隨著工作方式的多樣化，希望能隨時確認所需資訊的需求日益提高。", "word": "多様化" } ],
    [ { "text": "另一方面，也有不少使用者對個人資訊的處理方式感到不安，有人指出沒有資安對策的強化，就難以期待普及範圍的擴大。", "word": "セキュリティ対策" } ],
    [ { "text": "今後，如何在易用性與安全性之間取得平衡，應該會成為一項課題。", "word": "バランス" } ]
  ],
