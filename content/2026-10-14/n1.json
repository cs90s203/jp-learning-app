  "translations": [
    [ { "text": "在日本，結婚時夫婦其中一方須依民法規定更改姓氏，實際上多數情況是女性改姓。", "word": "民法" } ],
    [ { "text": "針對此現象，希望婚後仍能保留原姓的人，長年以來一直呼籲引進選擇性夫婦別姓制度。", "word": "選択的夫婦別姓制度" } ],
    [ { "text": "贊成方強調，這能解決因改姓而產生的工作不便與身份認同的失落感，主張有足夠的理由應尊重個人的選擇自由。", "word": "尊重する" } ],
    [ { "text": "另一方面，反對方則認為，冠上相同姓氏有助於家族的一體感，若更改制度，恐會動搖家族該有的樣貌本身，對此表達擔憂。", "word": "揺らぐ" } ],
    [ { "text": "國會雖多次提出相關法案，但因意見對立導致審議無法推進，表決遙遙無期，時間就這樣流逝，這就是現狀。", "word": "審議" } ],
    [ { "text": "從國際角度來看，以法律規定夫婦必須同姓的國家屬於少數，今後國內將形成怎樣的共識，值得關注。", "word": "夫婦同姓" } ]
  ],
