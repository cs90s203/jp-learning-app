  "translations": [
    [ { "text": "近年來，出差或長期外出時使用寵物保姆服務的家庭正在增加。", "word": "ペットシッターサービス" } ],
    [ { "text": "以往多半是將寵物託給親戚或朋友照顧，但隨著核心家庭化的推進，也有不少人表示找不到能輕鬆託付的對象。", "word": "核家族化" } ],
    [ { "text": "於是，能到府代為餵食、遛狗的服務開始受到關注。", "word": "代行する" } ],
    [ { "text": "對寵物來說，由於環境不會改變，有不容易感到壓力的優點，但另一方面，使用費用絕對不便宜，選擇值得信賴的業者也不可或缺。", "word": "信頼する" } ],
    [ { "text": "今後，這樣的需求應該會進一步擴大。", "word": "広がる" } ]
