  "translations": [
    [ { "text": "隨著高齡化的推進，「企業應進一步調高退休年齡」的討論日益熱烈。", "word": "引き上げる" } ],
    [ { "text": "現行的高年齡者僱用安定法規定企業有義務確保員工僱用到六十五歲，但據說政府內部正在研議將此提高至七十歲。", "word": "義務づける" } ],
    [ { "text": "推動派主張，在勞動力不足與年金財政吃緊問題日益加劇之際，打造讓有意願、有能力的高齡者能持續工作的環境是當務之急，也有助於維持整體社會的活力。", "word": "主張する" } ],
    [ { "text": "另一方面，慎重派則擔憂，這樣做恐怕會剝奪年輕員工的升遷機會，而且不顧體力衰退、一律強迫就業，反而可能加重高齡者本人的負擔。", "word": "懸念" } ],
    [ { "text": "企業方面也出現聲音認為，若不伴隨薪資體系的重新檢討與職務的重新設計，草率延長退休年齡只會為職場帶來混亂，也不少人指出單純調高年齡並無法根本解決問題。", "word": "指摘" } ],
    [ { "text": "今後，如何不受限於一律的年齡標準，將依個人能力與意願而定的彈性就業形態加以制度化，可說將成為討論的焦點。", "word": "制度化する" } ]
  ],
