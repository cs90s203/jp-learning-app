  "translations": [
    [ { "text": "近年，以離島和山區為中心，使用無人機的貨物配送服務正逐漸普及。", "word": "広がる" } ],
    [ { "text": "以往這些地區因為道路狀況不佳，配送耗時，對居民來說是很大的負擔。", "word": "負担" } ],
    [ { "text": "據說引進無人機配送後，只要不是惡劣天氣，數十分鐘內就能送達貨物。", "word": "届ける" } ],
    [ { "text": "尤其在醫藥品、日用品等急需的貨物配送上發揮了效果，在高齡者較多的地區也被期待成為生活的支柱。", "word": "発揮する" } ],
    [ { "text": "儘管引進成本很高，機體故障和隱私問題等有待解決的課題依然存在。", "word": "課題" } ]
