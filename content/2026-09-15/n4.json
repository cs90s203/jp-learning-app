    [ { "text": "上星期六，我和爸爸去河邊釣魚。", "word": "行く" } ],
    [ { "text": "早上很早就起床了，雖然有點想睡，但爸爸說「今天一定釣得到」，所以我努力準備。", "word": "準備する" } ],
