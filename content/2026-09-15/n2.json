  "translations": [
    [ { "text": "每到週末，在公園或廣場看到跳蚤市場的機會變多了。", "word": "増える" } ],
    [ { "text": "以前這只不過是一部分愛好者才會參加的活動，但儘管二手交易App已經普及，想要當面看貨、親自挑選的需求反而根深蒂固。", "word": "根強い" } ],
    [ { "text": "除了能實際拿在手上確認狀態之外，還能和賣家直接互動、議價，這一點對年輕世代來說似乎也很新鮮。", "word": "新鮮" } ],
    [ { "text": "話雖如此，由於容易受天氣影響，加上場地難以確保，要提高舉辦頻率並不容易。", "word": "難しい" } ],
    [ { "text": "據說營運方正在研議導入事先預約制，以及雨天時的因應對策。", "word": "検討する" } ],
    [ { "text": "即便如此，作為讓當地居民能夠碰面的珍貴場所，跳蚤市場的價值今後應該會被重新評估。", "word": "見直す" } ]
  ],
