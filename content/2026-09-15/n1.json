  "translations": [
    [ { "text": "近年，自政府提出鼓勵副業的方針之後，許多企業修改了就業規則，開始容許員工從事副業，這股風潮正在擴大。", "word": "容認する" } ],
    [ { "text": "終身僱用制度事實上正在瓦解的現況，加上愈來愈多人深切感受到擁有多個收入來源的必要性，也助長了這股趨勢，可以這麼說。", "word": "痛感する" } ],
    [ { "text": "話雖如此，也有不少人認為，開放副業理應保持謹慎的態度，這種聲音依然根深蒂固。", "word": "根強い" } ],
    [ { "text": "不少經營者擔憂長時間工作帶來的健康損害或資訊洩漏，勞務管理跟不上的企業，越有可能猶豫是否導入。", "word": "懸念する" } ],
    [ { "text": "也有人指出，從副業獲得的經驗不一定能運用在本業上，反而可能導致專注力下降。", "word": "欠く" } ],
    [ { "text": "即便如此，若認為唯有個人能選擇自己方式的社會，才能實現真正的多樣性，那麼這場討論就不能被忽視。", "word": "看過する" } ],
    [ { "text": "要判斷這項制度的是非，理應傾聽實際從事副業的人們的心聲。", "word": "傾ける" } ]
