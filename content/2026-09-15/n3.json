  "translations": [
    [ { "text": "小時候附近雖然有鋼琴教室，但沒有勇氣去上課，就這樣放棄了。", "word": "諦める" } ],
    [ { "text": "長大後，朋友對我說『現在開始也不遲喔』，於是我下定決心去上課。", "word": "思い切る" } ],
    [ { "text": "一開始手指很不靈活，連簡單的曲子都彈不好，容易感到沮喪，但多虧老師耐心教導，才漸漸彈得動了。", "word": "教える" } ],
    [ { "text": "現在鋼琴已經成為我紓解工作壓力不可或缺的存在。", "word": "欠かす" } ],
    [ { "text": "雖然周圍的人有時會說『事到如今』，但正因為起步晚，我加倍感受到進步的喜悅。", "word": "感じる" } ]
  ],
