  "translations": [
    [ { "text": "去年冬天，我在朋友的推薦下決定嘗試編織看看。", "word": "やってみる" } ],
    [ { "text": "一開始連怎麼選毛線都不懂，光是織一條簡單的圍巾就花了好幾個小時。", "word": "マフラー" } ],
    [ { "text": "雖然常常失敗，但抓到訣竅之後，就漸漸有了雛形。", "word": "コツ" } ],
    [ { "text": "現在織不同季節的小物已經成了我的樂趣。", "word": "楽しみ" } ],
    [ { "text": "動著手指的時候，心情不可思議地會平靜下來。", "word": "落ち着く" } ]
  ],
