  "translations": [
    [ { "text": "因為祖母曾是茶道老師，我從小對和室的氛圍就有一種親近感。", "word": "親しみ" } ],
    [ { "text": "話雖如此，真正想學茶道，是在就業後過著忙碌的每一天之後的事。", "word": "とはいえ" } ],
    [ { "text": "「想要有專心品一杯茶的時間」，這樣的感覺就是契機。", "word": "きっかけ" } ],
    [ { "text": "開始上課後，一方面對繁瑣的禮法感到驚訝，一方面得知每個動作都有其意義，漸漸被那份深奧吸引。", "word": "一方で" } ],
    [ { "text": "雖然覺得困難，還是持續在練習。", "word": "続ける" } ],
    [ { "text": "現在，茶道對我來說不只是興趣，更是用來整理心情的重要時間。", "word": "大切" } ]
  ],
