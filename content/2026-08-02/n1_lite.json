  "translations": [
    [ { "text": "近年，作為工作方式改革的一環，越來越多企業引進讓有意願的員工可以選擇週休三日的「選擇性週休三日制」。", "word": "選択的週休三日制" } ],
    [ { "text": "縮短工作時間的同時，也能確保時間用於育兒、照護或進修，這對員工來說是一大魅力。", "word": "確保する" } ],
    [ { "text": "但另一方面，也有人指出，增加的假日會讓每天的工時或業務量隨之增加，反而可能迫使員工陷入長時間勞動的疑慮。", "word": "余儀なくされる" } ],
    [ { "text": "事實上，率先導入的企業中，有的回報生產力提升，也有的感嘆效果不如預期，成果並不一致。", "word": "成果" } ],
    [ { "text": "此外，也不能否認，因部門而異的導入與否，可能會讓員工之間產生不公平感的傾向。", "word": "きらい" } ],
    [ { "text": "不能讓制度只流於形式，唯有重新檢視整個業務流程，才會通往真正意義上的工作方式改革。", "word": "見直す" } ]
  ],
