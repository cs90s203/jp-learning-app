  "translations": [
    [ { "text": "在超市和便利商店看到自助結帳機的機會正在增加。", "word": "セルフレジ" } ],
    [ { "text": "以往結帳全部由店員負責，但隨著人手不足日益嚴重，由顧客自己掃描商品並完成結帳的形式正急速普及。", "word": "伴う" } ],
    [ { "text": "導入的店鋪中，有不少聲音表示排隊等待結帳的隊伍變短了，但另一方面，也有人指出不熟悉機器操作的高齡者容易感到負擔。", "word": "一方" } ],
    [ { "text": "部分店鋪透過配置專門的工作人員、當場說明操作方法，來體貼使用者的需求。", "word": "通じる" } ],
    [ { "text": "今後應該會根據使用者的意見，打造出無論對誰都好用的機制。", "word": "基づく" } ]
  ],
