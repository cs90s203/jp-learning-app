  "translations": [
    [ { "text": "上週六，我和三個朋友去海邊玩水。", "word": "海水浴" } ],
    [ { "text": "因為從早上天氣就很好，所以決定搭電車去海邊。", "word": "行く" } ],
    [ { "text": "到了海邊後，又是游泳又是在沙灘上小睡，悠閒地度過。", "word": "過ごす" } ],
