  "translations": [
    [ { "text": "近年，以坡道較多的地區為中心，電動輔助自行車正逐漸普及。", "word": "普及" } ],
    [ { "text": "靠電池和馬達的力量，只要輕輕踩踏板就能輕鬆爬坡，因此也漸漸獲得育兒中的父母和高齡者的支持。", "word": "高まる" } ],
    [ { "text": "價格比一般自行車貴，但如果利用地方政府的購買補助，很多情況下也能減輕負擔。", "word": "抑える" } ],
    [ { "text": "另一方面，電池老化和重量增加等課題依然存在，隨著需求的提高，各製造商也致力於輕量化與縮短充電時間。", "word": "応じる" } ],
    [ { "text": "作為對環境友善的交通方式，預計今後使用者會進一步增加。", "word": "見込む" } ]
