  "translations": [
    [ { "text": "以新型傳染病的流行為契機而急速普及的遠距工作，即使在疫情趨緩後，也在部分企業中逐漸固定下來。", "word": "定着する" } ],
    [ { "text": "肯定通勤時間減少與工作方式更有彈性的聲音不少，尤其對於需要育兒或照護的員工來說，工作方式選擇變多這件事意義重大。", "word": "選択肢" } ],
    [ { "text": "另一方面，也有人擔心面對面溝通不足會剝奪年輕員工的成長機會，這樣的憂慮根深蒂固；不少企業在評鑑制度尚未跟上的情況下，被迫轉向成果主義。", "word": "余儀なくされる" } ],
    [ { "text": "雖說隨著科技的進步，線上也能取得足夠的協作，但實際上依部門或職種不同，適合程度差異很大，這才是真實情況。", "word": "相まって" } ],
    [ { "text": "經營層理應採取的態度，不是全公司一致的制度，而是依照各現場的實際情況靈活調整做法。", "word": "しかるべし" } ],
    [ { "text": "員工雖然也各自以自己的方式努力想辦法，但訴說孤獨感與對評價的不安的聲音也不絕於耳，這也是事實，不能把這單純當作個人問題處理掉。", "word": "なりに" } ],
    [ { "text": "不必急著得出草率的結論，反而不斷累積長期的驗證，才是建立真正值得信賴的工作方式的道路。", "word": "足る" } ]
  ],
