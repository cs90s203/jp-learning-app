  "translations": [
    [ { "text": "近年，愈來愈多地方政府設立讓高齡者、育兒世代、單身者等不同世代能輕鬆聚集的「多世代交流據點」。", "word": "多世代交流拠点" } ],
    [ { "text": "把空店舗或廢校的校舍加以改裝，開放成任何人都能來訪的落腳處，藉此希望創造出地區居民之間的交流。", "word": "開放する" } ],
    [ { "text": "使用者表示，跨世代的對話自然而然產生，孤立感也因此緩和了不少。", "word": "和らぐ" } ],
    [ { "text": "另一方面，儘管確保營運經費和招募志工並不容易，仍有不少據點靠自己的巧思建立起持續的營運體制。", "word": "にもかかわらず" } ],
    [ { "text": "不只依靠行政機關，建立讓地區企業與居民也能參與營運的機制，被認為是支撐今後持續擴展的關鍵。", "word": "支える" } ]
  ],
