  "translations": [
    [ { "text": "在人口持續減少的地方，為使用者減少所苦的地方鐵路線的存續，已成為重大的課題。", "word": "存続" } ],
    [ { "text": "由於收益性下降而考慮廢線的鐵路公司也在增加，對於因此失去上學、就醫交通手段的地區居民來說，失去生活代步工具的不安根深蒂固。", "word": "根強い" } ],
    [ { "text": "雖然也有地方政府提供財政支援，或運用群眾募資摸索將其作為觀光資源重振的動向，但要找出根本性的解決方案並不容易。", "word": "模索する" } ],
    [ { "text": "若站在居住於沿線高齡者特有的視角來看，這對就醫、購物等日常生活造成的影響難以估量，並不能單純當作交通問題來處理。", "word": "計り知れる" } ],
    [ { "text": "除非鐵路業者、地方政府與居民同心協力共同想辦法，否則維持地方的交通網絡恐怕相當困難。", "word": "絞る" } ]
  ],
  "grammar_notes": [
