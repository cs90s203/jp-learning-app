  "translations": [
    [ { "text": "上週六，我和哥哥一起去了附近的河邊釣魚。", "word": "釣り" } ],
    [ { "text": "雖然早起很辛苦，但哥哥仔細教我釣竿的用法，所以連初學者的我也能釣到魚。", "word": "できる" } ],
    [ { "text": "有時釣到小魚，有時釣到大魚，釣到各種各樣的魚很開心。", "word": "楽しい" } ],
