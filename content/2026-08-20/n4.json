  "translations": [
    [ { "text": "上週六，我和弟弟一起去了科學館的天文館。", "word": "プラネタリウム" } ],
    [ { "text": "一進去，就看到滿天的星星，簡直就像置身於真正的夜空中一樣。", "word": "夜空" } ],
    [ { "text": "聽了解說，也請人教了星座的形狀，學到了很多。", "word": "星座" } ],
    [ { "text": "弟弟很喜歡星星，所以一直很開心的樣子。", "word": "好き" } ],
    [ { "text": "結束之後，外面也能看到一點真正的星星，兩人都很高興。", "word": "喜ぶ" } ]
