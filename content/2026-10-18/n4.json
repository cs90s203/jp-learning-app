  "translations": [
    [ { "text": "星期天我和兒子去騎了自行車。", "word": "サイクリング" } ],
    [ { "text": "到公園的路上坡道很多很辛苦，不過風景很美，所以我們一邊休息一邊看風景、拍照。", "word": "景色" } ],
    [ { "text": "兒子還小，原本擔心他能不能跑完這麼長的距離，但他努力到最後，成功跑完了。", "word": "頑張る" } ],
    [ { "text": "回程路上，兩人明明都累了，卻互相笑著說「好開心喔」。", "word": "笑い合う" } ]
