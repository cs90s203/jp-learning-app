  "translations": [
    [ { "text": "開始學習茶道的契機，是小時候在祖母家第一次喝抹茶時的記憶。", "word": "きっかけ" } ],
    [ { "text": "原本以為會很苦，沒想到比想像中更好入口，讓我很驚訝。", "word": "飲みやすい" } ],
    [ { "text": "從那以後，我漸漸想著「總有一天也想自己點茶」，半年前開始到附近的教室上課。", "word": "点てる" } ],
    [ { "text": "禮法很細瑣，學起來很不容易，但每當發現每個動作都有其意義時，就能感受到茶道的深奧。", "word": "奥深さ" } ],
    [ { "text": "老師對我說「不要著急，慢慢學會就好」，讓我心情輕鬆了一些。", "word": "言う" } ],
    [ { "text": "今後也想透過茶道，更深入地了解日本的傳統文化。", "word": "伝統文化" } ]
  ],
