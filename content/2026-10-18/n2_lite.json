  "translations": [
    [ { "text": "近年，引進線上診療的醫院正在增加。", "word": "オンライン診療" } ],
    [ { "text": "對於沒有時間就醫，或因身體不適難以外出的人來說，能在家中接受醫師診察的機制是很大的幫助。", "word": "仕組み" } ],
    [ { "text": "尤其在地方，由於距離有專科醫師的醫院較遠，線上診療被期待能減少移動的負擔。", "word": "専門医" } ],
    [ { "text": "此外，由於能減少在候診室與其他患者接觸的機會，也被視為一種感染防治對策而受到關注。", "word": "感染症対策" } ],
    [ { "text": "另一方面，也有人指出隔著畫面難以準確傳達症狀，如何與面對面診療結合是今後的課題。", "word": "組み合わせ" } ]
