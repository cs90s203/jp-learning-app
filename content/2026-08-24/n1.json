  "translations": [
    [ { "text": "「應該把選舉權年齡調降到十六歲」的意見，正被部分政治人物與研究者提倡。", "word": "唱えられている" } ],
    [ { "text": "「從年輕時就累積參與政治的經驗，能導向培養主動承擔社會的意識」這種想法，是其根本立場。", "word": "醸成" } ],
    [ { "text": "實際上，自調降到十八歲以來，很難說年輕族群的投票率有顯著提升，「光調降年齡效果有限」的反駁意見也根深蒂固。", "word": "とは言いがたく" } ],
    [ { "text": "若在教育現場學習政治與社會機制的機會依然缺乏的狀態下，就讓制度先行，反而可能助長對政治的冷漠，這樣的疑慮也不容忽視。", "word": "助長しかねない" } ],
    [ { "text": "比起調降年齡本身，若不與「如何建立讓年輕人能培養政治判斷力的環境」這項討論一併推進，這場制度改革恐怕無法具有實質意義。", "word": "併せて" } ]
  ],
