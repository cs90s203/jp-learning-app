  "translations": [
    [ { "text": "上星期天，跟爸爸一起去附近的山賞鳥。", "word": "バードウォッチング" } ],
    [ { "text": "一大早起床，帶著望遠鏡出門。", "word": "双眼鏡" } ],
    [ { "text": "要在樹叢裡找到鳥，比想像中困難。", "word": "見つける" } ],
    [ { "text": "爸爸聽到鳥叫聲，就教我那是什麼鳥的名字。", "word": "教えてくれました" } ],
    [ { "text": "能找到少見的鳥，非常開心。", "word": "嬉しかった" } ],
    [ { "text": "下次還想再一起去。", "word": "また" } ]
