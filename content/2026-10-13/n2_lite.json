  "translations": [
    [ { "text": "近年，電子書的使用者正迅速增加。", "word": "増える" } ],
    [ { "text": "以前偏好紙本書的人很多，但隨著智慧型手機和平板的普及，隨處都能享受閱讀的環境逐漸成形。", "word": "によって" } ],
