  "translations": [
    [ { "text": "隨著高齡化的加劇，為了守護獨居高齡者而建立的地區網絡正逐漸擴大。", "word": "広がる" } ],
    [ { "text": "到目前為止，這類措施因地方政府預算不足而未能充分推展，但以某地區的成功案例為契機，鄰近的地方政府也開始跟進。", "word": "きっかけ" } ],
    [ { "text": "守護的方法不只限於訪視，還包括郵局人員、宅配業者的關心問候，以及透過感測器進行的安全確認等，涵蓋範圍相當廣泛。", "word": "限る" } ],
    [ { "text": "當然，在沒有顧慮隱私的情況下是不能隨意推行的，因此多數情況下會在取得本人同意後才實施。", "word": "わけ" } ],
    [ { "text": "雖然高齡者本人有時會對被看守這件事感到抗拒，但防止孤立的效果被認為很大，預期今後會進一步擴大。", "word": "ものの" } ]
  ],
