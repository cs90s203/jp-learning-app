  "translations": [
    [ { "text": "作為同時解決能源安全與溫室氣體減量這兩項課題的手段，要求核電重新啟動的聲浪日益增強。", "word": "再稼働" } ],
    [ { "text": "震災之後，許多因安全疑慮而停止運轉的發電廠，隨著電力供需惡化，也有地方政府被迫重新啟動。", "word": "余儀なくされる" } ],
    [ { "text": "不過，對於事故記憶依然鮮明的地區居民而言，儘管安全措施已大幅強化，仍無法完全消除不安，這也是理所當然的。", "word": "とはいえ" } ],
    [ { "text": "推動派主張，既然已經通過最新法規標準的審查，就科學上而言並非沒有依據，但這種看法也往往有優先考量經濟合理性之嫌。", "word": "きらい" } ],
    [ { "text": "另一方面，謹慎派的擔憂也相當值得理解，畢竟一旦發生事故，所造成的損害將無法挽回，這個事實是不能輕視的。", "word": "足る" } ],
    [ { "text": "歸根究底，不急於下結論，持續進行謹慎的共識形成，才是現在最被需要的態度。", "word": "結局のところ" } ]
