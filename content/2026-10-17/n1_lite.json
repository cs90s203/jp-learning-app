  "translations": [
    [ { "text": "需要照護的高齡者增加的同時，支撐現場的人力不足也日趨嚴重。", "word": "深刻化する" } ],
    [ { "text": "繁重的身體負擔與不規律的工作時間，加上薪資水準比其他行業低，被指出是讓招募人才變得困難的原因。", "word": "要因" } ],
