  "translations": [
    [ { "text": "圍繞選舉制度重新檢視的討論，又以國會為中心再次活躍起來。", "word": "議論" } ],
    [ { "text": "在現行制度下，一票的價值存在地區差異，人口較少的地方選民的票比城市地區的票更有份量，這種所謂的「一票差距」問題長年來一直被指出。", "word": "格差" } ],
    [ { "text": "最高法院也曾將這種狀況判定為違憲狀態，因此要求立法機關儘速採取應對措施。", "word": "違憲状態" } ],
    [ { "text": "作為改革方案，有人提出依人口比例重新檢視選區席次的方法，也有人提出提高比例代表制比重的方法，但無論哪一種都會影響既有的議席分配，使各政黨的利害糾纏在一起，再加上選民關注度低落，討論完全沒有進展。", "word": "相まる" } ],
    [ { "text": "有人主張不應輕視地方的聲音，也有人認為除非嚴密反映人口比例，否則就違背民主主義的原則，雙方要達成妥協並不容易。", "word": "折り合い" } ],
    [ { "text": "若放任這種結構性問題不管，持續舉行選舉下去，恐怕會損害制度本身的信任，因此不管是執政黨還是在野黨，認為根本性改革勢在必行的聲浪正逐漸增強。", "word": "抜本的" } ]
  ],
