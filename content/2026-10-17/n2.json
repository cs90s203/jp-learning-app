  "translations": [
    [ { "text": "為了支持生活陷入困境的家庭，在各地展開食物銀行活動的團體正在增加。", "word": "フードバンク活動" } ],
    [ { "text": "這是一種收集企業或個人捐贈的食品、無償送給有需要家庭的機制，也被認為有助於減少食物浪費而受到關注。", "word": "仕組み" } ],
    [ { "text": "背後原因在於，隨著物價上漲，生活費負擔增加，不得不縮減伙食費的家庭變多了。", "word": "切り詰める" } ],
    [ { "text": "以往主要由地方政府與社會福利協議會主導營運，但近年學生志工與當地商店街也加入其中，活動範圍正逐漸擴大。", "word": "広がる" } ],
    [ { "text": "另一方面，由於捐贈食品的數量與種類參差不齊，也存在無法充分支援到真正需要的人的課題。", "word": "課題" } ]
  ],
