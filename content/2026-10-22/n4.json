  "translations": [
    [ { "text": "上個月，在奶奶家", "word": "祖母" }, { "text": "幫忙做了醃梅乾。", "word": "手伝う" } ],
    [ { "text": "把院子裡摘的梅子一顆一顆地洗，", "word": "洗う" }, { "text": "又灑了鹽。", "word": "塩" } ],
    [ { "text": "因為天氣很好，", "word": "天気" }, { "text": "梅子很快就變紅了。", "word": "赤い" } ],
    [ { "text": "把沉重的石頭放在上面很辛苦，", "word": "大変" }, { "text": "奶奶幫了我。", "word": "手伝う" } ],
    [ { "text": "讓我試吃了一下，", "word": "味見" }, { "text": "非常鹹。", "word": "しょっぱい" } ],
    [ { "text": "知道自己也能醃漬，", "word": "漬ける" }, { "text": "感到很開心。", "word": "嬉しい" } ],
