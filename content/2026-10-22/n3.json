    [ { "text": "上個月，終於找到了教室，", "word": "教室" }, { "text": "便下定決心開始去上課。", "word": "通う" } ],
    [ { "text": "一開始完全記不住舞步，腳好幾次都絆在一起，", "word": "もつれる" }, { "text": "但多虧老師的鼓勵，漸漸有了進步。", "word": "おかげで" } ],
    [ { "text": "隨著音樂節奏活動身體的過程中，", "word": "リズム" }, { "text": "發現自己能忘記每天的壓力。", "word": "ストレス" } ],
    [ { "text": "跳完舞之後的成就感，", "word": "達成感" }, { "text": "是什麼都無法取代的。", "word": "代えがたい" } ],
    [ { "text": "今後也打算繼續下去。", "word": "続ける" } ]
