  "translations": [
    [ { "text": "儘管紙本依然擁有根深蒂固的人氣，", "word": "根強い" }, { "text": "使用電子書閱讀器的人也逐年增加。", "word": "電子書籍リーダー" } ],
    [ { "text": "比起紙本，攜帶輕便，", "word": "持ち運び" }, { "text": "能把幾百本書收納在一台裝置裡，是受歡迎的原因。", "word": "収める" } ],
    [ { "text": "因為可以自由調整字體大小，", "word": "大きさ" }, { "text": "許多人認為對高齡者來說也很容易閱讀。", "word": "高齢者" } ],
    [ { "text": "另一方面，也有不少人覺得翻紙頁的手感，", "word": "感触" }, { "text": "以及把書排在書架上的樂趣因此消失了。", "word": "楽しみ" } ],
    [ { "text": "在價格方面，電子書也常被設定得比紙本便宜，", "word": "価格" }, { "text": "容易入手這一點也受到好評。", "word": "購入する" } ],
    [ { "text": "今後電子書閱讀器的普及，", "word": "普及" }, { "text": "預計也會持續進展下去。", "word": "進む" } ]
  ],
