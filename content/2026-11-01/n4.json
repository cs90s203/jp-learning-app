  "translations": [
    [ { "text": "上週日，我和父親去海邊釣魚。", "word": "釣り" } ],
    [ { "text": "因為早上很早起床，所以有點睏。", "word": "眠い" } ],
    [ { "text": "到了防波堤後，父親教了我工具的使用方法。", "word": "教える" } ],
    [ { "text": "雖然是第一次，但練習之後就能釣到魚了。", "word": "できる" } ],
    [ { "text": "有時釣到小魚，有時讓大魚跑掉，非常開心。", "word": "釣る" } ],
    [ { "text": "回家的時候雖然很累，但我還是想再去一次。", "word": "思う" } ],
    [ { "text": "下次母親也打算一起去。", "word": "予定" } ]
  ],
