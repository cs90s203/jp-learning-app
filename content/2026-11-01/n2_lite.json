  "translations": [
    [ { "text": "近年，電子書的使用者快速增加。", "word": "電子書籍" } ],
    [ { "text": "可以用智慧型手機或平板輕鬆閱讀，而且不需要隨身攜帶沉重的書本，這種便利性正是受歡迎的理由。", "word": "利便性" } ],
    [ { "text": "出版社同時發售紙本書與電子版，也漸漸變得理所當然。", "word": "当たり前" } ],
    [ { "text": "電子書雖然輕便，但也有人說會讓眼睛疲勞。", "word": "手軽" } ],
    [ { "text": "另一方面，也有不少讀者偏好紙張的質感與翻頁的感覺，重視在書店挑選書本的樂趣的聲音依然強烈。", "word": "根強い" } ],
    [ { "text": "今後，應該會需要能巧妙結合兩者優點的閱讀環境吧。", "word": "求める" } ],
    [ { "text": "特別是在年輕世代之間，這股趨勢可能會更加加速。", "word": "流れ" } ]
  ],
  "grammar_notes": [
