  "translations": [
    [ { "text": "以新型病毒疫情為契機而普及的遠距工作，即使在疫情趨緩的現在，依然持續被許多企業採用。", "word": "リモートワーク" } ],
    [ { "text": "不用說通勤時間的減少，由於能自由選擇工作地點，也有調查結果顯示這有助於提升員工的滿意度。", "word": "満足度" } ],
    [ { "text": "然而，儘管碰面的機會減少了，如何維持團隊的一體感這樣的課題也逐漸浮現。", "word": "一体感" } ],
    [ { "text": "針對這一點，企業也透過舉辦定期的線上交流會等方式不斷下功夫。", "word": "工夫" } ],
    [ { "text": "今後，應該會更加需要能兼顧生產力與靈活性的制度建構。", "word": "両立する" } ],
    [ { "text": "在尊重個人自主裁量的同時，如何維持組織的一致性，是各家公司都面臨的問題。", "word": "一貫性" } ]
