  "translations": [
    [ { "text": "保育員短缺問題，以城市地區為中心日益嚴重。", "word": "保育士不足" } ],
    [ { "text": "一方面大家呼籲解決候補兒童問題，但另一方面保育員的離職率依然很高，人才的確保並不容易。", "word": "離職率" } ],
    [ { "text": "除了薪資水準偏低之外，應對家長與行政事務等業務負擔之重，也被認為是離職的原因之一。", "word": "業務負担" } ],
    [ { "text": "依地方政府的不同，有些地方引進了加薪制度，但也有不少聲音指出效果有限。", "word": "上乗せ" } ],
