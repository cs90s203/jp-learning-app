  "translations": [
    [ { "text": "上個月，因為朋友邀請，第一次去了寄席。", "word": "誘う" } ],
    [ { "text": "那次經驗成了契機，開始聽落語。", "word": "きっかけ" } ],
    [ { "text": "一開始因為難懂的詞彙很多，跟不上內容，但看著落語家掌握節奏的方式與表情變化，漸漸就懂得了其中的樂趣。", "word": "面白さ" } ],
    [ { "text": "特別讓我驚訝的是，同一個段子由不同的人來演，印象居然完全不同。", "word": "驚く" } ],
    [ { "text": "在忙碌的日子裡，總是不知不覺把興趣的時間往後拖延，但聽落語卻不可思議地讓心情放鬆下來。", "word": "後回し" } ],
    [ { "text": "接下來，我也想把它當作對自己來說很重要的喘息時間，每個月至少去一次寄席。", "word": "息抜き" } ]
  ],
