  "translations": [
    [ { "text": "上週六，和姊姊一起去了煙火大會。", "word": "花火大会" } ],
    [ { "text": "穿了浴衣，也在攤販吃了炒麵，非常開心。", "word": "楽しい" } ],
    [ { "text": "因為人非常多，所以牽著手以免和姊姊走散。", "word": "はぐれる" } ],
