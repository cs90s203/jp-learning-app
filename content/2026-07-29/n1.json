  "translations": [
    [ { "text": "智慧型手機或電腦裡留下的社群帳號、照片、電子錢包餘額等等，被稱為所謂的「數位遺物」，成為繼承相關的新課題而備受關注。", "word": "デジタル遺品" } ],
    [ { "text": "與傳統遺產不同，數位遺物往往受密碼保護，遺族甚至可能連其存在都無從得知就這樣被擱置，這樣的案例並不罕見。", "word": "把握する" } ],
    [ { "text": "尤其是，光是要確定故人在哪個服務留下了什麼樣的資產，這項作業本身就會讓遺族耗費極大的心力。", "word": "強いる" } ],
    [ { "text": "此外，各業者訂定的使用條款大多沒有預設繼承的情況，遺族因此被迫與服務提供者進行交涉。", "word": "余儀なくされる" } ],
    [ { "text": "加上這樣的狀況，也有人指出法律制度的滯後正讓損害進一步惡化，這樣的指摘值得傾聽。", "word": "足る" } ],
    [ { "text": "不過，輕視隱私保護、操之過急的立法應當避免，若不去思考如何讓故人的意願與遺族的權利兼顧的難題，就無法討論這個問題。", "word": "両立させる" } ]
  ],
