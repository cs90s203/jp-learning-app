  "translations": [
    [ { "text": "在休假期間到旅行地工作的「工作旅遊（workation）」這種工作方式正逐漸普及。", "word": "ワーケーション" } ],
    [ { "text": "可以說，透過遠距工作的普及，人們不再被辦公室束縛也能工作，這正是推動這股風潮的原因。", "word": "テレワーク" } ],
    [ { "text": "有些企業認為這有助於員工放鬆身心、提升創造力，因而積極引進工作旅遊制度。", "word": "導入する" } ],
    [ { "text": "地方政府也期待能帶動觀光業與地區經濟的連帶效益，致力於整備專用設施與通訊環境。", "word": "波及効果" } ],
    [ { "text": "另一方面，也有人指出休假與工作的界線變得模糊、無法充分休息，如何制定運用規則成為今後的課題。", "word": "指摘" } ],
    [ { "text": "在克服這些課題的同時，這種新的工作方式能普及到什麼程度，備受關注。", "word": "注目する" } ]
  ],
