  "translations": [
    [ { "text": "生成式AI利用既有的文章與圖像作為學習資料創造出新作品的技術，一方面拓展了創作的範疇，另一方面也讓著作權相關的議論愈趨激烈。", "word": "著作権" } ],
    [ { "text": "在學習階段未經授權使用著作物是否恰當、生成物與既有作品極為相似時責任歸屬何在，甚至該不該賦予生成AI的輸出創作物的權利，這些論點都超出了傳統著作權法的預想範圍，並非能簡單解決的問題。", "word": "論点" } ],
    [ { "text": "從權利人的立場來看，自己的作品未經對價就被用於學習，會產生反彈也是理所當然；另一方面，開發者一方則主張，可能阻礙技術革新的過度規範應該謹慎為之。", "word": "反発" } ],
    [ { "text": "雙方的主張都具有一定的合理性，並非能簡單以二元對立來解決的問題。", "word": "合理性" } ],
    [ { "text": "今後，建立標示學習資料來源的機制，以及讓權利人能選擇是否同意使用的制度等，摸索技術與權利保護之間平衡點的努力將變得不可或缺。", "word": "模索する" } ]
  ],
