  "translations": [
    [ { "text": "曾經熱鬧的地方城市商店街，因為郊外型購物中心的崛起與接班人不足，變成鐵捲門街的案例正在增加。", "word": "増える" } ],
    [ { "text": "為了突破這種狀況，以年輕店主與社區營造團體為中心，在週末舉辦結合音樂與市集活動的行動正在各地擴大。", "word": "広がる" } ],
    [ { "text": "不僅是為了聚集人潮，也希望透過把空店面改裝成咖啡廳或雜貨店來活用，藉此吸引新的客群。", "word": "活用する" } ],
    [ { "text": "不過，也有人指出活動的效果容易只是一時的，要延續成持續性的集客，行政的支援與當地居民的合作是不可或缺的。", "word": "欠かせない" } ],
    [ { "text": "即便如此，以這類嘗試為契機而回到商店街的年輕人增加，這個事實可說是顯示了今後的可能性。", "word": "示す" } ]
  ],
