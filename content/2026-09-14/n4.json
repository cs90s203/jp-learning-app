  "translations": [
    [ { "text": "週末，我和姊姊一起用和紙做了人偶。", "word": "作る" } ],
    [ { "text": "姊姊因為手巧，細緻的作業也不斷地推進。", "word": "器用" } ],
    [ { "text": "我笨手笨腳，重做了好幾次，也塗了太多漿糊。", "word": "やり直す" } ],
