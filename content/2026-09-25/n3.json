  "translations": [
    [
      {
        "text": "半年前開始學瑜珈。",
        "word": "ヨガ"
      }
    ],
    [
      {
        "text": "契機是因為工作壓力導致肩膀和脖子疼痛。",
        "word": "ストレス"
      }
    ],
    [
      {
        "text": "一開始身體很僵硬，連簡單的姿勢都做不到。",
        "word": "硬い"
      }
    ],
    [
      {
        "text": "但是，多虧老師仔細地教導，身體漸漸變得柔軟起來。",
        "word": "おかげで"
      }
    ],
    [
      {
        "text": "現在每週上兩次瑜珈課。",
        "word": "ヨガ教室"
      }
    ],
    [
      {
        "text": "家人有時候會說「妳真是熱衷呢」。",
        "word": "熱心"
      }
    ],
    [
      {
        "text": "開始瑜珈之後，感覺不只身體，連心情也變得平靜了。",
        "word": "落ち着く"
      }
    ],
    [
      {
        "text": "今後也想不勉強自己，長久地持續下去。",
        "word": "続ける"
      }
    ]
  ],
