      {
        "text": "上星期天，我和家人去了動物園。",
        "word": "動物園"
      }
    ],
    [
      {
        "text": "天氣非常好。",
        "word": "天気"
      }
    ],
    [
      {
        "text": "在動物園裡看到了長頸鹿。",
        "word": "キリン"
      }
    ],
    [
      {
        "text": "長頸鹿的脖子非常長，讓我很驚訝。",
        "word": "長い"
      }
    ],
    [
      {
        "text": "孩子們說「好厲害喔」。",
        "word": "すごい"
      }
    ],
    [
      {
        "text": "然後，大家一起吃了便當。",
        "word": "お弁当"
      }
    ],
    [
      {
        "text": "真是開心的一天。",
        "word": "楽しい"
      }
    ]
