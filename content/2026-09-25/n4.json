  "translations": [
    [
      {
        "text": "上星期六，我和姊姊一起做了蛋糕。",
        "word": "ケーキ"
      }
    ],
    [
      {
        "text": "姊姊很擅長做點心，所以教了我很多。",
        "word": "得意"
      }
    ],
    [
      {
        "text": "攪拌材料、用烤箱烘烤，花了兩個小時。",
        "word": "オーブン"
      }
    ],
    [
      {
        "text": "烤好的蛋糕聞起來很香，味道也香甜可口。",
        "word": "おいしい"
      }
    ],
    [
      {
        "text": "全家人一起吃，所以一下子就吃完了。",
        "word": "家族"
      }
    ],
    [
      {
        "text": "下次還想再做做看不同的蛋糕。",
        "word": "作る"
      }
    ]
  ],
