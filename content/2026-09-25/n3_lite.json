  "translations": [
    [
      {
        "text": "最近開始嘗試攝影。",
        "word": "写真撮影"
      }
    ],
    [
      {
        "text": "契機是朋友拍的照片非常漂亮。",
        "word": "写真"
      }
    ],
    [
      {
        "text": "買了便宜的相機，休假時邊在附近散步邊拍照。",
        "word": "カメラ"
      }
    ],
    [
      {
        "text": "一開始拍得不好，但漸漸抓到了一些訣竅。",
        "word": "コツ"
      }
    ],
    [
      {
        "text": "特別喜歡在傍晚光線下拍的照片。",
        "word": "夕方"
      }
    ],
    [
      {
        "text": "天空的顏色和光線的變化會讓照片的印象改變，這點很有趣。",
        "word": "印象"
      }
    ],
    [
      {
        "text": "今後也想在各種不同的地方拍拍看。",
        "word": "場所"
      }
    ]
  ],
