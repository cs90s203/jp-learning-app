  "translations": [
    [ { "text": "上個月和哥哥一起試著做了天婦羅。", "word": "天ぷら" } ],
    [ { "text": "把蝦子和蔬菜切一切，裹上麵衣，", "word": "切る" }, { "text": "兩人開心地一起準備。", "word": "準備する" } ],
    [ { "text": "油溫掌控很困難，一開始還稍微炸焦了，", "word": "焦げる" }, { "text": "但漸漸能炸得很上手了。", "word": "揚げる" } ],
    [ { "text": "吃了剛炸好的天婦羅之後，因為太好吃了，", "word": "美味しい" }, { "text": "所以決定下次再做一次。", "word": "作る" } ],
    [ { "text": "和哥哥一起做菜的時光，比平常多了更多對話，很開心。", "word": "会話" } ]
