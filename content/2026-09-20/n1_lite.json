    [ { "text": "根據厚生勞動省的推估，今後十幾年內將需要新增數十萬人規模的照護人力，", "word": "担い手" }, { "text": "但由於薪資水準偏低與勞動環境嚴峻，年輕世代依然不願投入。", "word": "参入" } ],
    [ { "text": "儘管擴大接納外籍勞工、導入照護機器人等對策正在推進，", "word": "対策" }, { "text": "但加上少子高齡化急速發展的影響，實際情況是現場負擔仍未能從根本上減輕。", "word": "相まって" } ],
    [ { "text": "儘管照護是任何人遲早都可能面臨的問題，", "word": "関わる" }, { "text": "但整體社會的討論仍難謂充分深入。", "word": "議論" } ],
    [ { "text": "照這樣下去，需要照護的人們將無法獲得適切支援的情況，", "word": "支援" }, { "text": "恐怕在不遠的將來就會變得真實起來。", "word": "現実味" } ]
  ],
  "grammar_notes": [
