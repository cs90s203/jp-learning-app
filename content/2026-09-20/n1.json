  "translations": [
    [ { "text": "因傳染病流行，許多企業被迫重新檢視工作方式，因而急速普及的遠距工作，", "word": "余儀なくされる" }, { "text": "即使在恢復平常狀態的現在，依然作為工作方式的選項之一，逐漸在企業中扎根。", "word": "定着する" } ],
    [ { "text": "通勤時間的減少、彈性的時間分配等優點，雖然受到勞工高度肯定，", "word": "利点" }, { "text": "但也有不少聲音指出，因缺乏面對面溝通而導致的意思不合，以及成果評估上的困難，這類意見依然根深蒂固。", "word": "齟齬" } ],
    [ { "text": "尤其管理層普遍出現「難以掌握部屬工作進度」的不滿情緒，", "word": "進捗" }, { "text": "也有人指出，這正助長了企業對推行遠距工作採取謹慎態度。", "word": "姿勢" } ],
    [ { "text": "話雖如此，若從確保優秀人才的角度來看，", "word": "人材" }, { "text": "能否提供彈性的工作方式，恐怕已逐漸成為左右企業競爭力的要素了。", "word": "競争力" } ],
    [ { "text": "在尊重員工自主性的同時，如何維持組織的凝聚力，", "word": "一体感" }, { "text": "已成為今後企業經營上的重要議題浮現出來。", "word": "論点" } ]
