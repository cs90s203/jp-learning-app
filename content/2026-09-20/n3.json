  "translations": [
    [ { "text": "小時候身體虛弱、常常感冒的我，在父母的建議下開始去空手道教室上課。", "word": "空手" } ],
    [ { "text": "老實說，一開始完全沒有興趣，練習也很辛苦，好幾次都想放棄。", "word": "興味" } ],
