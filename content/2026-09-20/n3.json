    [ { "text": "然後，不僅體力變好了，", "word": "体力" }, { "text": "也培養出即使失敗也不放棄的心態。", "word": "諦める" } ],
    [ { "text": "對現在的我來說，空手道不只是運動，而是成為讓自己成長的地方。", "word": "成長する" } ]
