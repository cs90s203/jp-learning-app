  "translations": [
    [ { "text": "以都市地區為中心，由社區整體守護流浪貓的「地域貓活動」正逐漸展開。", "word": "地域猫活動" } ],
    [ { "text": "這項活動是藉由志工承擔餵食與排泄物管理的工作，試圖在不讓貓的數量無秩序增加的情況下謀求共存。", "word": "共存" } ],
    [ { "text": "以往，圍繞流浪貓的議題，餵食者受到的抱怨與反對撲殺的意見往往互相對立。", "word": "対立する" } ],
    [ { "text": "然而，因某位地區居民的熱心呼籲，各地開始結合「先絕育再放回原處」的TNR行動，", "word": "きっかけに" }, { "text": "逐漸發現這在某種程度上能回應雙方的疑慮。", "word": "懸念" } ],
    [ { "text": "話雖如此，資金與人力的確保自不用說，", "word": "もとより" }, { "text": "行政支援體制該如何完善，也仍是今後留下的課題。", "word": "課題" } ]
