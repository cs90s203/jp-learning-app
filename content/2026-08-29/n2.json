  "translations": [
    [ { "text": "說到以往的二手書店，給人的印象總是昏暗塵封、書堆得毫無縫隙。", "word": "埃っぽい" } ],
    [ { "text": "然而近年，能一邊喝咖啡一邊悠閒選書的「二手書咖啡廳」，正以都市地區為中心逐漸擴展開來。", "word": "古本カフェ" } ],
    [ { "text": "這些店提供的不只是買賣書籍的場所，而是能在舒適空間裡度過時光本身，這一點可說是與傳統二手書店最大的不同。", "word": "提供する" } ],
    [ { "text": "書架上濃厚地反映著店主的喜好，為了與意想不到的一本書相遇而常來報到的常客也不在少數。", "word": "常連客" } ],
    [ { "text": "在數位化推進、人們日漸遠離紙本書的聲浪中，這樣的場所正培育著新的閱讀文化，這點對業界而言可說是值得關注的一線曙光。", "word": "育む" } ]
  ],
