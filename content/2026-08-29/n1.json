  "translations": [
    [ { "text": "作為工作方式改革的一環，逐漸有企業在考慮引進讓有意願的員工每週可以休三天的「選擇性週休三日制」。", "word": "選択的週休三日制" } ],
    [ { "text": "推動派主張，對於希望兼顧育兒、照護或自我進修的員工而言，選擇範圍的擴大本身就具有重大意義。", "word": "両立" } ],
    [ { "text": "尤其作為防止優秀人才流失的手段，不少企業試圖將這項制度確立為人才戰略的支柱。", "word": "人材戦略" } ],
    [ { "text": "另一方面，抱持謹慎態度的一方則認為，假期增加後，每天的業務量反而有可能增大，結果恐怕會淪為長時間勞動的溫床，這樣的疑慮也根深蒂固。", "word": "懸念" } ],
    [ { "text": "此外，若是以削減薪資的形式導入，恐怕也難以避開「實質上就是減薪」的批評。", "word": "賃下げ" } ],
    [ { "text": "在討論制度本身是非之前，先詳細審查自家公司的業務實際狀況、摸索出不勉強的運用方式，這樣的態度可說才是真正被要求的。", "word": "模索する" } ]
  ],
