  "translations": [
    [ { "text": "近年，購物時可以選擇不用紙本，而是以電子資料收取「電子收據」的店家越來越多。", "word": "電子レシート" } ],
    [ { "text": "因為能透過手機App確認購買紀錄，許多人表示這樣就省去了記帳的麻煩。", "word": "家計簿" } ],
    [ { "text": "以往的紙本收據容易堆在錢包裡，也常有需要時偏偏找不到的困擾。", "word": "紙レシート" } ],
    [ { "text": "電子化雖然消除了這種麻煩，但另一方面，也有人指出不熟悉收銀台操作的長者反而更難理解。", "word": "高齢者" } ],
    [ { "text": "如何在便利性與易用性之間取得平衡，可說是今後的課題。", "word": "利便性" } ]
