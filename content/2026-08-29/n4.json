  "translations": [
    [ { "text": "上週六，我和弟弟久違地玩了桌遊。", "word": "ボードゲーム" } ],
    [ { "text": "兩人都很好勝，所以每次比賽都很認真。", "word": "負けず嫌い" } ],
    [ { "text": "一開始弟弟贏，但後半我逆轉了。", "word": "逆転する" } ],
    [ { "text": "我一邊安撫不甘心的弟弟，一邊提議再玩一次。", "word": "なだめる" } ],
    [ { "text": "結果一直玩到深夜玩了三次，兩人都累癱了。", "word": "くたくただ" } ],
    [ { "text": "即便如此，能久違地和弟弟一起笑，是非常開心的時光。", "word": "笑い合う" } ]
