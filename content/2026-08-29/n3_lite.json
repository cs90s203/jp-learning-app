  "translations": [
    [ { "text": "上個月開始，我去上了家附近的陶藝教室。", "word": "陶芸教室" } ],
    [ { "text": "一開始光是揉土就很困難，怎麼也做不出想要的形狀。", "word": "こねる" } ],
    [ { "text": "一邊跟老師學習，一邊一點一點掌握訣竅，漸漸就能做出簡單的器皿了。", "word": "コツ" } ],
    [ { "text": "用自己做的茶碗喝茶時，總覺得味道特別不一樣。", "word": "茶碗" } ],
    [ { "text": "雖然失敗還很多，但我覺得這也是陶藝的樂趣所在。", "word": "楽しさ" } ],
