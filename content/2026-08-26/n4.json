    [ { "text": "麵糊比想像中還硬，不過妹妹並不在意。", "word": "固い" } ],
    [ { "text": "一邊裝飾，一邊漸漸覺得開心起來。", "word": "楽しい" } ],
    [ { "text": "看到完成的蛋糕，妹妹非常高興。", "word": "喜ぶ" } ],
    [ { "text": "雖然很困難，但能做到最後，真的太好了。", "word": "難しい" } ]
