  "translations": [
    [ { "text": "圍繞學校營養午餐免費化的討論，作為少子化對策的一環，近幾年迅速成為政治關注的焦點。", "word": "無償化" } ],
    [ { "text": "推動派主張，減輕育兒家庭的經濟負擔、消弭地區間差距的意義，絕非可以忽視。", "word": "看過する" } ],
    [ { "text": "再加上物價飆漲的影響，考量到食費在家庭支出中所占比例不斷上升的現況，也有不少人認為免費化是當務之急的課題。", "word": "相まる" } ],
    [ { "text": "另一方面，慎重派指出，如果擱置財源該從何而來這個根本問題、只讓制度先行上路，各地方政府之間的差距反而可能進一步擴大。", "word": "拡大する" } ],
    [ { "text": "此外，要在維持營養午餐品質的同時實現免費化，誰該如何分攤相應的財政負擔、達成共識才是不可或缺的，也有不少聲音認為不應把它當成單純討好選民的政策。", "word": "合意形成" } ],
    [ { "text": "說到底，這場討論的走向，終究取決於能否具體提出籌措財源的途徑。", "word": "かかる" } ]
  ],
