  "translations": [
    [ { "text": "過去說到移動販賣車，給人的印象大多是繞行工地或住宅區、以販售午餐便當為主。", "word": "イメージ" } ],
    [ { "text": "然而近年來，儘管地方因人口過疎化，商店和超市陸續退出的地區不斷增加，載著日用品和生鮮食品的移動販賣車，卻作為新型態的生活基礎設施受到矚目。", "word": "にもかかわらず" } ],
    [ { "text": "行政機關與當地企業攜手合作，推出兼具高齡者關懷功能的服務案例也不少。", "word": "連携する" } ],
    [ { "text": "可以說，這類服務不僅止於單純的商品販售，還發揮著類似傳統「上門問需」的角色，這也是它的特色。", "word": "御用聞き" } ],
    [ { "text": "不過，也確實面臨燃料費飆漲、人手不足等課題，能否以永續的方式持續經營下去，將左右今後普及的走向。", "word": "左右する" } ]
  ],
