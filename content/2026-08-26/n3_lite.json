  "translations": [
    [ { "text": "最近，我在自家陽台開始嘗試小小的園藝。", "word": "ガーデニング" } ],
    [ { "text": "契機是朋友送我的香草幼苗。", "word": "きっかけ" } ],
    [ { "text": "又是去買土和花盆，又是查詢澆水的時機，準備工作比想像中辛苦。", "word": "大変" } ],
    [ { "text": "每天看著它一點一點成長的樣子很開心，忍不住就拍起照片來。", "word": "楽しい" } ],
    [ { "text": "雖然也遇過長蟲讓人困擾的狀況，但總算克服了。", "word": "乗り越える" } ],
    [ { "text": "到現在還沒讓它枯掉、順利養著，下次也想挑戰種蔬菜。", "word": "挑戦する" } ]
