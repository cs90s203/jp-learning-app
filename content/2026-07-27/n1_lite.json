  "translations": [
    [ { "text": "隨著工作方式的多樣化，一邊休假一邊在旅行地工作的「工作旅遊（Workation）」這種工作方式正備受關注。", "word": "ワーケーション" } ],
    [ { "text": "對地方自治團體而言，這不僅能開發觀光需求，從創造關係人口的觀點來看，也可說是值得歡迎的趨勢。", "word": "関係人口" } ],
    [ { "text": "實際上，不少自治團體整頓了配備共享工作空間的住宿設施，積極招攬都市地區的企業。", "word": "誘致する" } ],
    [ { "text": "不過，休假與業務的界線容易變得模糊，反而導致身心無法休息的意見也根深蒂固，這並非單純作為工作方式改革的一環就能解決的難題。", "word": "曖昧" } ],
    [ { "text": "與其只是形式上導入制度，是否有必要連勞動時間的管理與溝通方式都一併重新設計呢。", "word": "設計し直す" } ],
    [ { "text": "今後，加深企業方的理解似乎也將成為重要的課題。", "word": "課題" } ]
  ]
}
