  "translations": [
    [ { "text": "上週日，我和弟弟去了附近的游泳池。", "word": "行く" } ],
    [ { "text": "在游泳池裡游泳、玩水槍等等。", "word": "泳ぐ" } ],
    [ { "text": "因為弟弟還小，不用游泳圈就無法游泳。", "word": "できる" } ],
    [ { "text": "但是今天第一次能自己稍微游一下，看起來真的很開心。", "word": "嬉しい" } ],
    [ { "text": "明明天氣很好，途中卻突然下起雨來，所以提早回去了。", "word": "降る" } ],
    [ { "text": "希望下次能游得更久一點。", "word": "泳げる" } ]
