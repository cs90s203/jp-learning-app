  "translations": [
    [ { "text": "在人口減少與高齡化同時進行的地方地區，路線公車與鐵路的使用人數逐年減少，業者接連減班或廢止路線。", "word": "相次ぐ" } ],
    [ { "text": "越是仰賴自用車作為交通手段的地區，這種變化帶來的影響就越嚴重，對於繳回駕照的高齡者，以及原本就沒有車的族群而言，公共交通的縮減可能動搖到生活基礎本身，成了一個問題。", "word": "揺るがす" } ],
    [ { "text": "面對這樣的情況，部分自治團體以需求反應式交通或社區巴士取代既有的路線公車，嘗試依需求靈活運行，這種做法正逐漸普及。", "word": "広がる" } ],
    [ { "text": "不過，這類措施伴隨著一定的財政負擔，在有限的預算中能將公共交通的功能維持到什麼程度，各自治團體的應對方式並不相同，這是實際情況。", "word": "実情" } ],
    [ { "text": "此外，也有人指出，若僅以收益性為基準判斷路線的存廢，恐怕會使地區的生活基礎建設本身消失，因此也出現了應該將公共交通不只當作單純的事業，而是重新定位為社會保障一環的議論。", "word": "位置づけ直す" } ],
    [ { "text": "今後，除了確保財源之外，恐怕也需要建立讓居民自身參與討論交通應有樣貌的機制。", "word": "仕組みづくり" } ]
  ]
}
