  "translations": [
    [ { "text": "在少子高齡化不斷推進之中，地區內世代之間聯繫日益淡化的問題，早已被指出多時。", "word": "希薄化" } ],
    [ { "text": "因應這樣的狀況，近年來企劃讓從兒童到高齡者都能共同參加的多世代交流活動的地方自治團體與NPO正在增加。", "word": "多世代交流イベント" } ],
    [ { "text": "例如，高齡者向孩子們傳授傳統遊戲與料理，另一方面孩子們則教高齡者使用數位裝置的方法，這種納入雙向學習的活動也並不少見。", "word": "学び合い" } ],
    [ { "text": "這些措施不僅止於單純的世代間聯誼，也被認為能連結到對容易陷入孤立的高齡者的照看，因此從福利的側面也備受關注。", "word": "見守り" } ],
    [ { "text": "不過，也面臨著擔任推手的志工本身高齡化、資金不足等課題，要讓活動持續下去，可以說行政機關持續性的支援是不可或缺的。", "word": "支援" } ]
  ]
}
