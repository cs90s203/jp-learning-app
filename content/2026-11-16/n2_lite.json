  "translations": [
    [ { "text": "近年，使用智慧型手機或平板就能線上看診的服務正在普及。", "word": "オンライン" } ],
    [ { "text": "即使不特地跑去醫院，只要用視訊通話就能和醫生諮詢，對忙碌的人或行動不便的高齡者來說是很方便的機制。", "word": "にとって" } ],
    [ { "text": "依症狀而定，有時仍需要面對面診療，但如果只是輕微感冒或開藥，現在能靠線上就充分應對的案例也增加了。", "word": "対応する" } ],
    [ { "text": "另一方面，在通訊環境不完善的地區，以及不熟悉操作機器的高齡者來說，反而變得更難以使用，這樣的課題依然存在。", "word": "一方で" } ],
    [ { "text": "今後，該如何填補這樣的差距，恐怕會變得很重要。", "word": "格差" } ]
  ],
