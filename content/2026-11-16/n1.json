  "translations": [
    [ { "text": "再生能源導入規模的擴大，除了作為應對地球暖化對策的意義之外，從能源安全保障的角度來看，重要性也日益增加。", "word": "重要性" } ],
    [ { "text": "尤其值得關注的是，與化石燃料價格的國際波動相結合，國內要求提高能源自給率的聲音也日漸增強。", "word": "相まる" } ],
    [ { "text": "政府正在推動固定價格收購制度的檢討、電網併聯的擴充等政策，但圍繞導入成本的負擔，也有人指出這有可能以電費上漲的形式轉嫁到消費者身上。", "word": "めぐる" } ],
    [ { "text": "另外，依賴太陽光、風力等自然條件的電源，發電量容易隨天候大幅波動，這給承擔穩定供電任務的既有電網帶來了相應的負荷。", "word": "きらい" } ],
    [ { "text": "若無視這些課題、只一味喊出導入目標數字，很難說是對未來世代盡到了責任。", "word": "言う" } ],
    [ { "text": "為了充分發揮唯有再生能源才能實現的地區分散型電力供應的可能性，從技術層面與制度層面雙管齊下，累積足以令人信賴的討論，應該是必要的。", "word": "足る" } ]
  ],
