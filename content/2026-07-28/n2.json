  "translations": [
    [ { "text": "近年，代替飼主照顧寵物的寵物保姆服務利用日益普及。", "word": "ペットシッターサービス" } ],
    [ { "text": "背後原因可能是雙薪家庭增加，以及把寵物視為家人般珍惜的意識提高。", "word": "共働き" } ],
    [ { "text": "與傳統的寵物旅館不同，因為能在住慣的自家接受照顧，能減輕動物壓力這點受到肯定。", "word": "軽減する" } ],
    [ { "text": "另一方面，也有聲音指出服務品質參差不齊，以及對讓陌生人在自己不在家時進入家中感到不安。", "word": "不安" } ],
    [ { "text": "業界團體中，也出現了設立資格制度與研習，試圖維持服務品質穩定的動向。", "word": "資格" } ],
    [ { "text": "建立能辨別可信賴業者的機制，成為當務之急。", "word": "見極める" } ]
  ],
