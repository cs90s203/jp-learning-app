  "translations": [
    [ { "text": "上個月和媽媽去附近的溫泉住了一晚旅行。", "word": "温泉" } ],
    [ { "text": "泡了溫泉，也吃了好吃的料理，能悠閒地度過時光。", "word": "のんびり" } ],
    [ { "text": "晚上星星看起來很美，於是兩人出去外面散了一下步。", "word": "見える" } ],
    [ { "text": "媽媽說能這麼悠閒地聊天，已經是好久沒有的事了。", "word": "久しぶり" } ],
    [ { "text": "回程的車上，兩人聊著說還想再來。", "word": "話す" } ],
    [ { "text": "下次想住得更久一點。", "word": "泊まる" } ]
