  "translations": [
    [ { "text": "會開始學發聲練習的理由是，我發現自己在人前說話時聲音發不好。", "word": "ボイストレーニング" } ],
    [ { "text": "一開始從基礎的呼吸法學起，沒想到比想像中更消耗體力，讓我很驚訝。", "word": "呼吸法" } ],
    [ { "text": "老師說，聲音並不是天生的，而是可以透過練習改變的東西。", "word": "変える" } ],
    [ { "text": "實際上持續練習了幾個月後，感覺聲音變得比以前更響亮清晰了。", "word": "通る" } ],
    [ { "text": "對在人前說話的排斥感，也覺得漸漸緩和了下來。", "word": "和らぐ" } ],
    [ { "text": "想照這個步調再繼續下去，希望有一天在人前也能不緊張地說話。", "word": "緊張する" } ]
  ],
