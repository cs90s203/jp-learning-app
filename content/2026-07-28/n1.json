  "translations": [
    [ { "text": "以人口減少與高齡化加劇的地方為中心，空屋增加已成為嚴重的社會問題。", "word": "空き家" } ],
    [ { "text": "背景被認為是繼承時所有人未能確定，或是為了避免負擔拆除費用而被放置不管，這樣的空屋也可能成為引發倒塌、景觀惡化及治安風險的因素。", "word": "放置する" } ],
    [ { "text": "行政雖然設有將其指定為特定空屋並進行指導、勸告的制度，但對私有財產的介入有其極限，尚未達到根本性的解決。", "word": "介入" } ],
    [ { "text": "雖然各地也在推動將空屋作為地區資源加以活化、交由移居者或業者利用的措施，但供需不一致與修繕費用高昂仍是障礙。", "word": "再生する" } ],
    [ { "text": "今後除了所有人意識改革之外，建立防患於未然、避免空屋產生的機制，也可說是不可或缺的。", "word": "仕組みづくり" } ],
    [ { "text": "不僅止於單純加強法規，及早掌握空屋狀況、建置能順利交接給下一位承接者的資訊基盤，也同樣被需要。", "word": "引き継ぐ" } ]
  ],
