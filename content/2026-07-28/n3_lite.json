    [ { "text": "最近開始嘗試刺繡。", "word": "刺繍" } ],
    [ { "text": "契機是朋友給我看了她做的手帕。", "word": "見せる" } ],
    [ { "text": "因為做得非常仔細精緻，讓我自己也想試著做做看。", "word": "丁寧" } ],
