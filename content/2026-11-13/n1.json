  "translations": [
    [ { "text": "自從教師的長時間勞動被視為社會問題提出討論以來，工作方式改革已成為教育行政上的重要課題之一。", "word": "働き方改革" } ],
    [ { "text": "根據文部科學省的調查，許多教師因備課、社團活動指導、應對家長等事務而忙得不可開交，無法準時下班的實際情況也隨之曝光。", "word": "実態" } ],
    [ { "text": "不僅如此，加班時間之多依然看不到改善的跡象，再加上人手不足，現場的負擔只是不斷增加。", "word": "相まる" } ],
    [ { "text": "基於這樣的狀況，部分教育委員會正推動將社團活動轉移至地方社區承接，並配置支援人力處理行政事務，但也有不少意見指出其效果有限。", "word": "限定的" } ],
    [ { "text": "也有越來越多聲音指出，為了確保教師能將唯有他們才具備的專業性投入到課堂教學中，有必要重新檢視業務分配本身。", "word": "専門性" } ],
    [ { "text": "要求改善薪資待遇的意見依然根深蒂固，工作方式改革的議論預料今後仍將持續下去。", "word": "議論" } ]
