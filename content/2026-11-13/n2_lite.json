  "translations": [
    [ { "text": "最近，購物時使用集點卡的人越來越多。", "word": "ポイントカード" } ],
    [ { "text": "過去每家店鋪都要各自持有不同的卡片，不少人抱怨管理起來很繁瑣。", "word": "煩雑" } ],
    [ { "text": "但近年來，能在智慧型手機應用程式中統一登錄多家店鋪點數的服務普及開來，便利性大幅提升。", "word": "普及する" } ],
    [ { "text": "在這樣的變化背景下，原本偏好用現金的高齡族群，使用集點卡的情況也逐漸增加。", "word": "高齢層" } ],
    [ { "text": "另一方面，對於個人購買數據被企業累積這一點，也有不少人持謹慎的態度。", "word": "慎重" } ],
    [ { "text": "企業方被要求更明確地說明保護隱私的機制。", "word": "説明する" } ]
