  "translations": [
    [ { "text": "支撐緊急送醫現場的救護員人才短缺問題，正在各地日益嚴重。", "word": "人材不足" } ],
    [ { "text": "儘管隨著高齡化，救護出勤次數年年增加，但救護員的培訓人數卻未能相應成長。", "word": "増加する" } ],
    [ { "text": "長時間工作、夜間應對等勞動環境的嚴峻，使得不少人選擇離職，現場始終瀰漫著人手不足的緊張氣氛。", "word": "離職する" } ],
    [ { "text": "考量到這樣的狀況，部分地方政府正在推動重新檢討薪資水準，以及引進支援取得資格的獎學金制度。", "word": "奨学金制度" } ],
    [ { "text": "然而根本性的人才確保問題仍未解決，專家指出，需要全國上下共同致力於改善待遇的呼聲也隨之提高。", "word": "専門家" } ],
    [ { "text": "為了維護緊急醫療的持續性，也急需建立起將現場聲音反映到政策上的機制。", "word": "救急医療" } ]
  ],
