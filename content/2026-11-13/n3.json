  "translations": [
    [ { "text": "開始學俳句的契機，是祖父留下的一本俳句筆記。", "word": "きっかけ" } ],
    [ { "text": "祖父生前把吟詠俳句當作興趣，但我當時並不太懂其中的魅力。", "word": "趣味" } ],
    [ { "text": "整理遺物時，我接觸到筆記裡季語的運用和選詞的方式，驚訝於短短的文字中竟蘊含著如此豐富的情景。", "word": "驚く" } ],
    [ { "text": "受到這個契機的觸動，我心中萌生了想自己試著吟詠的念頭，於是開始定期參加當地的俳句社團。", "word": "きっかけ" } ],
    [ { "text": "一開始光是把句子套進五七五的格式就已經竭盡全力，但持續下去之後，我發現自己漸漸能更仔細地觀察季節的變化了。", "word": "観察する" } ]
  ],
