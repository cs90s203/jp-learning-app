  "translations": [
    [ { "text": "週末，我去了奶奶家，一起在附近的河邊散步。", "word": "散歩する" } ],
    [ { "text": "奶奶的腳力已經變弱了，卻還是不休息地慢慢繼續走著。", "word": "弱い" } ],
    [ { "text": "途中我們拍了照片，也聊了以前的事，度過了非常愉快的時光。", "word": "楽しい" } ],
    [ { "text": "奶奶說她以前常常在這條河邊玩，讓我聽到了許多不知道的故事，覺得很新鮮。", "word": "新鮮" } ],
    [ { "text": "好久沒有這樣和奶奶慢慢聊天了，覺得很開心。", "word": "嬉しい" } ]
