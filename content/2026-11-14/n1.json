  "translations": [
    [ { "text": "與少子高齡化相結合，勞動力不足正對各行各業投下陰影，有關接受外籍勞工的議論也再度活躍起來。", "word": "相まって" } ],
    [ { "text": "取代技能實習制度的新居留資格已經設立，可接受的行業也逐漸擴大，但在人力嚴重不足的領域，也不能否認有被迫擴大接受規模的情況。", "word": "余儀なくされる" } ],
    [ { "text": "另一方面，若偏向把他們當作低薪勞動力來接受，也有不少人指出這可能招致勞動環境惡化與社會分裂的隱憂。", "word": "おそれ" } ],
    [ { "text": "據報導，有些接收企業在支援體制尚未完備的情況下就接收人才，結果導致離職或失蹤等案例。", "word": "つながる" } ],
    [ { "text": "要建立足以真正實現共生社會的制度，恐怕也需要同時推進語言教育、住房支援等生活基礎的建置。", "word": "足る" } ],
    [ { "text": "與其只優先考慮經濟合理性，更應該思考如何建立讓被接受的人們能有尊嚴地生活的機制，這需要全國一起深化討論。", "word": "求める" } ]
