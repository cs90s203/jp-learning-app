  "translations": [
    [ { "text": "以地方為中心，助產師不足已成為嚴重的課題。", "word": "不足" } ],
    [ { "text": "隨著生產環境的改變，希望在大醫院而非個人婦產醫院生產的人增加，結果使得每位助產師的業務負擔變重。", "word": "増える" } ],
    [ { "text": "夜間與假日的待命呼叫也很多，身心都難以獲得餘裕的工作方式持續著，因此選擇離職的助產師也不少。", "word": "続く" } ],
    [ { "text": "由於人力不足，被迫暫停接收分娩的婦產醫院也開始出現，有些地區甚至出現孕婦必須前往遠方醫院的狀況。", "word": "余儀なくされる" } ],
    [ { "text": "如果這種狀況持續下去，也有人擔心能夠安心生產的環境本身可能會消失。", "word": "失われる" } ],
    [ { "text": "行政正在推動擴大培訓學校名額與改善待遇，但要看到成效似乎還需要一些時間。", "word": "進める" } ]
  ],
  "grammar_notes": [
    { "sentence": 3, "pattern": "〜を余儀なくされる", "note": "「被迫〜」，書面被動" }
  ]
}
