  "translations": [
    [ { "text": "終身僱用不再是理所當然的現在，日本企業裡技能再造的做法正逐漸擴展。", "word": "広がり" } ],
    [ { "text": "隨著數位轉型的進展，光靠以往的知識已無法應付業務的情況增多，這促使許多企業開始支援員工重新學習。", "word": "きっかけ" } ],
    [ { "text": "雖然建立了研修制度，但也有不少員工因業務繁忙而無法如願抽出時間。", "word": "ものの" } ],
    [ { "text": "即使如此，據說透過線上課程等方式，比以前更積極學習新技術的人正在增加。", "word": "通じる" } ],
    [ { "text": "專家指出，若不建立因應個人意願的靈活學習機會，難得的制度也可能只淪為形式。", "word": "終わる" } ],
    [ { "text": "員工與企業能否一起持續變化，將左右今後的競爭力。", "word": "変化し続ける" } ]
  ],
