  "translations": [
    [
      {
        "text": "上週末，第一次在朋友家的院子裡烤肉。",
        "word": "バーベキュー"
      }
    ],
    [
      {
        "text": "大家一起烤肉和蔬菜，熱熱鬧鬧地吃了。",
        "word": "にぎやかだ"
      }
    ],
    [
      {
        "text": "用火的方法很難，稍微烤焦了一點。",
        "word": "焦げる"
      }
    ],
    [
      {
        "text": "即便如此味道還是很好吃，大家看起來都很滿足。",
        "word": "満足そうだ"
      }
    ],
    [
      {
        "text": "收拾很辛苦，但成了很好的回憶。",
        "word": "思い出"
      }
    ]
  ],
