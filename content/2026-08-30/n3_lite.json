  "translations": [
    [
      {
        "text": "去年春天，開始嘗試一直很在意的攝影。",
        "word": "始める"
      }
    ],
    [
      {
        "text": "一開始連相機的用法都不太懂，反覆看了好幾次說明書。",
        "word": "分かる"
      }
    ],
    [
      {
        "text": "還不習慣的時候常常失敗，也有很多對不到焦的照片。",
        "word": "失敗"
      }
    ],
    [
      {
        "text": "即便如此漸漸掌握了訣竅，最近也能拍出自己滿意的一張照片了。",
        "word": "満足する"
      }
    ],
    [
      {
        "text": "休假日會到公園或咖啡廳，一邊留意光線的照入方式一邊拍照。",
        "word": "意識する"
      }
    ],
    [
      {
        "text": "作為興趣持續下來後，日常的風景漸漸變得比以前更美了。",
        "word": "見える"
      }
    ]
  ],
