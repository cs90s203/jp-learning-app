  "translations": [
    [
      {
        "text": "今年夏天，和祖母一起醃了梅乾。",
        "word": "梅干し作り"
      }
    ],
    [
      {
        "text": "把院子裡採到的梅子洗一洗、裹上鹽，花時間慢慢醃漬。",
        "word": "漬け込む"
      }
    ],
    [
      {
        "text": "祖母很了解從前的做法，我就一邊跟她學一邊進行作業。",
        "word": "教わる"
      }
    ],
    [
      {
        "text": "途中差點失敗，但多虧祖母才得以完成到最後。",
        "word": "やり遂げる"
      }
    ],
    [
      {
        "text": "完成的梅乾很酸，全家人都吃得很開心。",
        "word": "出来上がる"
      }
    ]
  ],
