  "translations": [
    [ { "text": "在少子高齡化導致勞動人口減少的背景下，", "word": "少子高齢化" }, { "text": "應進一步擴大接受外國人才的議論正在各界熱烈展開。", "word": "外国人材" } ],
    [ { "text": "經濟界方面，以苦於人手不足的產業為中心，", "word": "人手不足" }, { "text": "要求擴大接受名額的呼聲根深蒂固。", "word": "根強い" } ],
    [ { "text": "然而，在討論擴大接受與否時，", "word": "是非" }, { "text": "不應僅止於單純補充勞動力這種想法。", "word": "補填" } ],
    [ { "text": "實際上，源自語言與文化差異的摩擦、與地方社區的摩擦，", "word": "摩擦" }, { "text": "乃至圍繞勞動條件的糾紛等，亟待解決的課題堆積如山。", "word": "山積する" } ],
    [ { "text": "尤其是，若不對那種容易被輕易當作廉價勞動力對待的結構本身動刀，", "word": "低賃金労働力" }, { "text": "無論再怎麼增加接受人數，恐怕都無法實現真正意義上的共生社會。", "word": "共生社会" } ],
    [ { "text": "視制度設計的好壞而定，所接受的人才可能被迫陷入孤立，", "word": "余儀なくされる" }, { "text": "非但無法定居下來，反而有可能導致不信任感加深的結果。", "word": "不信感" } ],
    [ { "text": "今後，在擴大接受數量的同時，也必須不懈怠生活支援與日語教育等質面的基礎建設，", "word": "基盤整備" }, { "text": "並持續不斷地檢驗政策的實效性，這樣的態度將是必要的。", "word": "実効性" } ]
  ],
