  "translations": [
    [ { "text": "近年，隨著科技革新的速度，", "word": "技術革新" }, { "text": "社會人士重新學習新技能的「回爐再造」風潮正在擴大。", "word": "リスキリング" } ],
    [ { "text": "過去，很多人都是以長期任職於同一間公司為前提，", "word": "勤める" }, { "text": "來累積職涯。", "word": "キャリア" } ],
    [ { "text": "但如今終身雇用已不再是理所當然，", "word": "終身雇用" }, { "text": "也確實有越來越多人覺得，光是依賴企業無法消除對未來的不安。", "word": "依存する" } ],
    [ { "text": "實際上，雖然政府和企業也在逐步建立推動回爐再造的制度，", "word": "制度" }, { "text": "但一邊工作一邊確保學習新領域的時間並不容易。", "word": "確保" } ],
    [ { "text": "雖然不少人會以忙碌為由，而容易把重新學習的事往後拖延，", "word": "先延ばし" }, { "text": "但在這個變化劇烈的時代，持續學習本身或許可以說是一種安全網。", "word": "学び続ける" } ]
  ],
