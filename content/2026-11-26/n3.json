  "translations": [
    [ { "text": "大學時代，因為被研討課的老師邀請，", "word": "誘う" }, { "text": "就此開始學習能樂。", "word": "習い始める" } ],
    [ { "text": "一開始，對那種獨特的動作和發聲方式感到不知所措，", "word": "戸惑う" }, { "text": "說實話好幾次都想過要放棄。", "word": "やめる" } ],
    [ { "text": "但是，我相信了老師說的「只要記住型，身體一定會自然而然地動起來」，", "word": "おっしゃる" }, { "text": "於是決定繼續練習下去。", "word": "ことにする" } ],
    [ { "text": "實際上，隨著不斷練習，", "word": "練習" }, { "text": "漸漸能感覺到型逐漸融入了身體。", "word": "身につく" } ],
    [ { "text": "能樂雖然稱不上華麗，", "word": "派手さ" }, { "text": "卻在寧靜之中蘊含著強烈的緊張感。", "word": "緊張感" } ],
    [ { "text": "越了解能樂的深奧之處，", "word": "奥深さ" }, { "text": "就越想要更加進步。", "word": "上達する" } ]
  ],
