  "translations": [
    [ { "text": "近年，公立學校的教師短缺問題日益嚴重，", "word": "教員不足" }, { "text": "各地教育現場的業務吃緊情況也被指出。", "word": "逼迫" } ],
    [ { "text": "其背景之一在於，由於長時間勞動與行政業務增加，", "word": "長時間労働" }, { "text": "教職這份工作的魅力正逐漸減弱。", "word": "魅力" } ],
    [ { "text": "實際上，教師錄用考試的競爭倍率逐年下降，", "word": "倍率" }, { "text": "無法充分確保人才的地方政府也不在少數。", "word": "自治体" } ],
    [ { "text": "尤其在理科、英語等專業性較高的科目中，連代課老師都找不到，", "word": "講師" }, { "text": "導致課程本身無法成立的案例也在各地被陸續通報。", "word": "成立する" } ],
    [ { "text": "文部科學省雖試圖透過業務外包與工作方式改革來減輕負擔，", "word": "働き方改革" }, { "text": "但預料要看到成效仍需要一段時間。", "word": "効果" } ],
    [ { "text": "正因為教師短缺是直接關係到孩子學習品質的問題，", "word": "直結する" }, { "text": "所以人們要求儘速採取對策。", "word": "対応" } ]
  ],
