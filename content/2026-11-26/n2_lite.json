    [ { "text": "尤其是只要掃描QR Code就能完成付款的便利性，", "word": "手軽さ" }, { "text": "受到許多使用者的支持。", "word": "支持する" } ],
    [ { "text": "對使用者來說，就算忘記帶錢包也能購物，", "word": "財布" }, { "text": "這種安心感很大。", "word": "安心感" } ],
    [ { "text": "另一方面，也有人指出，", "word": "一方で" }, { "text": "停電或系統故障時將無法完成付款的缺點。", "word": "弱点" } ],
