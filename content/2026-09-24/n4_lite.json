    [
      {
        "text": "上星期，我第一次和家人去了挖蛤蜊。",
        "word": "潮干狩り"
      }
    ],
    [
      {
        "text": "海邊風很大，有點冷。",
        "word": "強い"
      }
    ],
    [
      {
        "text": "不過，挖到了很多蛤蜊，很開心。",
        "word": "採れる"
      }
    ],
    [
      {
        "text": "回家之後，大家一起煮味噌湯吃了。",
        "word": "味噌汁"
      }
    ],
    [
      {
        "text": "貝類的味道很濃郁，非常好吃。",
        "word": "おいしい"
      }
    ],
    [
      {
        "text": "我想明年也再去一次。",
        "word": "思う"
      }
    ]
