  "translations": [
    [
      {
        "text": "星期天，我和弟弟去了附近的河邊釣魚。",
        "word": "魚釣り"
      }
    ],
    [
      {
        "text": "早上天氣很好，但到了中午突然轉陰，有點擔心。",
        "word": "ので"
      }
    ],
    [
      {
        "text": "儘管如此，弟弟不放棄地一直拋竿、收線。",
        "word": "諦める"
      }
    ],
    [
      {
        "text": "我怎麼也釣不到魚，弟弟卻釣到了三條小魚。",
        "word": "のに"
      }
    ],
    [
      {
        "text": "雖然不甘心，但看到弟弟的笑容，不知怎麼地開心了起來。",
        "word": "笑顔"
      }
    ]
  ],
