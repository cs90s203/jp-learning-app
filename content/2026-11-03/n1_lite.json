  "translations": [
    [ { "text": "在地方醫療現場，藥師不足已成為嚴重的課題。", "word": "深刻" } ],
    [ { "text": "比起城市地區，地方藥局即使刊登職缺也很難招到人，現有藥師被迫長時間工作的情況也不少。", "word": "余儀なくされる" } ],
    [ { "text": "背景之一是，許多藥學系畢業生傾向於志願進入城市地區的大型連鎖藥局，而不希望被分配到地方。", "word": "傾向" } ],
    [ { "text": "此外，除了調劑業務之外，對患者的用藥指導、居家醫療應對等被要求的角色也逐年增加，這也加速了人才不足的情況。", "word": "拍車" } ],
    [ { "text": "因應這樣的狀況，部分地方政府設立了獎學金還款減免制度，推動在地方就業的措施。", "word": "設ける" } ],
    [ { "text": "此外，也有藥局透過活用線上用藥指導，試圖以有限的人力擴大服務範圍。", "word": "活用" } ],
    [ { "text": "確保藥師並不是單靠一個地方政府就能解決的問題，而是需要全國重新檢視培養人數與配置方式。", "word": "見直す" } ]
