  "translations": [
    [ { "text": "關於選擇性夫婦別姓制度的引進，國會與媒體多年來持續進行討論。", "word": "議論" } ],
    [ { "text": "根據現行民法，結婚時必須將姓氏統一為其中一方的姓，而實際上絕大多數是女性改姓。", "word": "統一する" } ],
    [ { "text": "主張引進此制度的一方認為，不應輕視改姓帶來的職業上不利益與身分認同的喪失感。", "word": "主張" } ],
    [ { "text": "事實上，擔心改姓會切斷研究成果或與客戶之間信賴關係的聲音也根深蒂固。", "word": "懸念する" } ],
    [ { "text": "另一方面，持謹慎立場的一方則認為，夫婦同姓是支撐家庭一體感的習慣，若允許選擇不同姓，家庭的情感連結恐怕會變弱。", "word": "弱まる" } ],
    [ { "text": "從國際上來看，以法律強制夫婦姓氏相同的國家屬於少數，因此也有不少國內外的聲音基於此點要求重新檢視制度。", "word": "見直し" } ],
    [ { "text": "最終的判斷仍交由國會討論，但理應制定出一套符合當事人實際情況的制度。", "word": "しかるべき" } ]
  ],
