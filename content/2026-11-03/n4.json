  "translations": [
    [ { "text": "這次休假和媽媽去山上賞楓了。", "word": "紅葉狩り" } ],
    [ { "text": "因為天氣很好，所以看到了很多美麗的紅葉。", "word": "ので" } ],
    [ { "text": "又拍照又吃便當，悠閒地度過了時間。", "word": "のんびり" } ],
