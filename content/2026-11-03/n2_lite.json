  "translations": [
    [ { "text": "近年，日本的無現金支付正在快速普及。", "word": "普及する" } ],
    [ { "text": "只要使用智慧型手機的應用程式或IC卡，就算不帶現金也能購物了。", "word": "できる" } ],
    [ { "text": "不只便利商店和超市，連個人經營的小店也漸漸跟上了這個趨勢。", "word": "進む" } ],
    [ { "text": "隨著無現金支付的普及，使用現金的機會確實在減少。", "word": "伴う" } ],
    [ { "text": "對使用者來說，結帳速度變快是個優點；對店家來說，收銀業務的負擔也減輕了，是個好處。", "word": "メリット" } ],
    [ { "text": "另一方面，不少高齡者對操作方式感到不安，因此需要細心的說明與協助。", "word": "一方で" } ],
    [ { "text": "不僅是高齡者，打造一套任何人都容易使用的機制，今後應該是必要的。", "word": "限る" } ]
  ],
