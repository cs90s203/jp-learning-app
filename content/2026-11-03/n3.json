  "translations": [
    [ { "text": "開始學習書法的原因，是奶奶那手漂亮的字。", "word": "達筆" } ],
    [ { "text": "奶奶總是用美麗的文字寫季節問候信，每次看到都讓我很感動。", "word": "感動する" } ],
    [ { "text": "我也想變得能寫出一樣的字，於是開始去附近的書法教室上課。", "word": "通い始める" } ],
    [ { "text": "一開始連拿筆的方式都很困難，線條完全畫不出我想要的樣子。", "word": "難しい" } ],
    [ { "text": "但老師告訴我：「比起寫得好，享受寫字的過程更重要。」", "word": "楽しむ" } ],
    [ { "text": "因為這句話，就算寫不好的日子也能輕鬆地繼續下去了。", "word": "続ける" } ],
    [ { "text": "過了半年的現在，拿筆的時間成了比什麼都重要的放鬆時刻。", "word": "息抜き" } ]
  ],
