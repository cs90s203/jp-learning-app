  "translations": [
    [ { "text": "在高齡化持續加劇的當下，各地都在推動培育在社區守護失智症患者的「失智症支援員」。", "word": "認知症サポーター" } ],
    [ { "text": "由於只要參加研習任何人都能登記，這種便利性也讓至今培育的人數在全國已超過一千萬人。", "word": "手軽さ" } ],
    [ { "text": "然而，據說也有不少人雖然取得了資格，卻始終沒有具體的活動機會就不了了之。", "word": "ものの" } ],
    [ { "text": "儘管地區綜合照護支援中心等單位試圖提供活動場所，但由於知名度不足，參加者遲遲無法增加，這是實情。", "word": "にもかかわらず" } ],
    [ { "text": "也有人指出，若無法活用好不容易培育出的人才就沒有意義，行政單位被要求建立具實效性的機制。", "word": "実効性" } ],
    [ { "text": "今後不僅是培育，也有愈來愈多聲音認為應該同時投入持續性的活動支援。", "word": "だけでなく" } ]
  ],
  "grammar_notes": []
}
