  "translations": [
    [ { "text": "在人口過疏化持續的地方自治體，空屋增加已成為嚴重的問題。", "word": "空き家" } ],
    [ { "text": "儘管行政單位設立了名為「空屋銀行」的制度，向有意移居者提供房產資訊，但實際的成交數卻未如預期增長。", "word": "にもかかわらず" } ],
    [ { "text": "許多房產老舊化嚴重，整修費用的負擔沉重，被認為是原因之一。", "word": "要因" } ],
    [ { "text": "話雖如此，隨著對都市生活感到疲憊的人增加，據說對鄉下生活本身的關心確實在提高。", "word": "伴う" } ],
    [ { "text": "就行政單位而言，也不得不設法充實整修費用的補助制度等，來減輕使用者的負擔。", "word": "せざるを得ない" } ],
    [ { "text": "今後，恐怕需要包含與當地居民交流支援在內的綜合性措施。", "word": "求める" } ]
  ],
  "grammar_notes": [
