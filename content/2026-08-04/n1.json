  "translations": [
    [ { "text": "隨著生成式AI的急速進化，圍繞著將既有著作物作為訓練資料使用是否恰當的議論，正在各國變得活躍。", "word": "学習データ" } ],
    [ { "text": "雖然否定技術發展本身的人不多，但隨著大量作品在未經權利人同意下被用於學習的實情逐漸明朗，認為不能再忽視法律制度落後的聲浪也日益增強。", "word": "看過する" } ],
    [ { "text": "尤其當生成物與既有作品極為相似時，許多人對於將其視為獨創作品持謹慎態度。", "word": "慎重論" } ],
    [ { "text": "不過，僅靠現有著作權法的框架就想全面掌握生成式AI特有的課題，似乎有些勉強。", "word": "きらいがある" } ],
    [ { "text": "技術革新的速度與法制完善跟不上的現狀相互交織，使得權利人與開發者雙方都能認同的共識並不容易達成。", "word": "相まって" } ],
    [ { "text": "即使如此，若放任可能威脅創作者生活基礎的情況不管，不難想像這將招致文化本身的衰退。", "word": "難くない" } ],
    [ { "text": "各國議論的走向，將大幅左右今後創作活動應有的樣貌，這是無庸置疑的。", "word": "論をまたない" } ]
  ],
