  "translations": [
    [ { "text": "上星期天，我和弟弟在附近的河邊烤肉。", "word": "バーベキュー" } ],
    [ { "text": "因為天氣很好，所以一大早就開始準備了。", "word": "準備" } ],
    [ { "text": "烤烤肉、烤烤菜，還在河邊釣釣魚，玩得很開心。", "word": "楽しむ" } ],
    [ { "text": "弟弟明明不擅長做菜，這次卻注意炭火的火候，能烤得很好，讓我很驚訝。", "word": "驚く" } ],
    [ { "text": "連收拾都兩個人確實做好了，是非常滿足的一天。", "word": "満足する" } ],
    [ { "text": "明年也想再一起做。", "word": "やる" } ]
  ],
