  "translations": [
    [ { "text": "從小時候就喜歡唱歌，但不擅長在人前唱歌。", "word": "苦手" } ],
    [ { "text": "去年，以朋友的邀約為契機，我下定決心加入了地區的合唱團。", "word": "きっかけに" } ],
    [ { "text": "第一次練習時緊張到發不出聲音，但多虧老師，漸漸有了自信。", "word": "おかげで" } ],
    [ { "text": "工作忙碌的時期常常請假，但每次練習都有新發現，很開心。", "word": "たびに" } ],
    [ { "text": "對在人前唱歌的排斥感，經過反覆練習後，感覺也淡化了不少。", "word": "末に" } ],
    [ { "text": "和夥伴們一起合唱的時光，是無可取代的珍貴時刻。", "word": "貴重" } ]
  ],
