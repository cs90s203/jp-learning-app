    [ { "text": "在全國人口減少與高齡化不斷加劇之中，繼承之後遭到放置的空屋增加，已成為嚴重的問題。", "word": "空き家" } ],
    [ { "text": "根據總務省的調查，這個數量在全國已經超過九百萬戶。", "word": "調査" } ],
    [ { "text": "尤其在地方的人口稀少地區，這個傾向更加顯著。", "word": "顕著" } ],
    [ { "text": "倒塌的危險與景觀惡化自不待言，甚至可能成為提高治安風險的因素，讓許多地方政府傷透腦筋。", "word": "自治体" } ],
    [ { "text": "也有不少案例是無法確定所有者，或以拆除費用的負擔為由而遲遲不肯脫手，行政上的強制處理也有其極限。", "word": "限界" } ],
    [ { "text": "儘管空屋銀行制度的完善、稅制上的優惠措施等促進活用的措施也在推進，但現狀是尚未達到根本性的解決。", "word": "現状" } ],
    [ { "text": "可以說這是需要整個地區社會持續著手處理的課題。", "word": "課題" } ]
  ],
