  "translations": [
    [ { "text": "星期六我和朋友烤肉了。", "word": "バーベキュー" } ],
    [ { "text": "從早上開始烤肉、切菜，大家一起準備。", "word": "準備する" } ],
    [ { "text": "因為天氣非常好，所以能在河邊愉快地度過一整天。", "word": "できる" } ],
