  "translations": [
    [ { "text": "去年夏天，因為想穿和服出席朋友的婚禮，開始去上和服穿著課。", "word": "通い始める" } ],
    [ { "text": "在那之前一直覺得和服跟自己沒什麼緣分，但實際學了之後才知道，光是綁腰帶的方式就有很深的訣竅。", "word": "奥深い" } ],
    [ { "text": "老師常說：「穿和服要靠身體記住，只能不斷練習。」", "word": "練習する" } ],
    [ { "text": "一開始腰帶總是綁不緊，吃了不少苦頭，但現在已經能一個人穿好了。", "word": "苦労する" } ],
    [ { "text": "穿上和服時感覺背脊會自然挺直，也讓我覺得日本的傳統文化變得更貼近生活。", "word": "身近" } ]
