  "translations": [
    [ { "text": "作為同時實現減少食物浪費與支援生活困難者的措施，食物銀行活動正在全國各地擴展開來。", "word": "取り組み" } ],
    [ { "text": "這是一種收集企業或個人捐贈、雖然接近賞味期限但品質沒有問題的食品，再無償送到有需要的家庭或福利機構的機制。", "word": "仕組み" } ],
    [ { "text": "加上物價上漲的影響，希望使用這項服務的人據說逐年增加。", "word": "増加する" } ],
    [ { "text": "不過，捐贈食品的數量和種類並不均衡，負責營運的志工也不容易確保，因此要持續穩定的活動，課題並不少。", "word": "課題" } ],
    [ { "text": "即便如此，善用地區間的連結、努力擴大支援圈子的行動，仍在穩健地擴展當中。", "word": "広がる" } ],
    [ { "text": "今後也期待能與行政機關展開合作。", "word": "連携" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜ものの", "note": "「雖然〜」，書面逆接" }
  ]
