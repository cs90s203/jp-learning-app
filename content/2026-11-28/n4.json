  "translations": [
    [ { "text": "上星期和哥哥兩個人去露營了。", "word": "キャンプ" } ],
    [ { "text": "因為天氣很好，所以在河邊游泳、釣魚玩耍。", "word": "ので" } ],
    [ { "text": "晚上在帳篷外一邊看星星，一邊兩個人悠閒地聊天。", "word": "できる" } ],
