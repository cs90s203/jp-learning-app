  "translations": [
    [ { "text": "去年秋天，因為祖父的影響而開始學習俳句。", "word": "俳句" } ],
    [ { "text": "祖父多年來都把俳句當作興趣，很重視用言語表現季節的變化。", "word": "趣味" } ],
