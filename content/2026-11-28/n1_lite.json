  "translations": [
    [ { "text": "日本各地的護理師短缺問題日益嚴重，尤其在地方的中小型醫院，其影響特別顯著。", "word": "看護師不足" } ],
    [ { "text": "隨著高齡化，醫療需求增加的同時，由於夜班和伴隨重大責任的工作十分嚴苛，選擇離職的護理師也不在少數。", "word": "伴う" } ],
    [ { "text": "儘管薪資方面的改善正在進行，但人力不足的問題遲遲無法解決，留下來的每位職員的負擔也往往變得更加沉重。", "word": "にもかかわらず" } ],
    [ { "text": "其中也有人因身心不適而被迫休職的案例被報告出來，現場的疲憊程度正日益加劇。", "word": "疲弊" } ],
    [ { "text": "如果放任這個狀況不管，地區醫療本身都可能無法維持下去。", "word": "立ち行く" } ],
    [ { "text": "因此，不僅勞動環境需要根本性的重新檢討，包括引進海外人才、以及透過業務資訊化減輕負擔在內的綜合性對策，都有其必要性。", "word": "はもとより" } ]
  ],
