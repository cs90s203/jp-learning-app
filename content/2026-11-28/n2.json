  "translations": [
    [ { "text": "全國各地引進地域貨幣的地方自治體正在增加。", "word": "地域通貨" } ],
    [ { "text": "所謂地域貨幣，是指只能在特定地區內使用的貨幣，目的是以在當地商店購物為契機來活化地區經濟。", "word": "きっかけに" } ],
    [ { "text": "與以往的現金不同，許多地域貨幣是透過智慧型手機應用程式使用的，也可以看到有些自治體會因應使用者的年齡層而在使用方式上下工夫。", "word": "通じる" } ],
    [ { "text": "儘管引進需要花費系統開發費用，但預期長期來看，錢會在地區內循環，進而帶動當地企業營業額的增加。", "word": "にもかかわらず" } ],
    [ { "text": "不過，由於能使用的店鋪有限，感到不便的居民也不在少數，不得不說普及還需要時間。", "word": "言う" } ],
    [ { "text": "即使如此，對於正為人口減少所苦的地方來說，地域貨幣正逐漸成為地區活化的有效手段之一。", "word": "にとって" } ]
  ],
