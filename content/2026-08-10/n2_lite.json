    [ { "text": "近年，不隸屬於公司、獨立工作的「自由工作者」這種工作方式正在普及。", "word": "フリーランス" } ],
    [ { "text": "背景之一，是網路環境的完善使得工作不再受地點限制。", "word": "整備" } ],
