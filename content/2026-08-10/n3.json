  "translations": [
    [ { "text": "去年秋天開始，在附近的教室學茶道。", "word": "茶道" } ],
    [ { "text": "契機是被朋友邀請。", "word": "きっかけ" } ],
    [ { "text": "一開始跪坐很辛苦，好幾次都想放棄。", "word": "正座" } ],
    [ { "text": "但是持續學習的過程中，漸漸明白了道具的用法和禮法的含義，發現了其中的樂趣。", "word": "気づく" } ],
    [ { "text": "老師常說：「不只是形式，讓內心平靜下來也很重要。」", "word": "落ち着ける" } ],
    [ { "text": "多虧了那句話，覺得在日常生活中也能不慌不忙地面對事情了。", "word": "おかげで" } ],
    [ { "text": "覺得茶道真的很有深度。", "word": "奥" } ],
    [ { "text": "以後也想在不勉強的範圍內繼續下去。", "word": "無理" } ]
  ],
