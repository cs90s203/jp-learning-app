  "translations": [
    [ { "text": "以新冠病毒疫情為契機而急速普及的線上課程，即使在疫情趨緩的現在，仍在許多大學持續採用。", "word": "オンライン授業" } ],
    [ { "text": "不僅減輕了通學的負擔，還能反覆觀看錄好的課程，這樣的優點讓學生給予一定的支持。", "word": "利点" } ],
    [ { "text": "另一方面，也有人指出，比起實體課程，與教師和其他學生的交流減少，感到孤立的學生正在增加。", "word": "孤立感" } ],
    [ { "text": "此外，也有不少聲音表示，在家上課誘惑很多，難以維持專注力。", "word": "誘惑" } ],
    [ { "text": "考量到這些課題，部分大學正嘗試結合實體與線上的混合型課程。", "word": "ハイブリッド型" } ],
    [ { "text": "今後，如何在活用各自優點的同時提升學習品質，將成為需要面對的問題。", "word": "生かす" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜をきっかけに", "note": "「以〜為契機」" }
  ]
