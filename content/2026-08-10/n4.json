  "translations": [
    [ { "text": "上週末，表弟來我家玩。", "word": "従兄弟" } ],
    [ { "text": "他帶了新的桌遊來，我們就一起玩了。", "word": "持ってくる" } ],
    [ { "text": "規則雖然很難，但練習了好幾次後，漸漸就會玩了。", "word": "難しい" } ],
