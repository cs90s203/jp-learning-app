  "translations": [
    [ { "text": "以地方城市為中心，將商店街的空店面再利用為咖啡廳或工作室的動向正在擴大。", "word": "再利用する" } ],
    [ { "text": "背景在於，由於缺乏接班人以及大型店舗進駐郊外，導致鐵捲門持續緊閉的店家不斷增加。", "word": "増え続ける" } ],
    [ { "text": "某地方政府針對租下空店面開業的年輕人推出房租補助制度後，希望開業的人便聚集了起來。", "word": "補助する" } ],
