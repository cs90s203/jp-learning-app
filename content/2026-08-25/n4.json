  "translations": [
    [ { "text": "上週末，因為天氣很好，我和妹妹去了附近的公園賞花。", "word": "花見" } ],
    [ { "text": "櫻花開得很漂亮，很多人有的在拍照，有的在吃便當。", "word": "咲く" } ],
    [ { "text": "我們也在櫻花樹下鋪了野餐墊，吃了飯糰、喝了茶。", "word": "敷く" } ],
    [ { "text": "雖然有點冷，妹妹卻說想一直待在外面。", "word": "寒い" } ],
    [ { "text": "今年能看到盛開的櫻花，真的太好了。", "word": "満開" } ]
