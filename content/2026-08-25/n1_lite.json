  "translations": [
    [ { "text": "在高齡化持續發展的日本，社會對失智症預防的關注逐年升高。", "word": "認知症" } ],
    [ { "text": "陸續有研究結果發表指出，運動、知性活動與社會參與有助於降低發病風險，地方政府與企業也紛紛積極展開預防計畫的普及。", "word": "寄与する" } ],
