  "translations": [
    [ { "text": "近年，日本國內減少「食物損耗」的相關努力正逐漸推廣開來。", "word": "取り組み" } ],
    [ { "text": "所謂食物損耗，指的是明明還能吃卻被丟棄的食品。", "word": "捨てる" } ],
    [ { "text": "超市透過將接近賞味期限的商品打折出售，來設法減少廢棄。", "word": "値引きする" } ],
    [ { "text": "此外，將家庭剩餘食材與社區分享的「食物銀行」活動也備受關注。", "word": "フードバンク" } ],
    [ { "text": "另一方面，許多餐飲店也有因為做太多而不得不丟棄的情況，看來要完全解決還需要一段時間。", "word": "かかる" } ],
    [ { "text": "即使如此，每個人抱持「不要浪費」的心情，應該就是減少食物損耗的第一步。", "word": "もったいない" } ]
  ],
