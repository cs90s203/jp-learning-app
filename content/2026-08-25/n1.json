  "translations": [
    [ { "text": "選擇性夫婦別姓制度的議題，多年來一直讓國會與輿論意見分歧。", "word": "議論" } ],
    [ { "text": "在現行制度下，結婚時夫妻其中一方必須改姓，但實際上絕大多數是女性改姓，因此要求檢討這項制度的聲浪始終存在。", "word": "余儀なくされる" } ],
    [ { "text": "贊成派指出，改姓所伴隨的職業上不利影響，以及損及個人身分認同的姓名問題，並主張擴大選擇本身並不侵害任何人的權利。", "word": "損なう" } ],
    [ { "text": "另一方面，反對派則以家庭凝聚感恐遭削弱為由，立場謹慎不變，雙方的主張始終呈現平行線。", "word": "崩す" } ],
    [ { "text": "民意調查雖顯示贊成者占多數，但在政治層面尚未達成共識。", "word": "合意形成" } ],
    [ { "text": "這個問題不僅止於制度設計的對錯，更根植於對家庭應有樣貌的價值觀差異，可說是一個值得全民徹底討論的議題。", "word": "相違" } ]
