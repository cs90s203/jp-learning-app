  "translations": [
    [ { "text": "半年前開始，我因興趣開始學習落語。", "word": "落語" } ],
    [ { "text": "契機是在電視上看到年輕落語家的表演，深受感動。", "word": "感動する" } ],
    [ { "text": "「光靠說話方式，就能讓人又笑又哭嗎」，我感到很驚訝。", "word": "驚く" } ],
    [ { "text": "練習絕不輕鬆，同一段故事必須反覆練習好幾次。", "word": "繰り返す" } ],
    [ { "text": "但是，每次反覆練習時，都覺得自己一點一點地在進步，這讓我很開心。", "word": "上達する" } ],
    [ { "text": "工作容易讓人疲倦的平日，有時會想乾脆不去練習，但持續下去後，落語對我來說變成了重要的喘息時光。", "word": "とって" } ],
    [ { "text": "希望總有一天能登上舞台，把觀眾逗笑。", "word": "笑う" } ]
  ],
