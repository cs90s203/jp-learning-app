  "translations": [
    [ { "text": "所謂兒童食堂，是指地方居民或志工，以免費或低價方式為孩子們提供餐點的一種活動。", "word": "子ども食堂" } ],
    [ { "text": "原本是以支援經濟困難家庭孩子為目的而開始的，但近年來，作為防止孤食、創造地方連結場所的角色也受到關注。", "word": "孤食" } ],
    [ { "text": "營運主要仰賴志工的善意支撐，不少團體都為資金與人力不足所苦。", "word": "善意" } ],
    [ { "text": "儘管如此，全國各地兒童食堂的數量仍逐年增加，其擴展已逐漸具有不僅止於單純福利活動的社會意義。", "word": "それにもかかわらず" } ],
    [ { "text": "行政單位也透過補助金的發放與資訊提供，加強推動這類活動的力道。", "word": "通じる" } ],
    [ { "text": "今後，如何把資訊傳達給需要支援的孩子，仍是留下的一大課題。", "word": "届ける" } ]
  ],
  "grammar_notes": [
