  "translations": [
    [ { "text": "近年，隨著通訊技術的發展，不必出門就能接受醫師診察的線上看診迅速普及。", "word": "伴う" } ],
    [ { "text": "以往，看病需要花費交通時間與等待時間，身體不舒服時負擔更大，是個問題。", "word": "通院" } ],
    [ { "text": "如果是線上看診，用智慧型手機或電腦，就能在家和醫師諮詢。", "word": "相談する" } ],
    [ { "text": "尤其對育兒中的家長或高齡者來說，這個機制是很大的幫助。", "word": "にとって" } ],
    [ { "text": "另一方面，也有人指出，有些症狀不面對面看診就難以準確判斷，並非所有診療都能改為線上。", "word": "一方で" } ],
    [ { "text": "今後，如何根據使用紀錄，搭配面對面診療與線上診療，將成為課題。", "word": "基づく" } ]
  ],
