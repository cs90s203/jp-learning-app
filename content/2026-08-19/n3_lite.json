  "translations": [
    [ { "text": "最近，我開始去家附近的烹飪教室上課。", "word": "料理教室" } ],
    [ { "text": "雖然以前就對做菜有興趣，卻遲遲踏不出第一步。", "word": "踏み出せる" } ],
