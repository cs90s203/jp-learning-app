  "translations": [
    [ { "text": "在要求縮短工時的呼聲高漲之際，各國圍繞週休三日制導入的議論日趨活絡。", "word": "週休三日制" } ],
    [ { "text": "相對於以往的週休二日制，其內容並不一致，有維持工時不變、只增加休假天數的形式，也有直接削減工時本身的形式。", "word": "週休二日制" } ],
    [ { "text": "推動派主張，這種做法能在不降低勞動生產力的前提下提升員工的生活品質，並以部分企業的試行成果作為論據。", "word": "推進派" } ],
    [ { "text": "事實上，也有企業在試行後回報，員工滿意度提升、離職率下降，出現值得關注的案例。", "word": "注目" } ],
    [ { "text": "另一方面，謹慎派則指出，依業種不同，人員配置的調整在所難免，反而可能加重現場的負擔。", "word": "慎重派" } ],
    [ { "text": "尤其在人手短缺的醫療與照護現場，增加休假並非易事，這樣的聲音依然根深蒂固。", "word": "人手不足" } ],
    [ { "text": "此外，要讓週休三日制真正落實，勢必需要在不降低服務品質的前提下下工夫，也有人擔憂，操之過急的制度變更可能會將負擔轉嫁給使用者。", "word": "しわ寄せ" } ],
    [ { "text": "不過，在工作價值觀日趨多元的今日，也可以說，執著於單一化的工時框架已缺乏足夠的合理性。", "word": "画一的" } ],
    [ { "text": "在制度設計上，準備依業種與企業規模而異的彈性選項，看似繞遠路，卻似乎才是最實際可行的方向。", "word": "柔軟" } ],
    [ { "text": "操之過急的改革是大忌，制度設計應該體察現場獨有的實際情況。", "word": "ならでは" } ]
  ],
  "grammar_notes": [
