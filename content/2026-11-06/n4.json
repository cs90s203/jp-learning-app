  "translations": [
    [ { "text": "上個星期天，我和表親一起去潮間帶挖蛤蜊。", "word": "潮干狩り" } ],
    [ { "text": "因為天氣很好，擠滿了許多攜家帶眷的人潮。", "word": "にぎわう" } ],
    [ { "text": "我們走進淺水區，用耙子挖沙、撿貝殻。", "word": "掘る" } ],
