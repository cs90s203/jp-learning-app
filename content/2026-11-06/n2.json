  "translations": [
    [ { "text": "隨著技術進步與產業結構的改變，社會人士重新學習新技能的「回流學習」逐漸受到關注。", "word": "リスキリング" } ],
    [ { "text": "過去這多半被視為個人的自我進修，但近年企業主動負擔研習費用的案例也增加了。", "word": "自己啓発" } ],
    [ { "text": "政府也擴充補助金制度等，持續推動鼓勵重新學習的政策。", "word": "助成金制度" } ],
    [ { "text": "事實上，不只IT產業，醫療、製造業等廣泛領域也正在推動回流學習的措施。", "word": "取り組み" } ],
    [ { "text": "話雖如此，一邊工作一邊確保學習時間並不容易，即使有制度，實際能善加利用的人仍然有限，這是現況。", "word": "現状" } ],
    [ { "text": "今後，如何妥善評估學習成果並將其與升遷、轉職做連結，將會是一項課題。", "word": "課題" } ]
  ],
