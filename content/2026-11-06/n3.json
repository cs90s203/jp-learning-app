  "translations": [
    [ { "text": "聽說公司前輩在培育盆栽，一開始我以為那只是上了年紀的人才會有的興趣。", "word": "盆栽" } ],
    [ { "text": "沒想到實際請前輩讓我看了花盆之後，小小的樹木裡竟呈現出宏大的自然景象，我完全被深深吸引住了。", "word": "奪う" } ],
    [ { "text": "以那次經驗為契機，我決定自己也開始去上盆栽課。", "word": "きっかけに" } ],
    [ { "text": "光是樹枝彎曲的方式不同，給人的印象就會改變，比我想像中還要深奧。", "word": "奥" } ],
    [ { "text": "雖然照料起來很花時間，但每天看著它一點一點變化的樣子，已經成了我最大的樂趣。", "word": "楽しみ" } ]
  ],
