  "translations": [
    [ { "text": "最近因為在意運動量不足，開始定期去家附近的網球教室上課。", "word": "テニススクール" } ],
    [ { "text": "一開始連球拍怎麼揮都不知道，不過教練從基礎開始仔細教我，感覺自己一點一點在進步。", "word": "上達する" } ],
