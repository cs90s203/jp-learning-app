  "translations": [
    [ { "text": "今年夏天，第一次去了煙火大會。", "word": "花火大会" } ],
    [ { "text": "和朋友一起穿上浴衣，坐電車到了會場。", "word": "浴衣" } ],
    [ { "text": "人非常多，讓我有點驚訝。", "word": "驚く" } ],
    [ { "text": "煙火升起時，大家發出了很大的聲音。", "word": "上がる" } ],
    [ { "text": "煙火非常漂亮，聲音也很大。", "word": "きれい" } ],
    [ { "text": "回去之前，在攤位吃了刨冰。", "word": "かき氷" } ],
    [ { "text": "成了開心的夏日回憶。", "word": "思い出" } ]
  ],
