  "translations": [
    [ { "text": "獨居的高齡者在無人送終的情況下過世，長時間未被發現而遭到放置，這種所謂的「孤獨死」被視為社會問題已經有一段時間了。", "word": "孤独死" } ],
    [ { "text": "隨著核心家庭化與地區社群連結的淡化，與鄰居往來稀少的高齡者不在少數。", "word": "希薄化" } ],
    [ { "text": "察覺異狀的機會越少，發現得晚的風險就不得不越高。", "word": "危険性" } ],
    [ { "text": "有些地方政府開始導入遠端確認電力和瓦斯使用量、異常時通報的守護服務。", "word": "見守りサービス" } ],
    [ { "text": "這類措施雖然取得了一定成效，但也有人指出，在費用與人力確保方面，普及仍有其極限。", "word": "限界" } ],
    [ { "text": "不應該把孤獨死單純當作個人問題來處理，而是需要建立整個地區互相扶持的機制，可以說這正是目前所需要的。", "word": "支え合う" } ]
  ],
