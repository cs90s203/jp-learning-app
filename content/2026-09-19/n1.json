  "translations": [
    [ { "text": "近年，利用顧客這個身分對員工提出過度要求或惡言相向的所謂「奧客騷擾」日趨嚴重，各方對其對策的討論也日益活躍。", "word": "カスタマーハラスメント" } ],
    [ { "text": "零售業、餐飲業、客服中心等從事對人業務的勞動者中，有許多人正暴露在不合理的客訴之下，被迫承受精神上的疲憊，這樣的實際情況正逐漸明朗。", "word": "疲弊" } ],
    [ { "text": "企業方面認為，對於惡意客訴應採取堅定的應對方式，因此正推動應對手冊的完善與錄音系統的導入。", "word": "毅然とする" } ],
    [ { "text": "另一方面，若把正當的申訴也一律拒絕，恐怕會有輕視消費者權利之虞，這樣的擔憂依然根深蒂固。", "word": "軽視する" } ],
    [ { "text": "在法律制度層面，也難以說已有明確的規範，很大一部分仍仰賴企業的自主努力。", "word": "委ねる" } ],
    [ { "text": "如何在保護員工與維持顧客服務品質之間取得平衡，今後應該仍會是持續被討論的重要課題。", "word": "両立させる" } ]
