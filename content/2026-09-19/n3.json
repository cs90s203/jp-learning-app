  "translations": [
    [ { "text": "國中時，被朋友邀請，沒有多想就加入了劍道社。", "word": "剣道部" } ],
    [ { "text": "一開始不習慣竹刀的重量，光是揮竹刀手臂就會痛。", "word": "慣れる" } ],
