    [ { "text": "即使如此，持續每週三次的練習後，體力漸漸增加了。", "word": "体力" } ],
    [ { "text": "學長姐們的姿勢非常優美，讓我漸漸想著有一天自己也要變成那樣。", "word": "姿勢" } ],
    [ { "text": "比賽中第一次拿到一分時的喜悅，到現在都忘不了。", "word": "喜び" } ],
    [ { "text": "透過劍道，也感覺自己學到了禮儀和忍耐力。", "word": "礼儀" } ]
