  "translations": [
    [ { "text": "上週日，決定和媽媽一起做麵包。", "word": "パン" } ],
    [ { "text": "量材料、揉麵團，花了大約兩小時。", "word": "こねる" } ],
    [ { "text": "讓麵團發酵的時候，和媽媽一邊喝紅茶一邊聊天。", "word": "飲む" } ],
    [ { "text": "烤箱裡飄出甜甜的香味，讓我很開心。", "word": "匂い" } ],
    [ { "text": "烤好的麵包形狀有點不好看，但味道非常好吃，全家人一起吃了。", "word": "おいしい" } ],
    [ { "text": "下次也想試著做做看不同種類的麵包。", "word": "作る" } ]
