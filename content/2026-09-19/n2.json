  "translations": [
    [ { "text": "最近，各地陸續增加了暫時收容無家可歸的狗和貓的動物收容所。", "word": "動物シェルター" } ],
    [ { "text": "因飼主高齡化或搬家等原因，不得不放棄寵物的案例層出不窮。", "word": "手放す" } ],
    [ { "text": "在收容所裡，獸醫和志工們負責健康管理，並悉心照顧直到找到新飼主為止。", "word": "世話する" } ],
    [ { "text": "有些設施拯救了許多原本可能面臨安樂死的動物，並靠著當地居民的捐款與物資支援來維持營運。", "word": "救う" } ],
    [ { "text": "另一方面，也有不少設施苦於營運資金不足和人手不足，永續經營仍是個課題。", "word": "課題" } ],
    [ { "text": "隨著這類活動的擴展，或許會讓動物與人類能夠共同生活的社會更近一步。", "word": "広がる" } ]
  ],
