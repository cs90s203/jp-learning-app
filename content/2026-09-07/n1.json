  "translations": [
    [ { "text": "作為工作方式改革的一環，越來越多企業開始導入讓有意願的員工每週增加一天休假的『選擇性週休三日制』。", "word": "選択的週休三日制" } ],
    [ { "text": "導入的背景不僅是為了改善長時間勞動，也是為了因應育兒、照護或重新進修等多樣的生活方式。", "word": "のみならず" } ],
    [ { "text": "伴隨著要求縮短勞動時間的社會呼聲，人們對這項制度的關注也日益升高。", "word": "相まる" } ],
    [ { "text": "利用這項制度雖然能確保自己的時間，但也不能否認薪資可能被減少，或是每天的負擔反而增加的可能性。", "word": "否む" } ],
    [ { "text": "在導入的企業中，據說也有透過縮短會議時間與活用數位工具來維持生產力的例子。", "word": "維持する" } ],
    [ { "text": "不過，依業種不同，也有不少職場難以適應這項制度，若倉促地一律推行，反而可能招致現場的混亂。", "word": "なじむ" } ],
    [ { "text": "專家之間有不少人指出，如果不伴隨勞動時間本身的縮短，這項制度的效果將是有限的。", "word": "指摘する" } ],
    [ { "text": "僅僅增加休假天數，只會使勞動密度提高，反而可能導致身心負擔加重的結果。", "word": "密度" } ]
  ],
