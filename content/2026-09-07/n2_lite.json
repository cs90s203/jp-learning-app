  "translations": [
    [ { "text": "近年，使用電子書服務的人越來越多。", "word": "電子書籍" } ],
    [ { "text": "只要有智慧型手機或平板電腦，隨時隨地都能閱讀喜歡的書，這是受到許多讀者支持的原因。", "word": "読者" } ],
    [ { "text": "和以往的紙本書相比，電子書不占保管空間，攜帶也很方便。", "word": "比べる" } ],
    [ { "text": "另一方面，也有不少人惋惜翻紙頁的觸感、以及把書排在書架上的樂趣正逐漸消失。", "word": "惜しむ" } ],
    [ { "text": "即便如此，能在通勤途中或旅行地輕鬆閱讀的便利性，對許多人來說仍是很大的魅力。", "word": "利便性" } ],
    [ { "text": "今後，隨著電子書服務的普及，語音朗讀等更方便的功能，也令人期待會持續增加。", "word": "普及" } ]
  ],
