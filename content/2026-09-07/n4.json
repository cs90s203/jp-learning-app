  "translations": [
    [ { "text": "上週日，我和妹妹一起摺了紙。", "word": "折り紙" } ],
    [ { "text": "妹妹還小，所以摺紙鶴摺得不太好。", "word": "鶴" } ],
    [ { "text": "雖然失敗了好幾次，但沒有放棄，繼續練習。", "word": "諦める" } ],
    [ { "text": "到最後，如果是簡單的形狀，變得能自己一個人摺了。", "word": "できる" } ],
    [ { "text": "摺著、攤開著，兩人漸漸都開心了起來。", "word": "楽しい" } ],
    [ { "text": "這次，還想挑戰更難的作品。", "word": "挑戦する" } ]
