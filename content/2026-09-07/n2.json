  "translations": [
    [ { "text": "受少子化影響，地方廢校的中小學逐年增加。", "word": "少子化" } ],
    [ { "text": "曾經充滿孩子們喧鬧聲的校舍，如果就這樣被放任不管，很可能會成為地區衰退的象徵。", "word": "なりかねない" } ],
    [ { "text": "於是近年來，越來越多地方政府將廢校建築改建為住宿設施或體驗學習設施重新利用。", "word": "再生する" } ],
