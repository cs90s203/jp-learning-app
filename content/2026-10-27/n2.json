  "translations": [
    [ { "text": "所謂兒童食堂，是由社區居民或志工，以免費或低價提供兒童餐食的一種措施。", "word": "提供する" } ],
    [ { "text": "一方面有因經濟原因無法獲得足夠飲食的家庭，另一方面也不少兒童面臨獨自吃飯的問題。", "word": "孤食" } ],
    [ { "text": "在這樣的背景下，兒童食堂正在全國各地擴展開來。", "word": "広がり" } ],
    [ { "text": "營運主要靠捐款與補助金支撐，但由於資金與人力不足，也有一些據點難以持續下去。", "word": "支える" } ],
    [ { "text": "儘管如此，許多經營者仍表示「因為能看到孩子的笑容」，持續進行這項活動。", "word": "語る" } ],
    [ { "text": "在地區社會連結日漸淡化的現代，兒童食堂已經超越單純用餐場所，逐漸承擔起跨世代交流場所的角色。", "word": "担う" } ]
  ],
  "grammar_notes": [
