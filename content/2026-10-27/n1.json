  "translations": [
    [ { "text": "隨著能源價格上漲與脫碳化要求的疊加，要求重啟核能發電廠的聲浪日益增強。", "word": "相まる" } ],
    [ { "text": "從穩定電力供應的觀點來看，重啟可以說是值得考慮的選項。", "word": "値する" } ],
    [ { "text": "然而，對經歷過去事故的人來說，對安全性的疑慮並非輕易就能抹去。", "word": "拭い去る" } ],
    [ { "text": "即使監管機構制定了多麼嚴格的審查標準，無法保證絕對安全這一事實仍不會改變。", "word": "保証する" } ],
    [ { "text": "此外，在核廢料處理問題被擱置不決的情況下推動重啟，也有不少批評認為這是把負擔推給未來世代。", "word": "押し付ける" } ],
    [ { "text": "另一方面，若電力供應出現不穩定，整體產業遭受嚴重打擊的情況也不難想像。", "word": "難い" } ],
    [ { "text": "說到底，重啟與否無法用簡單的二元對立來理解，只能從經濟性、安全性，以及對未來世代的責任等多重視角，謹慎地持續討論下去。", "word": "捉える" } ]
  ],
