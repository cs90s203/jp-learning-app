  "translations": [
    [ { "text": "近年來，宅配置物櫃的設置在都市地區迅速普及。", "word": "進む" } ],
    [ { "text": "過去領取包裹必須待在家裡，但有了置物櫃，就能在喜歡的時間領取。", "word": "できる" } ],
    [ { "text": "對送貨員來說，也有減少重新配送次數的優點。", "word": "減る" } ],
    [ { "text": "另一方面，在置物櫃數量不足的地區，仍然存在難以使用的課題。", "word": "づらい" } ],
    [ { "text": "這種便利性不僅限於單身家庭，也有愈來愈多高齡者家庭表示支持。", "word": "限る" } ],
    [ { "text": "今後若能擴大到車站、商業設施，而不僅限於公寓大樓，便利性應該會更進一步提升。", "word": "高まる" } ]
