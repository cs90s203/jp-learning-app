  "translations": [
    [ { "text": "看超市和便利商店的付款方式，比起用現金的人，用智慧型手機或卡片支付的人變得更顯眼了。", "word": "目立つ" } ],
    [ { "text": "尤其在年輕世代之中，不帶錢包出門的人也不稀奇。", "word": "珍しい" } ],
    [ { "text": "無現金支付得以普及的背景，可以認為是點數回饋、結帳省事等便利性高的緣故。", "word": "考えられる" } ],
    [ { "text": "另一方面，在停電等無法使用通訊環境的場合會無法付款，這樣的風險也存在，因此完全捨棄現金的不安聲浪依然根深蒂固。", "word": "根強い" } ],
    [ { "text": "今後如何在便利性與安全性之間取得平衡，似乎將成為課題。", "word": "課題" } ]
