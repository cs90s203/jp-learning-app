  "translations": [
    [ { "text": "因為祖父喜歡下將棋的影響，我從小就知道棋子的走法，但真正開始認真學習是從去年冬天開始的。", "word": "習い始める" } ],
    [ { "text": "契機是職場的前輩邀我「要不要下一局」。", "word": "誘う" } ],
    [ { "text": "一開始光是想起規則就竭盡全力，也因為老是輸而感到不甘心，但隨著對局次數增加，漸漸能贏了。", "word": "勝つ" } ],
    [ { "text": "我覺得將棋不靠運氣、只靠自己的判斷力左右結果這一點很有趣。", "word": "面白い" } ],
    [ { "text": "週末我會去道場，和實力堅強的人們對弈，每天都有新的發現。", "word": "発見" } ]
