  "translations": [
    [ { "text": "在都市地區的車站前或商業設施周邊，越來越常看到排滿腳踏車的無人站點。", "word": "見かける" } ],
    [ { "text": "這是一種叫做共享單車的服務，只要用專用App完成使用註冊，就能在喜歡的地方借車，並歸還到別的站點。", "word": "返却する" } ],
    [ { "text": "與傳統的租借自行車不同，可以甲地借乙地還這一點，可說是它最大的特徵。", "word": "異なる" } ],
    [ { "text": "其背景除了期待它能作為彌補公共交通空白地帶的交通方式之外，也有藉由減少私家車使用來抑制塞車與排放氣體的意圖。", "word": "補う" } ],
    [ { "text": "不過，也有人指出隨意放置的腳踏車增加等新問題，因此也出現了呼籲行政機關與業者合作推動規則制定的聲音。", "word": "指摘する" } ]
  ],
