  "translations": [
    [ { "text": "爺爺過世後，我在遺物中發現了一本舊俳句筆記本。", "word": "俳句" } ],
    [ { "text": "我不經意地翻開一看，裡面用短短十七個音節，鮮明地描繪出爺爺曾見過的季節風景。", "word": "鮮やか" } ],
    [ { "text": "「話語削減得越多，反而越能傳達心意」，爺爺生前常這麼說。", "word": "言葉" } ],
    [ { "text": "知道這件事之後，我也開始想自己試著寫俳句了。", "word": "俳句" } ],
    [ { "text": "一開始連季語的用法都不懂，但通了句會之後，漸漸體會到把日常小小發現化為言語的樂趣。", "word": "楽しさ" } ],
    [ { "text": "雖然現在寫的還都是不成熟的句子，但希望在持續創作的過程中，能稍微更靠近爺爺的心情。", "word": "近づく" } ]
