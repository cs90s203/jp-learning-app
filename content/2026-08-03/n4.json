  "translations": [
    [ { "text": "上星期週末，我去了奶奶家玩，一起幫忙做了庭院工作。", "word": "庭仕事" } ],
    [ { "text": "奶奶的菜園總是種滿了蔬菜。", "word": "畑" } ],
    [ { "text": "我們拔雜草、給花澆水，工作了大約兩個小時。", "word": "抜く" } ],
    [ { "text": "明明很熱，奶奶卻精神奕奕地到處走動，讓我很驚訝。", "word": "驚く" } ],
    [ { "text": "休息的時候，我吃到了用奶奶種的蔬菜做的沙拉，非常好吃。", "word": "できる" } ],
    [ { "text": "我還想再去幫忙。", "word": "思う" } ]
  ],
