  "translations": [
    [ { "text": "能便宜買到即期食品的App，在這一兩年間迅速普及開來。", "word": "アプリ" } ],
    [ { "text": "超市和便利商店只要把可能賣不完的商品登錄到App上，使用者就能用手機找到並便宜買到，是這樣的機制。", "word": "仕組み" } ],
    [ { "text": "對店家而言能減少報廢成本，對使用者而言也能比平常更便宜地購物，是一項對雙方都有好處的作法。", "word": "メリット" } ],
    [ { "text": "隨著大眾對環境問題的關注升高，積極使用這類服務的人也逐漸增加。", "word": "環境問題" } ],
