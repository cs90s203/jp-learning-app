  "translations": [
    [ { "text": "在嚴重人手不足的背景下，擴大接收外籍人才的趨勢正在各行各業中推進。", "word": "外国人材" } ],
    [ { "text": "尤其在地方中小企業，人才確保與經營存續直接掛鉤的情況並不少見。", "word": "中小企業" } ],
