  "translations": [
    [ { "text": "越來越多企業導入「不固定座位制」——辦公室不設固定座位，員工每天可依喜好選擇工作地點。", "word": "フリーアドレス制" } ],
    [ { "text": "由於座位不再像以往那樣固定，不僅更容易促成跨部門交流，還能有效利用辦公室空間，具有這樣的優點。", "word": "利点" } ],
    [ { "text": "另一方面，也有不少員工覺得物品管理變得繁瑣，或因不知道隔壁會坐誰而感到不安。", "word": "一方で" } ],
    [ { "text": "在導入該制度的企業當中，也能看到透過併用可事先預約座位的系統，來緩解這種不安的做法。", "word": "システム" } ],
    [ { "text": "若讓制度本身變成了目的，就本末倒置了；如何配合工作方式靈活運用，才是被要求的重點。", "word": "本末転倒" } ]
  ],
