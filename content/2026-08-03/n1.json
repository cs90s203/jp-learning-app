  "translations": [
    [ { "text": "作為少子化對策的一環，不論監護人的就業狀況為何，都能讓尚未就讀幼兒園的孩子定期送托保育設施的「無論任何理由皆可入園制度」，正在全國推行。", "word": "通園制度" } ],
    [ { "text": "以往的保育制度原則上以監護人有工作為前提，家庭主婦等家庭則被排除在適用對象之外。", "word": "保育制度" } ],
    [ { "text": "然而，有人指出孤立育兒會提高虐待與產後憂鬱症的風險，於是不問是否有工作的新制度的意義，正重新受到重視。", "word": "見直す" } ],
    [ { "text": "該制度的目的在於，一方面讓孩子有機會與團體互動，同時減輕監護人的育兒負擔。", "word": "育児負担" } ],
    [ { "text": "話雖如此，作為實施主體的地方政府紛紛發出疑慮之聲，指出保育士的確保與財源的保障仍跟不上進度。", "word": "自治体" } ],
    [ { "text": "也有人指出，都市地區的情況與候補入園兒童問題彼此交織，如何分配有限的保育資源正受到質疑。", "word": "と相まって" } ],
    [ { "text": "雖然幾乎沒有人反對制度的理念本身，但也有不少慎重派認為倉促在全國一律推行，反而可能招致現場混亂。", "word": "慎重論" } ],
    [ { "text": "若要提升育兒支援的實際成效，需要伴隨財政措施與人才確保、循序漸進的制度設計，這樣的看法可以說是相當合理的。", "word": "制度設計" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜と相まって", "note": "「與〜相結合」，書面因果" }
  ]
