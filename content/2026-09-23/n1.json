  "translations": [
    [ { "text": "在計程車不足日益嚴重之際，圍繞著讓一般駕駛用自用車進行有償載客的共乘服務全面解禁一事，議論持續不斷。", "word": "ライドシェア" } ],
    [ { "text": "推動派主張，若考量都市與地方兩地交通方式都日漸萎縮的現狀，放寬管制已是當務之急。", "word": "規制緩和" } ],
    [ { "text": "事實上，也有人指出，隨著觀光客增加，地方二次交通的不足正在縮小旅客的行動範圍。", "word": "指摘" } ],
    [ { "text": "另一方面，謹慎派則堅持主張，在安全管理及事故責任歸屬尚不明確的情況下貿然推行制度存在危險。", "word": "主張する" } ],
    [ { "text": "既有的計程車業界則反彈聲浪不斷，認為此舉輕視了他們多年培養的安全標準。", "word": "根強い" } ],
    [ { "text": "從這種對立的局勢來看，恐怕不能簡單地以「放寬管制」或「維持現狀」這種二元對立來談論這個問題。", "word": "言う" } ],
    [ { "text": "應該追求的是考量各地區交通狀況差異、更細膩周到的制度設計，恐怕不該急於做出草率的結論。", "word": "拙速" } ]
