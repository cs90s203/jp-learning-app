  "translations": [
    [ { "text": "近年，針對因經濟因素無法上補習班的孩子，免費教授課業的學習支援志工正在各地擴展開來。", "word": "学習支援ボランティア" } ],
    [ { "text": "契機據說是某位大學生到訪社區兒童食堂時，順手幫忙看了功課。", "word": "きっかけ" } ],
    [ { "text": "這項活動博得好評，透過口耳相傳，參加者也逐漸增加。", "word": "口コミ" } ],
    [ { "text": "志工大多是大學生或退休教師，雖然具備專業知識，但據說也常為教學方法而煩惱。", "word": "悩む" } ],
