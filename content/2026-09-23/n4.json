  "translations": [
    [ { "text": "星期天和爸爸一起整理了庭院。", "word": "庭" } ],
    [ { "text": "拔拔雜草、給花澆澆水，相當累人。", "word": "疲れる" } ],
    [ { "text": "因為天氣很好，兩人都流了汗。", "word": "汗" } ],
    [ { "text": "休息的時候，媽媽端來了冰涼的麥茶。", "word": "麦茶" } ],
    [ { "text": "爸爸笑著說：「雖然很累，還是很有精神呢」。", "word": "元気" } ],
    [ { "text": "多虧如此，今年應該能看到漂亮的花了。", "word": "おかげで" } ],
