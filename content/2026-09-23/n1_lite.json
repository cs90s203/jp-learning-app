  "translations": [
    [ { "text": "以都市地區為主，所謂進不了托兒所的「待機兒童」問題依然嚴重。", "word": "待機児童" } ],
    [ { "text": "根據去年的調查，都市地區的待機兒童人數雖然比前一年略有下降，但依然處於高水準。", "word": "調査" } ],
    [ { "text": "隨著雙薪家庭的增加，托育需求逐年提高，但設施和保育員的數量卻跟不上。", "word": "保育需要" } ],
    [ { "text": "尤其在大城市，有不少父母因為進不了希望的托兒所，不得已放棄重返職場。", "word": "やむを得ず" } ],
    [ { "text": "政府雖然在推動保育員待遇改善及設施建設，但受限於財源，實情是尚未達到根本性的解決。", "word": "実情" } ],
    [ { "text": "一方面高喊少子化，另一方面育兒環境的建設卻跟不上，這種現狀不得不說是一種諷刺。", "word": "皮肉" } ],
    [ { "text": "今後需要因應各地區的實際情況，制定更細膩周到的對策。", "word": "きめ細かい" } ]
  ],
