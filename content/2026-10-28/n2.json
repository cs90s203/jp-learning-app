  "translations": [
    [ { "text": "所謂自由學校，是為了因各種原因難以到一般學校上學的孩子們，提供學習與交流場所的機構。", "word": "フリースクール" } ],
    [ { "text": "拒學的兒童與學生人數年年增加，要求不被學校這個框架束縛的學習場所的聲音也日益增強。", "word": "不登校" } ],
    [ { "text": "在自由學校裡，雖然可以配合每個人的步調學習，但也有不少案例是學費成為家庭的重大負擔。", "word": "学費" } ],
    [ { "text": "此外，各地區的設施數量存在差異，也能聽到即使想去上學，附近卻沒有選項可選的聲音。", "word": "選択肢" } ],
    [ { "text": "儘管如此，為了邁向互相認可多元學習方式的社會，可以說自由學校的存在意義正逐年提高。", "word": "存在意義" } ],
    [ { "text": "今後，行政方面的支援擴充，應該會成為普及的關鍵。", "word": "拡充" } ]
  ],
  "grammar_notes": [
