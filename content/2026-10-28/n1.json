  "translations": [
    [ { "text": "在少子高齡化導致勞動力不足的疊加影響下，擴大接納外國勞工的動向正在各行業加速進行。", "word": "受け入れ" } ],
    [ { "text": "對於為人力不足所苦的企業而言，能不問國籍確保有能力的人才，可以說是左右事業持續性的重要因素。", "word": "確保する" } ],
    [ { "text": "然而，也有不少意見指出，若只將擴大接納單純視為勞動力的補充，應該謹慎以待。", "word": "慎重" } ],
    [ { "text": "因語言與文化差異在職場產生的摩擦，以及住所與醫療等生活基礎配套不足，都可能成為妨礙外國勞工定居的原因。", "word": "妨げる" } ],
    [ { "text": "此外，若持續以低薪勞動為前提來接納，也有人深深擔憂這可能導致侵犯人權。", "word": "人権侵害" } ],
    [ { "text": "另一方面，對於人口減少加速的地區來說，外國勞工的存在已成為支撐地區經濟不可或缺的存在，這也是事實。", "word": "地域経済" } ],
    [ { "text": "說到底，在討論擴大接納的是非之際，不能只著眼於確保勞動力這一經濟層面，也不能缺少如何建立多元文化共存社會的視角。", "word": "視点" } ]
  ],
