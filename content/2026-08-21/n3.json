  "translations": [
    [ { "text": "去祖母家玩的時候，從壁櫥深處翻出了一把舊三味線。", "word": "三味線" } ],
    [ { "text": "祖母懷念地說：「年輕時常常彈奏呢。」", "word": "懐かしい" } ],
    [ { "text": "實際聽她彈奏那音色，比想像中更細膩，也帶著力量。", "word": "繊細" } ],
    [ { "text": "以此為契機，自己也開始想學學看。", "word": "習う" } ],
    [ { "text": "找教室很不容易，但終於在附近找到了。", "word": "見つける" } ],
    [ { "text": "現在每週一次，在老師那裡認真練習。", "word": "励む" } ],
    [ { "text": "雖然常常彈不好，但持續下去，能感覺到聲音一點一點在改變。", "word": "変わる" } ]
