  "translations": [
    [ { "text": "作為工作方式改革的一環，許多企業出現了解禁副業的動向。", "word": "解禁する" } ],
    [ { "text": "過去公司規章通常一律禁止副業，但如今逐漸有一種看法認為，這不僅不會導致人才流失，反而能透過累積多元經驗促進員工成長，進而回饋本業。", "word": "考え方" } ],
    [ { "text": "實際上，也有透過副業獲得的知識成為新事業靈感的案例被報告出來，對企業而言，副業解禁未必能斷言就是風險。", "word": "報告する" } ],
    [ { "text": "話雖如此，對副業解禁持謹慎態度的意見依然根深蒂固。", "word": "根強い" } ],
    [ { "text": "擔心長時間勞動導致的健康損害、資訊外洩風險的聲音不在少數，也有不少企業因勞務管理趨於複雜而遲遲無法邁出這一步。", "word": "懸念する" } ],
    [ { "text": "此外，也有人指出，若副業造成的收入差距擴大，反而可能助長員工之間的不公平感。", "word": "助長する" } ],
    [ { "text": "可以說，今後所需要的並非一律解禁或禁止，而是依據行業與職種特性而設計的彈性制度。", "word": "応じる" } ]
