  "translations": [
    [ { "text": "在日本，伴隨少子高齡化而來的勞動力短缺，使得接受外國勞工的人數逐年擴大。", "word": "拡大する" } ],
    [ { "text": "在製造業、看護、農業等人手嚴重不足的領域，「沒有外國人才現場就無法運作」的說法也不罕見。", "word": "外国人材" } ],
    [ { "text": "政府正在推動擴充居留資格，但制度複雜，企業方面的理解似乎跟不上，也有人如此指出。", "word": "指摘" } ],
    [ { "text": "尤其圍繞技能實習制度，其勞動環境的嚴苛長年以來一直被視為問題。", "word": "技能実習制度" } ],
    [ { "text": "此外，日語教育與生活支援的體制因地區而異，不少勞工因此陷入孤立。", "word": "孤立する" } ],
    [ { "text": "部分地方自治體也開始獨自設置諮詢窗口、推動多語言服務等行動。", "word": "相談窓口" } ],
    [ { "text": "不僅是增加接收人數，如何打造共生社會，今後也將受到檢視。", "word": "共生する" } ]
  ],
