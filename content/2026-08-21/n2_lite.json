  "translations": [
    [ { "text": "近年，能與語音操作或智慧型手機連動的家電，也就是所謂的智慧家電正急速普及。", "word": "普及する" } ],
    [ { "text": "從外出地點操作照明或空調，甚至只靠聲音開電視，都已經不稀奇了。", "word": "操作する" } ],
    [ { "text": "背後原因可能是雙薪家庭增加，以及高齡者的照護需求。", "word": "見守り" } ],
    [ { "text": "對於獨居的高齡者來說，住在遠方的家人能確認家電使用狀況這點，似乎成了一種安心的來源。", "word": "確認する" } ],
    [ { "text": "另一方面，也有人指出通訊故障時家電會無法運作、初期設定複雜難以上手等課題。", "word": "指摘する" } ],
    [ { "text": "便利的同時，似乎也產生了新的依賴與不安，這一面也不容忽視。", "word": "見逃す" } ]
  ],
