  "translations": [
    [ { "text": "過去說到辦公室，通常是指企業簽約的專用建築或房間。", "word": "オフィス" } ],
    [ { "text": "但近年不僅自由工作者和個體經營者，連上班族也開始使用共享工作空間。", "word": "コワーキングスペース" } ],
    [ { "text": "背景可能是遠距工作的普及，讓越來越多人想在家以外找到能專心工作的環境。", "word": "リモートワーク" } ],
    [ { "text": "共享工作空間不僅有單純作為工作場所的功能，還有讓不同行業的使用者能夠交流的優點。", "word": "交流する" } ],
    [ { "text": "實際上，據說也有不少人在那裡認識了新朋友並一起創業。", "word": "知り合う" } ],
    [ { "text": "另一方面，也有人反映座位難以確保、周圍的談話聲讓人在意，因此需要因應使用目的做出區分。", "word": "応じる" } ],
    [ { "text": "今後，將集中空間與交流空間分開的設施應該也會增加。", "word": "分ける" } ]
  ],
  "grammar_notes": [
    { "sentence": 5, "pattern": "〜に応じて", "note": "「依據〜而」，對應變化" }
