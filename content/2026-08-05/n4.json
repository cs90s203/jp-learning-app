  "translations": [
    [ { "text": "上週日，我和妹妹一起去了水族館。", "word": "水族館" } ],
    [ { "text": "因為有海豚表演，我們一早就去，坐在最前排的位子。", "word": "ので" } ],
    [ { "text": "海豚一下跳躍一下潑水，妹妹非常開心。", "word": "喜ぶ" } ],
    [ { "text": "在水槽前面還能近距離摸到企鵝，讓人很感動。", "word": "感動する" } ],
    [ { "text": "回程時，我在紀念品店買了海豚玩偶送給妹妹。", "word": "買う" } ],
    [ { "text": "妹妹回家後也一直抱著它。", "word": "抱く" } ]
