  "translations": [
    [ { "text": "隨著都市化的推進，地方政府或NPO承租那些所有者已無力管理的空地，將其整建為小型公園的做法正逐漸擴大。", "word": "伴う" } ],
    [ { "text": "過去，空地容易成為雜草叢生和非法棄置垃圾的溫床，附近居民投訴的情況也不在少數。", "word": "温床" } ],
    [ { "text": "然而，透過設置長椅和花壇，將其改造成人人都能使用的空間後，據說不僅治安獲得改善，還發揮了作為當地居民交流據點的作用。", "word": "もとより" } ],
    [ { "text": "此外，能夠在壓低初期費用的同時暫時性地加以利用，這點也降低了地方政府導入的門檻。", "word": "ハードル" } ],
    [ { "text": "今後，在解決取得所有者共識、確保維護管理人力等課題的同時，如何持續推動這類做法也備受關注。", "word": "問う" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜に伴って", "note": "「伴隨〜」，同步變化" },
    { "pattern": "〜はもとより", "note": "「不用說〜，就連〜也」" }
  ]
}
