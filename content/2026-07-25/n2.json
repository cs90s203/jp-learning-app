    [ { "text": "相對於傳統貓咖啡廳以觀賞、療癒為目的，保護貓咖啡廳的主要目的是減少撲殺，具有較強的社會貢獻色彩。", "word": "殺処分" } ],
    [ { "text": "上門的客人可以一邊和貓互動，一邊在遇到喜歡的貓時申請認養。", "word": "譲渡" } ],
    [ { "text": "不過，認養通常需要審查飼養環境並提交誓約書，以防止衝動認養。", "word": "審査" } ],
    [ { "text": "這樣的行動不僅提供了疼愛貓咪的場所，也成為思考生命重要性的契機，反映出社會對動物保護的關注日益升高。", "word": "動物愛護" } ]
  ]
}
