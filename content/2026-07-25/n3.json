    [ { "text": "三個月前開始使用手機的日記App。", "word": "使い始める" } ],
    [ { "text": "契機是朋友對我說「就算每天只是寫一點小事，之後回頭看也會很有趣喔」而推薦的。", "word": "勧める" } ],
