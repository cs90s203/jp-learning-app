  "translations": [
    [ { "text": "作為氣候變遷對策的一環，透過為二氧化碳排放訂定價格以促進減排的手法「碳定價」，正受到國際間的關注。", "word": "カーボンプライシング" } ],
    [ { "text": "具代表性的手法包括：對企業設定排放量上限、讓超額或不足部分互相買賣的排放權交易制度，以及依化石燃料使用量課稅的碳稅，兩者都具備運用市場機制促使排放者自主減排的特徵。", "word": "排出量取引" } ],
    [ { "text": "從推動導入的立場來看，透過價格這一明確訊號，能有效促使企業與消費者改變行為，因而獲得肯定評價。", "word": "評価" } ],
    [ { "text": "另一方面，也有人擔憂負擔最終會透過價格轉嫁沉重地壓在低所得階層身上，以及可能招致國際競爭力下降，來自產業界的反彈依然根深蒂固。", "word": "反発" } ],
    [ { "text": "為因應這些課題，也有人在研議將部分稅收回饋給低所得家庭、或導入邊境碳調整措施等方案，但由於制度設計複雜，達成共識並不容易。", "word": "合意形成" } ],
    [ { "text": "今後，如何構建兼顧實效性與公平性的制度，恐怕將持續是各國共同面對的課題。", "word": "実効性" } ]
  ]
