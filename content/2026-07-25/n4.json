  "translations": [
    [ { "text": "上星期六，和朋友一起去海邊玩水。", "word": "海水浴" } ],
    [ { "text": "因為天氣很好，海很漂亮。", "word": "良い" } ],
    [ { "text": "又游泳又在沙灘上玩球，玩得很開心。", "word": "泳ぐ" } ],
    [ { "text": "中午大家一起吃了飯糰。", "word": "おにぎり" } ],
    [ { "text": "雖然有點累，但能久違地見到朋友，真的很開心。", "word": "嬉しい" } ],
    [ { "text": "回程的電車上，大家都睡著了。", "word": "眠る" } ],
    [ { "text": "明年還想再去。", "word": "来年" } ]
