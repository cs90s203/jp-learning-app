  "translations": [
    [ { "text": "關於選擇性夫妻別姓制度的討論，近年再次活躍起來。", "word": "議論" } ],
    [ { "text": "現行制度規定結婚時必須有一方改姓，實際上絕大多數都是女性改姓。", "word": "改姓する" } ],
    [ { "text": "對於用姓氏一起建立起職涯的人來說，改姓可能成為破壞經歷連續性的沉重負擔。", "word": "負担" } ],
    [ { "text": "贊成方主張，讓夫妻能各自選擇想要的姓氏，有助於尊重個人自由。", "word": "主張する" } ],
    [ { "text": "另一方面，反對方則擔憂家庭的一體感可能因此喪失，要求審慎討論。", "word": "懸念" } ],
    [ { "text": "民調中贊成有時甚至超過反對，但國會的修法始終未能實現，討論仍停留在平行線上。", "word": "平行線" } ]
