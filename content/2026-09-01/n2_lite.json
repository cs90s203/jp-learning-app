  "translations": [
    [ { "text": "最近在街上到處都能看到共享單車的停車點了。", "word": "見かける" } ],
    [ { "text": "透過智慧型手機的應用程式可以簡單註冊，付費後馬上就能借到腳踏車。", "word": "通じる" } ],
    [ { "text": "不只是通勤通學的人使用，觀光客把它當作遊覽街道的交通方式的案例也在增加。", "word": "利用する" } ],
    [ { "text": "和以往的租借腳踏車不同，可以在不同於借車地點的地方歸還，這一點對使用者來說是很大的魅力。", "word": "違う" } ],
    [ { "text": "另一方面，也有部分地區發生腳踏車被亂停放的糾紛，營運方為對策傷透腦筋。", "word": "悩ます" } ],
    [ { "text": "即便如此，作為對環境友善的移動方式，共享單車的需求預計今後仍會持續成長。", "word": "伸びる" } ]
  ],
