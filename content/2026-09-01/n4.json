    [ { "text": "上週末我和哥哥一起去做天文觀測。", "word": "出かける" } ],
    [ { "text": "到了晚上，天空中可以看到很多星星了。", "word": "見える" } ],
    [ { "text": "用望遠鏡看月亮和星星，還拍了照片。", "word": "撮る" } ],
