    [ { "text": "開始學三味線是去年秋天的事。", "word": "習う" } ],
    [ { "text": "祖母家裡有一把舊三味線，從小時候起就一直很在意。", "word": "気になる" } ],
    [ { "text": "祖母懷念地說「以前我常常彈奏呢」。", "word": "話す" } ],
    [ { "text": "以此為契機，開始去附近的教室上課。", "word": "通う" } ],
