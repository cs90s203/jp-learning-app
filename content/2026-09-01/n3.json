    [ { "text": "練習雖然辛苦，但每次聽到音色心情就會平靜下來。", "word": "落ち着く" } ],
    [ { "text": "從今以後也想繼續彈下去。", "word": "続ける" } ],
    [ { "text": "三味線對我來說，漸漸成為特別的存在。", "word": "存在" } ]
