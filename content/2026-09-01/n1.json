  "translations": [
    [ { "text": "針對大型科技企業應如何課稅的國際性討論，近年愈發熱烈。", "word": "活発化する" } ],
    [ { "text": "儘管以GAFA為代表的跨國企業，即便在沒有實體據點的國家也賺取龐大利益，但在傳統的國際課稅規則下，卻很難要求其負擔與利益相符的稅款。", "word": "見合う" } ],
    [ { "text": "面對這樣的情況，各國政府被迫引進數位服務稅，陸續有國家實施獨自課稅。", "word": "余儀なくされる" } ],
    [ { "text": "然而，僅靠單一國家的措施實效性有限，也有人指出這不足以完全防止跨國企業的避稅行為。", "word": "足る" } ],
    [ { "text": "以OECD為中心的國際課稅規則正在重新檢討，但各國利害關係複雜交織，達成共識並不容易。", "word": "絡み合う" } ],
    [ { "text": "隨著數位經濟的快速發展，這個問題預料今後將更形重要。", "word": "発展" } ],
    [ { "text": "在不受國界概念束縛的經濟活動擴展的當下，甚至有聲音認為，原封不動地維持現行課稅制度的框架，已是不可原諒的怠惰。", "word": "許す" } ]
  ],
