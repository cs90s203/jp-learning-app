  "translations": [
    [ { "text": "所謂兒童食堂，是指地區的大人免費或以低價為孩子們提供餐食的一種措施。", "word": "提供する" } ],
    [ { "text": "這原本是以全國性的兒童貧困問題為契機而開始擴展的，但現在不僅限於貧困家庭，雙薪家庭與獨居的高齡者也開始使用。", "word": "限る" } ],
    [ { "text": "雖然營運是靠志工的善意支撐，但為資金與人力不足所苦的團體也不在少數。", "word": "悩む" } ],
    [ { "text": "依地區而異，光靠政府的補助金無法支應營運費用，也有不得不依賴捐款的地方。", "word": "頼る" } ],
    [ { "text": "儘管如此，被孩子們的笑容所支持，持續參與活動的人年年增加。", "word": "続ける" } ],
    [ { "text": "可以說，它不僅止於提供餐食，也逐漸承擔起地區交流據點的角色。", "word": "担う" } ]
  ],
