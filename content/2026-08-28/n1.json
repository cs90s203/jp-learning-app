  "translations": [
    [ { "text": "關於遺產稅的重新檢討，長久以來各種立場的意見一直在交鋒。", "word": "めぐる" } ],
    [ { "text": "在高齡化推進、資產的世代間轉移成為整個社會課題的當下，現行的稅率與扣除機制是否符合實際狀況，再次受到質疑。", "word": "即する" } ],
    [ { "text": "主張增稅的一方認為，為了防止差距固化，向擁有一定資產以上的階層要求更多負擔也是不得已的。", "word": "やむを得ない" } ],
    [ { "text": "對此，主張減稅的一方反駁道，如果事業繼承或不動產繼承產生過大的稅務負擔，甚至可能危及家業的存續。", "word": "反論する" } ],
    [ { "text": "正因為雙方的主張都有一定道理，不應僅止於單純的增減稅爭論，理應追求依資產種類與規模量身打造的細膩制度設計。", "word": "求める" } ],
    [ { "text": "今後這場議論的走向，可以說將左右少子高齡化持續加劇的日本社會本身的樣貌，這麼說並不誇張。", "word": "左右する" } ],
    [ { "text": "尤其在資產形成機會因世代與家庭環境而有很大差異的現代，稅制的樣貌，也可說掌握著未來矯正差距的關鍵。", "word": "握る" } ]
  ],
