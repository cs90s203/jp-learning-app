  "translations": [
    [ { "text": "開始學習弓道，是因為大學社團介紹的契機。", "word": "習い始める" } ],
    [ { "text": "面對箭靶、放箭的姿態看起來非常美，讓我不由自主地決定要體驗看看。", "word": "体験する" } ],
    [ { "text": "實際嘗試之後才發現，姿勢與呼吸的每一個細節都有意義，讓我驚訝的是，左右結果的並非單純的力量，而是內心的沉穩。", "word": "驚く" } ],
    [ { "text": "比起是否命中靶心，我更喜歡認真面對每一箭的過程本身，現在每週去道場兩次。", "word": "好き" } ],
    [ { "text": "一開始因為緊張，箭完全射不到靶，但多虧老師的指導，姿勢漸漸端正了起來。", "word": "整う" } ]
  ],
