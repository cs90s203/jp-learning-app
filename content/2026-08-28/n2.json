  "translations": [
    [ { "text": "提到讀書會，過去指的是大家聚在固定場所、面對面分享感想的活動。", "word": "語り合う" } ],
    [ { "text": "但近年來，以疫情為契機，「線上讀書會」這種新形式正快速普及。", "word": "きっかけ" } ],
    [ { "text": "只要使用視訊通話APP，即使住在外地或國外，只要能配合時間，就能就同一本書互相討論。", "word": "できる" } ],
    [ { "text": "由於參加門檻降低，過去不擅長在人前發言的人，也有不少人表示變得能輕鬆發言了。", "word": "苦手" } ],
    [ { "text": "另一方面，也有人指出，隔著螢幕的交流較難讀出對方的反應，難以獲得像面對面說話時那樣的一體感。", "word": "読み取る" } ],
    [ { "text": "儘管如此，對忙碌的現代人來說，不受時間與地點侷限就能與人連結的讀書會，其存在今後只會愈發重要。", "word": "つながる" } ]
  ],
  "grammar_notes": [
