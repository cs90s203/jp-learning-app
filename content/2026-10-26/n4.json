  "translations": [
    [ { "text": "上星期六，我和哥哥去了煙火大會。", "word": "花火大会" } ],
    [ { "text": "因為人很多，所以提早找好了位置。", "word": "多い" } ],
    [ { "text": "在攤子上吃了章魚燒，也買了蘋果糖，非常開心。", "word": "たこ焼き" } ],
