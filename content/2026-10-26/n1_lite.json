  "translations": [
    [ { "text": "日本的建築業界長年深陷嚴重的人手不足問題。", "word": "人手不足" } ],
    [ { "text": "高齡化持續推進的同時，年輕的新進員工卻沒有增加，支撐現場的作業員人數逐年減少。", "word": "減少する" } ],
    [ { "text": "背景原因除了勞動環境嚴峻之外，薪資水準與其他行業相比也未必算高。", "word": "厳しさ" } ],
    [ { "text": "此外，由於對伴隨重度勞力與危險的作業存在抗拒感，這種職業難以被選擇的現實也不容忽視。", "word": "抵抗感" } ],
    [ { "text": "這樣的人手不足可能招致工期延誤與建設成本上升，甚至有可能延遲基礎建設與災害復原的腳步。", "word": "招く" } ],
    [ { "text": "業界團體正試圖透過擴大接納外國勞工及導入機器人技術來應對，但效果顯現恐怕還需要一些時間。", "word": "ロボット技術" } ]
  ],
