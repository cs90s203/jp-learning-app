  "translations": [
    [ { "text": "關於引進選擇性夫婦別姓制度的討論，儘管在國會已持續多年，至今仍未能實現。", "word": "選択的夫婦別姓制度" } ],
    [ { "text": "現行制度規定，結婚時必須統一成其中一方的姓氏，而實際上絕大多數都是女性改姓。", "word": "統一する" } ],
    [ { "text": "因此，不少人因改姓而承受繁瑣的手續，以及工作上的不利影響。", "word": "改姓" } ],
    [ { "text": "贊成方主張，從尊重個人身分認同的觀點來看，應該承認夫婦可以選擇各自姓氏的自由。", "word": "尊重する" } ],
    [ { "text": "另一方面，反對方則以可能損害家庭凝聚力為由，要求謹慎討論。", "word": "一体感" } ],
    [ { "text": "隨著社會價值觀日益多樣化的現狀相輔相成，對這個問題的關注持續升高，但執政黨內部意見分歧，使得短期內修法前景難以預料。", "word": "相まつ" } ],
    [ { "text": "即便這不是該急於下結論的問題，但持續擱置討論本身，恐怕也不該再被容許了。", "word": "先送りする" } ]
