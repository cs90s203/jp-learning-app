"続けられる","basic_form":"続ける","reading":"つづけられる","pos":"動詞"},{"surface_form":"環境","basic_form":"環境","reading":"かんきょう","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"整える","basic_form":"整える","reading":"ととのえる","pos":"動詞"},{"surface_form":"こと","basic_form":"こと","reading":"こと","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"求められている","basic_form":"求める","reading":"もとめられている","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"大規模":{"meaning":"大規模"},"自然災害":{"meaning":"自然災害"},"頻発する":{"meaning":"頻繁發生"},"中":{"meaning":"之中、正在…過程中"},"被災地":{"meaning":"受災地區"},"復旧":{"meaning":"復原、重建"},"行政":{"meaning":"行政機關"},"ない":{"meaning":"沒有"},"民間":{"meaning":"民間"},"ボランティア":{"meaning":"志工"},"力":{"meaning":"力量"},"欠かせない":{"meaning":"不可或缺"},"認識":{"meaning":"認知、認識"},"広がる":{"meaning":"擴大、普及"},"実際":{"meaning":"實際上"},"SNS":{"meaning":"社群網路"},"通じる":{"meaning":"透過、通過"},"支援":{"meaning":"支援"},"呼びかけ":{"meaning":"呼籲"},"一気":{"meaning":"一口氣、一下子"},"拡散する":{"meaning":"擴散"},"短期間":{"meaning":"短期間"},"多い":{"meaning":"多的"},"人手":{"meaning":"人力"},"集まる":{"meaning":"聚集"},"例":{"meaning":"例子、案例"},"少ない":{"meaning":"少的"},"もっとも":{"meaning":"不過、話雖如此"},"移動手段":{"meaning":"交通方式"},"滞在費用":{"meaning":"停留費用"},"かかる":{"meaning":"花費"},"自己負担":{"meaning":"自行負擔"},"参加する":{"meaning":"參加"},"人":{"meaning":"人"},"ほとんど":{"meaning":"幾乎、大部分"},"ある":{"meaning":"有"},"継続的":{"meaning":"持續性的"},"活動":{"meaning":"活動"},"交通費":{"meaning":"交通費"},"補助":{"meaning":"補助"},"何らか":{"meaning":"某種"},"支援体制":{"meaning":"支援體制"},"必要":{"meaning":"必要"},"指摘":{"meaning":"指出的問題、指摘"},"また":{"meaning":"此外、又"},"ニーズ":{"meaning":"需求"},"基づく":{"meaning":"根據、基於"},"柔軟":{"meaning":"靈活、柔軟"},"活動内容":{"meaning":"活動內容"},"調整する":{"meaning":"調整"},"体制づくり":{"meaning":"建立體制"},"課題":{"meaning":"課題、待解決的問題"},"される":{"meaning":"被視為、被做"},"おる":{"meaning":"在、有（書面謙遜語，同いる）"},"経験豊富":{"meaning":"經驗豐富"},"団体":{"meaning":"團體"},"自治体":{"meaning":"地方自治體"},"連携する":{"meaning":"合作、聯手"},"場面":{"meaning":"場合、情況"},"増える":{"meaning":"增加"},"今後":{"meaning":"今後"},"個人":{"meaning":"個人"},"善意":{"meaning":"善意"},"頼る":{"meaning":"依賴"},"仕組み":{"meaning":"機制、體系"},"続ける":{"meaning":"持續"},"環境":{"meaning":"環境"},"整える":{"meaning":"建立、整頓"},"こと":{"meaning":"事情（形式名詞）"},"求める":{"meaning":"要求、尋求"}},"particles":{"な":"な形容詞的連體形","が":"標示句子的主語","に":"表示時間點、對象，或構成副詞用法","は":"主題標記","だけ":"「只有〜」，表示限定","で":"表示方法/手段、場所，或原因","の":"表示所屬關係，或準體用法","という":"「所謂〜」，用於引用說法","を":"標示動作的受詞","も":"「也」，表示並列或強調","まで":"「到〜為止」，表示範圍的終點","や":"列舉部分事物","にもかかわらず":"「儘管〜」，強逆接","と":"用於引用，或並列","ために":"「為了〜」，表示目的","など":"「〜等等」，列舉範例","だ":"常體斷定助動詞","として":"「作為〜」的身分/立場"},"translations":[[{"text":"在大規模自然災害頻發的當下，大家逐漸認知到，受災地區的重建不能只靠行政單位，民間志工的力量也不可或缺。","word":"ボランティア"}],[{"text":"實際上，透過社群網路發出的支援呼籲會迅速擴散，短時間內聚集大量人力的案例也不少。","word":"通じる"}],[{"text":"不過，儘管前往受災地區需要花費交通和住宿費用，大多數人仍是自行負擔參加，因此也有人指出，若要持續活動，就需要交通費補助之類的某種支援體制。","word":"にもかかわらず"}],[{"text":"此外，能根據受災地區的需求靈活調整活動內容的體制建構也是一項課題，經驗豐富的團體與地方自治體不得不展開合作的場面也在增加。","word":"基づいて"}],[{"text":"今後，不能只依賴個人的善意，而是需要建立一套能持續提供支援的機制和環境。","word":"として"}]],"grammar_notes":[{"sentence":1,"pattern":"〜を通じて／〜を通して","note":"「透過〜」，媒介或期間"},{"sentence":2,"pattern":"〜にもかかわらず","note":"「儘管〜」，強逆接，較のに更書面"},{"sentence":3,"pattern":"〜に基づいて","note":"「基於〜」"},{"sentence":3,"pattern":"〜ざるを得ない","note":"「不得不〜」"}]}