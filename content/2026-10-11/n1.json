sic_form":"で","reading":"で","pos":"助詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"ない","basic_form":"ない","reading":"ない","pos":"形容詞"},{"surface_form":"だろう","basic_form":"だろう","reading":"だろう","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"少子高齢化":{"meaning":"少子化與高齡化"},"伴う":{"meaning":"伴隨"},"労働力不足":{"meaning":"勞動力不足"},"深刻化する":{"meaning":"嚴重化"},"中":{"meaning":"之中、正在…過程中"},"外国人労働者":{"meaning":"外籍勞工"},"受け入れ":{"meaning":"接納、引進"},"さらに":{"meaning":"進一步、更加"},"拡大する":{"meaning":"擴大"},"議論":{"meaning":"討論、爭論"},"各業界":{"meaning":"各行各業"},"強まる":{"meaning":"增強"},"製造業":{"meaning":"製造業"},"介護":{"meaning":"照護"},"農業":{"meaning":"農業"},"現場":{"meaning":"現場"},"人手":{"meaning":"人力"},"足りる":{"meaning":"足夠"},"事業":{"meaning":"事業、業務"},"継続":{"meaning":"持續、延續"},"危ぶむ":{"meaning":"擔憂、擔心"},"ところ":{"meaning":"地方、情況（形式名詞）"},"少ない":{"meaning":"少的"},"受け入れ拡大":{"meaning":"擴大接納"},"避ける":{"meaning":"避免"},"選択":{"meaning":"選擇"},"声":{"meaning":"聲音（這裡指意見）"},"大きい":{"meaning":"大的"},"一方":{"meaning":"另一方面"},"拙速":{"meaning":"草率而求快"},"制度拡充":{"meaning":"制度擴充"},"低賃金労働":{"meaning":"低薪勞動"},"温床":{"meaning":"溫床"},"なりかねない":{"meaning":"有可能演變成（負面結果）"},"労働環境":{"meaning":"勞動環境"},"整備":{"meaning":"完善、整頓"},"追いつく":{"meaning":"跟上"},"受け入れ数":{"meaning":"接納人數"},"増やす":{"meaning":"增加"},"こと":{"meaning":"事情（形式名詞）"},"慎重":{"meaning":"謹慎"},"ある":{"meaning":"是（存在）"},"指摘":{"meaning":"指出的問題"},"根強い":{"meaning":"根深蒂固"},"言語":{"meaning":"語言"},"文化":{"meaning":"文化"},"違い":{"meaning":"差異"},"起因する":{"meaning":"起因於"},"地域社会":{"meaning":"地方社會、社區"},"摩擦":{"meaning":"摩擦"},"子ども":{"meaning":"孩子"},"教育機会":{"meaning":"教育機會"},"確保":{"meaning":"確保"},"課題":{"meaning":"課題"},"相まる":{"meaning":"與…相結合"},"一層":{"meaning":"更加、更進一步"},"顕在化する":{"meaning":"顯現出來、浮現"},"経済合理性":{"meaning":"經濟合理性"},"優先する":{"meaning":"優先"},"受け入れる":{"meaning":"接納"},"側":{"meaning":"一方、那一邊"},"社会的":{"meaning":"社會上的"},"準備":{"meaning":"準備"},"後回しにする":{"meaning":"延後處理"},"姿勢":{"meaning":"態度、姿態"},"長期的":{"meaning":"長期的"},"看過する":{"meaning":"輕易放過、忽視"},"歪み":{"meaning":"扭曲、弊病"},"生む":{"meaning":"產生"},"言う":{"meaning":"說"},"制度設計":{"meaning":"制度設計"},"当たる":{"meaning":"面臨、處於"},"労働力":{"meaning":"勞動力"},"側面":{"meaning":"層面"},"生活者":{"meaning":"生活在當地的人"},"地域":{"meaning":"地區"},"根づく":{"meaning":"扎根"},"存在":{"meaning":"存在"},"視点":{"meaning":"觀點、視角"},"欠く":{"meaning":"缺乏"},"ない":{"meaning":"沒有"}},"particles":{"に":"表示時間點、對象，或構成副詞用法（〜に伴う、〜に当たって）","が":"標示句子的主語","の":"表示所屬關係，或準體用法","を":"標示動作的受詞","だ":"常體斷定助動詞","という":"「所謂〜」，用於引用說法","から":"表示原因或起點","や":"列舉部分事物","で":"表示方法/手段、場所，或原因","は":"主題標記","すら":"「連〜都」，強調極端例子","も":"「也」，表示並列或強調","な":"な形容詞的連體形","だけ":"「只有〜」，表示限定","と":"用於引用，或與相まって搭配表示「與〜相結合」","といった":"「〜之類的」，列舉例子","として":"「作為〜」的身分/立場","べき":"「應該〜」的書面語形式","だろう":"表示推測，「大概〜吧」"},"translations":[[{"text":"在少子高齡化伴隨而來的勞動力不足日益嚴重之下，各行各業要求進一步擴大接納外籍勞工的討論聲浪高漲。","word":"労働力不足"}],[{"text":"在製造業、照護、農業等現場，人力不足甚至讓事業能否持續都令人擔憂的情況不少，因此擴大接納被視為無法避免的選擇，這種聲音相當強烈。","word":"避けられない"}],[{"text":"另一方面，也有根深蒂固的意見指出，草率擴充制度有可能成為低薪勞動的溫床，在勞動環境整備跟不上的情況下，單純增加接納人數應該謹慎為之。","word":"なりかねず"}],[{"text":"此外，語言與文化差異所引起的與地方社會的摩擦、孩子教育機會的確保等課題，也隨著接納擴大而愈發顯現。","word":"相まって"}],[{"text":"只優先考慮經濟合理性，將接納方的社會準備工作一再延後的態度，長遠來看不得不說會產生難以忽視的弊病。","word":"看過できない"}],[{"text":"在制度設計之際，不應該只把外籍勞工當作勞動力的一個層面，而欠缺將他們視為在當地生活、扎根下來的存在這種視角。","word":"根づいていく"}]],"grammar_notes":[{"sentence":3,"pattern":"〜と相まって","note":"「與〜相結合」，書面因果"}]}