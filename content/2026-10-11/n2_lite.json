:"訂閱制"},"利用する":{"meaning":"利用、使用"},"サービス":{"meaning":"服務"},"増える":{"meaning":"增加"},"従来":{"meaning":"以往、過去"},"よう":{"meaning":"樣子（〜のように=像〜一樣）"},"商品":{"meaning":"商品"},"購入する":{"meaning":"購買"},"所有する":{"meaning":"擁有"},"ない":{"meaning":"沒有"},"必要":{"meaning":"必要"},"期間":{"meaning":"期間"},"借りる":{"meaning":"借"},"使う":{"meaning":"使用"},"考え方":{"meaning":"想法"},"広がる":{"meaning":"擴大、普及"},"背景":{"meaning":"背景"},"所有":{"meaning":"擁有"},"こだわる":{"meaning":"拘泥、堅持"},"価値観":{"meaning":"價值觀"},"広がり":{"meaning":"擴大、普及（名詞形）"},"初期費用":{"meaning":"初期費用"},"抑える":{"meaning":"壓低、抑制"},"経済的":{"meaning":"經濟上的"},"事情":{"meaning":"情況、原因"},"ある":{"meaning":"有"},"考える":{"meaning":"認為、思考"},"一方":{"meaning":"另一方面"},"解約忘れ":{"meaning":"忘記解約"},"よる":{"meaning":"由於、根據"},"無駄":{"meaning":"白費、浪費"},"支払い":{"meaning":"支付、付款"},"長期的":{"meaning":"長期的"},"見る":{"meaning":"看"},"購入":{"meaning":"購買（名詞）"},"割高":{"meaning":"相對昂貴"},"なる":{"meaning":"變成"},"ケース":{"meaning":"案例、情況"},"際":{"meaning":"之際、時候"},"料金プラン":{"meaning":"費率方案"},"解約条件":{"meaning":"解約條件"},"事前":{"meaning":"事先"},"よい":{"meaning":"好的"},"確認する":{"meaning":"確認"},"慎重":{"meaning":"謹慎"},"比較":{"meaning":"比較"},"欠かせない":{"meaning":"不可或缺"}},"particles":{"や":"列舉部分事物，「〜和〜等」","は":"主題標記","まで":"「到〜為止」，表示範圍的終點","で":"表示方法/手段、原因，或場所","が":"標示句子的主語","の":"表示所屬關係，或準體用法","に":"表示時間點、對象，或構成副詞用法","を":"標示動作的受詞","だけ":"「只有〜」，表示限定","という":"「所謂〜」，用於引用說法","な":"な形容詞的連體形","も":"「也」，表示並列或強調","と":"表示條件「一…就…」，或用於引用","より":"表示比較的基準","など":"「〜等等」，列舉範例"},"translations":[[{"text":"近年，音樂和影片當然不用說，連衣服和家具都能以訂閱制利用的服務也越來越多。","word":"サブスクリプション形式"}],[{"text":"不像以往購買商品來擁有，而是只在需要的期間租借使用，這種想法似乎正逐漸普及。","word":"考え方"}],[{"text":"背後的原因，可能是不執著於擁有的價值觀逐漸擴大，以及想降低初期費用的經濟考量。","word":"価値観"}],[{"text":"另一方面，也有因忘記解約而白白付費，或長期來看反而比購買更貴的情況，使用時必須仔細事先確認費率方案和解約條件，謹慎比較不可或缺。","word":"慎重"}]],"grammar_notes":[]}