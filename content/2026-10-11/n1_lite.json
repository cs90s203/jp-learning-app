被迫（不得已）"},"自治体":{"meaning":"地方自治體"},"財政":{"meaning":"財政"},"限界":{"meaning":"極限"},"ある":{"meaning":"有"},"路線":{"meaning":"路線"},"維持する":{"meaning":"維持"},"ため":{"meaning":"為了（目的）"},"補助金":{"meaning":"補助金"},"今後":{"meaning":"今後"},"出す":{"meaning":"支出、拿出"},"不透明":{"meaning":"不明確、不透明"},"言う":{"meaning":"說"},"一方":{"meaning":"另一方面"},"車":{"meaning":"車"},"運転する":{"meaning":"駕駛"},"高齢者":{"meaning":"高齡者"},"学生":{"meaning":"學生"},"公共交通":{"meaning":"公共交通"},"生活":{"meaning":"生活"},"足":{"meaning":"代步工具"},"欠く":{"meaning":"缺乏"},"こと":{"meaning":"事情（形式名詞）"},"できる":{"meaning":"能夠"},"存在":{"meaning":"存在"},"単純":{"meaning":"單純"},"不採算":{"meaning":"不划算、虧本"},"理由":{"meaning":"理由"},"切り捨てる":{"meaning":"捨棄、切除"},"よい":{"meaning":"好的"},"もの":{"meaning":"事物（形式名詞）"},"ない":{"meaning":"沒有"},"声":{"meaning":"聲音（這裡指意見）"},"強い":{"meaning":"強烈的"},"デマンド交通":{"meaning":"需求反應式交通（預約制交通）"},"自動運転バス":{"meaning":"自動駕駛巴士"},"導入":{"meaning":"導入、引進"},"新しい":{"meaning":"新的"},"形":{"meaning":"形式"},"維持":{"meaning":"維持"},"模索する":{"meaning":"摸索"},"動き":{"meaning":"動向"},"各地":{"meaning":"各地"},"出る":{"meaning":"出現"},"少ない":{"meaning":"少的"},"地域":{"meaning":"地區"},"運用":{"meaning":"運用、營運"},"コスト":{"meaning":"成本"},"重い":{"meaning":"沉重的"},"のしかかる":{"meaning":"壓在身上、沉重地落在"},"方法":{"meaning":"方法"},"一長一短":{"meaning":"各有優缺點"},"実情":{"meaning":"實際情況"},"結局のところ":{"meaning":"說到底、歸根究柢"},"何":{"meaning":"什麼"},"優先する":{"meaning":"優先"},"誰":{"meaning":"誰"},"負担":{"meaning":"負擔"},"引き受ける":{"meaning":"承擔"},"根本的":{"meaning":"根本的"},"問い":{"meaning":"問題、疑問"},"まだ":{"meaning":"尚未、還"},"明確":{"meaning":"明確"},"答え":{"meaning":"答案"},"その":{"meaning":"那個（的）"},"どの":{"meaning":"哪個（的）"}},"particles":{"で":"表示方法/手段、場所，或原因","は":"主題標記","や":"列舉部分事物","を":"標示動作的受詞","に":"表示時間點、對象，或構成副詞用法","の":"表示所屬關係，或準體用法","が":"標示句子的主語","も":"「也」，表示並列或強調","か":"表示疑問或不確定","と":"用於引用，或並列","にとって":"「對〜來說」，表示立場","として":"「作為〜」的身分/立場","から":"表示原因或起點","という":"「所謂〜」，用於引用說法","だけ":"「只有〜」，表示限定","ほど":"表示程度，「越〜越…」","な":"な形容詞的連體形"},"translations":[[{"text":"在地方城市，隨著人口減少與高齡化，使用人數持續下滑的巴士路線和鐵路，一條接一條被迫廢止。","word":"余儀なくされる"}],[{"text":"地方自治體的財政也有極限，今後是否還能持續撥出補助金來維持路線，只能說前景不明。","word":"不透明"}],[{"text":"另一方面，對於無法開車的高齡者和學生而言，公共交通是生活不可或缺的代步工具，也有強烈的意見認為不能單純因為虧本就將其捨棄。","word":"にとって"}],[{"text":"雖然各地也出現了導入預約制交通、自動駕駛巴士等新形式維持營運的嘗試，但使用人數越少的地區，導入和營運的成本就越是沉重負擔，每種方法都各有優缺點，這就是現實狀況。","word":"一長一短"}],[{"text":"說到底，該優先什麼、又該由誰來承擔這份負擔，這個根本性的問題，至今仍沒有明確的答案。","word":"根本的"}]],"grammar_notes":[{"sentence":0,"pattern":"〜を余儀なくされる","note":"「被迫〜」，書面被動"}]}