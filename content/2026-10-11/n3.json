{"meaning":"運動"},"始める":{"meaning":"開始"},"思う":{"meaning":"覺得、認為"},"ところ":{"meaning":"正好的時候、那時候"},"職場":{"meaning":"職場"},"先輩":{"meaning":"前輩"},"誘う":{"meaning":"邀約"},"きっかけ":{"meaning":"契機、起因"},"合気道":{"meaning":"合氣道"},"習う":{"meaning":"學習"},"こと":{"meaning":"事情（形式名詞）"},"する":{"meaning":"做"},"入門する":{"meaning":"入門"},"頃":{"meaning":"時候、時期"},"受け身":{"meaning":"受身（被摔倒的防護動作）"},"取り方":{"meaning":"作法、方式"},"うまい":{"meaning":"順利、巧妙"},"できる":{"meaning":"能夠、做得到"},"畳":{"meaning":"榻榻米"},"上":{"meaning":"上面"},"何度":{"meaning":"好幾次"},"転ぶ":{"meaning":"跌倒"},"いる":{"meaning":"在、存在"},"しかし":{"meaning":"然而、但是"},"道場":{"meaning":"道場"},"仲間":{"meaning":"夥伴、同伴"},"丁寧":{"meaning":"細心、仔細"},"教える":{"meaning":"教導"},"おかげ":{"meaning":"多虧、託…的福"},"少しずつ":{"meaning":"一點一點地"},"体":{"meaning":"身體"},"使い方":{"meaning":"使用方法"},"分かる":{"meaning":"懂、明白"},"力":{"meaning":"力氣"},"相手":{"meaning":"對方"},"押さえつける":{"meaning":"壓制、按住"},"ない":{"meaning":"沒有"},"動き":{"meaning":"動作、動向"},"利用する":{"meaning":"利用"},"技":{"meaning":"招式、技巧"},"かける":{"meaning":"使出（招式）"},"考え方":{"meaning":"想法、思考方式"},"面白さ":{"meaning":"有趣之處"},"実感する":{"meaning":"真實感受到"},"これから":{"meaning":"從今以後"},"無理":{"meaning":"勉強、過度"},"範囲":{"meaning":"範圍"},"長い":{"meaning":"長久的"},"続ける":{"meaning":"持續"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞，也用於準體用法","ために":"「為了〜」，表示目的","を":"標示動作的受詞","と":"用於引用，或表示條件「一…就…」","に":"表示時間點、對象，或構成副詞用法（〜に）","さえ":"「連〜都」，強調極端例子","で":"表示方法/手段、原因（〜おかげで），或場所","が":"標示句子的主語","も":"「也」，表示並列或強調","という":"「叫做〜、所謂〜」，用於引用名稱或說法","な":"な形容詞接續名詞修飾用法，或「〜なのだ」的連接形式","だ":"常體斷定助動詞","ばかり":"「剛〜」或「淨是〜」，依語境表示剛完成或頻率高","は":"主題標記"},"translations":[[{"text":"原本就想開始做些什麼運動來增強體力，正好被職場前輩邀約，就以此為契機決定開始學合氣道。","word":"きっかけ"}],[{"text":"剛入門的那段時間，連受身的方式都做不好，在榻榻米上摔了好幾次。","word":"転ぶ"}],[{"text":"但多虧道場的夥伴細心教導，漸漸開始懂得身體該怎麼運用了。","word":"おかげ"}],[{"text":"不是用力氣去壓制對方，而是利用對方的動作來使出招式，這種想法正是合氣道有趣之處，我真實感受到了。","word":"考え方"}],[{"text":"今後也想在不勉強的範圍內，長久地持續下去。","word":"続ける"}]],"grammar_notes":[{"sentence":0,"pattern":"〜ことにする／〜ことになる","note":"決定／自然而然演變成的結果"},{"sentence":2,"pattern":"〜おかげで／〜せいで","note":"「多虧〜」／「都怪〜」，正負面歸因"}]}