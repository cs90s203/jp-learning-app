"去年"}, "空手": {"meaning": "空手道"}, "習い始める": {"meaning": "開始學習"}, "運動": {"meaning": "運動"}, "苦手": {"meaning": "不擅長"}, "なぜか": {"meaning": "不知為何"}, "続ける": {"meaning": "繼續"}, "最初": {"meaning": "一開始"}, "正直": {"meaning": "老實說"}, "続く": {"meaning": "持續"}, "思う": {"meaning": "覺得、認為"}, "でも": {"meaning": "不過、但是"}, "道場": {"meaning": "道場"}, "先生": {"meaning": "老師"}, "優しい": {"meaning": "溫柔的"}, "教えてくれる": {"meaning": "（為我）教導"}, "おかげで": {"meaning": "多虧"}, "少しずつ": {"meaning": "一點一點地"}, "自信": {"meaning": "自信"}, "ついてくる": {"meaning": "逐漸具備、跟著來"}, "一方で": {"meaning": "另一方面"}, "練習": {"meaning": "練習"}, "思ったより": {"meaning": "比想像中"}, "厳しい": {"meaning": "嚴格的、嚴厲的"}, "あきらめかける": {"meaning": "差點放棄"}, "こと": {"meaning": "事情"}, "ある": {"meaning": "有"}, "それでも": {"meaning": "即使如此"}, "せっかく": {"meaning": "難得、好不容易"}, "始める": {"meaning": "開始"}, "思い直す": {"meaning": "重新想、改變想法"}, "頑張る": {"meaning": "加油、努力"}, "今では": {"meaning": "現在則是"}, "体力": {"meaning": "體力"}, "つく": {"meaning": "增添、具備"}, "ひきにくくなる": {"meaning": "變得不容易感冒"}, "気がする": {"meaning": "覺得、有種感覺"}}, "particles": {"は": "主題標記，用來提示句子的主題", "が": "主格助詞，標示動作或狀態的主體", "を": "受格助詞，標示動作的對象", "に": "表示動作涉及的對象，此處指「對母親」", "と": "用於引用他人所說的話或想法，相當於中文的「說」", "から": "表示起點，「從〜開始」", "だけ": "表示限定範圍，「只有〜」", "な": "形容動詞（な形容詞）語幹與後續助詞之間的連接形式", "のに": "表示轉折語氣，「明明〜卻」", "の": "連體修飾助詞，連接名詞與名詞", "も": "表示並列或附加，「也〜」", "よ": "句末助詞，用於加強語氣或提醒對方", "んだから": "「のだから」的口語縮約形，表示原因理由，「正因為〜」"}, "translations": [[{"text": "小時候身體虛弱，經常感冒。", "word": "風邪"}], [{"text": "母親對我說『鍛鍊身體比較好喔』，於是我從去年開始學空手道。", "word": "習い始める"}], [{"text": "雖然不擅長運動，不知為何只有空手道能持續下去。", "word": "苦手"}], [{"text": "一開始老實說，並不覺得自己能堅持下去。", "word": "思う"}], [{"text": "不過多虧道場老師溫柔地教導，我漸漸有了自信。", "word": "おかげで"}], [{"text": "另一方面，練習比想像中嚴格，也曾一度想要放棄。", "word": "一方で"}], [{"text": "即便如此，我重新告訴自己『難得開始了』，繼續努力著。", "word": "思い直す"}], [{"text": "現在體力也增加了，感覺變得不容易感冒了。", "word": "気がする"}]], "grammar_notes": [{"sentence": 4, "pattern": "〜おかげで／〜せいで", "note": "「多虧〜」／「都怪〜」，正負面歸因"}, {"sentence": 5, "pattern": "〜一方で", "note": "「另一方面」，對比"}]}
