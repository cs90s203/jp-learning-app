    "translations": [
      [ { "text": "近年來，政府為了糾正人口過度集中東京的現象，並促進人們移居地方，已經導入了向移居者發放補助金的制度。", "word": "是正する" } ],
      [ { "text": "伴隨著都市地區生活費高漲以及居家辦公的普及，對移居地方抱持興趣的人雖然逐漸增加，但實際下決心移居的人依然很少。", "word": "伴う" } ],
      [ { "text": "醫療機構與教育設施的不足、與地區社會建立關係的困難等，移居者所面臨的課題涉及多個層面。", "word": "課題" } ],
      [ { "text": "另一方面，透過與當地居民的交流踏實地建立生活基礎、成功移居的例子也不少。", "word": "通じる" } ],
      [ { "text": "然而，也可以看到有人是衝著補助款而移居，結果數年後又返回都市地區的案例，這使得質疑該制度實效性的聲音也隨之出現。", "word": "疑問視する" } ],
      [ { "text": "可以說，地方自治體目前被迫不能僅止於金錢上的支援，還必須完善讓移居者能夠在當地扎根的環境。", "word": "整備する" } ]
    ],
