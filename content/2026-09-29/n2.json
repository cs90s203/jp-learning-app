form":"期待する","reading":"きたいされている","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"近年":{"meaning":"近年"},"地域":{"meaning":"地區"},"住民":{"meaning":"居民"},"気軽":{"meaning":"輕鬆、隨意"},"集う":{"meaning":"聚集"},"交流する":{"meaning":"交流"},"場":{"meaning":"場所"},"コミュニティカフェ":{"meaning":"社區咖啡館"},"全国各地":{"meaning":"全國各地"},"広がる":{"meaning":"擴展、普及"},"こうした":{"meaning":"這樣的"},"カフェ":{"meaning":"咖啡館"},"多く":{"meaning":"大多、許多"},"商店街":{"meaning":"商店街"},"空き店舗":{"meaning":"空店鋪"},"公民館":{"meaning":"公民館（社區活動中心）"},"活用する":{"meaning":"活用、利用"},"開く":{"meaning":"打開、開設"},"特に":{"meaning":"特別是"},"高齢者":{"meaning":"高齡者"},"孤立":{"meaning":"孤立"},"防ぐ":{"meaning":"防止"},"注目する":{"meaning":"關注、受到矚目"},"一人暮らし":{"meaning":"獨居"},"誰か":{"meaning":"某人、誰"},"会話":{"meaning":"對話"},"する":{"meaning":"做"},"機会":{"meaning":"機會"},"生活":{"meaning":"生活"},"支え":{"meaning":"支柱、依靠"},"なる":{"meaning":"成為"},"得る":{"meaning":"能夠（接於動詞後表示可能）"},"外出":{"meaning":"外出"},"減る":{"meaning":"減少"},"つれる":{"meaning":"伴隨、跟隨（常用於\"につれて\"句型）"},"そうした":{"meaning":"那樣的"},"つながり":{"meaning":"聯繫、連結"},"失う":{"meaning":"失去"},"ボランティア":{"meaning":"志工"},"運営":{"meaning":"營運"},"通じる":{"meaning":"透過、經由"},"お茶":{"meaning":"茶"},"飲む":{"meaning":"喝"},"悩み":{"meaning":"煩惱"},"相談する":{"meaning":"商量、諮詢"},"情報":{"meaning":"資訊"},"交換する":{"meaning":"交換"},"こと":{"meaning":"事情（形式名詞）"},"できる":{"meaning":"能夠、可以"},"資金面":{"meaning":"資金方面"},"課題":{"meaning":"課題、問題"},"ある":{"meaning":"有、存在"},"行政":{"meaning":"行政（政府機關）"},"企業":{"meaning":"企業"},"支援":{"meaning":"支援"},"受ける":{"meaning":"接受"},"活動":{"meaning":"活動"},"続ける":{"meaning":"繼續"},"団体":{"meaning":"團體"},"増える":{"meaning":"增加"},"取り組み":{"meaning":"舉措、努力"},"きっかけ":{"meaning":"契機、契機點"},"世代":{"meaning":"世代"},"超える":{"meaning":"超越"},"交流":{"meaning":"交流"},"生まれる":{"meaning":"誕生、產生"},"期待する":{"meaning":"期待"}},"particles":{"の":"表示所有、所屬或修飾關係的助詞，相當於「的」","が":"標示句子主語的格助詞","に":"表示時間、對象、方向或存在場所等的助詞","と":"表示動作對象、引用內容或並列關係的助詞","は":"提示句子主題的助詞","を":"標示動作對象（受詞）的格助詞","で":"表示動作發生的場所、方式或手段的助詞","や":"表示不完全列舉，意為「和、及」的助詞","も":"表示「也」的助詞","など":"表示「等等」，用於列舉例子的副助詞","として":"表示「作為〜」身份或資格的助詞","にとって":"表示「對〜而言」，用來說明立場觀點的助詞","ものの":"表示「雖然〜，但是〜」的逆接助詞，書面語氣較強","ながら":"表示「一邊〜一邊〜」，同時進行兩個動作的助詞","かねない":"接在動詞連用形後，表示「有可能會〜（帶負面語氣）」的助動詞"},"translations":[[{"text":"近年，作為居民能輕鬆聚集、交流的場所，被稱為「社區咖啡館」的設施正在全國各地擴展開來。","word":"広がる"}],[{"text":"這類咖啡館多利用商店街的空店鋪或公民館等場地開設，尤其作為防止高齡者孤立的場所而受到關注。","word":"注目する"}],[{"text":"對獨居的高齡者而言，能和某人交談的機會可以成為生活上的支柱，但隨著外出機會減少，這樣的聯繫也有可能因此失去。","word":"失う"}],[{"text":"在社區咖啡館，透過志工的營運，人們可以一邊喝茶一邊商量煩惱，或交換地區資訊。","word":"通じる"}],[{"text":"儘管營運上也存在資金方面的課題，但持續獲得行政與企業支援、繼續活動的團體也在增加。","word":"課題"}],[{"text":"以這樣的努力為契機，期待能夠產生跨世代的交流。","word":"期待する"}]],"grammar_notes":[{"sentence":2,"pattern":"〜かねない","note":"「有可能會〜（負面）」"},{"sentence":3,"pattern":"〜を通じて／〜を通して","note":"「透過〜」，媒介或期間"},{"sentence":4,"pattern":"〜ものの","note":"「雖然〜」，書面逆接"},{"sentence":5,"pattern":"〜をきっかけに","note":"「以〜為契機」"}]}
