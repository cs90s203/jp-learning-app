ng": "現行制度"}, "違憲": {"meaning": "違憲"}, "あるいは": {"meaning": "或者；或是"}, "違憲状態": {"meaning": "違憲狀態"}, "判断する": {"meaning": "判斷"}, "国": {"meaning": "國家"}, "増える": {"meaning": "增加"}, "国際的": {"meaning": "國際性的"}, "潮流": {"meaning": "潮流；趨勢"}, "相まって": {"meaning": "與～相結合（書面用語）"}, "国内": {"meaning": "國內"}, "法整備": {"meaning": "法律制度的完善；立法整備"}, "求める": {"meaning": "要求；尋求"}, "声": {"meaning": "聲音；意見"}, "高まる": {"meaning": "高漲；升高"}, "賛成派": {"meaning": "贊成派"}, "中": {"meaning": "之中；當中"}, "司法判断": {"meaning": "司法判斷"}, "相次ぐ": {"meaning": "接連發生"}, "以上": {"meaning": "既然～；以上"}, "国会": {"meaning": "國會"}, "踏み出す": {"meaning": "邁出（步伐）；踏出"}, "しかるべし": {"meaning": "應當如此；理應如此"}, "意見": {"meaning": "意見"}, "一方": {"meaning": "另一方面"}, "伝統的": {"meaning": "傳統的"}, "家族観": {"meaning": "家庭觀"}, "重んじる": {"meaning": "重視"}, "立場": {"meaning": "立場"}, "制度変更": {"meaning": "制度變更"}, "影響": {"meaning": "影響"}, "慎重": {"meaning": "慎重；謹慎"}, "見極める": {"meaning": "看清；判斷清楚"}, "合意形成": {"meaning": "形成共識"}, "優先する": {"meaning": "優先"}, "与党内": {"meaning": "執政黨內部"}, "賛否": {"meaning": "贊成與反對；贊否"}, "分かれる": {"meaning": "分歧；分開"}, "国民的合意": {"meaning": "全民共識"}, "足る": {"meaning": "足夠；足以"}, "尽くす": {"meaning": "竭盡；充分進行"}, "言い難い": {"meaning": "難以說；難言"}, "世論調査": {"meaning": "輿論調查"}, "賛成": {"meaning": "贊成"}, "多数": {"meaning": "多數"}, "占める": {"meaning": "佔（比例）"}, "政治的優先度": {"meaning": "政治上的優先程度"}, "低い": {"meaning": "低的"}, "扱う": {"meaning": "對待；處理"}, "行方": {"meaning": "走向；去向"}, "不透明": {"meaning": "不明朗；不透明"}}, "particles": {"で": "格助詞，表示動作發生的場所、方式，或狀態變化後的結果。", "は": "係助詞，標示句子的主題或用於對比。", "の": "連體助詞，連接名詞與名詞表示所屬、修飾關係，或作形式名詞用法。", "を": "格助詞，標示動作所及的直接受詞。", "が": "格助詞或接續助詞，標示主語，或表「雖然～但是」的逆接。", "と": "格助詞，表示引用內容、比較對象或並列關係。", "に": "格助詞，表示動作的對象、時間點或基準。", "や": "並列助詞，列舉部分事物，暗示「還有其他」。", "まで": "副助詞，表示範圍的終點，「到～為止」。", "など": "副助詞，表示舉例，「～等」。", "も": "係助詞，表示「也」，用於類比或並列。", "だ": "斷定助動詞，「是」，用於常體句尾表判斷。", "な": "斷定助動詞「だ」的連體形，用於修飾後面的名詞。", "として": "複合格助詞，「作為～」，表示身分或立場。"}, "translations": [[{"text": "在日本，圍繞同性婚姻法制化的討論已持續多年。", "word": "議論"}], [{"text": "現行的民法及戶籍法將婚姻規定為男女之間的結合，同性婚姻在法律上尚未被承認。", "word": "規定する"}], [{"text": "部分地方自治體雖已導入伴侶制度，但並不保障繼承及稅制上的權利。", "word": "パートナーシップ制度"}], [{"text": "因此有人指出，當事人在住院陪護等方面被迫承受諸多不便。", "word": "余儀なくされる"}], [{"text": "推動派主張，不論性傾向為何，都應承認婚姻的權利，且已有多個地方法院判定現行制度違憲或處於違憲狀態。", "word": "主張する"}], [{"text": "隨著承認同性婚姻的國家增加這一國際潮流的推波助瀾，國內要求完善相關法律的呼聲也日益高漲。", "word": "相まって"}], [{"text": "贊成派中也有人認為，既然司法判斷接連出現，國會也理應著手展開討論。", "word": "しかるべし"}], [{"text": "另一方面，重視傳統家庭觀的立場則主張應謹慎評估制度變更帶來的影響，優先形成社會共識。", "word": "見極める"}], [{"text": "執政黨內部意見也存在分歧，難以說已經進行了足以形成全民共識的充分討論。", "word": "足る"}], [{"text": "民調顯示贊成者占多數，但在政治上的優先程度卻往往被視為較低，議論的走向依然不明朗。", "word": "不透明"}]], "grammar_notes": [{"sentence": 3, "pattern": "〜を余儀なくされる", "note": "「被迫〜」，書面被動"}, {"sentence": 5, "pattern": "〜と相まって", "note": "「與〜相結合」，書面因果"}, {"sentence": 6, "pattern": "〜てしかるべきだ", "note": "「理應〜」"}, {"sentence": 8, "pattern": "〜に足る", "note": "「足以〜」"}]}
