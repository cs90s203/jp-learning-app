    "translations": [
      [
        {"text": "近年來，在日本，使用電子書籍的人正穩健增加。", "word": "電子書籍"}
      ],
      [
        {"text": "這是因為智慧型手機和平板電腦的普及，讓人們即使在通勤途中也能輕鬆閱讀書籍。", "word": "普及する"}
      ],
      [
        {"text": "根據出版業界的統計，電子書籍的市場規模在這十年間大幅擴大，據說在漫畫領域尤其顯著。", "word": "拡大する"}
      ],
      [
        {"text": "另一方面，紙本書有其獨特的觸感與香氣，喜歡親自前往書店的人也不在少數。", "word": "独特"}
      ],
      [
        {"text": "如果是電子書籍，也有不增加行李重量就能攜帶好幾本書的優點。", "word": "持ち歩く"}
      ],
      [
        {"text": "據認為，今後電子書籍與紙本書將會在發揮各自優點的同時繼續共存下去。", "word": "共存する"}
      ]
    ],
    "grammar_notes": [
      {"sentence": 1, "pattern": "〜によって", "note": "「依據〜」／「因〜而異」，也用於被動的動作者"},
      {"sentence": 3, "pattern": "〜一方で", "note": "「另一方面」，對比"},
      {"sentence": 4, "pattern": "〜ずに", "note": "「不〜地」，書面的ない形替代"}
