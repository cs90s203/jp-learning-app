  "translations": [
    [ { "text": "近年，居民自發參與的社區清掃活動在各地逐漸展開。", "word": "地域清掃活動" } ],
    [ { "text": "起因是一直為亂丟垃圾和非法棄置所苦的商店街，訂定了每月一次的清掃日。", "word": "きっかけ" } ],
    [ { "text": "一開始參加者很少，但隨著活動情況在社群媒體上被傳播，年輕世代的參加者據說逐漸增加了。", "word": "発信する" } ],
    [ { "text": "透過清掃增加了熟識的人，也有聲音認為在防範犯罪與防災方面，社區的聯繫正在強化。", "word": "通じる" } ],
    [ { "text": "另一方面，參加者高齡化、固定化的地區也不少，有人指出要持續營運，確保新的接班人不可或缺。", "word": "担い手" } ],
    [ { "text": "行政方面也打算擴充對這類活動的補助金制度等，進一步加強支持力道。", "word": "拡充する" } ]
  ],
