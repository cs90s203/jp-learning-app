  "translations": [
    [ { "text": "近年，共享單車的使用在都市地區迅速普及。", "word": "シェアサイクル" } ],
    [ { "text": "用專用App尋找附近的腳踏車，當場登記後馬上就能騎走，這種輕鬆感是受歡迎的原因。", "word": "手軽さ" } ],
