,"文部科学省":{"meaning":"文部科學省（日本教育部）"},"採用試験":{"meaning":"錄用考試"},"早期化":{"meaning":"提前進行"},"待遇改善":{"meaning":"待遇改善"},"進める":{"meaning":"推進"},"現場":{"meaning":"現場"},"人手不足":{"meaning":"人力不足"},"すぐ":{"meaning":"馬上、立刻"},"解消する":{"meaning":"解決、消除"},"教員":{"meaning":"教師"},"軽減する":{"meaning":"減輕"},"教育":{"meaning":"教育"},"質":{"meaning":"品質"},"維持する":{"meaning":"維持"},"ため":{"meaning":"為了（目的）"},"校務":{"meaning":"校務"},"効率化":{"meaning":"效率化"},"外部人材":{"meaning":"外部人才"},"活用":{"meaning":"活用"},"多角的":{"meaning":"多角度的、多方面的"},"対策":{"meaning":"對策"},"講じる":{"meaning":"採取（對策）"},"必要":{"meaning":"必要"},"ある":{"meaning":"有、存在"},"特に":{"meaning":"特別、尤其"},"小学校":{"meaning":"小學"},"学級担任":{"meaning":"班級導師"},"決まる":{"meaning":"決定"},"新学期":{"meaning":"新學期"},"迎える":{"meaning":"迎接"},"事例":{"meaning":"案例、事例"},"報告する":{"meaning":"報告"},"保護者":{"meaning":"家長"},"児童":{"meaning":"兒童、學童"},"影響":{"meaning":"影響"},"懸念する":{"meaning":"擔憂"}},"particles":{"における":"表示範圍或場域，書面語的「在〜方面」","が":"標示句子的主語","や":"列舉名詞時用的「和」","の":"表示所屬關係","を":"標示動作的受詞","さえ":"「甚至連…」，強調極端的例子","で":"表示場所、範圍","と":"引用或構成される的結構","は":"主題標記","に":"表示對象、時間點或構成副詞形","ものの":"「雖然〜」的逆接語氣","など":"「〜等」，列舉","において":"書面語的「在〜方面」，近義於における","まま":"「…的狀態」，表示持續不變","へ":"表示方向或對象"},"translations":[[{"text":"近年，公立學校的教師不足問題日益嚴重，連代理產假、病假的代課教師都確保不到，許多學校被迫調整課程安排，這種情況在各地接連發生。","word":"余儀なくされる"}],[{"text":"長時間工作與應對家長的沉重負擔被認為是志願者減少的原因之一，教育現場的工作方式改革因此成為當務之急。","word":"働き方改革"}],[{"text":"文部科學省雖然正在推動提前舉辦錄用考試及改善待遇，但現場的人力不足恐怕無法立刻解決。","word":"人手不足"}],[{"text":"為了在減輕教師負擔的同時維持教育品質，有必要採取如精簡校務、活用外部人才等多方面的對策。","word":"講じる"}],[{"text":"尤其是在小學，甚至有報導指出有些班級在開學時仍未確定導師，這也讓人擔心會影響到家長與學童。","word":"懸念する"}]],"grammar_notes":[{"sentence":0,"pattern":"〜を余儀なくされる","note":"「被迫〜」，書面被動"}]}