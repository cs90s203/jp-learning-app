營運"},"子ども食堂":{"meaning":"兒童食堂（社區共食據點）"},"全国各地":{"meaning":"全國各地"},"広がる":{"meaning":"擴大、普及"},"当初":{"meaning":"當初、一開始"},"貧困対策":{"meaning":"貧困對策"},"側面":{"meaning":"側面、面向"},"強調する":{"meaning":"強調"},"実際":{"meaning":"實際上"},"一人":{"meaning":"一個人"},"温かい":{"meaning":"溫暖的"},"居場所":{"meaning":"歸屬、落腳處"},"提供する":{"meaning":"提供"},"役割":{"meaning":"角色、作用"},"大きい":{"meaning":"大的"},"多世代交流":{"meaning":"多世代交流"},"場":{"meaning":"場所、場域"},"機能する":{"meaning":"發揮功能、運作"},"運営費":{"meaning":"營運經費"},"多く":{"meaning":"大部分、多數"},"寄付":{"meaning":"捐款、捐贈"},"自治体":{"meaning":"地方政府"},"補助":{"meaning":"補助"},"限る":{"meaning":"限於（常用否定形表示不僅限於）"},"地域企業":{"meaning":"地方企業"},"支援":{"meaning":"支援、援助"},"頼る":{"meaning":"依賴、依靠"},"資金":{"meaning":"資金"},"人手":{"meaning":"人力"},"確保":{"meaning":"確保、確保取得"},"苦労する":{"meaning":"辛苦、費心"},"団体":{"meaning":"團體"},"少ない":{"meaning":"少的"},"それでも":{"meaning":"即使如此"},"子どもたち":{"meaning":"孩子們"},"笑顔":{"meaning":"笑容"},"活動":{"meaning":"活動"},"続ける":{"meaning":"持續、繼續"},"運営者":{"meaning":"經營者、營運者"},"姿":{"meaning":"身影、樣子"},"地域福祉":{"meaning":"地區福利（社福）"},"新しい":{"meaning":"新的"},"表れる":{"meaning":"顯現、展現"},"言う":{"meaning":"說"},"形":{"meaning":"形狀、型態"},"今後":{"meaning":"今後"},"行政":{"meaning":"行政機關"},"連携":{"meaning":"合作、聯繫"},"強化する":{"meaning":"強化"},"持続可能":{"meaning":"永續的、可持續的"},"運営体制":{"meaning":"營運體制"},"整える":{"meaning":"整頓、建立"},"こと":{"meaning":"事情（形式名詞）"},"求める":{"meaning":"要求、尋求"}},"particles":{"の":"表示所屬關係","で":"表示場所、方法或原因","な":"な形容詞修飾名詞時的連接形式","を":"標示動作的受詞","や":"列舉名詞時用的「和」","が":"標示句子的主語","に":"表示對象、時間點或構成副詞形","として":"「作為〜」的身分/立場","も":"「也」，表示並列或強調","と":"「和」，或用於言える等引用結構","は":"主題標記","から":"表示來源或起點"},"translations":[[{"text":"為了支撐因家庭狀況無法吃飽飯的孩子，由地區居民和志工經營的兒童食堂正在全國各地擴展開來。","word":"子ども食堂"}],[{"text":"一開始大家常強調這是貧困對策的一面，","word":"強調する"},{"text":"但實際上它也扮演著給獨自用餐孩子一個溫暖歸屬的重要角色，同時也發揮著地區多世代交流場所的功能。","word":"居場所"}],[{"text":"營運經費不僅依賴捐款與地方政府的補助，也仰賴地方企業的支援，不少團體都為籌措資金和人力而苦惱。","word":"支援"}],[{"text":"儘管如此，看著在孩子們笑容支持下持續活動的經營者身影，可以說展現出一種新的地區福祉型態。","word":"表れる"}],[{"text":"今後需要強化與行政機關的合作，建立起可持續的營運體制才行。","word":"整える"}]],"grammar_notes":[{"sentence":2,"pattern":"〜に限らず","note":"「不僅限於〜」"}]}