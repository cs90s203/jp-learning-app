ading":"えがお","pos":"名詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"なっていた","basic_form":"なる","reading":"なっていた","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"},{"surface_form":"来週","basic_form":"来週","reading":"らいしゅう","pos":"名詞"},{"surface_form":"も","basic_form":"も","reading":"も","pos":"助詞"},{"surface_form":"また","basic_form":"また","reading":"また","pos":"副詞"},{"surface_form":"一緒","basic_form":"一緒","reading":"いっしょ","pos":"名詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"やる","basic_form":"やる","reading":"やる","pos":"動詞"},{"surface_form":"予定","basic_form":"予定","reading":"よてい","pos":"名詞"},{"surface_form":"だ","basic_form":"だ","reading":"だ","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"休み":{"meaning":"休息、放假"},"日":{"meaning":"日子"},"久しぶり":{"meaning":"隔了好久、久違"},"息子":{"meaning":"兒子"},"キャッチボール":{"meaning":"傳接球"},"する":{"meaning":"做"},"最初":{"meaning":"一開始"},"ボール":{"meaning":"球"},"うまく":{"meaning":"順利地"},"投げる":{"meaning":"投"},"優しい":{"meaning":"溫柔、親切"},"教える":{"meaning":"教導"},"少しずつ":{"meaning":"一點一點地"},"コツ":{"meaning":"要領、訣竅"},"つかむ":{"meaning":"抓住、掌握"},"汗":{"meaning":"汗"},"かく":{"meaning":"流（汗）"},"何度":{"meaning":"好幾次"},"練習する":{"meaning":"練習"},"うち":{"meaning":"…的時候、之中"},"だんだん":{"meaning":"漸漸"},"球":{"meaning":"球"},"受ける":{"meaning":"接、接受"},"よう":{"meaning":"變得…的樣子"},"なる":{"meaning":"變成"},"終わる":{"meaning":"結束"},"ころ":{"meaning":"…的時候"},"二人":{"meaning":"兩個人"},"笑顔":{"meaning":"笑容"},"来週":{"meaning":"下週"},"また":{"meaning":"再、又"},"一緒":{"meaning":"一起"},"やる":{"meaning":"做"},"予定":{"meaning":"預定、計畫"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞","に":"表示時間點、對象，或構成副詞形","と":"表示一起做某事的對象","を":"標示動作的受詞","は":"主題標記","が":"標示句子的主語","ので":"表示客觀原因","も":"「也」，表示並列或強調","とも":"「兩者都」，接在數量詞後強調全部"},"translations":[[{"text":"休假日，隔了好久和兒子玩了傳接球。","word":"息子"}],[{"text":"一開始球怎麼都投不好，","word":"投げる"},{"text":"但兒子溫柔地教我，讓我漸漸抓到一點訣竅。","word":"コツ"}],[{"text":"一邊流汗一邊練習好幾次之後，漸漸能接到兒子的球了，","word":"受ける"},{"text":"結束的時候我們兩個都露出了笑容。","word":"笑顔"}],[{"text":"下週也打算再一起玩。","word":"一緒"}]],"grammar_notes":[{"sentence":1,"pattern":"〜ので（因為）","note":"客觀原因，比から更委婉/書面"},{"sentence":1,"pattern":"〜てあげる／〜てくれる／〜てもらう","note":"授受表現（幫忙的方向性）"},{"sentence":3,"pattern":"〜予定だ","note":"預計、行程安排"}]}