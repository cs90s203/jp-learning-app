は","pos":"助詞"},{"surface_form":"稽古","basic_form":"稽古","reading":"けいこ","pos":"名詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"日","basic_form":"日","reading":"ひ","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"待ち遠しく","basic_form":"待ち遠しい","reading":"まちどおしく","pos":"形容詞"},{"surface_form":"感じられる","basic_form":"感じる","reading":"かんじられる","pos":"動詞"},{"surface_form":"ほど","basic_form":"ほど","reading":"ほど","pos":"助詞"},{"surface_form":"で","basic_form":"で","reading":"で","pos":"助詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"来月","basic_form":"来月","reading":"らいげつ","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"初めて","basic_form":"初めて","reading":"はじめて","pos":"名詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"お茶会","basic_form":"お茶会","reading":"おちゃかい","pos":"名詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"参加する","basic_form":"参加する","reading":"さんかする","pos":"動詞"},{"surface_form":"予定","basic_form":"予定","reading":"よてい","pos":"名詞"},{"surface_form":"だ","basic_form":"だ","reading":"だ","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"以前":{"meaning":"以前"},"和":{"meaning":"日式、和風"},"文化":{"meaning":"文化"},"興味":{"meaning":"興趣"},"ある":{"meaning":"有、存在"},"茶道":{"meaning":"茶道"},"敷居":{"meaning":"門檻（敷居が高い=難以親近）"},"高い":{"meaning":"高的"},"思う":{"meaning":"覺得、想"},"なかなか":{"meaning":"（後接否定）怎麼也不"},"始める":{"meaning":"開始"},"ところが":{"meaning":"然而、沒想到"},"去年":{"meaning":"去年"},"職場":{"meaning":"職場"},"先輩":{"meaning":"前輩"},"誘う":{"meaning":"邀約"},"きっかけ":{"meaning":"契機、起因"},"思い切る":{"meaning":"下定決心、狠下心"},"近所":{"meaning":"附近、鄰近"},"茶道教室":{"meaning":"茶道教室"},"通う":{"meaning":"定期前往"},"こと":{"meaning":"事情（形式名詞）"},"する":{"meaning":"做"},"最初":{"meaning":"一開始"},"正座":{"meaning":"正坐、跪坐"},"足":{"meaning":"腳"},"しびれる":{"meaning":"發麻"},"お茶":{"meaning":"茶"},"点てる":{"meaning":"泡茶、點茶（茶道用語）"},"手順":{"meaning":"步驟、順序"},"覚える":{"meaning":"記住、學會"},"先生":{"meaning":"老師"},"丁寧":{"meaning":"仔細、周到"},"一つ":{"meaning":"一個"},"説明する":{"meaning":"說明"},"おかげ":{"meaning":"多虧、託…的福"},"少しずつ":{"meaning":"一點一點地"},"所作":{"meaning":"動作、禮儀舉止"},"身につける":{"meaning":"學會、掌握（技能）"},"よう":{"meaning":"…的樣子、變得…"},"なる":{"meaning":"變成"},"今":{"meaning":"現在"},"稽古":{"meaning":"練習、修習"},"日":{"meaning":"日子"},"待ち遠しい":{"meaning":"期待已久、迫不及待"},"感じる":{"meaning":"感覺"},"来月":{"meaning":"下個月"},"初めて":{"meaning":"第一次"},"お茶会":{"meaning":"茶會"},"参加する":{"meaning":"參加"},"予定":{"meaning":"預定、計畫"}},"particles":{"から":"表示時間或地點的起點","の":"表示所屬關係","に":"表示對象、時間點或構成副詞形","が":"標示句子的主語","ものの":"「雖然〜」的逆接語氣","は":"主題標記","と":"用於引用（と思う）","を":"標示動作的受詞","だけ":"「只有〜」，表示限定","で":"表示場所、方法，或原因","ずつ":"表示「每次一點」","ほど":"表示程度，「〜到…的程度」"},"translations":[[{"text":"雖然以前就對日式傳統文化有興趣，但覺得茶道的門檻很高，一直沒能開始學。","word":"敷居"}],[{"text":"沒想到去年因為被職場前輩邀約，我才終於下定決心，開始去附近的茶道教室上課。","word":"きっかけ"}],[{"text":"一開始光是正坐就讓我的腳發麻，連點茶的步驟也怎麼都記不住，","word":"しびれる"},{"text":"但多虧老師仔細地一一說明，我才漸漸學會了這些禮儀動作。","word":"身につける"}],[{"text":"現在練習的日子讓我期待不已，下個月打算第一次參加茶會。","word":"お茶会"}]],"grammar_notes":[{"sentence":1,"pattern":"〜ことにする／〜ことになる","note":"決定／自然而然演變成的結果"},{"sentence":2,"pattern":"〜おかげで／〜せいで","note":"「多虧〜」／「都怪〜」，正負面歸因"}]}