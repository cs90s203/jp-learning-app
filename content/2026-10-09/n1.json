:"招致、引發"},"懸念":{"meaning":"擔憂"},"示す":{"meaning":"顯示、表示"},"エネルギーコスト":{"meaning":"能源成本"},"上昇":{"meaning":"上升"},"物価高":{"meaning":"物價上漲"},"相まる":{"meaning":"相互作用、交織"},"家計":{"meaning":"家庭經濟、家計"},"圧迫する":{"meaning":"壓迫、造成壓力"},"現状":{"meaning":"現狀"},"軽視する":{"meaning":"輕視、忽視"},"ない":{"meaning":"沒有、不"},"訴える":{"meaning":"訴求、呼籲"},"双方":{"meaning":"雙方"},"主張":{"meaning":"主張"},"それぞれ":{"meaning":"各自"},"相応":{"meaning":"相應、相稱"},"根拠":{"meaning":"根據、依據"},"ある":{"meaning":"有、存在"},"拙速":{"meaning":"草率求快"},"結論":{"meaning":"結論"},"出す":{"meaning":"提出"},"避ける":{"meaning":"避免"},"今後":{"meaning":"今後"},"段階的":{"meaning":"階段性的"},"税率設定":{"meaning":"稅率設定"},"他国":{"meaning":"他國"},"制度":{"meaning":"制度"},"整合性":{"meaning":"整合性、一致性"},"踏まえる":{"meaning":"基於、根據"},"産業構造":{"meaning":"產業結構"},"転換":{"meaning":"轉型"},"後押しする":{"meaning":"推動、支持"},"制度設計":{"meaning":"制度設計"},"進める":{"meaning":"推進"},"政策立案者":{"meaning":"政策制定者"},"課す":{"meaning":"課予、賦予"},"責務":{"meaning":"責任、職責"},"言う":{"meaning":"說"},"この":{"meaning":"這個"},"行方":{"meaning":"走向、去向"},"いかん":{"meaning":"如何（結果會怎樣）"},"エネルギー政策":{"meaning":"能源政策"},"全体":{"meaning":"整體"},"方向性":{"meaning":"方向性"},"左右する":{"meaning":"左右、影響"},"過言":{"meaning":"誇大之詞、過分的話"}},"particles":{"の":"表示所屬關係","が":"標示句子的主語","な":"な形容詞修飾名詞時的連接形式","と":"「和」，或構成なる/言う等的結構","で":"表示場所、方法，或限定","も":"「也」，表示並列或強調","として":"「作為〜」的身分/立場","を":"標示動作的受詞","に":"表示對象、時間點或構成副詞形","へ":"表示方向、對象","や":"列舉名詞時用的「和」","は":"主題標記"},"translations":[[{"text":"在溫室氣體排放削減成為全球性當務之急的情況下，日本也掀起了圍繞將碳稅導入作為氣候變遷對策一環的議論，再度升溫。","word":"炭素税"}],[{"text":"支持導入的立場認為，依排放量課稅能讓企業與個人產生減少排放的動機，而且稅收可以用於促進再生能源的普及，並以此為優點提出主張。","word":"動機付け"}],[{"text":"對此，以產業界為主的反對派則擔憂這可能導致國際競爭力下滑，並主張能源成本上升與物價上漲相互作用、壓迫家計的現狀不應被輕視。","word":"国際競争力"}],[{"text":"雙方的主張各有相應的依據，不應草率得出結論。","word":"根拠"}],[{"text":"今後必須在兼顧階段性稅率設定與他國制度整合性的同時，推動有助於產業結構轉型的制度設計，這可以說是政策制定者被賦予的責任，不得不這麼說。","word":"言わざるを得ない"}],[{"text":"這場議論的走向如何，可以說將左右今後整體能源政策的方向，這麼說並不為過。","word":"いかん"}]],"grammar_notes":[{"sentence":2,"pattern":"〜と相まって","note":"「與〜相結合」，書面因果"}]}