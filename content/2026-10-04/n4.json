  "translations": [
    [
      {
        "text": "上週日，我和姊姊一起爬了附近的山。",
        "word": "登る"
      }
    ],
    [
      {
        "text": "因為早上很早起床，有點想睡，但還是打起精神出發了。",
        "word": "頑張る"
      }
    ],
    [
      {
        "text": "山路比想像中陡，一路上休息了好幾次才走完。",
        "word": "休む"
      }
    ],
    [
      {
        "text": "終於爬到山頂時，景色非常漂亮，疲勞感一下子都消失了。",
        "word": "景色"
      }
    ],
    [
      {
        "text": "回程雖然很累，但能和姊姊留下美好的回憶，覺得很開心。",
        "word": "嬉しい"
      }
    ],
    [
      {
        "text": "真是非常美好的一天。",
        "word": "一日"
      }
    ]
  ],
