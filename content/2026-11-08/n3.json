  "translations": [
    [ { "text": "去年秋天，因為想穿和服出席朋友的婚禮，所以開始學習和服的穿著方式。", "word": "着付け" } ],
    [ { "text": "一開始完全記不住腰帶的綁法，不管練習多少次都重複同樣的失誤。", "word": "繰り返す" } ],
    [ { "text": "老師對我說「不用著急，沒關係的」，讓我心情稍微輕鬆了一些。", "word": "言う" } ],
    [ { "text": "還不熟悉的時候，自己一個人穿要花將近一個小時，但半年過去的現在，已經不用三十分鐘就能穿好了。", "word": "かかる" } ],
    [ { "text": "穿和服也需要體力，要記的東西也不少，但每次能夠穿上和服的時候，總有種自豪的感覺。", "word": "誇らしい" } ],
    [ { "text": "今後只要有機會，我都還想穿著和服出門。", "word": "機会" } ]
  ],
