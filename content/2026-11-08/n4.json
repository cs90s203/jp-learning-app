  "translations": [
    [ { "text": "上星期六，和弟弟一起去了附近的煙火大會。", "word": "花火大会" } ],
    [ { "text": "穿浴衣的人也很多，非常熱鬧。", "word": "にぎやか" } ],
    [ { "text": "因為人非常多，走路也很辛苦，不過在攤販吃了炒麵，也吃了刨冰，玩得很開心。", "word": "楽しむ" } ],
    [ { "text": "煙火開始後，弟弟發出很大的聲音，非常高興。", "word": "喜ぶ" } ],
    [ { "text": "最後的煙火非常大，兩人都被感動了。", "word": "感動する" } ],
    [ { "text": "明年也還想一起去。", "word": "思う" } ]
  ],
