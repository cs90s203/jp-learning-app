  "translations": [
    [ { "text": "今天我和媽媽一起做了麵包。", "word": "パン" } ],
    [ { "text": "揉麵團、等待發酵，花了不少時間但很開心。", "word": "こねる" } ],
    [ { "text": "因為烤箱一直沒有熱起來，比平常多花了些時間。", "word": "温まる" } ],
    [ { "text": "麵團明明很柔軟，卻很難揉成球狀，讓我很費力。", "word": "丸める" } ],
    [ { "text": "即便如此，能吃到自己做的麵包還是很開心。", "word": "嬉しい" } ],
    [ { "text": "下次也想試著加入起司。", "word": "入れる" } ]
