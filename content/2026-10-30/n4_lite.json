  "translations": [
    [
      {
        "text": "上禮拜，我參加了做和紙的工作坊。",
        "word": "参加する"
      }
    ],
    [
      {
        "text": "把用樹皮製成的纖維，在水裡慢慢地展開。",
        "word": "広げる"
      }
    ],
    [
      {
        "text": "比想像中還需要力氣，有點辛苦。",
        "word": "要る"
      }
    ],
    [
      {
        "text": "不過，能做出屬於自己原創的和紙，讓我非常開心。",
        "word": "できる"
      }
    ],
    [
      {
        "text": "等乾了之後，我打算拿來當書籤用。",
        "word": "つもり"
      }
    ]
  ],
