  "translations": [
    [
      {
        "text": "今天中午，在便利商店買了飯糰。",
        "word": "買う"
      }
    ],
    [
      {
        "text": "選了梅子和鮭魚口味的兩個，也順便買了茶。",
        "word": "一緒に"
      }
    ],
    [
      {
        "text": "在收銀台付了錢，走到外面。",
        "word": "払う"
      }
    ],
    [
      {
        "text": "坐在公園的長椅上，慢慢地吃了起來。",
        "word": "座る"
      }
    ],
    [
      {
        "text": "飯糰還是溫熱的，非常好吃。",
