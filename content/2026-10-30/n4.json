  "translations": [
    [
      {
        "text": "上週六，我和朋友去附近的山上健行。",
        "word": "ハイキング"
      }
    ],
    [
      {
        "text": "因為一大早就出發，山路上人還很少，走起來很輕鬆。",
        "word": "ので"
      }
    ],
    [
      {
        "text": "途中拍了照片，也吃了帶來的飯糰，好好地休息了一下。",
        "word": "休む"
      }
    ],
    [
      {
        "text": "一到山頂，城鎮的風景就看得很清楚，非常漂亮。",
        "word": "見える"
      }
    ],
    [
      {
        "text": "雖然很累，但能看到山頂上的風景，讓我覺得這趟真的來對了。",
        "word": "のに"
      }
    ]
  ],
