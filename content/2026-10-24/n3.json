  "translations": [
    [ { "text": "開始學手語的契機，是在職場遇到了一位耳朵不便的同事。", "word": "きっかけ" } ],
    [ { "text": "一開始只用手勢溝通，但後來我漸漸想「想要更自然地交談」。", "word": "もっと" } ],
    [ { "text": "於是，我決定週末去上手語教室。", "word": "ことにする" } ],
    [ { "text": "要記的東西很多，手指的動作也常常不如預期，但漸漸能表達的單字增加了。", "word": "増える" } ],
    [ { "text": "有一次用手語跟同事打招呼，他露出又驚訝又開心的表情，讓我難以忘懷。", "word": "忘れる" } ],
    [ { "text": "今後也想變得能和更多人用手語交流。", "word": "なる" } ]
