  "translations": [
    [ { "text": "在日本各地，為了將隨著人口減少和高齡化而增加的空屋作為地區資源加以活用的專案正在擴展。", "word": "広がり" } ],
    [ { "text": "過去容易被放任不管的空屋，經過修繕後被改造成咖啡廳、住宿設施、育兒支援據點等，這樣的推動措施正在各地進行。", "word": "取り組み" } ],
    [ { "text": "背景原因除了空屋增加已成為治安和景觀方面的地區課題之外，還有年輕世代對翻修老屋居住的興趣日漸提高。", "word": "関心" } ],
    [ { "text": "地方政府也以補助修繕費用、建立空屋銀行等形式提供支持，與民間企業及NPO的合作也在推進中。", "word": "後押しする" } ],
    [ { "text": "話雖如此，仍有許多無法確定所有人的空屋，以及今後的課題將是如何擴大資金方面的支援。", "word": "とはいえ" } ]
  ],
