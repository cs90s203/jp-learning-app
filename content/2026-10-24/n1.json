  "translations": [
    [ { "text": "關於觀光地的「觀光公害」，也就是所謂的過度旅遊議論，近年來在各地逐漸浮現。", "word": "オーバーツーリズム" } ],
    [ { "text": "隨著訪日外國遊客的急速增加，交通系統的擁擠與對居民生活造成的妨礙日益嚴重，當地居民接連發出被奪走寧靜生活的不滿聲浪。", "word": "深刻化する" } ],
    [ { "text": "部分鐵路公司為了緩解擁擠，不得不增開臨時班次。", "word": "余儀ない" } ],
    [ { "text": "對從事觀光業的業者而言，入境需求的擴大仍是支撐地區經濟的重要收入來源，因此對輕率限制觀光客人數抱持謹慎態度的業者也不在少數。", "word": "とって" } ],
    [ { "text": "部分地方政府已開始以入場費、住宿稅等形式要求觀光客負擔一定費用，並將該收益用於擁擠應對措施及環境保護等推動計畫。", "word": "充てる" } ],
    [ { "text": "然而，這類措施是否能對觀光客的分散產生實際效果，不得不說仍在驗證階段。", "word": "言う" } ],
    [ { "text": "觀光帶來的經濟利益，與如何兼顧居民生活品質，這一課題恐怕將持續是日本各地觀光地今後不得不面對、無法迴避的論點。", "word": "向き合う" } ]
  ],
