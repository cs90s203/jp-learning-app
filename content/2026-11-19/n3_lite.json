  "translations": [
    [
      {
        "text": "最近開始嘗試編織。",
        "word": "編み物"
      }
    ],
    [
      {
        "text": "起因是收到朋友織的圍巾，覺得很感動。",
        "word": "マフラー"
      }
    ],
    [
      {
        "text": "一開始織目對不齊，重做了好幾次。",
        "word": "やり直す"
      }
    ],
    [
      {
        "text": "不過漸漸變得熟練，",
        "word": "上手"
      },
      {
        "text": "連自己都感到驚訝。",
        "word": "驚く"
      }
    ],
    [
      {
        "text": "雖然現在還只能做簡單的東西，但希望將來也能織織看毛衣。",
        "word": "編む"
      }
    ],
    [
      {
        "text": "動手編織的時候，心情也會平靜下來，這也是編織的魅力所在。",
        "word": "落ち着く"
      }
    ],
    [
      {
        "text": "今後也想繼續開心地編織下去。",
        "word": "編む"
      }
    ]
  ],
