  "translations": [
    [
      {
        "text": "近年，在超市和便利商店看到自助結帳機的機會變多了。",
        "word": "セルフレジ"
      }
    ],
    [
      {
        "text": "因為可以縮短排隊結帳的時間，使用的人數似乎逐年增加。",
        "word": "短縮する"
      }
    ],
    [
      {
        "text": "特別是在都市地區，似乎也有助於緩解高峰時段的擁擠。",
        "word": "役立つ"
      }
    ],
    [
      {
        "text": "另一方面，不習慣操作的高齡者，",
        "word": "一方で"
      },
      {
        "text": "有時也不得不感受到使用上的不便。",
        "word": "感じる"
      }
    ],
    [
      {
        "text": "對店家來說，雖然有可以降低人事成本的優點，",
        "word": "メリット"
      },
      {
        "text": "但順手牽羊等風險管理也成了新的課題。",
        "word": "課題"
      }
    ],
    [
      {
        "text": "今後，兼顧易用性與安全性的系統開發將會是必須的。",
        "word": "開発"
      }
    ]
  ],
  "grammar_notes": [
    {
      "sentence": 3,
      "pattern": "〜ざるを得ない",
      "note": "「不得不〜」"
    }
  ]
