  "translations": [
    [
      {
        "text": "上週六，我和弟弟在附近的河邊放了煙火。",
        "word": "花火"
      }
    ],
    [
      {
        "text": "放了仙女棒，也放了手持煙火，",
        "word": "線香花火"
      },
      {
        "text": "非常開心。",
        "word": "楽しい"
      }
    ],
    [
      {
        "text": "弟弟還小，所以我一邊小心處理火，一邊陪他一起玩。",
        "word": "付ける"
      }
    ],
    [
      {
        "text": "最後我特地多買了一個大煙火留著，所以那個我們兩人可以特別一起看。",
        "word": "できる"
      }
    ],
    [
      {
        "text": "回去的時候，弟弟說「明年也要一起放喔」，",
        "word": "言う"
      },
      {
        "text": "讓我很開心。",
        "word": "うれしい"
      }
    ]
  ],
