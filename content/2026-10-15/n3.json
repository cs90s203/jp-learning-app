    [ { "text": "即便如此，老師總是說「年齡沒關係」來鼓勵我。", "word": "励ます" } ],
    [ { "text": "每次練習都感覺身體漸漸變得柔軟，", "word": "柔らかい" }, { "text": "覺得能堅持下來真好。", "word": "続ける" } ],
