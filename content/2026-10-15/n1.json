  "translations": [
    [ { "text": "圍繞退休制度重新檢視的討論，", "word": "見直し" }, { "text": "在各方面逐漸熱烈起來。", "word": "活発化する" } ],
    [ { "text": "在少子高齡化導致勞動力人口減少之際，", "word": "少子高齢化" }, { "text": "讓有意願、有能力的高齡者能長期工作，被認為有助於提高社會保障制度的永續性，這樣的看法頗為強烈。", "word": "持続可能性" } ],
    [ { "text": "事實上，企業界也出現將退休年齡從六十五歲延長到七十歲的動向，", "word": "延長する" }, { "text": "甚至有不限年齡、持續雇用有意願者的制度被引進。", "word": "雇用する" } ],
    [ { "text": "然而，對這樣的動向，也有不少謹慎的聲音。", "word": "慎重" } ],
    [ { "text": "隨著體力衰退或有健康限制的高齡勞工增加，", "word": "高齢労働者" }, { "text": "有人指出職場上的安全管理與業務的重新設計已是不得不進行的事。", "word": "余儀なくされる" } ],
    [ { "text": "此外，也有人根深蒂固地擔憂，年輕世代的雇用機會可能因高齡者的持續雇用而受到壓迫，", "word": "圧迫する" }, { "text": "世代之間該如何確保公平性也備受質疑。", "word": "公平性" } ],
    [ { "text": "也有人認為應該廢除退休這種一律的界線，轉換成能依照個人能力與意願選擇工作方式的機制；", "word": "転換する" }, { "text": "但考慮到制度設計的複雜性，也有不少謹慎論者認為應避免草率的改革。", "word": "改革" } ]
  ],
