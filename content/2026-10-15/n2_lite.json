  "translations": [
    [ { "text": "近年，透過智慧型手機應用程式點餐的外送服務快速普及。", "word": "フードデリバリーサービス" } ],
    [ { "text": "對忙碌的公司職員和獨居的學生來說，", "word": "一人暮らし" }, { "text": "不用外出就能享用喜歡的店家料理，是很大的魅力。", "word": "魅力" } ],
    [ { "text": "以往提到外送，大多僅限於壽司、蕎麥麵等部分店家，", "word": "出前" }, { "text": "但現在幾乎各種類型的料理都成為外送的對象。", "word": "ジャンル" } ],
    [ { "text": "另一方面，外送員的勞動條件與安全方面的課題也被提出，", "word": "課題" }, { "text": "各公司都被迫做出應對。", "word": "対応" } ],
    [ { "text": "此外，也有人擔心包裝造成垃圾增加，", "word": "増加" }, { "text": "因此環保容器的開發也在進行中。", "word": "開発" } ],
    [ { "text": "如何兼顧便利性與社會課題，", "word": "両立する" }, { "text": "將是今後外送服務普及的關鍵。", "word": "鍵" } ]
  ],
