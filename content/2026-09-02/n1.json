  "translations": [
    [ { "text": "過去，日本企業大多在就業規則中原則禁止員工從事副業。", "word": "就業規則" } ],
    [ { "text": "然而近年，隨著工作方式改革的推進，解禁副業的企業穩健增加。", "word": "相まる" } ],
    [ { "text": "背景在於，如今終身僱用已不再是理所當然，人們對於將人生完全託付給單一公司這件事感到不安。", "word": "終身雇用" } ],
    [ { "text": "話雖如此，也有不少經營者擔心本業可能因此而被疏忽。", "word": "おろそか" } ],
    [ { "text": "實際上，似乎也有人因為貿然嘗試不熟悉的副業，反而導致本業出錯增加的例子。", "word": "ばかりに" } ],
    [ { "text": "即使如此，在優秀人才不乏外部邀約的這個時代，堅持禁止副業的立場，反而可能招致人才流失。", "word": "事欠く" } ],
    [ { "text": "對企業而言，理應建立一個讓每位員工都能依循自己的職涯觀選擇工作方式的環境。", "word": "しかるべき" } ],
    [ { "text": "無需討論副業解禁的是非對錯，工作方式的多樣化恐怕已經到了無法阻擋的地步了。", "word": "多様化" } ]
