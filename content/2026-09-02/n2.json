  "translations": [
    [ { "text": "近年，全國各地的車站前，出現越來越多由當地農家與商店擺攤的「早市」活動。", "word": "朝市" } ],
    [ { "text": "過去只是在商店街一角小規模舉辦，但最近因口耳相傳的好評，從遠方前來的人也不少。", "word": "口コミ" } ],
    [ { "text": "舉辦的背景是，因大型超市進駐而減少的個體商店營業額，想以某種方式彌補回來的緣故。", "word": "減少する" } ],
    [ { "text": "實際上，不少農家表示自從在早市擺攤後，常客也增加了。", "word": "常連客" } ],
    [ { "text": "另一方面，清晨的準備工作以及因天氣而取消等，攤商的負擔絕不算小。", "word": "負担" } ],
    [ { "text": "即使如此，作為找回人與人之間連結的場所，早市的角色今後應該會變得更加重要。", "word": "役割" } ]
  ],
