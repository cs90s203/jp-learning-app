  "translations": [
    [ { "text": "開始學弓道，是因為去年秋天在祭典上看到演武，成了契機。", "word": "きっかけ" } ],
    [ { "text": "拉弓的身影很美，一瞬間就讓我著迷了。", "word": "奪う" } ],
    [ { "text": "剛開始弓很重，拿到手臂都在顫抖。", "word": "重い" } ],
    [ { "text": "於是我找了道場，立刻就入門了。", "word": "入門する" } ],
    [ { "text": "一開始光是記住動作型式就已經竭盡全力，但老師對我說「別急，慢慢調整呼吸」之後，漸漸能夠射中箭靶了。", "word": "言う" } ],
    [ { "text": "箭命中箭靶那一瞬間的寧靜喜悅，是我覺得其他運動無法體會到的。", "word": "味わう" } ],
    [ { "text": "接下來也想長久地繼續下去。", "word": "続ける" } ]
