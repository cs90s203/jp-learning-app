  "translations": [
    [ { "text": "最近，只要用智慧型手機就能輕鬆買賣的二手交易App使用者正快速增加。", "word": "急増する" } ],
    [ { "text": "尤其是以年輕世代為中心，在App上輕鬆交換不需要物品的文化逐漸普及。", "word": "広がる" } ],
    [ { "text": "據說有越來越多人不丟棄不需要的衣服或家電，而是選擇上架出售，這也有助於減少垃圾。", "word": "つながる" } ],
    [ { "text": "另一方面，也有不少聲音反映商品狀態引發的糾紛，以及對個人資訊管理的不安。", "word": "訴える" } ],
    [ { "text": "也有人指出，對高齡者來說操作比較困難。", "word": "指摘" } ],
    [ { "text": "儘管如此，由於便利性和環保意識的提升，預料今後使用者會持續擴大。", "word": "拡大する" } ]
