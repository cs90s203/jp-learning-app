  "translations": [
    [ { "text": "昨晚，我和媽媽去公園觀星了。", "word": "星空観察" } ],
    [ { "text": "因為忘了帶望遠鏡，所以用手機的App查星座，還找流星。", "word": "忘れる" } ],
    [ { "text": "空氣很清澄，連銀河也能看得很清楚。", "word": "できる" } ],
