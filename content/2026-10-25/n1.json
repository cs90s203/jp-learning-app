  "translations": [
    [ { "text": "為溫室氣體的排放定價，以經濟手段促使減少排放的碳定價制度，其導入問題在各國引發激烈討論。", "word": "カーボンプライシング" } ],
    [ { "text": "依制度設計的不同，大致可分為像碳稅一樣依排放量課稅的方式，和像排放量交易制度一樣透過市場決定價格的方式，但無論哪一種，都勢必會招致產業界的反對。", "word": "招く" } ],
    [ { "text": "推動派主張，正因為有價格這個明確的指標，企業才能邁出減排投資的步伐，為了提高氣候變遷對策的實效性，引進此制度是不可或缺的。", "word": "踏み出す" } ],
    [ { "text": "另一方面，以高耗能產業為中心，擔心國際競爭力下降、生產基地被迫遷往海外的疑慮根深蒂固；若在沒有充分緩和措施的情況下引進制度，也有人指出反而可能讓整體經濟萎縮。", "word": "余儀なくされる" } ],
    [ { "text": "此外，由於碳價格上升容易直接反映在電費與物價上，低收入階層的負擔往往會變得更重，這種公平性問題，也成為制度設計上無法迴避的議題。", "word": "反映する" } ],
    [ { "text": "考量到這種複雜利害關係相互交織的狀況，與其單純討論要不要引進，更應該連負擔的分配方式與階段性的導入時程都納入考量，做出細緻周到的制度設計才是真正被需要的。", "word": "求める" } ]
  ],
