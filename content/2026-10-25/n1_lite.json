  "translations": [
    [ { "text": "支撐日本各地山林的林業從業人員不足，已成為嚴重的社會課題浮現出來。", "word": "浮上する" } ],
    [ { "text": "由於高齡化，退出現場的人接連不斷，另一方面年輕的新進就業人數卻沒有相應增加，接班人的確保依然處於嚴峻的狀況。", "word": "依然として" } ],
    [ { "text": "尤其在人口過疏化加劇的地區，接班人不足可能直接導致地區經濟的衰退。", "word": "直結する" } ],
    [ { "text": "工作的危險性和收入的不穩定被視為年輕人不選擇這一行的原因之一，機械化與自動化帶來的勞動環境改善被指出是當務之急。", "word": "指摘する" } ],
    [ { "text": "這樣的人力不足，招致間伐、植林等森林管理的停滯，提高土石流災害風險的擔憂也日益增強。", "word": "強まる" } ],
    [ { "text": "行政機關和行業團體正透過充實研習制度、移居支援措施等方式謀求促進新人加入，但要見到效果似乎仍需要時間。", "word": "図る" } ]
