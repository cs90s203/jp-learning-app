  "translations": [
    [ { "text": "上週六，和哥哥一起去爬了一直想去的附近那座山。", "word": "登る" } ],
    [ { "text": "早上雖然有點冷，但走著走著身體就暖了起來。", "word": "温まる" } ],
    [ { "text": "途中邊拍照、邊休息，慢慢地往上爬。", "word": "休む" } ],
    [ { "text": "山頂的風景很美，連疲勞都忘了。", "word": "忘れる" } ],
    [ { "text": "哥哥說「明年要去更高的山」，讓我開始期待明年了。", "word": "言う" } ]
