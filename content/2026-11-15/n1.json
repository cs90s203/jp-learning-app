  "translations": [
    [ { "text": "隨著少子高齡化的進展，對年金財政前景的不安逐年增強，年金制度改革的議論在國會日益熾熱。", "word": "相まる" } ],
    [ { "text": "若維持現行制度，現役世代的負擔將加重，另一方面，未來世代能領取的年金金額恐將縮水的指摘也接連出現。", "word": "目減りする" } ],
    [ { "text": "政府正探討提高開始支領年齡、重新檢討保費負擔，但對生活仰賴年金的高齡者而言，給付金額的削減是絕對無法接受的，可能招致世代間的對立。", "word": "受け入れる" } ],
    [ { "text": "另一方面，若持續擱置改革，制度本身的持續性將會動搖，長遠來看也有可能把更大的負擔強加給下一代，這樣的擔憂依然根深蒂固。", "word": "揺らぐ" } ],
    [ { "text": "專家之間普遍認為，這不僅僅是數字上的調整，更被迫轉向考量工作方式與家庭形態變化的制度設計。", "word": "余儀なくする" } ],
    [ { "text": "該如何建立一個足以讓所有人都能安心度過晚年的社會制度，跨世代的共識形成已成為當務之急。", "word": "足る" } ]
  ],
