  "translations": [
    [ { "text": "以疫情為契機，考慮從城市搬到地方的人增加了。", "word": "きっかけ" } ],
    [ { "text": "隨著遠距工作的普及，變得不受地點限制也能工作，可以說是推動了這股潮流。", "word": "伴う" } ],
    [ { "text": "地方政府雖然也透過住宅補助、就業支援等制度努力吸引移居者，但有些地區工作選擇有限，不少人因理想與現實的差距而苦惱。", "word": "悩む" } ],
    [ { "text": "儘管如此，因為想在被自然環繞的環境中養育孩子，決定移居的家庭也逐漸增加。", "word": "決断する" } ],
    [ { "text": "另一方面，也不能忽視有人無法融入當地社群、始終懷抱孤獨感生活的情況。", "word": "見逃す" } ],
    [ { "text": "政府被要求建立能支撐移居後生活的機制。", "word": "求める" } ]
  ],
