  "translations": [
    [ { "text": "近年來，在超市和便利商店等地方，導入自助結帳的店家正在增加。", "word": "セルフレジ" } ],
    [ { "text": "以往的收銀台是由店員負責結帳，而自助結帳則是由顧客自己掃描商品的條碼並完成付款。", "word": "読み取る" } ],
