  "translations": [
    [ { "text": "最近開始嘗試上皮拉提斯課。", "word": "ピラティス" } ],
    [ { "text": "因為要邊意識身體的軸心邊活動，感覺比想像中更用到肌肉。", "word": "意識する" } ],
    [ { "text": "一開始動作做得不太好，有點不好意思，不過老師仔細地教我，慢慢就會做了。", "word": "教える" } ],
