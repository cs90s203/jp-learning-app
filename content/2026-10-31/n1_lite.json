  "translations": [
    [ { "text": "近年，飼養寵物的家庭增加，但另一方面，地方的獸醫師不足已成為嚴重的問題。", "word": "獣医師" } ],
    [ { "text": "由於動物醫院和工作機會都集中在城市地區，地方的醫院往往一位獸醫師得負責廣大的範圍，不得不如此，看診常常要花很長時間。", "word": "カバーする" } ],
    [ { "text": "此外，能診治大型動物的獸醫師特別減少，也讓人擔心會影響畜牧業。", "word": "減少する" } ],
    [ { "text": "背後據說存在長時間勞動和待遇偏低等問題，也有人指出，若不改善待遇，確保人才將很困難。", "word": "待遇改善" } ],
    [ { "text": "再者，獸醫學系的招生名額雖然在增加，但畢業後選擇城市醫院的學生較多，實際上並未落實到地方扎根，這是目前的現狀。", "word": "現状" } ],
    [ { "text": "考量到這樣的狀況，政府和地方自治團體有必要擴充支援政策，並提升在地方工作的吸引力。", "word": "支援策" } ]
