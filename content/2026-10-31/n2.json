  "translations": [
    [ { "text": "在災害頻發的日本，為提高防災意識而成立的市民志工活動正在各地擴展開來。", "word": "市民ボランティア活動" } ],
    [ { "text": "許多團體是以一場大地震為契機而開始活動的，他們承擔著彌補行政機關人手不足之處的角色，例如協助避難所的運營和物資的分類。", "word": "きっかけ" } ],
    [ { "text": "儘管參加者大多是公司職員或學生，他們仍利用假日參加訓練，可見其對防災的關注程度之高。", "word": "にもかかわらず" } ],
    [ { "text": "不過，要長期持續這樣的活動，資金與人才的確保也確實是一項課題，因此也出現了透過與地方政府合作來建置相關體制的動向。", "word": "通じる" } ],
    [ { "text": "今後，為了讓更多人了解這樣的活動，相關的資訊發布也將變得十分重要。", "word": "情報発信" } ]
  ],
