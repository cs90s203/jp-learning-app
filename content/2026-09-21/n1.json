  "translations": [
    [ { "text": "近年，國政選舉的投票率持續下滑，成為象徵政治關注度減退的現象，引發議論。", "word": "投票率" } ],
    [ { "text": "根據總務省的發表，最近一次眾議院選舉的投票率已接近戰後最低水準，等於每三位選民中就有一人沒有前往投票所投票。", "word": "投票所" } ],
    [ { "text": "這背後除了以年輕世代為中心的政治不信任之外，也可歸因於少子高齡化與選民整體高齡化相互結合所導致。", "word": "少子高齢化" } ],
    [ { "text": "不過，也有人指出，把投票率下降單純歸咎於年輕人政治意識的缺乏未免過於草率，候選人與政策缺乏吸引力、投票制度本身使用不便等結構性因素也不應被忽視。", "word": "きらい" } ],
    [ { "text": "事實上，也有在提前投票制度擴充後投票率一度回升的例子，制度設計如何能改變選民的行為，這是不言而喻的。", "word": "言う" } ],
    [ { "text": "今後恐怕不只是呼籲投票而已，重新檢討整個選舉制度的討論將無可避免。", "word": "避ける" } ]
