  "translations": [
    [ { "text": "為經濟因素而無法充分獲得飲食的孩子們，提供免費或低價餐點的「兒童食堂」，正在全國各地擴展開來。", "word": "こども食堂" } ],
    [ { "text": "營運的核心是當地居民志工，儘管資金與食材大多仰賴捐贈，舉辦次數增加的團體仍絡繹不絕。", "word": "にもかかわらず" } ],
    [ { "text": "背後原因據說是，伴隨雙薪家庭的增加，家人一起圍著餐桌吃飯的機會正在減少。", "word": "伴う" } ],
    [ { "text": "這不僅止於飲食援助，還發揮著孩子容身之處的作用，這一點也不容忽視。", "word": "とどまる" } ],
    [ { "text": "不過，營運者高齡化與人手不足等課題依然存在，如何打造可持續的機制備受期待。", "word": "持続可能" } ]
  ],
