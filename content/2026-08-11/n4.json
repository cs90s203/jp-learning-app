    [ { "text": "星期天去祖父家玩，他教了我下將棋。", "word": "教える" } ],
    [ { "text": "因為規則很難，一開始完全贏不了。", "word": "難しい" } ],
    [ { "text": "祖父雖然很溫柔，但一比賽就會變得一臉認真。", "word": "のに" } ],
