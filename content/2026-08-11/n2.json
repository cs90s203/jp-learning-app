  "translations": [
    [ { "text": "以免費或低價方式為地區孩童提供餐點的「兒童食堂」，正在全國各地擴展開來。", "word": "子ども食堂" } ],
    [ { "text": "背景在於，雙薪家庭增加，以及因經濟因素而無法獲得充足飲食的孩子並不在少數這一現實。", "word": "現実" } ],
    [ { "text": "起初容易被強調成貧困對策的一面，但實際上，透過兒童食堂讓多樣世代交流的場所這一功能也逐漸受到關注。", "word": "交流する" } ],
    [ { "text": "承擔營運的多半是當地居民或退休後的志工，也有不少團體正為資金與人力不足所苦。", "word": "悩む" } ],
    [ { "text": "話雖如此，也有聲音認為，這裡不僅是孩子，對高齡者與獨居住民而言也成了容身之處，因此今後仍需要行政單位完善支援體制。", "word": "居場所" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜を通じて／〜を通して", "note": "「透過〜」，媒介或期間" }
  ]
}
