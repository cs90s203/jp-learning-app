  "translations": [
    [ { "text": "開始學陶藝的契機，是朋友送我的一個碗。", "word": "きっかけ" } ],
    [ { "text": "那手工製作、略微歪斜的形狀莫名讓人感到溫暖，於是開始想著「自己也想試著做做看」。", "word": "温かい" } ],
    [ { "text": "開始去教室上課後才發現，施力的方式比想像中困難，一開始好幾次連像樣的形狀都做不出來。", "word": "難しい" } ],
    [ { "text": "即便如此，接觸黏土的時間卻不可思議地讓心平靜下來，也讓人忘卻日常的疲憊。", "word": "落ち着く" } ],
    [ { "text": "完成的器皿每一個都有些歪斜，但漸漸覺得，那份歪斜正是屬於自己的特色。", "word": "いびつ" } ],
    [ { "text": "現在，思考接下來要做什麼的時間，成了最大的樂趣。", "word": "楽しみ" } ]
  ],
