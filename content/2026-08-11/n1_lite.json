  "translations": [
    [ { "text": "年輕人對政治疏離已被談論許久，據指出這背後交織著多種原因。", "word": "政治離れ" } ],
    [ { "text": "首先，政治人物的主張讓人覺得與自己的生活實感相差甚遠，因而根深蒂固地存在著「投票也不會改變什麼」的放棄心理。", "word": "諦め" } ],
    [ { "text": "此外，學校教育中缺乏能自由討論政治的機會，導致難以切身感受到政治參與的意義，這種結構性問題也不容忽視。", "word": "見過ごす" } ],
