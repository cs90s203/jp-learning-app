  "translations": [
    [ { "text": "近年，利用智慧型手機或電腦即可接受醫師診察的線上診療正急速普及。", "word": "オンライン診療" } ],
    [ { "text": "除了能省去就診所需的時間與交通費之外，身體不適時不必外出即可看診這一點也受到使用者支持。", "word": "省く" } ],
    [ { "text": "特別是對育兒中的家庭或居住在地方的患者來說，就診的負擔能大幅減輕，這是一大優點。", "word": "軽減する" } ],
    [ { "text": "另一方面，也有一些症狀若非面對面診察就難以察覺，因此仍有不少醫療機構建議初診盡量採面對面看診。", "word": "気づく" } ],
    [ { "text": "今後，如何巧妙結合面對面診療與線上診療，被認為將成為一大課題。", "word": "組み合わせる" } ]
