  "translations": [
    [ { "text": "在兒童貧困與高齡者獨自用餐等問題受到社會關注之際，讓任何人都能輕鬆造訪的社區食堂正在全國各地擴展開來。", "word": "地域食堂" } ],
    [ { "text": "大多數的營運是透過當地居民的人際網絡來支撐，不以營利為目的是其特色。", "word": "通じる" } ],
    [ { "text": "隨著少子高齡化，獨居老人不斷增加，對使用者而言，不僅能以便宜的價格吃到溫暖的餐點，也成為能與其他世代交流的珍貴場所。", "word": "伴う" } ],
    [ { "text": "不過，也有人指出營運資金的確保、承辦人員高齡化等課題，並認為若沒有政府的支援，活動也難以持續。", "word": "支援" } ],
    [ { "text": "即使如此，正因為地區之間的連結正逐漸淡化，這類食堂的存在意義今後才會愈發重要。", "word": "存在意義" } ]
  ],
