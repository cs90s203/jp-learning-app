  "translations": [
    [ { "text": "近年，以人口稀少地區與離島為中心，導入無人機配送服務的情況正在增加。", "word": "ドローン" } ],
    [ { "text": "以往，將貨物送到山區不僅耗時，配送員的負擔也很大。", "word": "かかる" } ],
    [ { "text": "但是，若使用無人機就不受路況影響，能在短時間內把貨物送達。", "word": "届ける" } ],
    [ { "text": "隨著實證實驗的累積，天候造成的飛航限制、墜落風險等課題也正逐漸被解決。", "word": "解決する" } ],
    [ { "text": "另一方面，也出現了侵犯隱私、噪音等新的疑慮聲浪。", "word": "懸念" } ],
    [ { "text": "未來，這種配送手段預期也將在都市地區作為日常方式之一逐漸普及。", "word": "定着する" } ]
