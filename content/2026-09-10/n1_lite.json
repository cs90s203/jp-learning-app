  "translations": [
    [ { "text": "隨著高齡化的發展，需要照護的人數逐年增加，另一方面，支撐照護現場的人力不足問題也日益嚴重。", "word": "人材" } ],
    [ { "text": "由於薪資水準偏低、業務負擔沉重，離職的職員絡繹不絕，新進人力的確保也難以如願，這就是現狀。", "word": "離職する" } ],
    [ { "text": "尤其在地方，年輕族群外流的問題也疊加在一起，使人力不足的情況更加顯著。", "word": "流出" } ],
