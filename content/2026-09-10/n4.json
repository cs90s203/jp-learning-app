  "translations": [
    [ { "text": "今天，我和媽媽一起第一次做了麵包。", "word": "パン" } ],
    [ { "text": "首先，把麵粉、牛奶和砂糖混合在一起，充分揉勻。", "word": "混ぜる" } ],
    [ { "text": "把麵團揉到變軟，再讓它休息一下。", "word": "こねる" } ],
    [ { "text": "用烤箱烤的時候，整個房間都飄著香味。", "word": "匂い" } ],
    [ { "text": "因為有時間，形狀也能隨自己喜好做。", "word": "できる" } ],
    [ { "text": "烤好的麵包非常好吃，全家人都開心地吃了。", "word": "美味しい" } ]
  ],
