  "translations": [
    [ { "text": "以疫情為契機而急速普及的遠距工作，今後是否應該作為標準的工作方式固定下來，這樣的議論仍在持續。", "word": "リモートワーク" } ],
    [ { "text": "推動派主張，通勤時間的減少與居住地自由度的提升，不僅能提升員工的生活品質，對企業而言，也有壓縮辦公室租金、確保居住在地方的優秀人才等優點。", "word": "主張する" } ],
    [ { "text": "對此，謹慎派則擔憂，面對面交流的減少可能導致團隊內默會知識的共享與新人培育停滯，而在成果難以量化的業務中，要確保評價的公平性也會變得困難，這點令人不得不感到憂心。", "word": "懸念する" } ],
    [ { "text": "此外，也有人指出，在家工作導致工作與私人生活的界線變得模糊，反而可能助長長時間勞動。", "word": "助長する" } ],
    [ { "text": "雙方的主張各有一定道理，要一概而論地判斷誰對誰錯並不容易。", "word": "主張" } ],
    [ { "text": "今後，應當摸索一種依職種與業務內容彈性搭配到公司上班與遠距工作的混合型工作方式。", "word": "望む" } ]
