  "translations": [
    [ { "text": "過去在日本許多企業裡，依照就業規則，副業原則上是被禁止的。", "word": "就業規則" } ],
    [ { "text": "但是隨著人力不足以及個人對收入來源多樣化的關注升高，解除副業禁令的企業正在增加。", "word": "解禁する" } ],
    [ { "text": "政府也將副業、兼業的推廣列為工作方式改革的一環，甚至從標準就業規則範本中刪除了禁止規定。", "word": "推進する" } ],
    [ { "text": "不過，擔心資訊外洩或過度勞動風險的聲音依然根深蒂固，也有不少企業無法下定決心解禁。", "word": "根強い" } ],
    [ { "text": "即使實際上允許副業，關於該如何管理勞動時間這個課題，也並不代表已經解決。", "word": "わけではない" } ],
    [ { "text": "綜合這樣的狀況來看，企業除了完善制度之外，也被要求打造讓員工能安心投入副業的環境。", "word": "求める" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜に伴って", "note": "「伴隨〜」，同步變化" }
  ]
}
