  "translations": [
    [ { "text": "祖母曾經是插花老師，或許也受到這個影響，我從小就對花有種親近感。", "word": "生け花" } ],
    [ { "text": "但是以忙碌為理由，一直沒有勇氣把插花當作一項才藝正式開始學。", "word": "習い事" } ],
    [ { "text": "轉機是去年祖母的身體出了狀況。", "word": "転機" } ],
    [ { "text": "「趁我還健康的時候，也想讓你知道花的樂趣」，被這麼一說，就以這句話為契機開始去教室上課。", "word": "きっかけ" } ],
    [ { "text": "一開始光是記住基本的形式就竭盡全力，但持續練習後，也漸漸懂得挑選當季花卉的樂趣。", "word": "楽しみ" } ],
    [ { "text": "現在每個月一次的插花課，成了忙碌日子裡整理心情的時間。", "word": "整える" } ]
  ],
