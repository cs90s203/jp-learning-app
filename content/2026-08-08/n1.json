  "translations": [
    [ { "text": "圍繞大學入學考試應有的樣貌，至今已經歷過無數次改革討論，而近年隨著生成式AI的急速普及，傳統偏重知識的考試本身的意義正被重新檢視。", "word": "生成AI" } ],
    [ { "text": "傳統的入學考試，向來有偏重「能否在有限時間內準確再現知識」這種能力的傾向，然而如今檢索與編輯資訊的能力已容易被取代，僅憑這樣的評量標準恐怕不足以衡量真正必要的學力，這樣的指摘接連出現。", "word": "再現できる" } ],
    [ { "text": "不過，一方面有人主張應轉向重視思考力與表達力的多面向評量，另一方面如何確保評分的客觀性與公平性，也是不可忽視的課題。", "word": "客観性" } ],
    [ { "text": "尤其是面試或小論文這類評量方式，容易受評分者主觀影響，也讓人擔心恐怕反而會加劇因地區或家庭環境造成的教育落差，這樣的疑慮依然根深蒂固。", "word": "左右する" } ],
    [ { "text": "面對這樣的狀況，不陷入單純的二元對立，一邊組合多元的評量尺度一邊推進制度設計的態度，才是真正被需要的。", "word": "評価尺度" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜きらいがある", "note": "有〜的傾向（負面）" }
  ]
