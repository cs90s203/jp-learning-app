  "translations": [
    [ { "text": "學生時代很不擅長運動，對於活動身體這件事一直有排斥感。", "word": "苦手" } ],
    [ { "text": "這樣的我最近開始攀岩的契機，是朋友的邀約。", "word": "きっかけ" } ],
    [ { "text": "一開始原本打算拒絕，但體驗一次後意外地有趣，不知不覺每月都會去好幾次。", "word": "楽しい" } ],
    [ { "text": "挑戰了好幾次都爬不上去的岩壁，終於爬上去時的成就感，是任何事都無法取代的。", "word": "達成感" } ],
    [ { "text": "從今以後也想按自己的節奏，不勉強地繼續下去。", "word": "続ける" } ],
    [ { "text": "不跟別人比較，只要能比昨天的自己更熟練一點，就覺得足夠了。", "word": "上手" } ]
