  "translations": [
    [ { "text": "圍繞著讓夫婦在結婚時各自保留原本姓氏的所謂選擇性夫婦別姓制度是否導入，這場議論已經持續多年。", "word": "議論" } ],
    [ { "text": "現行民法以夫婦同姓為原則，長期以來一直存在著對改姓所帶來的職業上不利，以及身分認同喪失感的根深蒂固的訴求。", "word": "不利益" } ],
    [ { "text": "從主張推動這項制度的立場來看，這只是增加了是否改姓的選項，批評認為會損害家庭凝聚力的說法並不一定正確。", "word": "選択肢" } ],
    [ { "text": "另一方面，從謹慎的立場來看，有人擔憂親子或夫婦姓氏不同可能影響孩子的心理層面，也有人指出這與戶籍制度整合性相關的技術性課題，認為應避免倉促變更制度的聲音依然根深蒂固。", "word": "懸念" } ],
    [ { "text": "在國會中，議員之間的贊成與反對也意見分歧，尚未達成共識，這是目前的現狀。", "word": "合意形成" } ],
    [ { "text": "隨著少子化與女性進入職場的趨勢持續，這個議題今後勢必仍會持續引起社會關注。", "word": "社会的関心" } ]
  ],
