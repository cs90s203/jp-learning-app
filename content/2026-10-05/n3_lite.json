  "translations": [
    [
      {
        "text": "最近開始試著寫俳句。",
        "word": "始める"
      }
    ],
    [
      {
        "text": "用五・七・五的十七個音來表現季節，很有趣，整個人完全沉迷其中。",
        "word": "はまる"
      }
    ],
    [
      {
        "text": "一開始要刪減字詞很困難，改寫了好幾次。",
        "word": "難しい"
      }
    ],
    [
      {
        "text": "不過，能用很少的字詞傳達出情景的時候，會有一點小小的成就感。",
        "word": "達成感"
      }
    ],
    [
      {
        "text": "記季語的同時，還不太擅長把字數控制在十七音以內。",
        "word": "苦手"
      }
    ],
    [
      {
        "text": "試著參加了前輩的句會，大家的想法完全不一樣，讓我學到了很多。",
        "word": "勉強"
      }
    ],
    [
      {
        "text": "我決定今後也繼續寫下去。",
        "word": "続ける"
      }
    ]
  ],
