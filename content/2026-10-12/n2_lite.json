":"とともに","reading":"とともに","pos":"助詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"誰","basic_form":"誰","reading":"だれ","pos":"代名詞"},{"surface_form":"にとって","basic_form":"にとって","reading":"にとって","pos":"助詞"},{"surface_form":"も","basic_form":"も","reading":"も","pos":"助詞"},{"surface_form":"便利な","basic_form":"便利","reading":"べんりな","pos":"形容詞"},{"surface_form":"支払い方法","basic_form":"支払い方法","reading":"しはらいほうほう","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"広がっていく","basic_form":"広がる","reading":"ひろがっていく","pos":"動詞"},{"surface_form":"こと","basic_form":"こと","reading":"こと","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"期待される","basic_form":"期待する","reading":"きたいされる","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"近年":{"meaning":"近年"},"キャッシュレス決済":{"meaning":"無現金支付"},"急速に":{"meaning":"快速地"},"普及する":{"meaning":"普及"},"スマートフォン":{"meaning":"智慧型手機"},"アプリ":{"meaning":"應用程式"},"カード":{"meaning":"卡片"},"支払い":{"meaning":"支付"},"できる":{"meaning":"能夠、可以"},"現金":{"meaning":"現金"},"持ち歩く":{"meaning":"隨身攜帶"},"必要":{"meaning":"必要、需要"},"なくなる":{"meaning":"變得不需要、消失"},"人":{"meaning":"人"},"多い":{"meaning":"多的"},"特に":{"meaning":"特別"},"都市部":{"meaning":"都市地區"},"ほとんど":{"meaning":"幾乎、大部分"},"店":{"meaning":"店家"},"対応する":{"meaning":"應對、支援"},"のみ":{"meaning":"僅、只"},"むしろ":{"meaning":"反而、倒不如說"},"少数派":{"meaning":"少數派"},"なる":{"meaning":"變成"},"高齢者":{"meaning":"高齢者"},"中心":{"meaning":"中心"},"操作":{"meaning":"操作"},"不安":{"meaning":"不安、擔心"},"感じる":{"meaning":"感覺到"},"少ない":{"meaning":"少的"},"普及率":{"meaning":"普及率"},"地域":{"meaning":"地區"},"世代":{"meaning":"世代"},"差":{"meaning":"差異"},"見る":{"meaning":"看、顯現"},"今後":{"meaning":"今後"},"使いやすい":{"meaning":"方便使用的"},"システム":{"meaning":"系統"},"開発":{"meaning":"開發"},"誰":{"meaning":"誰、任何人"},"便利":{"meaning":"方便"},"支払い方法":{"meaning":"支付方式"},"広がる":{"meaning":"擴大、普及"},"こと":{"meaning":"事情（形式名詞）"},"期待する":{"meaning":"期待"}},"particles":{"が":"標示句子的主語","の":"表示所屬關係，或名詞修飾名詞","や":"列舉部分事物，「〜和〜等」","で":"表示方法/手段，或動作發生的場所","ため":"「因為〜」，表示原因或目的","を":"標示動作的受詞","という":"「叫做〜」，用於引用名稱或說法","も":"「也」，取代が/を，但と、で等助詞會保留","において":"「在〜方面」，書面語","は":"主題標記","に":"表示到達點、對象，或結果","一方で":"「另一方面」，表示對比","によって":"「依據〜」／「因〜而異」","とともに":"「隨著〜」／「與〜一起」","にとって":"「對〜來說」，立場觀點"},"translations":[[{"text":"近年，無現金支付正快速普及。","word":"普及する"}],[{"text":"因為可以用手機應用程式或卡片支付，很多人變得不再需要隨身帶現金。","word":"必要"}],[{"text":"尤其在都市地區，大部分店家都支援無現金支付，只收現金的店反而成了少數。","word":"少数派"}],[{"text":"另一方面，也有不少以高齡者為主的人對操作感到不安，普及率因地區和世代而有差異。","word":"不安"}],[{"text":"今後隨著更好用系統的開發，希望能普及一種對任何人都方便的支付方式。","word":"期待する"}]],"grammar_notes":[]}