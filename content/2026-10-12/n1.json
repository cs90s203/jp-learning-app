m":"設計","reading":"せっけい","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"模索する","basic_form":"模索する","reading":"もさくする","pos":"動詞"},{"surface_form":"必要","basic_form":"必要","reading":"ひつよう","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"ある","basic_form":"ある","reading":"ある","pos":"動詞"},{"surface_form":"だろう","basic_form":"だろう","reading":"だろう","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"働き方":{"meaning":"工作方式"},"多様化":{"meaning":"多樣化"},"フリーランス":{"meaning":"自由工作者"},"働く":{"meaning":"工作"},"人":{"meaning":"人"},"年々":{"meaning":"逐年"},"増加する":{"meaning":"增加"},"その":{"meaning":"那個"},"多く":{"meaning":"大多數"},"企業":{"meaning":"企業"},"雇用する":{"meaning":"雇用"},"労働者":{"meaning":"勞工"},"同等":{"meaning":"同等"},"社会保障":{"meaning":"社會保障"},"受ける":{"meaning":"接受、獲得"},"実情":{"meaning":"實際情況"},"病気":{"meaning":"疾病"},"事故":{"meaning":"事故"},"際":{"meaning":"……的時候"},"収入":{"meaning":"收入"},"途絶える":{"meaning":"中斷"},"リスク":{"meaning":"風險"},"一身に":{"meaning":"獨自一人（承擔）"},"負う":{"meaning":"承擔、背負"},"セーフティネット":{"meaning":"安全網"},"薄さ":{"meaning":"薄弱（程度）"},"看過する":{"meaning":"忽視、放過"},"問題":{"meaning":"問題"},"言う":{"meaning":"說"},"制度設計":{"meaning":"制度設計"},"あたる":{"meaning":"面臨、涉及（に当たって：在〜之際）"},"雇用形態":{"meaning":"雇用形態"},"違い":{"meaning":"差異"},"すべて":{"meaning":"全部、所有"},"公平に":{"meaning":"公平地"},"支える":{"meaning":"支撐"},"仕組み":{"meaning":"機制"},"構築する":{"meaning":"構築、建立"},"意見":{"meaning":"意見"},"根強い":{"meaning":"根深蒂固的"},"もっとも":{"meaning":"不過、話雖如此"},"保険料負担":{"meaning":"保費負擔"},"増加":{"meaning":"增加"},"事業者":{"meaning":"業者、經營者"},"経営":{"meaning":"經營"},"圧迫する":{"meaning":"壓迫、擠壓"},"可能性":{"meaning":"可能性"},"指摘する":{"meaning":"指出"},"拙速":{"meaning":"草率而求快"},"制度変更":{"meaning":"制度變更"},"むしろ":{"meaning":"反而、倒不如說"},"混乱":{"meaning":"混亂"},"招く":{"meaning":"招致、引來"},"技術革新":{"meaning":"技術革新"},"社会保障制度":{"meaning":"社會保障制度"},"見直し":{"meaning":"重新審視"},"相まって":{"meaning":"相輔相成、交互作用"},"ようやく":{"meaning":"終於"},"実効性":{"meaning":"實際效用"},"ある":{"meaning":"有、存在"},"支援策":{"meaning":"支援措施"},"整う":{"meaning":"完備、齊備"},"道半ば":{"meaning":"半途、尚未完成"},"こと":{"meaning":"事情（形式名詞）"},"否む":{"meaning":"否認"},"各国":{"meaning":"各國"},"制度":{"meaning":"制度"},"参照する":{"meaning":"參考、參照"},"日本":{"meaning":"日本"},"即する":{"meaning":"符合、契合"},"独自":{"meaning":"獨自、獨特"},"設計":{"meaning":"設計"},"模索する":{"meaning":"摸索"},"必要":{"meaning":"必要、需要"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞","とともに":"「隨著〜」／「與〜一起」","として":"「作為〜」的身分/立場","は":"主題標記","が":"標示句子的主語，或表示逆接「但是」","に":"表示對象、方面，或結果","と":"用於比較或引述內容","を":"標示動作的受詞","や":"列舉部分事物，「〜和〜等」","によって":"「依據〜」／「因〜而異」，也用於被動的動作者","いかんにかかわらず":"「不論〜如何」","という":"「叫做〜」，用於引用名稱或說法","も":"「也」，取代が/を","とはいえ":"「雖說如此」，帶有讓步語氣的逆接"},"translations":[[{"text":"隨著工作方式的多樣化，以自由工作者身分工作的人逐年增加，但其中多數人並未獲得與企業雇用勞工同等的社會保障，這是實際情況。","word":"社会保障"}],[{"text":"一旦因疾病或事故而無法工作，就不得不獨自承擔收入中斷的風險，安全網的薄弱可說是一個無法忽視的問題。","word":"負う"}],[{"text":"在制度設計上，不論雇用形態的差異如何，都應該建立公平支撐所有勞動者的機制，這樣的意見根深蒂固。","word":"いかんにかかわらず"}],[{"text":"不過，也有人指出保費負擔的增加可能會壓迫業者的經營，草率的制度變更反而可能招致混亂。","word":"圧迫する"}],[{"text":"技術革新與社會保障制度的重新審視相輔相成，雖然具實際效用的支援措施終於逐漸完備，但仍處於半途，這一點無法否認。","word":"相まって"}],[{"text":"一面參考各國的制度，一面摸索出符合日本實際情況的獨特設計，應該是必要的。","word":"模索する"}]],"grammar_notes":[{"sentence":2,"pattern":"〜いかんによらず／〜いかんにかかわらず","note":"「不論〜如何」"},{"sentence":4,"pattern":"〜と相まって","note":"「與〜相結合」，書面因果"}]}