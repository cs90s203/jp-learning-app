み","basic_form":"取り組み","reading":"とりくみ","pos":"名詞"},{"surface_form":"も","basic_form":"も","reading":"も","pos":"助詞"},{"surface_form":"進められている","basic_form":"進める","reading":"すすめられている","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"},{"surface_form":"今後","basic_form":"今後","reading":"こんご","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"こうした","basic_form":"こうした","reading":"こうした","pos":"連体詞"},{"surface_form":"支援","basic_form":"支援","reading":"しえん","pos":"名詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"仕組み","basic_form":"仕組み","reading":"しくみ","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"さらに","basic_form":"さらに","reading":"さらに","pos":"副詞"},{"surface_form":"充実し","basic_form":"充実する","reading":"じゅうじつし","pos":"動詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"年齢","basic_form":"年齢","reading":"ねんれい","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"問わず","basic_form":"問う","reading":"とわず","pos":"動詞"},{"surface_form":"意欲","basic_form":"意欲","reading":"いよく","pos":"名詞"},{"surface_form":"ある","basic_form":"ある","reading":"ある","pos":"動詞"},{"surface_form":"人材","basic_form":"人材","reading":"じんざい","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"活躍できる","basic_form":"活躍する","reading":"かつやくできる","pos":"動詞"},{"surface_form":"社会","basic_form":"社会","reading":"しゃかい","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"広がっていく","basic_form":"広がる","reading":"ひろがっていく","pos":"動詞"},{"surface_form":"こと","basic_form":"こと","reading":"こと","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"望まれる","basic_form":"望む","reading":"のぞまれる","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"近年":{"meaning":"近年"},"高齢化":{"meaning":"高齡化"},"進む":{"meaning":"前進、發展"},"働く":{"meaning":"工作"},"意欲":{"meaning":"意願、積極性"},"持つ":{"meaning":"擁有"},"高齢者":{"meaning":"高齡者"},"少ない":{"meaning":"少的"},"そうした":{"meaning":"那樣的"},"状況":{"meaning":"狀況"},"応じる":{"meaning":"回應、因應"},"シニア向け":{"meaning":"針對高齡者"},"就労支援":{"meaning":"就業支援"},"サービス":{"meaning":"服務"},"各地":{"meaning":"各地"},"広がり":{"meaning":"擴展、普及"},"見せる":{"meaning":"顯現、呈現"},"企業側":{"meaning":"企業方"},"人手不足":{"meaning":"人力不足"},"深刻化":{"meaning":"嚴重化"},"伴う":{"meaning":"伴隨"},"経験豊富":{"meaning":"經驗豐富"},"シニア人材":{"meaning":"高齡人才"},"活用":{"meaning":"活用"},"積極的に":{"meaning":"積極地"},"検討する":{"meaning":"檢討、考慮"},"ある":{"meaning":"有、在"},"実際":{"meaning":"實際上"},"自治体":{"meaning":"地方政府"},"紹介":{"meaning":"介紹"},"再就職":{"meaning":"再就業"},"果たす":{"meaning":"達成、實現"},"例":{"meaning":"例子"},"多い":{"meaning":"多的"},"年齢":{"meaning":"年齡"},"環境":{"meaning":"環境"},"整う":{"meaning":"完備、齊備"},"もちろん":{"meaning":"當然"},"体力的":{"meaning":"體力上的"},"制約":{"meaning":"限制"},"事実":{"meaning":"事實"},"働き方":{"meaning":"工作方式"},"工夫":{"meaning":"想辦法、巧思"},"活躍":{"meaning":"活躍"},"場":{"meaning":"場合、場域"},"広がる":{"meaning":"擴大、普及"},"研修":{"meaning":"研習、培訓"},"プログラム":{"meaning":"計畫、課程"},"マッチング":{"meaning":"媒合"},"イベント":{"meaning":"活動"},"開催する":{"meaning":"舉辦"},"企業":{"meaning":"企業"},"求職者":{"meaning":"求職者"},"つなぐ":{"meaning":"連結"},"取り組み":{"meaning":"措施、努力"},"進める":{"meaning":"推進"},"こうした":{"meaning":"這樣的"},"支援":{"meaning":"支援"},"仕組み":{"meaning":"機制"},"さらに":{"meaning":"進一步、更加"},"充実する":{"meaning":"充實"},"問う":{"meaning":"詢問、追究（問わず：不論）"},"人材":{"meaning":"人才"},"活躍する":{"meaning":"活躍"},"社会":{"meaning":"社會"},"望む":{"meaning":"期望"},"今後":{"meaning":"今後"},"こと":{"meaning":"事情（形式名詞）"}},"particles":{"が":"標示句子的主語，或表示逆接「但是」","一方で":"「另一方面」，表示對比","に":"表示對象、方面，或結果","の":"表示所屬關係，或將子句名詞化","で":"表示場所或方法","を":"標示動作的受詞","も":"「也」，取代が/を，但と、で等助詞會保留","きっかけに":"「以〜為契機」","にもかかわらず":"「儘管〜」，強逆接，較のに更書面","だ":"肯定的斷定語氣","によって":"「依據〜」／「因〜而異」，也用於被動的動作者"},"translations":[[{"text":"近年，高齡化不斷加劇，另一方面，有意願工作的高齡者也不少。","word":"高齢化"}],[{"text":"因應這樣的狀況，各地逐漸出現為高齡者設計的就業支援服務。","word":"応じる"}],[{"text":"企業方也因人力不足日益嚴重，不得不積極考慮活用經驗豐富的高齡人才。","word":"検討する"}],[{"text":"實際上，不少人以地方政府的介紹為契機成功再就業，儘管有年齡限制，只要有意願，能工作的環境正逐漸完善。","word":"果たす"}],[{"text":"當然體力上的限制確實存在，但透過工作方式的巧思，發揮所長的場域正在擴大。","word":"工夫"}],[{"text":"依地方政府不同，也有舉辦研習課程或媒合活動，推動連結企業與求職者的措施。","word":"開催する"}],[{"text":"今後希望這類支援機制能更加充實，打造一個不論年齡、只要有意願的人才都能活躍的社會。","word":"望む"}]],"grammar_notes":[{"sentence":1,"pattern":"〜に応じて","note":"「依據〜而」，對應變化"},{"sentence":2,"pattern":"〜ざるを得ない","note":"「不得不〜」"},{"sentence":3,"pattern":"〜をきっかけに","note":"「以〜為契機」"},{"sentence":3,"pattern":"〜にもかかわらず","note":"「儘管〜」，強逆接，較のに更書面"}]}