pos":"副詞"},{"surface_form":"作る","basic_form":"作る","reading":"つくる","pos":"動詞"},{"surface_form":"こと","basic_form":"こと","reading":"こと","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"できた","basic_form":"できる","reading":"できた","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"},{"surface_form":"できあがる","basic_form":"できあがる","reading":"できあがる","pos":"動詞"},{"surface_form":"まで","basic_form":"まで","reading":"まで","pos":"助詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"一か月","basic_form":"一か月","reading":"いっかげつ","pos":"名詞"},{"surface_form":"ほど","basic_form":"ほど","reading":"ほど","pos":"助詞"},{"surface_form":"かかる","basic_form":"かかる","reading":"かかる","pos":"動詞"},{"surface_form":"そうだ","basic_form":"そうだ","reading":"そうだ","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"先日":{"meaning":"前幾天"},"祖母":{"meaning":"奶奶、祖母"},"家":{"meaning":"家"},"行く":{"meaning":"去"},"一緒に":{"meaning":"一起"},"梅干し":{"meaning":"梅乾、鹹梅"},"作り":{"meaning":"製作"},"する":{"meaning":"做"},"梅":{"meaning":"梅子"},"洗う":{"meaning":"洗"},"塩":{"meaning":"鹽"},"まぶす":{"meaning":"沾裹、撒上"},"瓶":{"meaning":"瓶子"},"入れる":{"meaning":"放入"},"毎年":{"meaning":"每年"},"この":{"meaning":"這個"},"時期":{"meaning":"時期"},"作る":{"meaning":"製作"},"手順":{"meaning":"步驟"},"よく":{"meaning":"經常、很"},"知る":{"meaning":"知道"},"わたし":{"meaning":"我"},"初めて":{"meaning":"第一次"},"失敗する":{"meaning":"失敗"},"思う":{"meaning":"覺得、想"},"ていねいに":{"meaning":"仔細地、細心地"},"教える":{"meaning":"教導"},"無事に":{"meaning":"平安地、順利地"},"こと":{"meaning":"事情（形式名詞）"},"できる":{"meaning":"能夠、做得到"},"できあがる":{"meaning":"完成"},"一か月":{"meaning":"一個月"},"かかる":{"meaning":"花費（時間）"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞","に":"表示時間點、對象，或到達的地點","を":"標示動作的受詞","は":"主題標記","ので":"「因為〜」，客觀原因，比から更委婉","と":"用於〜と思う，引述所想的內容","が":"標示句子的主語，或表示逆接「但是」","ながら":"表示兩個動作同時進行，「一邊〜一邊〜」","まで":"表示範圍終點，「到〜為止」","ほど":"表示大致的程度或數量"},"translations":[[{"text":"前幾天去了奶奶家，一起做了梅干。","word":"梅干し"}],[{"text":"把梅子洗一洗、抹上鹽，裝進瓶子裡。","word":"まぶす"}],[{"text":"奶奶每年這個時候都會做，所以很熟悉步驟。","word":"手順"}],[{"text":"我是第一次做，心想可能會失敗，但在奶奶細心地教導下，順利地做成了。","word":"できる"}],[{"text":"聽說完成要花大約一個月的時間。","word":"かかる"}]],"grammar_notes":[{"sentence":2,"pattern":"〜ので（因為）","note":"客觀原因，比から更委婉/書面"},{"sentence":3,"pattern":"〜と思う","note":"「我覺得〜」，表示個人想法"},{"sentence":3,"pattern":"〜てあげる／〜てくれる／〜てもらう","note":"授受表現（幫忙的方向性）"},{"sentence":4,"pattern":"〜そうだ（傳聞/樣態）","note":"「聽說」或「看起來」，依接續判斷語意"}]}