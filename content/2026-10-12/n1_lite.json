"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"日本":{"meaning":"日本"},"農業":{"meaning":"農業"},"高齢化":{"meaning":"高齡化"},"後継者不足":{"meaning":"繼承人不足"},"構造的":{"meaning":"結構性的"},"課題":{"meaning":"課題、問題"},"長年":{"meaning":"多年來"},"悩む":{"meaning":"煩惱、困擾"},"若年層":{"meaning":"年輕族群"},"新規就農":{"meaning":"新進從農"},"促す":{"meaning":"促使、催促"},"各地":{"meaning":"各地"},"研修制度":{"meaning":"培訓制度"},"整備する":{"meaning":"健全化、完善"},"収益性":{"meaning":"收益性"},"低さ":{"meaning":"低（程度）"},"労働環境":{"meaning":"勞動環境"},"厳しさ":{"meaning":"嚴峻（程度）"},"定着率":{"meaning":"留任率"},"依然として":{"meaning":"依然、仍舊"},"低い":{"meaning":"低的"},"水準":{"meaning":"水準"},"とどまる":{"meaning":"停留、維持在"},"加えて":{"meaning":"此外、加上"},"気候変動":{"meaning":"氣候變遷"},"伴う":{"meaning":"伴隨"},"収穫":{"meaning":"收穫"},"不安定化":{"meaning":"不穩定化"},"新規就農者":{"meaning":"新進農民"},"意欲":{"meaning":"意願、積極性"},"減退する":{"meaning":"減退、下降"},"要因":{"meaning":"原因、因素"},"懸念する":{"meaning":"擔憂、顧慮"},"こうした":{"meaning":"這樣的"},"状況":{"meaning":"狀況"},"打開する":{"meaning":"打開（局面）、突破"},"補助金政策":{"meaning":"補助金政策"},"依存する":{"meaning":"依賴"},"生産":{"meaning":"生產"},"流通":{"meaning":"流通"},"一体的に":{"meaning":"一體地、整合地"},"支える":{"meaning":"支撐"},"仕組み":{"meaning":"機制"},"構築":{"meaning":"構築、建立"},"不可欠":{"meaning":"不可或缺"},"言う":{"meaning":"說"},"また":{"meaning":"又、還"},"ベテラン農家":{"meaning":"資深農民"},"持つ":{"meaning":"擁有"},"技術":{"meaning":"技術"},"ノウハウ":{"meaning":"專業知識、技術訣竅"},"継承":{"meaning":"傳承"},"急務":{"meaning":"緊急任務"},"である":{"meaning":"是（書面斷定）"},"単なる":{"meaning":"單純的、僅僅"},"人手":{"meaning":"人力"},"確保":{"meaning":"確保"},"解決する":{"meaning":"解決"},"側面":{"meaning":"面向、方面"},"ある":{"meaning":"有、存在"},"地域ぐるみ":{"meaning":"整個地區（一起）"},"若手":{"meaning":"年輕人、新手"},"育てる":{"meaning":"培育"},"体制づくり":{"meaning":"建立體制"},"今後":{"meaning":"今後"},"持続する":{"meaning":"持續"},"鍵":{"meaning":"關鍵"},"なる":{"meaning":"變成"},"ない":{"meaning":"沒有"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞","は":"主題標記","と":"用於引述內容，或表示「與〜」","という":"「叫做〜」，用於引用名稱或說法","に":"表示對象、方面，或結果","で":"表示場所","が":"標示句子的主語","ものの":"「雖然〜」，書面逆接","や":"列舉部分事物，「〜和〜等」","から":"表示原因，或範圍起點「從〜」","も":"「也」，取代が/を","として":"「作為〜」的身分/立場","を":"標示動作的受詞","ため":"表示目的，「為了〜」","のみ":"「僅、只」","まで":"表示範圍終點，「到〜為止」"},"translations":[[{"text":"日本的農業長年來一直為高齡化與繼承人不足這種結構性課題所困擾。","word":"悩む"}],[{"text":"雖然各地都在完善培訓制度以促進年輕人新進從農，但由於收益偏低、勞動環境嚴峻，留任率依然處於低水準。","word":"ものの"}],[{"text":"此外，伴隨氣候變遷而來的收穫不穩定，也被視為可能使新進農民意願降低的隱憂。","word":"懸念する"}],[{"text":"要打開這樣的局面，恐怕不能僅依賴補助金政策，而必須建立從生產到流通一體支援的機制才行。","word":"仕組み"}],[{"text":"此外，資深農民所擁有的技術與專業知識的傳承也是當務之急，單靠確保人力並無法解決所有面向。","word":"継承"}],[{"text":"由整個地區一起培育年輕人的體制，或許正是今後讓農業得以持續下去的關鍵所在。","word":"体制づくり"}]],"grammar_notes":[]}