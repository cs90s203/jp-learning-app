  "translations": [
    [ { "text": "作為氣候變遷對策的一環，將擴大可再生能源列為國家目標的動向，正在世界各國推進。", "word": "拡大" } ],
    [ { "text": "日本也不例外，一直將太陽能與風力發電的擴大導入作為政策核心。", "word": "導入" } ],
    [ { "text": "然而，在快速普及的背後，也有不少人指出，開墾山林設置的太陽能板正提高土石流風險，導致當地居民被迫一再重新檢討相關計畫的案例接連發生。", "word": "余儀なくされる" } ],
    [ { "text": "此外，發電量容易受天候左右，這種可再生能源特有的弱點，也讓電力穩定供應蒙上不確定性，這一點也不容忽視。", "word": "見過ごす" } ],
    [ { "text": "推動派往往強調成本下降與技術革新，但既然反對派的疑慮也有足以側耳傾聽的依據，就不應把雙方的討論簡化為單純的善惡二元論。", "word": "きらいがある" } ],
    [ { "text": "能源政策的轉向，唯有在經濟成長與環境保護這兩項訴求相互交織之下才能實現，與其急於求成，不如說眼下最需要的，正是一套審慎的共識形成過程。", "word": "求める" } ]
  ],
