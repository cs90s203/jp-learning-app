  "translations": [
    [ { "text": "上個月，我跟媽媽一起去了兩天一夜的溫泉旅行。", "word": "温泉" } ],
    [ { "text": "因為天氣很好，我們從早上開始，有時去附近的山散步，有時悠閒地泡溫泉，就這樣度過了一天。", "word": "散歩する" } ],
    [ { "text": "媽媽雖然說腳很痛，卻還是一直精神奕奕地走著。", "word": "元気" } ],
    [ { "text": "旅館的人非常親切，從房間就能看到美麗的景色。", "word": "できる" } ],
    [ { "text": "晚餐端出了新鮮的魚料理，媽媽和我都非常滿足。", "word": "大満足" } ],
    [ { "text": "希望能再跟媽媽兩個人一起去旅行。", "word": "思う" } ]
  ],
