  "translations": [
    [ { "text": "從小就喜歡畫畫，但長大之後，忙著生活瑣事，漸漸遠離了畫畫這件事。", "word": "遠ざかる" } ],
    [ { "text": "半年前，因為朋友邀請，開始去上水彩畫教室。", "word": "通う" } ],
    [ { "text": "實際嘗試之後才發現，每疊加一層顏色都有新發現，比想像中還要深奧。", "word": "発見" } ],
    [ { "text": "雖然也有畫不好的日子，但即使笨拙，也能感受到一張一張仔細完成作品的喜悅。", "word": "喜び" } ],
    [ { "text": "身邊的人有時會問「事到如今為什麼才開始」，但多虧了這個興趣，我漸漸能察覺到日常生活中的小小美好。", "word": "気づく" } ]
