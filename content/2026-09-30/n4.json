  "translations": [
    [ { "text": "週末去了祖母家玩。", "word": "祖母" } ],
    [ { "text": "祖母很擅長編織，所以教了我。", "word": "得意" } ],
    [ { "text": "一開始毛線常常纏在一起，", "word": "絡まる" }, { "text": "或是把針弄掉在地上。", "word": "落とす" } ],
