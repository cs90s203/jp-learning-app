  "translations": [
    [ { "text": "在少子高齡化導致勞動人口減少，加上產業結構變化的雙重作用下，主張應進一步擴大接收外國人力的議論日益熱烈。", "word": "相まる" } ],
    [ { "text": "政府已擴充特定技能制度，提出在更多領域接收外籍勞工的方針。", "word": "拡充する" } ],
    [ { "text": "經濟界傳出聲音認為，對苦於人手不足的行業而言，這項措施值得歡迎。", "word": "歓迎する" } ],
    [ { "text": "然而，若不完善勞動環境、充實日語教育，就無法真正實現共生社會的謹慎論調依然根深蒂固。", "word": "実現する" } ],
    [ { "text": "事實上，若在低薪、長工時等問題未獲改善的情況下擴大接收，恐怕難逃勞動剝削的批評。", "word": "是正する" } ],
    [ { "text": "與當地居民的摩擦，也讓不少業者被迫縮減計畫，行政單位完善支援體制已刻不容緩。", "word": "余儀なくされる" } ],
    [ { "text": "另一方面，也有現實論認為，既然少子化的趨勢無法遏止，依賴外國人力已是無法迴避的現實。", "word": "避けて通る" } ],
    [ { "text": "不得不說，這項議論的走向，將大幅受到制度設計如何而左右。", "word": "左右する" } ]
  ],
