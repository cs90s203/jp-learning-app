    [ { "text": "近年，以免費或低價格提供餐食給地區孩童的「兒童食堂」正在全國展開。", "word": "子ども食堂" } ],
    [ { "text": "據說是大約十年前，一位店主因為看不下去獨自吃飯的孩子，才開始了這項活動。", "word": "見かねる" } ],
    [ { "text": "營運主要仰賴志工、當地商店和NPO等支撐，資金和食材有很大一部分依靠捐款。", "word": "頼る" } ],
    [ { "text": "不僅是提供餐食，也肩負著幫忙寫作業、傾聽煩惱等容身之處的角色。", "word": "居場所" } ],
    [ { "text": "另一方面，隨著營運者的高齡化，加上後繼者不足，也有不少團體難以持續下去。", "word": "伴う" } ],
    [ { "text": "也有人指出，若不加強與行政機關的合作，要長期維持這項行動並不容易。", "word": "強化する" } ],
    [ { "text": "即便如此，靠著孩子們的笑容支持，持續投入這項活動的人依然絡繹不絕。", "word": "続ける" } ]
  ],
  "grammar_notes": [
    { "sentence": 1, "pattern": "〜をきっかけに", "note": "「以〜為契機」" },
    { "sentence": 4, "pattern": "〜に伴って", "note": "「伴隨〜」，同步變化" }
  ]
}
