  "translations": [
    [ { "text": "半年前開始在公園學太極拳。", "word": "太極拳" } ],
    [ { "text": "契機是健康檢查時被指出運動不足。", "word": "指摘する" } ],
    [ { "text": "一開始我有「這是老年人在做的運動」的印象，但實際做了之後完全不同。", "word": "違う" } ],
    [ { "text": "在緩慢的動作之中，其實用到全身的肌肉，深奧得超乎想像，流的汗也比想像中還多。", "word": "奥深さ" } ],
    [ { "text": "老師總是教導「要留意呼吸」。", "word": "意識する" } ],
    [ { "text": "持續練習之後，漸漸感覺身體變輕了。", "word": "感じる" } ],
    [ { "text": "老師說，身體越僵硬的人，越應該持續練太極拳。", "word": "続ける" } ],
    [ { "text": "今後也不想讓自己養成硬撐的習慣，而是按照自己的步調繼續下去。", "word": "続ける" } ]
  ],
