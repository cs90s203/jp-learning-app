  "translations": [
    [ { "text": "近年，公立學校的教師短缺日益嚴重，全國各地都有開學典禮當天仍未確定導師的班級被報導出來。", "word": "教員不足" } ],
    [ { "text": "背景之一是，因長時間勞動與龐大行政事務帶來的負擔感，敬而遠之教職的年輕人正在增加。", "word": "敬遠する" } ],
    [ { "text": "即使有教師因產假、病假出現職缺，也常常找不到替代人力，只能由其他教師兼課來度過難關的案例並不少。", "word": "掛け持ちする" } ],
    [ { "text": "據說這種傾向在地方尤其顯著。", "word": "顕著" } ],
    [ { "text": "文部科學省雖提出了提前錄用考試、改善待遇等對策，", "word": "対策" }, { "text": "但教育現場也傳出「杯水車薪」的聲音，尚未達到根本性的解決。", "word": "焼け石に水" } ],
    [ { "text": "正因為支撐孩子們學習的基礎本身正在動搖，才更需要盡快因應。", "word": "揺らぐ" } ]
  ],
