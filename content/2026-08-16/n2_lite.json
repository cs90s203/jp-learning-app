  "translations": [
    [ { "text": "近年，讓貨物寄放在玄關前等處的「置放配送」服務，使用的人越來越多。", "word": "置き配" } ],
    [ { "text": "以前拜託再次配送是理所當然的事，", "word": "再配達" }, { "text": "但隨著雙薪家庭的增加，不必在意時間就能收貨的置放配送迅速普及開來。", "word": "広まる" } ],
    [ { "text": "引進專用箱或指定置放應用程式的配送業者也增加了，", "word": "導入する" }, { "text": "作為防盜對策，能用照片確認放置地點的機制也逐漸完善。", "word": "確認する" } ],
    [ { "text": "另一方面，也有人擔心壞天氣時貨物會被淋濕、", "word": "濡れる" }, { "text": "或對長時間放在玄關前感到不安，如何在便利性與安全性之間取得平衡，成了今後的課題。", "word": "バランス" } ]
  ],
