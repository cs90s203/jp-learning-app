  "translations": [
    [ { "text": "圍繞著一般駕駛用自用車進行有償接送、也就是所謂「共乘服務」的全面解禁，各方贊成與反對的意見交織不斷。", "word": "ライドシェア" } ],
    [ { "text": "為計程車不足所苦的觀光地與人口稀少地區傳出應增加交通方式選項的聲音，", "word": "選択肢" }, { "text": "歡迎放寬管制的看法也不少。", "word": "規制緩和" } ],
    [ { "text": "另一方面，既有的計程車業界則根深蒂固地擔憂，若在安全管理體制尚未完善時就解禁，恐怕會導致事故與糾紛頻傳。", "word": "懸念" } ],
    [ { "text": "實際上，對於把乘客安全交付給沒有營業用駕照的一般駕駛這件事，", "word": "委ねる" }, { "text": "抱持慎重論的有識之士也不少，也有人指出操之過急的制度設計恐將留下禍根。", "word": "拙速" } ],
    [ { "text": "政府方面表示將先限定地區與時段進行部分解禁，再分階段擴大對象，", "word": "段階的に" }, { "text": "但從業界團體的角度看來，這似乎是逐步邁向全面解禁的鋪路之舉，戒心始終無法消除。", "word": "布石" } ],
    [ { "text": "使用者便利性的提升與安全性的確保，這兩項往往容易相互矛盾的訴求該如何兼顧，方向的掌控正受到考驗。", "word": "両立する" } ],
    [ { "text": "唯有貼合地方實際情況的靈活制度設計，今後應會愈發受到期待。", "word": "実情" } ]
  ],
  "grammar_notes": [
