  "translations": [
    [ { "text": "近年，設置在公園或商店街一角的小書架，讓任何人都能自由帶書來放或借閱的「街角圖書箱」正逐漸在各地普及。", "word": "まちなか図書ポスト" } ],
    [ { "text": "儘管設置費用並不算高，卻作為促進居民彼此交流的契機而備受關注。", "word": "にもかかわらず" } ],
    [ { "text": "在某個商店街，由店主們發起設置之後，據說吸引了從小孩到高齡者等各個世代的人前來造訪。", "word": "きっかけに" } ],
    [ { "text": "不過，由誰來負責管理的課題依然存在，不少地區不得不依靠志工來補充書籍和打掃。", "word": "頼らざるを得ない" } ],
    [ { "text": "即便如此，作為找回地區聯繫的手段，這項作法今後預期會進一步普及。", "word": "取り戻す" } ]
  ],
