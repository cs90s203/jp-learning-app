  "translations": [
    [ { "text": "去年秋天，我開始在附近的圖書館當志工。", "word": "ボランティア" } ],
    [ { "text": "雖然本來就喜歡讀書，但不擅長在人前說話，所以一開始其實很猶豫。", "word": "ものの" } ],
    [ { "text": "然而，得知是要為孩子們朗讀繪本的志工活動後，我便下定決心報名了。", "word": "読み聞かせる" } ],
    [ { "text": "第一次朗讀時，緊張得聲音都在顫抖，但孩子們聽得很開心，讓我很欣慰。", "word": "震える" } ],
    [ { "text": "另一方面，在面向大人的讀書會上，我常常無法順利表達自己的意見，感到不甘心。", "word": "一方で" } ],
    [ { "text": "即便如此，這段經驗對我來說，正逐漸變成無可取代的存在。", "word": "にとって" } ]
  ],
