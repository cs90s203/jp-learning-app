  "translations": [
    [ { "text": "最近發現房間東西太多，怎麼整理都馬上又亂了。", "word": "片付ける" } ],
    [ { "text": "於是下定決心開始嘗試斷捨離。", "word": "断捨離" } ],
    [ { "text": "首先把不穿的衣服和不看的書全部拿出來，一件一件思考是否需要。", "word": "考える" } ],
