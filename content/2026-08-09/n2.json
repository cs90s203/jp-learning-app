  "translations": [
    [ { "text": "以新型態的工作方式改革為契機，導入遠距工作的企業正穩健增加。", "word": "テレワーク" } ],
    [ { "text": "隨著不再需要通勤時間，員工雖然變得能更靈活地運用時間，但為與上司、同事溝通不足而煩惱的聲音也不少。", "word": "伴う" } ],
    [ { "text": "尤其對新進員工來說，據說對透過面對面交流學習的機會減少感到相當不安。", "word": "通じる" } ],
    [ { "text": "企業方面儘管被期待能提升生產力，但實際上也面臨評鑑制度的完善跟不上腳步的課題。", "word": "にもかかわらず" } ],
    [ { "text": "此外，能否在家中打造出專注工作的環境，據說個人差異也很大。", "word": "個人差" } ],
    [ { "text": "今後，或許需要一邊活用遠距工作獨有的優點，一邊融入面對面的好處，發展出更靈活的工作方式。", "word": "活かす" } ]
  ],
