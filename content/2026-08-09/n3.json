  "translations": [
    [ { "text": "我開始學民謠，契機是去年的夏日祭典。", "word": "きっかけ" } ],
    [ { "text": "看到當地的老奶奶們配合三味線歌唱的樣子，我強烈地想著『要是能像那樣唱該有多好』。", "word": "素敵" } ],
    [ { "text": "在那之前我對音樂沒有興趣，但從那天起心情有了轉變。", "word": "興味" } ],
    [ { "text": "開始去教室上課後才發現，發聲和方言發音都很難，一開始差點就要放棄。", "word": "挫折する" } ],
    [ { "text": "但老師對我說『比起唱得好，享受更重要』，讓我稍微放鬆了下來。", "word": "楽しむ" } ],
    [ { "text": "現在雖然唱得不算好，但在地方活動上唱歌的機會也漸漸增加了。", "word": "機会" } ]
