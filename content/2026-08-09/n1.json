  "translations": [
    [ { "text": "圍繞著以網路投票為首的選舉數位化的議論，近年來突然變得熱烈起來。", "word": "デジタル化" } ],
    [ { "text": "在少子高齡化與投票率低迷持續交織的情況下，作為遏止年輕族群疏離政治的手段，能透過智慧型手機投票的機制受到的期待日益高漲，這是事實。", "word": "相まる" } ],
    [ { "text": "另一方面，要完全排除冒名頂替、通訊故障等技術性風險並不容易，既然選舉是關係到民主主義根本的制度，也有不少人堅持認為應避免草率導入。", "word": "根幹" } ],
    [ { "text": "尤其令人擔憂的是，開票結果本身有可能因網路攻擊而遭到操縱，這樣的憂慮是可能從根本動搖選民信賴的問題，不容輕視。", "word": "かねない" } ],
    [ { "text": "實際上，部分地方自治體雖然被迫進行試驗性導入，但系統的脆弱性遭到指出，也出現了暫緩正式運用的案例。", "word": "余儀なくされる" } ],
    [ { "text": "考量到這樣的狀況，不應只追求便利性的提升，足以確保公正性與信賴性的制度設計，理應才是今後議論中最優先的課題。", "word": "足る" } ]
  ],
