    [ { "text": "透過手機應用程式或IC卡付款的人正在增加。", "word": "ICカード" } ],
    [ { "text": "不需要隨身帶現金也能購物的便利性，是受到許多人支持的理由。", "word": "手軽さ" } ],
    [ { "text": "尤其是在便利商店或餐飲店，結帳變得更加順暢，也縮短了等待時間。", "word": "会計" } ],
    [ { "text": "可以獲得點數或折扣的促銷活動，也是增加使用者的原因之一。", "word": "キャンペーン" } ],
    [ { "text": "另一方面，也有不少人擔心停電或通訊故障發生時無法完成支付。", "word": "不安" } ],
    [ { "text": "此外，高齡者中仍有許多人不習慣操作，依然偏好使用現金。", "word": "依然として" } ],
    [ { "text": "即便如此，無現金支付預料仍會越來越普及。", "word": "広がる" } ]
