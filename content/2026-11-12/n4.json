  "translations": [
    [ { "text": "這個週末，我和女兒去了附近的公園野餐。", "word": "ピクニック" } ],
    [ { "text": "因為天氣很好，所以坐在草坪上，還玩了球。", "word": "芝生" } ],
    [ { "text": "能在戶外吃便當，女兒看起來非常開心。", "word": "嬉しい" } ],
    [ { "text": "雖然風有點強，女兒卻說「還想再玩」。", "word": "強い" } ],
    [ { "text": "回去的時候，我們兩個都曬黑了。", "word": "焼ける" } ],
    [ { "text": "我們約定下週也要再去公園。", "word": "約束する" } ]
