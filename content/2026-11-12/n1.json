  "translations": [
    [ { "text": "圍繞大學教育免費化的議論，從少子化對策與消除教育差距的角度，近年來愈發活躍。", "word": "無償化" } ],
    [ { "text": "推動派認為，依家庭經濟狀況而受限的升學現狀是個問題，主張應該實現一個不讓有意願與能力的學生因經濟原因放棄升學的社會。", "word": "主張する" } ],
    [ { "text": "另一方面，謹慎派則指出財源的確保並不容易，而且免費化未必能帶來學力提升或升學率改善，因此主張應謹慎檢討。", "word": "検討" } ],
    [ { "text": "與少子化日益嚴重的日本特有危機感相結合，這場議論已成為政治上的重要論點。", "word": "と相まって" } ],
    [ { "text": "不必看其他國家的案例，公共支出用於高等教育的不足早已被人指出，這次的議論可說是這個脈絡的延續。", "word": "見るまでもなく" } ],
    [ { "text": "財源要靠稅負擔，還是透過重新分配既有預算來籌措，這一點也是左右議論走向的重要因素。", "word": "左右する" } ],
    [ { "text": "正因為草率的制度設計可能在現場招致混亂，才需要花足夠的時間反覆討論。", "word": "招く" } ],
    [ { "text": "即便如此，若以教育機會均等的理念來衡量，免費化的方向本身不應被否定的意見仍然根深蒂固。", "word": "根強い" } ],
    [ { "text": "今後，跨越朝野的共識能形成到什麼程度，備受關注。", "word": "合意形成" } ]
  ],
