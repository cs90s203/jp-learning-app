  "translations": [
    [ { "text": "隨著高齡化的進展與醫藥分業的普及，調劑業務的需求持續增加，但藥劑師不足仍是以地方為主的嚴重課題。", "word": "薬剤師" } ],
    [ { "text": "都市地區的供應相對穩定，但地方藥局往往由一名藥劑師負責覆蓋廣大地區，連休假都難以確保的聲音也時有所聞。", "word": "カバーする" } ],
    [ { "text": "業務內容不僅是調劑，還擴展到用藥指導與居家醫療的應對，這也被指出是增加負擔的原因之一。", "word": "指摘する" } ],
    [ { "text": "在待遇方面，人才容易集中於都市地區的醫院或大型連鎖藥局，地方的中小型藥局在招募人才上則相當吃力，這是實際的情況。", "word": "実情" } ],
    [ { "text": "國家雖然採取了消除藥劑師地區分布不均的支援措施，但效果顯現恐怕還需要一段時間。", "word": "解消する" } ],
    [ { "text": "若不談支撐地區醫療的藥劑師人力確保問題，就無法談論永續的醫療體制。", "word": "抜きにして" } ]
