  "translations": [
    [ { "text": "開始學茶道是受到媽媽的影響。", "word": "影響" } ],
    [ { "text": "小時候，媽媽常在家裡點茶，我覺得那個動作非常優美。", "word": "所作" } ],
    [ { "text": "但是，因為有種拘謹的印象，一直沒有勇氣開始學。", "word": "堅苦しい" } ],
    [ { "text": "去年，被朋友邀約參加了茶道體驗，發現心情比想像中更平靜，便想馬上繼續下去。", "word": "落ち着く" } ],
    [ { "text": "一開始連行禮的方式和走路的姿勢都很生硬，但多虧老師耐心的指導，漸漸掌握了一些動作要領。", "word": "身につく" } ],
    [ { "text": "在茶室裡靜靜度過的時間，成了讓我忘卻日常忙碌的特別時光。", "word": "ひととき" } ]
