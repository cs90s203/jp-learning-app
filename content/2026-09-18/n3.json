  "translations": [
    [ { "text": "開始學弓道，是因為去年偶然參觀道場時，被那裡的氣氛深深打動了。", "word": "弓道" } ],
    [ { "text": "面對靶心射出箭那一瞬間的寂靜，是其他運動所沒有的獨特感受。", "word": "静けさ" } ],
    [ { "text": "剛開始的幾個月，連拉弓的姿勢都不穩定，箭總是射不中靶心。", "word": "当たる" } ],
    [ { "text": "但是老師告訴我：「比起結果，專注在每一箭上更重要」，這讓我的想法改變了。", "word": "考え方" } ],
    [ { "text": "如今，比起命中與否，我更享受調整呼吸、讓心靜下來的那段時間本身。", "word": "楽しむ" } ],
    [ { "text": "正因為弓道有很長一段時間要默默地面對自己，這一年來我漸漸明白，心的狀態會直接反映在結果上。", "word": "分かる" } ]
  ],
