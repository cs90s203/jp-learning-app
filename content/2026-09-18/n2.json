  "translations": [
    [ { "text": "在高齡化持續發展的地區社會中，開設能讓孩童到高齡者都能輕鬆造訪的「多世代交流咖啡館」的行動正在各地展開。", "word": "多世代交流カフェ" } ],
    [ { "text": "這項措施原本是為了防止獨居高齡者陷入孤立而開始的，但最近也逐漸受到關注，成為育兒中的父母得以喘口氣的場所。", "word": "息抜きする" } ],
    [ { "text": "在咖啡館裡，地區居民以志工身分參與營運，提供簡單的餐食、照看孩童、進行煩惱諮詢等活動。", "word": "ボランティア" } ],
    [ { "text": "透過跨世代的交流，即使在人際連結容易變得淡薄的都市地區，重新建立看得見彼此臉孔的關係，這樣的嘗試也正逐漸受到肯定。", "word": "つながり" } ],
    [ { "text": "今後的課題在於，該如何擴大行政單位在資金方面的支援。", "word": "支援" } ]
  ],
