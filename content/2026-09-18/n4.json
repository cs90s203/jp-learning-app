  "translations": [
    [ { "text": "暑假去祖母家玩的時候，說好要一起做醃梅子。", "word": "梅干し" } ],
    [ { "text": "把庭院裡採來的梅子洗一洗、又撒上鹽，慢慢裝進瓶子裡。", "word": "詰める" } ],
