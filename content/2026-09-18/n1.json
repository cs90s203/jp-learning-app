  "translations": [
    [ { "text": "作為工作方式改革的一環，將一週中三天訂為假日的「週休三日制」導入議題，在企業與行政機關之間逐漸熱烈討論起來。", "word": "週休三日制" } ],
    [ { "text": "推動派主張，休養日增加能讓員工身心維持健康，進而提升生產力並降低離職率。", "word": "生産性" } ],
    [ { "text": "實際上已有部分企業試行導入，也有報告指出員工的滿意度因此提高。", "word": "満足度" } ],
    [ { "text": "另一方面，謹慎派則指出，把相同的業務量壓縮到四天完成，會導致每天的勞動強度增加，也可能擴大與非正式雇員之間的待遇差距，甚至造成客戶應對出現空白，這些都令人擔憂。", "word": "労働強度" } ],
    [ { "text": "尤其是在人手嚴重不足的醫療、照護、運輸等行業，「週休三日制」全面導入並不現實的聲音依然根深蒂固。", "word": "人手不足" } ],
    [ { "text": "政府雖然透過補助金制度推動企業導入，但可以說，仍需要一套考量不同業種與企業規模差異的、更有彈性的制度設計。", "word": "制度設計" } ]
  ],
