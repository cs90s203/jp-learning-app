    [ { "text": "據說當時行政支援不夠周全，", "word": "行政" }, { "text": "居民之間不得不互相合作來應對當時的狀況。", "word": "協力し合う" } ],
    [ { "text": "以那次經驗為契機，", "word": "経験" }, { "text": "開始以自治會為中心完善避難演習與物資儲備體制。", "word": "備蓄体制" } ],
    [ { "text": "儘管是高齡者眾多的地區，", "word": "高齢者" }, { "text": "年輕世代也積極參與，防災意識正跨世代地逐漸共享開來。", "word": "防災意識" } ],
    [ { "text": "不過，資金與人才的確保困難這一課題依然存在，", "word": "確保" }, { "text": "持續運營恐怕少不了與行政的合作。", "word": "連携" } ]
