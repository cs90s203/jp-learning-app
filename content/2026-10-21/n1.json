  "translations": [
    [ { "text": "近年，觀光地針對外國觀光客的定價方式，", "word": "外国人観光客" }, { "text": "也就是所謂的雙重定價問題，在各地的討論日益熱烈。", "word": "二重価格" } ],
    [ { "text": "背後原因在於，訪日遊客數的急速增加，", "word": "訪日客数" }, { "text": "加上物價上漲與人力不足等令業者苦惱的情況。", "word": "人手不足" } ],
    [ { "text": "事實上，某家老字號旅館將外國觀光客的價格設定得比日本人高之後，", "word": "老舗旅館" }, { "text": "引發了贊成與反對的聲浪，據說經營者被迫重新檢討了應對方式。", "word": "余儀なくされる" } ],
    [ { "text": "贊成方主張，考慮到觀光地特有的高需求，", "word": "需要" }, { "text": "依支付能力設定價差是合理的做法。", "word": "価格差" } ],
    [ { "text": "另一方面，反對方批評依國籍改變價格有帶歧視性的傾向，", "word": "国籍" }, { "text": "並主張這種有失公平的措施理應被修正。", "word": "公平性" } ],
    [ { "text": "雙方的主張各有一定的說服力，", "word": "説得力" }, { "text": "爭論至今仍未見平息的跡象。", "word": "収束する" } ],
    [ { "text": "說到底，這恐怕不是要不要設價差的二選一問題，", "word": "結局のところ" }, { "text": "而是該如何建立一套讓觀光客與地方社會都能接受的機制，這個更本質性的課題才是真正該被探討的。", "word": "仕組み" } ]
  ],
