  "translations": [
    [ { "text": "在物流業界，", "word": "物流業界" }, { "text": "卡車司機不足已成為嚴重的課題。", "word": "トラック運転手" } ],
    [ { "text": "由於長時間勞動與低薪等勞動環境的嚴苛，", "word": "労働環境" }, { "text": "年輕世代的接班人並未增加，高齡化日益加劇，這就是實際情況。", "word": "高齢化" } ],
    [ { "text": "此外，隨著近年工作方式改革帶來的加班限制強化，", "word": "残業規制" }, { "text": "每人平均的運輸量減少，貨物送達所需時間延長的案例也接連發生。", "word": "運送量" } ],
    [ { "text": "尤其在地方的人口過稀地區，配送網絡本身正在縮小，", "word": "過疎地域" }, { "text": "甚至有人反映連日用品都難以取得。", "word": "日用品" } ],
    [ { "text": "政府也在研議對策，", "word": "政府" }, { "text": "但效果尚未顯現。", "word": "効果" } ],
    [ { "text": "要突破這樣的狀況，除了提高薪資之外，", "word": "引き上げ" }, { "text": "整個業界都有必要改善勞動環境。", "word": "業界全体" } ],
    [ { "text": "否則，", "word": "さもなければ" }, { "text": "物流網絡本身恐怕都有可能無法維持。", "word": "維持できる" } ]
  ],
