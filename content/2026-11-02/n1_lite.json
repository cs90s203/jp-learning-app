  "translations": [
    [ { "text": "近年，隨著全球化的進展，醫療、司法等專業領域對口譯員的需求日益提高。", "word": "需要" } ],
    [ { "text": "然而，同時具備專業知識與高度語言能力的口譯員十分有限，人才不足的情況正在加劇。", "word": "人材不足" } ],
    [ { "text": "尤其在地方醫院，常因無法與外國病患順利溝通，而影響到診療。", "word": "コミュニケーション" } ],
    [ { "text": "實際上，也有連簡單說明都無法充分傳達、因而產生誤解的案例被報導出來。", "word": "誤解" } ],
    [ { "text": "雖然行政單位正逐步建立培訓制度，但由於待遇偏低，許多人即使取得資格也無法繼續從事這份工作。", "word": "ものの" } ],
    [ { "text": "如果這樣持續下去，支援可能無法周全，甚至可能有人連必要的醫療都得不到。", "word": "増えかねない" } ],
    [ { "text": "除了語言能力之外，建立一套因應專業性的人才培育機制，可說是當務之急。", "word": "応じる" } ]
  ],
