  "translations": [
    [ { "text": "上個月，因為被公司同事邀約，我開始在附近的健身房嘗試抱石運動。", "word": "ボルダリング" } ],
    [ { "text": "一開始手腳都不聽使喚，光是看著牆就覺得累了。", "word": "動かす" } ],
