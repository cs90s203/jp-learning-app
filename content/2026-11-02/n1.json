  "translations": [
    [ { "text": "近年在日本，圍繞同性婚姻法制化的議論透過各地的訴訟逐漸變得活躍。", "word": "議論" } ],
    [ { "text": "多個地方法院做出判斷，認為現行婚姻制度不承認同性伴侶一事違反了憲法精神，但國家至今仍未採取具體的修法行動。", "word": "判断" } ],
    [ { "text": "加上少子化與家庭觀的變化，重新檢視婚姻與家庭本身存在方式的氛圍日漸高漲，這點不言而喻。", "word": "機運" } ],
    [ { "text": "反對派主張傳統家庭觀可能因此受損，但看到已有許多企業將同性伴侶視同配偶對待的現況，可說社會的接受態度已不得不改變。", "word": "余儀なくされている" } ],
    [ { "text": "若從當事者的角度思考，他們在日常生活中承受的各種不利益，是足以讓人想像得到的，立法機關一再拖延結論，恐怕已經不該再被容許下去。", "word": "足る" } ],
    [ { "text": "這個問題已不只是部分當事人的事，而是整個社會都應該共同面對的課題。", "word": "向き合う" } ]
