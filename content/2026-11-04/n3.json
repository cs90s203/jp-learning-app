  "translations": [
    [ { "text": "開始學習茶道的契機，是在京都旅行時體驗到的一碗抹茶。", "word": "抹茶" } ],
    [ { "text": "苦味中帶著淡淡的甘甜，那複雜的滋味深深吸引了我。", "word": "惹かれる" } ],
    [ { "text": "我想更深入了解，回國後立刻找了附近的茶道教室開始去上課。", "word": "通い始める" } ],
    [ { "text": "一開始連跪坐都很辛苦，連動作的順序也記不住。", "word": "正座" } ],
    [ { "text": "但老師告訴我：「比起記住形式，用心款待客人的心意更重要。」", "word": "もてなす" } ],
    [ { "text": "託這句話的福，即使泡得不好，也漸漸能享受用心點茶的過程了。", "word": "おかげ" } ],
    [ { "text": "過了一年的現在，茶道的時間成了調整心情的重要習慣。", "word": "習慣" } ]
  ],
