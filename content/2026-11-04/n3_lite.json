    [ { "text": "常常滾進邊溝，有點不甘心，但分數漸漸提高讓我很開心。", "word": "うれしい" } ],
    [ { "text": "結束後手臂變得肌肉痠痛，不過很開心，還想再去一次。", "word": "楽しい" } ]
