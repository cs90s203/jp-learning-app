  "translations": [
    [ { "text": "為了支援因經濟狀況等原因無法攝取充足飲食的孩子們，由地區居民與志工經營的「兒童食堂」正在全國各地擴展開來。", "word": "子ども食堂" } ],
    [ { "text": "以前這原本僅侵限於部分地區的行動，隨著兒童貧困與孤食問題受到社會關注，設置數量逐年增加。", "word": "増加する" } ],
    [ { "text": "食堂不僅提供免費或低價的餐食，也扮演著學習支援，以及與當地高齡者交流場所的角色。", "word": "役割" } ],
    [ { "text": "營運資金大多依賴捐款與地方自治團體的補助金，同時也面臨人手不足、場地取得等課題。", "word": "頼る" } ],
    [ { "text": "儘管如此，想讓孩子們能有一個可以說「我回來了」的地方、由整個地區一起支撐的行動，預料今後仍會持續擴展。", "word": "にもかかわらず" } ]
  ],
  "grammar_notes": [
    { "sentence": 4, "pattern": "〜にもかかわらず", "note": "「儘管〜」，強逆接，較のに更書面" }
  ]
