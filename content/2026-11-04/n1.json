  "translations": [
    [ { "text": "每當高齡者引發的交通事故成為社會問題被提出討論，關於歸還駕照的議論就會變得熱烈。", "word": "議論" } ],
    [ { "text": "根據警察廳的統計，達到一定年齡的駕駛人被規定必須接受認知功能檢測，依檢測結果，有時也不被允許換發駕照。", "word": "認知機能検査" } ],
    [ { "text": "從促使歸還駕照的立場來看，既然判斷力與反應速度的下降有可能導致事故，僅僅交由本人自覺是不夠的。", "word": "以上" } ],
    [ { "text": "事實上，因踩錯煞車與油門而發生的事故絡繹不絕，受害者遺族強烈要求制度更加嚴格的聲音根深蒂固。", "word": "根強い" } ],
    [ { "text": "另一方面，持謹慎立場的一方則指出，在公共交通不夠完善的地方，歸還駕照可能會讓生活品質顯著下降，這樣的擔憂也被提出。", "word": "懸念" } ],
    [ { "text": "一旦失去購物與就醫的交通方式，就不得不縮小日常生活的範圍，這也可能成為導致高齡者孤立的原因之一。", "word": "余儀なくされる" } ],
    [ { "text": "考量到這樣的情況，有些地方自治團體已開始推動替代交通手段的建置，以及普及配備值得信賴的駕駛輔助功能的車輛。", "word": "足る" } ],
    [ { "text": "與其一律收回駕照，不如說更需要依據個別狀況量身打造出有彈性的制度設計。", "word": "柔軟" } ]
  ],
