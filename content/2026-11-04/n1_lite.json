    [ { "text": "除了長時間工作與伴隨危險的工作內容外，薪資水準與其他行業相比未必較高，也被認為是讓年輕人望而卻步的原因之一。", "word": "一因" } ],
    [ { "text": "政府雖在推動待遇改善與週休二日制的導入，但預料要見到效果仍需一段時間。", "word": "ものの" } ],
    [ { "text": "此外，雖然也有擴大接納外國勞工的動向，但語言與技能認證的障礙依然存在，要在現場穩定留任仍有不少課題。", "word": "定着" } ],
    [ { "text": "因應這種狀況，有些建設公司已開始活用資訊通訊技術，設法減少人力需求。", "word": "省人化" } ],
    [ { "text": "若人手不足持續下去，基礎設施維護與災害復原恐怕也會受到影響，這樣的擔憂正在加深。", "word": "懸念" } ]
  ],
  "grammar_notes": []
}
