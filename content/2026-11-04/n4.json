  "translations": [
    [ { "text": "上週末，我和阿姨去附近的山上撿栗子。", "word": "栗拾い" } ],
    [ { "text": "栗子樹下掉了很多大大小小的栗子，撿來撿去、挑選栗子的過程很開心。", "word": "楽しい" } ],
    [ { "text": "我小心不要碰到有刺的外殼，結果還是痛了好幾次。", "word": "痛い" } ],
    [ { "text": "因為阿姨戴著手套，所以能毫無受傷地撿栗子。", "word": "ので" } ],
    [ { "text": "回程約好要做栗子飯，但因為太累了，今天沒能做成。", "word": "のに" } ],
    [ { "text": "下週一定要一起做栗子飯。", "word": "思う" } ]
