  "translations": [
    [ { "text": "近年，透過智慧型手機或電腦就能接受醫師診察的線上診療正快速普及。", "word": "オンライン診療" } ],
    [ { "text": "以往即使身體不適也必須親自前往醫院，但隨著線上診療的普及，現在即使待在家裡也能接受診察了。", "word": "普及" } ],
    [ { "text": "對於有年幼孩子的家庭，或住在就醫需花費不少時間的地方的人們來說，這種便利性特別大。", "word": "利便性" } ],
    [ { "text": "另一方面，隔著畫面無法直接確認患部狀態的侷限依然存在，也有人指出與面對面診療併用是不可或缺的。", "word": "限界" } ],
    [ { "text": "今後透過完善通訊環境與制度上的支援，讓醫療的可及性變得更加公平，是眾人所期待的。", "word": "求める" } ]
  ],
