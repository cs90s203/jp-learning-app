  "translations": [
    [ { "text": "小時候常因為字寫得醜被父母提醒。", "word": "注意する" } ],
    [ { "text": "那一直是我的心結，長大後也一直想改善。", "word": "直す" } ],
    [ { "text": "去年，因為附近開了書法教室，我下定決心開始去上課。", "word": "思い切る" } ],
    [ { "text": "一開始連拿筆的方式都不懂，被老師糾正了好幾次，但反覆練習後，漸漸有了樣子。", "word": "重ねる" } ],
    [ { "text": "寫字這件事本身，感覺比以前能更沉穩地完成了。", "word": "落ち着く" } ],
    [ { "text": "現在，每週一次的教室，成了忙碌日子中珍貴的時光。", "word": "貴重" } ]
