    [ { "text": "近年，全社區一起守護沒有飼主的貓，也就是所謂「社區貓」的行動正在各地擴展。", "word": "広がる" } ],
    [ { "text": "以往常常發生：不負責任地只餵流浪貓的人，和覺得這造成困擾的人之間的糾紛。", "word": "トラブル" } ],
    [ { "text": "但社區貓活動會先進行絕育手術，在固定的地點和時間餵食，廁所的管理也由居民合作進行。", "word": "行う" } ],
    [ { "text": "這樣的作法一邊防止貓的數量無秩序增加，也讓圍繞糞尿和叫聲的鄰里糾紛減少了。", "word": "防ぐ" } ],
    [ { "text": "行政機關和志工團體舉辦講習會，推廣正確知識，也是這項活動逐漸扎根的背景之一。", "word": "広める" } ],
    [ { "text": "今後，如何在獲得更多居民理解的同時，以可持續的方式繼續這項活動，將是一大課題。", "word": "課題" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜によって", "note": "「依據〜」／「因〜而異」，也用於被動的動作者" }
  ]
