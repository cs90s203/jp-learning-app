  "translations": [
    [ { "text": "在少子化毫無止住跡象的日本，關於出生率下降的討論再度活絡起來。", "word": "活発化する" } ],
    [ { "text": "政府至今雖然推出了兒童津貼擴充、托兒所整備等以育兒家庭經濟支援為中心的政策，但出生率並未出現戲劇性的回升。", "word": "打ち出す" } ],
    [ { "text": "專家之間根深蒂固地指出，僅靠經濟支援無法從根本解決問題，還必須重新檢視以長時間勞動為象徵的工作方式，以及對結婚、生育本身的社會壓力。", "word": "見直す" } ],
    [ { "text": "實際上，針對年輕世代的調查顯示，除了「經濟上的不安」之外，「不想犧牲自己的時間或職涯」這種價值觀的轉變，也被列為少子化的原因之一。", "word": "挙げる" } ],
    [ { "text": "另一方面，無止境的財政支援有其極限，公共資金究竟該投入到什麼程度，也是無法迴避的討論。", "word": "投入する" } ],
    [ { "text": "少子化對策能否不止於一時的灑幣政策，而是連結到對社會結構本身的重新檢視，將是今後被質問的課題。", "word": "問う" } ]
