  "translations": [
    [ { "text": "最近，比起以前，在電車上幾乎看不到看紙本書的人了。", "word": "見かける" } ],
    [ { "text": "取而代之的是，用智慧型手機或平板看電子書的人明顯增加了。", "word": "増える" } ],
    [ { "text": "電子書有行李不會變重、能馬上查詢在意的單字等，紙本書沒有的便利性。", "word": "利便性" } ],
    [ { "text": "另一方面，也有不少人喜歡只有紙本書才有的觸感和翻頁的感覺。", "word": "手触り" } ],
    [ { "text": "就個人而言，通勤時看電子書，在家想悠閒閱讀時就看紙本書，依情況分別使用。", "word": "使い分ける" } ]
