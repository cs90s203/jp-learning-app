  "translations": [
    [ { "text": "上個月，我和媽媽一起去附近的山爬山。", "word": "登山" } ],
    [ { "text": "因為天氣預報說可能會下雨，所以有點擔心。", "word": "心配" } ],
    [ { "text": "不過實際上放晴了，感覺非常舒服。", "word": "気持ちいい" } ],
    [ { "text": "走走山路，拍拍風景照，悠閒地享受了時光。", "word": "楽しむ" } ],
    [ { "text": "到達山頂時，媽媽和我都非常開心。", "word": "嬉しい" } ],
    [ { "text": "下次也想邀爸爸一起，三個人再去爬一次山。", "word": "思う" } ]
