  "translations": [
    [ { "text": "圍繞著選擇性夫婦別姓制度導入與否的討論，在日本社會已經持續多年。", "word": "続く" } ],
    [ { "text": "以十年前誰也未曾想像過的速度，社會意識正在轉變。", "word": "だに" } ],
    [ { "text": "現行民法將夫婦同姓明定為法律婚姻的要件，因此因改姓而產生的個人識別上的不便，以及喪失自我認同感的聲音從未間斷。", "word": "絶つ" } ],
    [ { "text": "贊成派主張，是否改姓應該交由當事者本人的意願決定，而且從國際潮流來看，強制同姓已經不合時宜。", "word": "委ねる" } ],
    [ { "text": "對此，反對派則強調，這可能損害家庭的凝聚力，也可能在子女姓氏上招致新的混亂。", "word": "損なう" } ],
    [ { "text": "儘管民調顯示贊成者佔多數，但政治場域中的意見分歧仍然很大，修法討論遲遲沒有進展。", "word": "隔たり" } ],
    [ { "text": "不過，考量到雙薪家庭增加、國際婚姻普及等社會結構的變化，可以說現行制度已經到了不得不重新檢討的階段。", "word": "見直す" } ],
    [ { "text": "如果就這樣把討論一再拖延下去，當事者恐怕將被迫持續承受不利益。", "word": "余儀なくされる" } ],
    [ { "text": "在擴大當事者選擇空間的同時，也需要一套能兼顧家庭型態價值觀多元性的制度設計。", "word": "配慮する" } ]
  ],
