  "translations": [
    [ { "text": "星期天，我和妹妹一起去了水族館。", "word": "水族館" } ],
    [ { "text": "妹妹喜歡魚，所以從早上就很期待。", "word": "ので" } ],
    [ { "text": "館內雖然人不多，熱門的海豚秀卻是滿座。", "word": "のに" } ],
    [ { "text": "妹妹看到鯨鯊，對牠的體型感到驚訝。", "word": "驚く" } ],
    [ { "text": "我喜歡水獺，一直不停地拍照又拍影片。", "word": "撮る" } ],
    [ { "text": "回程在紀念品店買了海豚玩偶，妹妹非常開心。", "word": "喜ぶ" } ]
  ],
