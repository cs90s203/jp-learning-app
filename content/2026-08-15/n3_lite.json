  "translations": [
    [ { "text": "我在自家陽台開始嘗試家庭菜園。", "word": "家庭菜園" } ],
    [ { "text": "契機是，超市的蔬菜變貴了。", "word": "なる" } ],
    [ { "text": "一開始只種了小番茄和羅勒，沒想到長得比想像中容易，讓我很驚訝。", "word": "育つ" } ],
