  "translations": [
    [ { "text": "開始學書法的契機，是媽媽曾說「字寫得漂亮會佔便宜」。", "word": "言う" } ],
    [ { "text": "一開始連拿筆的方式都不懂，線條完全無法照自己所想畫出來。", "word": "分かる" } ],
    [ { "text": "不過，在跟老師學基礎、反覆練習的過程中，字形漸漸變得工整。", "word": "整う" } ],
    [ { "text": "以前覺得很麻煩，現在只要聞到墨的香氣，心情就會平靜下來。", "word": "落ち着く" } ],
    [ { "text": "字或許還是寫得不好，但漸漸喜歡上寫字這段時間本身。", "word": "好き" } ],
    [ { "text": "今後也打算每星期去教室上一次課。", "word": "つもり" } ],
    [ { "text": "字寫得漂亮這件事，對我來說成了很大的自信。", "word": "自信" } ]
