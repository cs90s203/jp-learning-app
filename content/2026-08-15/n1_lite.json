  "translations": [
    [ { "text": "在物價飛漲侵蝕家計的情況下，許多家庭被迫重新檢視支出。", "word": "迫る" } ],
    [ { "text": "食品和水電燃料費的上漲，因為是生活必需品而無法避免，尤其對低收入家庭的影響格外嚴重。", "word": "深刻" } ],
    [ { "text": "政府雖然祭出了發放補助金等對策，但也有不少人指出其效果只是暫時的。", "word": "ものの" } ],
