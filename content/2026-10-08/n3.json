c_form":"空手","reading":"からて","pos":"名詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"はまっていて","basic_form":"はまる","reading":"はまっていて","pos":"動詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"来年","basic_form":"来年","reading":"らいねん","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"初めて","basic_form":"初めて","reading":"はじめて","pos":"副詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"昇級審査","basic_form":"昇級審査","reading":"しょうきゅうしんさ","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"受ける","basic_form":"受ける","reading":"うける","pos":"動詞"},{"surface_form":"つもり","basic_form":"つもり","reading":"つもり","pos":"名詞"},{"surface_form":"だ","basic_form":"だ","reading":"だ","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"子供":{"meaning":"小孩、孩童時期"},"ころ":{"meaning":"時候、時期"},"テレビ":{"meaning":"電視"},"空手":{"meaning":"空手道"},"試合":{"meaning":"比賽"},"見る":{"meaning":"看"},"かっこいい":{"meaning":"帥氣的、很酷的"},"思う":{"meaning":"覺得、想"},"きっかけ":{"meaning":"契機、起因"},"それから":{"meaning":"從那之後"},"ずっと":{"meaning":"一直"},"憧れる":{"meaning":"憧憬、嚮往"},"なかなか":{"meaning":"（後接否定）怎麼也不、不容易"},"始める":{"meaning":"開始"},"勇気":{"meaning":"勇氣"},"出る":{"meaning":"出現、產生"},"去年":{"meaning":"去年"},"友達":{"meaning":"朋友"},"誘う":{"meaning":"邀約"},"おかげ":{"meaning":"多虧、託…的福"},"やっと":{"meaning":"終於"},"近所":{"meaning":"附近、鄰近"},"道場":{"meaning":"道場"},"通う":{"meaning":"往來、定期前往"},"こと":{"meaning":"事情（形式名詞）"},"する":{"meaning":"做"},"最初":{"meaning":"一開始、最初"},"受け身":{"meaning":"受身（被摔的防護動作）"},"一つ":{"meaning":"一個"},"うまく":{"meaning":"順利地"},"できる":{"meaning":"能夠、做得到"},"先生":{"meaning":"老師"},"丁寧":{"meaning":"仔細、周到"},"教える":{"meaning":"教導"},"くれる":{"meaning":"（別人）為我做…"},"少し":{"meaning":"一點、稍微"},"型":{"meaning":"招式、套路"},"覚える":{"meaning":"記住、學會"},"よう":{"meaning":"…的樣子、變得…"},"なる":{"meaning":"變成"},"今":{"meaning":"現在"},"週":{"meaning":"週"},"三回":{"meaning":"三次"},"はまる":{"meaning":"沉迷、熱衷於"},"来年":{"meaning":"明年"},"初めて":{"meaning":"第一次"},"昇級審査":{"meaning":"升級考試、晉級測驗"},"受ける":{"meaning":"接受、參加（考試）"},"つもり":{"meaning":"打算、意圖"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞、名詞化句子","で":"表示場所、方法，或接在名詞/な形容詞後表示原因","を":"標示動作的受詞","と":"用於引用（と思う）","が":"標示句子的主語，或表示逆接的「但是」","に":"表示時間點、對象或到達點","は":"主題標記","さえ":"「甚至連…」，強調極端的例子","ほど":"表示程度，「〜到…的程度」","ずつ":"表示「每次一點」，漸進的量"},"translations":[[{"text":"小時候在電視上看到空手道比賽，覺得很帥，這就是契機。","word":"きっかけ"}],[{"text":"從那之後我一直很嚮往，但怎麼也提不起開始的勇氣。","word":"憧れる"}],[{"text":"去年，多虧朋友邀約，我終於決定去附近的道場學習。","word":"おかげ"}],[{"text":"一開始連一個受身動作都做不好，但多虧老師一個個仔細教我，我漸漸能記住招式了。","word":"覚える"}],[{"text":"現在我熱衷空手道到每週去三次的程度，明年打算參加第一次的升級考試。","word":"はまる"}]],"grammar_notes":[{"sentence":2,"pattern":"〜おかげで","note":"「多虧〜」，正負面歸因"},{"sentence":2,"pattern":"〜ことにする／〜ことになる","note":"決定／自然而然演變成的結果"},{"sentence":3,"pattern":"〜おかげで","note":"「多虧〜」，正負面歸因"}]}
