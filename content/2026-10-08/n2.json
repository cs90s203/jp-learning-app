"meaning": "智慧型手機"}, "パソコン": {"meaning": "個人電腦"}, "操作": {"meaning": "操作"}, "不安": {"meaning": "不安、擔心"}, "感じる": {"meaning": "感覺到"}, "高齢者": {"meaning": "高齡者、長者"}, "少ない": {"meaning": "少的"}, "そうした": {"meaning": "那樣的"}, "状況": {"meaning": "狀況"}, "受ける": {"meaning": "接受、因應"}, "各地": {"meaning": "各地"}, "公民館": {"meaning": "公民會館、社區中心"}, "図書館": {"meaning": "圖書館"}, "シニア": {"meaning": "年長者、資深"}, "向け": {"meaning": "針對…、以…為對象"}, "デジタル": {"meaning": "數位"}, "講座": {"meaning": "課程、講座"}, "開く": {"meaning": "開辦、舉行"}, "よう": {"meaning": "…的樣子、以便…"}, "なる": {"meaning": "變成"}, "年齢": {"meaning": "年齡"}, "経験": {"meaning": "經驗"}, "応じる": {"meaning": "因應、根據"}, "内容": {"meaning": "內容"}, "調整する": {"meaning": "調整"}, "慣れる": {"meaning": "習慣"}, "人": {"meaning": "人"}, "安心する": {"meaning": "安心"}, "学ぶ": {"meaning": "學習"}, "工夫する": {"meaning": "設法、用心"}, "実際": {"meaning": "實際上"}, "参加する": {"meaning": "參加"}, "人たち": {"meaning": "人們"}, "声": {"meaning": "聲音、意見"}, "聞く": {"meaning": "聽、詢問"}, "家族": {"meaning": "家人"}, "ビデオ通話": {"meaning": "視訊通話"}, "できる": {"meaning": "能夠、可以"}, "こと": {"meaning": "事情（形式名詞）"}, "きっかけ": {"meaning": "契機"}, "生活": {"meaning": "生活"}, "そのもの": {"meaning": "本身"}, "豊か": {"meaning": "豐富、充實"}, "多い": {"meaning": "多的"}, "いう": {"meaning": "說（という＝據說）"}, "今後": {"meaning": "今後、未來"}, "デジタル機器": {"meaning": "數位裝置"}, "通じる": {"meaning": "透過、通達"}, "地域": {"meaning": "地區、社區"}, "つながる": {"meaning": "連結、連繫"}, "さらに": {"meaning": "進一步、更加"}, "増える": {"meaning": "增加"}, "期待する": {"meaning": "期待"}, "こうした": {"meaning": "像這樣的"}}, "particles": {"が": "標示句子的主語", "にもかかわらず": "「儘管〜」，強逆接，較のに更書面", "や": "列舉名詞時用的「和」", "の": "表示所屬關係，或名詞修飾名詞", "に": "表示對象、時間點或方向", "を": "標示動作的受詞", "は": "主題標記", "で": "表示場所、方法或範圍", "も": "「也」，表示並列或強調（〜でも＝即使是…也）", "と": "表示條件（〜と＝一…就…），或用於引用"}, "translations": [[{"text": "儘管高齡化持續加劇，仍有不少高齡者對智慧型手機和電腦的操作感到不安。", "word": "にもかかわらず"}], [{"text": "因應這樣的狀況，各地的公民會館和圖書館開始開辦針對年長者的數位課程。", "word": "講座"}], [{"text": "課程會依照年齡和經驗調整內容，即使是不熟悉操作的人，也能安心學習。", "word": "応じる"}], [{"text": "聽了實際參加者的心聲，很多人表示自從能和家人視訊通話之後，生活本身也變得更豐富了。", "word": "きっかけ"}], [{"text": "今後，希望透過這類課程為契機，有更多高齡者能藉由數位裝置與地區社會建立連結。", "word": "通じる"}]], "grammar_notes": [{"sentence": 0, "pattern": "〜にもかかわらず", "note": "「儘管〜」，強逆接，較のに更書面"}, {"sentence": 2, "pattern": "〜に応じて", "note": "「依據〜而」，對應變化"}, {"sentence": 3, "pattern": "〜をきっかけに", "note": "「以〜為契機」"}, {"sentence": 4, "pattern": "〜を通じて／〜を通して", "note": "「透過〜」，媒介或期間"}]}