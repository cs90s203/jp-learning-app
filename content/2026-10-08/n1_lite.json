な","pos":"形容詞"},{"surface_form":"介護サービス","basic_form":"介護サービス","reading":"かいごサービス","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"受けられない","basic_form":"受ける","reading":"うけられない","pos":"動詞"},{"surface_form":"高齢者","basic_form":"高齢者","reading":"こうれいしゃ","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"さらに","basic_form":"さらに","reading":"さらに","pos":"副詞"},{"surface_form":"増える","basic_form":"増える","reading":"ふえる","pos":"動詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"で","basic_form":"で","reading":"で","pos":"助詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"ない","basic_form":"ない","reading":"ない","pos":"形容詞"},{"surface_form":"か","basic_form":"か","reading":"か","pos":"助詞"},{"surface_form":"と","basic_form":"と","reading":"と","pos":"助詞"},{"surface_form":"懸念されている","basic_form":"懸念する","reading":"けねんされている","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"高齢化":{"meaning":"高齡化"},"加速する":{"meaning":"加速"},"介護":{"meaning":"照護、看護"},"必要":{"meaning":"需要、必要"},"する":{"meaning":"做"},"人":{"meaning":"人"},"数":{"meaning":"數量"},"年々":{"meaning":"逐年"},"増加する":{"meaning":"增加"},"それ":{"meaning":"那個"},"支える":{"meaning":"支撐、支持"},"介護人材":{"meaning":"照護人力"},"不足":{"meaning":"不足、短缺"},"依然として":{"meaning":"依然、仍然"},"深刻":{"meaning":"嚴重的"},"状態":{"meaning":"狀態"},"ある":{"meaning":"有、存在"},"賃金水準":{"meaning":"薪資水準"},"低い":{"meaning":"低的"},"心身":{"meaning":"身心"},"負担":{"meaning":"負擔"},"大きい":{"meaning":"大的"},"離職率":{"meaning":"離職率"},"高い":{"meaning":"高的"},"新た":{"meaning":"新的"},"人材":{"meaning":"人才"},"確保する":{"meaning":"確保、保障"},"こと":{"meaning":"事情（形式名詞）"},"容易":{"meaning":"容易的"},"ない":{"meaning":"沒有、不"},"政府":{"meaning":"政府"},"外国人労働者":{"meaning":"外籍勞工"},"受け入れ":{"meaning":"接納、接受"},"拡大する":{"meaning":"擴大"},"対策":{"meaning":"對策"},"進める":{"meaning":"推進"},"言語":{"meaning":"語言"},"文化":{"meaning":"文化"},"違い":{"meaning":"差異"},"よる":{"meaning":"由於、根據"},"定着":{"meaning":"落地生根、穩定留下"},"難しい":{"meaning":"困難的"},"指摘する":{"meaning":"指出"},"介護現場":{"meaning":"照護現場"},"働く":{"meaning":"工作"},"人々":{"meaning":"人們"},"声":{"meaning":"聲音、意見"},"耳":{"meaning":"耳朵"},"傾ける":{"meaning":"傾（耳）、側耳聆聽"},"業務量":{"meaning":"業務量、工作量"},"多い":{"meaning":"多的"},"比べる":{"meaning":"比較"},"評価":{"meaning":"評價"},"待遇":{"meaning":"待遇"},"十分":{"meaning":"充分的"},"いう":{"meaning":"說（という＝所謂、據說）"},"不満":{"meaning":"不滿"},"根強い":{"meaning":"根深蒂固的"},"残る":{"meaning":"殘留、留下"},"こうした":{"meaning":"像這樣的"},"構造的":{"meaning":"結構性的"},"課題":{"meaning":"課題、問題"},"解決する":{"meaning":"解決"},"質":{"meaning":"品質"},"そのもの":{"meaning":"本身"},"低下する":{"meaning":"下降、降低"},"恐れ":{"meaning":"擔憂、恐怕會…"},"専門家":{"meaning":"專家"},"警鐘":{"meaning":"警鐘"},"鳴らす":{"meaning":"敲響、發出（警鐘）"},"この":{"meaning":"這個"},"まま":{"meaning":"原樣、保持原狀"},"介護サービス":{"meaning":"照護服務"},"受ける":{"meaning":"接受"},"高齢者":{"meaning":"高齡者"},"さらに":{"meaning":"進一步、更加"},"増える":{"meaning":"增加"},"懸念する":{"meaning":"擔憂"}},"particles":{"が":"標示句子的主語，或表示逆接的「但是」","につれて":"「隨著〜」，表示伴隨變化","を":"標示動作的受詞","と":"用於引用，或構成とする、という等表現","の":"表示所屬關係，或名詞修飾名詞","は":"主題標記","から":"表示原因、理由","や":"列舉名詞時用的「和」","へ":"表示方向、對象","で":"表示場所、方法，或接在形容詞/名詞後表示原因、狀態","など":"「等等」，表示列舉未完","に":"表示對象、時間點或方向","か":"用於疑問句，或表示不確定語氣"},"translations":[[{"text":"隨著高齡化加速，需要照護的人數逐年增加，但支撐這一切的照護人力短缺依然十分嚴重。","word":"介護人材"}],[{"text":"由於薪資水準偏低，加上身心負擔沉重，離職率居高不下，要確保新的人力也並不容易。","word":"離職率"}],[{"text":"政府正推動擴大接納外籍勞工等對策，但語言與文化差異導致他們難以久留的問題也被指出。","word":"定着"}],[{"text":"聽聽在照護現場工作的人們的心聲，會發現對於工作量之多、評價與待遇卻不夠充分的不滿情緒根深蒂固。","word":"不満"}],[{"text":"若不解決這種結構性課題，專家警告，照護品質本身恐怕會逐漸下降。","word":"警鐘"}],[{"text":"如此下去，恐怕會有更多高齡者無法獲得充分的照護服務，這一點令人擔憂。","word":"懸念する"}]],"grammar_notes":[]}
