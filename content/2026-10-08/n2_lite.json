","reading":"つかえる","pos":"動詞"},{"surface_form":"サービス","basic_form":"サービス","reading":"サービス","pos":"名詞"},{"surface_form":"へ","basic_form":"へ","reading":"へ","pos":"助詞"},{"surface_form":"と","basic_form":"と","reading":"と","pos":"助詞"},{"surface_form":"進化していく","basic_form":"進化する","reading":"しんかしていく","pos":"動詞"},{"surface_form":"こと","basic_form":"こと","reading":"こと","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"期待されている","basic_form":"期待する","reading":"きたいされている","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"近年":{"meaning":"近年"},"スマートフォン":{"meaning":"智慧型手機"},"フリマアプリ":{"meaning":"二手交易App（跳蚤市場app）"},"使う":{"meaning":"使用"},"不要":{"meaning":"不需要、不要的"},"なる":{"meaning":"變成"},"品物":{"meaning":"物品"},"売買する":{"meaning":"買賣"},"人":{"meaning":"人"},"増える":{"meaning":"增加"},"従来":{"meaning":"以往、傳統上"},"リサイクルショップ":{"meaning":"二手商店"},"比べる":{"meaning":"比較"},"自分":{"meaning":"自己"},"値段":{"meaning":"價格"},"決める":{"meaning":"決定"},"上":{"meaning":"（接在動詞後）再加上、不僅如此"},"写真":{"meaning":"照片"},"説明文":{"meaning":"說明文字"},"工夫する":{"meaning":"用心設計、想辦法"},"思う":{"meaning":"覺得、想"},"以上":{"meaning":"以上"},"価格":{"meaning":"價格"},"売れる":{"meaning":"賣得出去"},"こと":{"meaning":"事情（形式名詞）"},"ある":{"meaning":"有、存在"},"特に":{"meaning":"特別、尤其"},"若い":{"meaning":"年輕的"},"世代":{"meaning":"世代"},"中心":{"meaning":"中心"},"洋服":{"meaning":"衣服"},"ゲーム機":{"meaning":"遊戲機"},"本":{"meaning":"書"},"気軽":{"meaning":"輕鬆、不費心思"},"出品する":{"meaning":"上架出售、出品"},"文化":{"meaning":"文化"},"広がる":{"meaning":"擴展、普及"},"一方":{"meaning":"另一方面"},"取引相手":{"meaning":"交易對象"},"トラブル":{"meaning":"糾紛、麻煩"},"実物":{"meaning":"實物、真品"},"違い":{"meaning":"差異"},"よる":{"meaning":"由於、根據"},"返品依頼":{"meaning":"退貨請求"},"新た":{"meaning":"新的"},"課題":{"meaning":"課題、問題"},"生まれる":{"meaning":"產生、誕生"},"こうした":{"meaning":"像這樣的"},"問題":{"meaning":"問題"},"減らす":{"meaning":"減少"},"ため":{"meaning":"為了（目的）"},"各":{"meaning":"各個"},"アプリ":{"meaning":"App、應用程式"},"本人確認":{"meaning":"身份驗證"},"評価制度":{"meaning":"評價制度"},"強化する":{"meaning":"強化"},"今後":{"meaning":"今後、未來"},"利用者":{"meaning":"使用者"},"安心する":{"meaning":"安心"},"サービス":{"meaning":"服務"},"進化する":{"meaning":"進化、演進"},"期待する":{"meaning":"期待"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞","を":"標示動作的受詞","に":"表示對象、時間點或方向","が":"標示句子的主語","で":"表示場所、方法或範圍","や":"列舉名詞時用的「和」，表示非完全列舉","も":"「也」，表示並列或強調","など":"「等等」，表示列舉未完","つつ":"「一邊〜一邊」或「正在〜」的書面語","と":"表示「跟…」，或構成へと等方向表現","へ":"表示移動的方向","は":"主題標記"},"translations":[[{"text":"近年，越來越多人使用智慧型手機上的二手交易App，買賣不再需要的物品。","word":"フリマアプリ"}],[{"text":"與傳統的二手商店相比，不僅可以自己決定價格，只要在照片和說明文字上用心，有時還能以超出預期的價格賣出。","word":"工夫する"}],[{"text":"尤其以年輕世代為中心，隨意上架衣服、遊戲機、書籍等的文化正逐漸普及。","word":"広がる"}],[{"text":"另一方面，與交易對象之間的糾紛，以及因照片與實物不同而產生的退貨請求等，新的課題也隨之出現。","word":"課題"}],[{"text":"為了減少這類問題，各App正在強化身份驗證與評價制度，未來也被期待能進化成讓使用者安心使用的服務。","word":"進化する"}]],"grammar_notes":[]}
