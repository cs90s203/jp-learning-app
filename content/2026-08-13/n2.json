  "translations": [
    [ { "text": "過去說到地區清掃活動，給人的印象多半是以町內會為主體、由高齡者主導進行的，但近年透過社群媒體號召的形式，讓年輕世代的參與變得顯著。", "word": "SNS" } ],
    [ { "text": "尤其是假日早晨，在海岸或公園邊撿垃圾邊做輕度運動的「Plogging」活動，加上民眾對環境問題關注度提升，也逐漸受到歡迎。", "word": "プロギング" } ],
    [ { "text": "參加者當中，也不少人已超越單純志工的意識，是為了尋求與地區居民的連結才前往參加。", "word": "つながり" } ],
    [ { "text": "另一方面，持續營運活動的推動人手不足，以及資金方面的課題依然存在，呼籲行政給予支援的聲音也在增加。", "word": "後押し" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜を通じて／〜を通して", "note": "「透過〜」，媒介或期間" }
  ]
