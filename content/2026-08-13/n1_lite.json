  "translations": [
    [ { "text": "每年一到八月，因為趁盂蘭盆節假期返鄉的人潮，高速公路和新幹線都會嚴重壅塞，這種所謂的返鄉車潮每年都成為話題。", "word": "帰省ラッシュ" } ],
    [ { "text": "有些路段的塞車會持續數小時，平常只要數小時就能到達的距離，花上一倍以上的時間也不稀奇。", "word": "渋滞" } ],
    [ { "text": "背後的原因在於，盂蘭盆節假期全國幾乎重疊，使得移動需求集中在特定的日子，這是一種結構性的問題。", "word": "構造的" } ],
    [ { "text": "面對這種狀況，呼籲錯峰返鄉的行動，以及利用遠距工作在人潮較少的平日返鄉的人，也逐漸增加。", "word": "時差帰省" } ],
    [ { "text": "話雖如此，由於一年只能和家人見上幾次面，依然有許多人認為就算多少擁擠一點，也寧願睜一隻眼閉一隻眼、在同一時期返鄉，根本性的解決至今仍未實現。", "word": "抜本的" } ]
  ],
