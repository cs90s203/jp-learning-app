    [ { "text": "老師曾說：「比起結果，更要重視過程」。", "word": "大事" } ],
    [ { "text": "多虧那句話，我變得能夠不焦躁地持續下去。", "word": "おかげで" } ],
    [ { "text": "現在每週去道場兩次，已經成了我的樂趣。", "word": "楽しみ" } ],
