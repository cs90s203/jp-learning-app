  "translations": [
    [ { "text": "近年，隨著大學升學率的上升，使用獎學金（學貸）的學生也在增加。", "word": "奨学金" } ],
    [ { "text": "但是，也不斷有人指出，畢業後的還款負擔沉重地壓在年輕人的生活規劃上。", "word": "返済負担" } ],
    [ { "text": "對於深受非正式雇用與低薪所苦的畢業生而言，每個月的還款絕非輕鬆的負擔，據說也成了讓人猶豫結婚生子的原因之一。", "word": "にとって" } ],
    [ { "text": "其中也有人為了還款，被迫改變自己原本希望的升學或就業方向。", "word": "余儀なくされる" } ],
    [ { "text": "一旦還款遲滯，除了會被加收滯納金之外，信用資訊也會留下污點，甚至可能影響到將來的房貸審查等。", "word": "影響する" } ],
    [ { "text": "面對這樣的狀況，要求擴充依所得調整還款金額之制度的呼聲也日益高漲。", "word": "応じる" } ],
    [ { "text": "在保障教育機會均等的同時，建立一套不讓年輕人背負過度負擔的機制，可說是當務之急。", "word": "仕組みづくり" } ],
    [ { "text": "加深對制度的理解、及早擬定還款計畫，也是不可或缺的。", "word": "欠かせない" } ]
