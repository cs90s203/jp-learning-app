  "translations": [
    [ { "text": "作為工作方式改革的一環，企業依員工意願選擇週休三日的「選擇性週休三日制」正備受關注。", "word": "選択的週休三日制" } ],
    [ { "text": "與政府的推動相結合，部分先進企業已經開始導入。", "word": "と相まって" } ],
    [ { "text": "已導入的企業紛紛表示，員工的工作與生活平衡獲得改善，也有報告指出這有助於降低離職率、提升招募競爭力。", "word": "ワークライフバランス" } ],
    [ { "text": "然而，勞動時間本身並未因此縮短，休假增加的份量恐怕會使每天的業務量隨之增加，這樣的憂慮依然根深蒂固。", "word": "懸念" } ],
    [ { "text": "尤其對苦於人力不足的中小企業而言，想導入卻無法導入才是實情，也有人指出企業規模造成的差距恐將擴大。", "word": "実情" } ],
    [ { "text": "此外，維持薪資不變、只增加休假天數的制度設計並不容易，也有批評認為恐將招致實質性的薪資下降。", "word": "賃金低下" } ],
    [ { "text": "一直以來以終身雇用為前提的日本企業評價制度，如今也面臨被迫重新檢討的處境。", "word": "ならでは" } ],
    [ { "text": "在討論這項制度的是非時，不僅是休假天數的多寡，業務效率化與評價制度的重新檢討等，重新審視整體工作方式的視角也不可或缺。", "word": "のみならず" } ]
  ],
