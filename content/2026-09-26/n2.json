  "translations": [
    [ { "text": "作為兼顧減少食物浪費與扶助生活困苦者的對策，食物銀行活動正在全國各地擴展開來。", "word": "フードバンク" } ],
    [ { "text": "所謂食物銀行，是指將明明還能食用卻遭丟棄的食品，從企業與家庭收集起來，無償提供給有需要的人們的一種機制。", "word": "仕組み" } ],
    [ { "text": "以前只是少數非營利團體小規模經營，但受到食物浪費問題報導的影響，企業與地方政府也開始積極合作。", "word": "きっかけに" } ],
