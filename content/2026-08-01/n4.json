  "translations": [
    [ { "text": "上星期週末，我和哥哥去附近的山上露營。", "word": "キャンプ" } ],
    [ { "text": "兩個人一起努力搭好帳篷，所以比想像中更早就準備好了。", "word": "頑張る" } ],
    [ { "text": "晚上一邊生營火，一邊吃零食、聽音樂，過得很開心。", "word": "楽しい" } ],
    [ { "text": "星星非常漂亮，如果用雙筒望遠鏡，甚至能看到流星。", "word": "見る" } ],
    [ { "text": "雖然有點冷，但能和哥哥慢慢聊天覺得很好。", "word": "話す" } ]
