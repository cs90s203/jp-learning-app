  "translations": [
    [ { "text": "近年，像送餐代跑、個人計程車這類不受雇於特定企業，而是透過應用程式承接單次工作的所謂零工工作者正在增加。", "word": "ギグワーカー" } ],
    [ { "text": "雖然能有彈性的工作方式受到肯定，但不被視為勞動基準法上勞工的案例很多，容易被排除在最低薪資、勞災保險等保障之外。", "word": "労働者" } ],
    [ { "text": "一旦因事故或身體不適而無法工作，若補償不足，不少人將被迫面臨收入減少。", "word": "余儀なくされる" } ],
    [ { "text": "面對這種情況，部分地方政府與企業已出現引進自有補償制度的動向，但全國性的法律完善仍未跟上，這是現實狀況。", "word": "補償制度" } ],
    [ { "text": "正值零工工作方式在社會逐漸扎根的此刻，建立具備實效性的保護制度刻不容緩。", "word": "実効性" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜を余儀なくされる", "note": "「被迫～」，書面被動" }
  ]
}
