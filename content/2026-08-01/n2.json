  "translations": [
    [ { "text": "全國各地的商店街，因後繼無人及與大型店鋪的競爭，長年來鐵捲門緊閉的空店鋪一直被視為問題。", "word": "空き店舗" } ],
    [ { "text": "但近年，將這類空店鋪以低租金出租給年輕世代的創業者，改造成咖啡廳或雜貨店的做法，正在各地擴展開來。", "word": "取り組み" } ],
    [ { "text": "不少地方政府設有補助部分改裝費用的制度，對於持有空店鋪的地主來說，除了能獲得收入，還有貢獻地方的好處。", "word": "メリット" } ],
    [ { "text": "不過，這類嘗試往往需要花時間才能上軌道，若過度追求短期成果，反而有可能損害整個商店街的活力，也有這樣的指摘。", "word": "損なう" } ],
    [ { "text": "從永續社區營造的角度來看，需要以長遠的眼光守護與觀察。", "word": "見守る" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜かねない", "note": "「有可能會～（負面）」" }
  ]
}
