  "translations": [
    [ { "text": "小時候，我曾跟祖母學過摺紙。", "word": "教わる" } ],
    [ { "text": "但是，長大後就完全忘了，有好一陣子沒有機會接觸。", "word": "忘れる" } ],
    [ { "text": "沒想到上個月，職場同事跟我說「聽說摺紙可以提高專注力」，我便以此為契機重新開始。", "word": "きっかけ" } ],
    [ { "text": "一開始手指不聽使喚，讓我很吃力，但隨著練習，漸漸有了雛形。", "word": "苦労する" } ],
    [ { "text": "看似單純的作業，其實色彩與角度的組合會讓表情大大不同，這點很有趣。", "word": "によって" } ],
    [ { "text": "現在工作空檔摺紙，成了小小的喘息時光。", "word": "息抜き" } ]
  ],
