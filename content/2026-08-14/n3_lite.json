    [ { "text": "最近，我開始養成睡前讀書的習慣。", "word": "習慣" } ],
    [ { "text": "契機是朋友說過「讀書會讓心情平靜下來」。", "word": "落ち着く" } ],
    [ { "text": "一開始選了難懂的書，結果一直讀不下去。", "word": "難しい" } ],
    [ { "text": "於是換成更簡單的小說之後，意外地變得容易堅持下去。", "word": "続ける" } ],
