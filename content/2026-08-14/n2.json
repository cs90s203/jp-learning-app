  "translations": [
    [ { "text": "以都市地區為中心，共享單車的使用正急速擴展開來。", "word": "シェアサイクル" } ],
    [ { "text": "它作為彌補傳統大眾運輸的移動方式而受到矚目，越來越多人將它納入通勤、購物等日常移動之中。", "word": "取り入れる" } ],
    [ { "text": "環境負擔較低以及健康意識的提升，也助長了這樣的使用者增加。", "word": "後押しする" } ],
    [ { "text": "導入初期，不少人擔憂遭棄置自行車增加的問題，但隨著專用停靠站的建置推進，這個問題也逐漸獲得改善。", "word": "につれて" } ],
    [ { "text": "話雖如此，使用者違反禮儀規範，以及歸還站分布不均導致的自行車不足等課題依然存在，尚未解決。", "word": "とはいえ" } ],
    [ { "text": "今後，行政機關與業者攜手合作，打造因應實際使用狀況的營運體制，將是必要之舉。", "word": "応じる" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜に応じて", "note": "「依據〜而」，對應變化" }
  ]
