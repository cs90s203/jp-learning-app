  "translations": [
    [ { "text": "在少子高齡化伴隨而來的勞動力短缺背景下，關於擴大接納外籍人才的議論再度趨於活躍。", "word": "労働力不足" } ],
    [ { "text": "政府提出擴大特定技能制度適用領域的方針，但這是否等同於實質上轉向移民政策，專家的見解分歧很大。", "word": "みなす" } ],
    [ { "text": "推進派主張，這不僅能支撐飽受人力短缺所苦的產業，多元人才的流入也可能為經濟帶來新的活力。", "word": "主張する" } ],
    [ { "text": "另一方面，慎重派則警告，若在接納體制尚未健全的情況下就草率擴大規模，恐將導致薪資下降與勞動環境惡化。", "word": "招く" } ],
    [ { "text": "尤其有人根深蒂固地指出，若缺乏語言教育與住宅保障等生活基礎的支援，僅是增加人數，社會融合反而會漸行漸遠。", "word": "遠のく" } ],
    [ { "text": "此外，如何防患未然地避免與地方社會產生摩擦，這樣的視角也不可或缺。", "word": "欠かせない" } ],
    [ { "text": "政策設計不應僅被視為單純的勞動力調度，而更需要站在如何建構共生社會的長期視角之上。", "word": "築く" } ]
  ],
