  "translations": [
    [ { "text": "上個月，我和妹妹去爬了附近的山。", "word": "登る" } ],
    [ { "text": "妹妹沒有爬山的經驗，所以我有點擔心，但我們一邊慢慢休息一邊順利爬了上去。", "word": "できる" } ],
    [ { "text": "途中，我們拍拍照、吃吃便當，度過了愉快的時光。", "word": "過ごす" } ],
    [ { "text": "從山頂看到的風景非常美，雖然兩人都很累，卻都覺得「來了真好」。", "word": "きれい" } ],
    [ { "text": "明年也想再一起爬一次。", "word": "一緒に" } ]
