  "translations": [
    [ { "text": "日本各地的自來水基礎設施老化問題正在加劇，如何判斷更新的時機已成為一大論點。", "word": "老朽化" } ],
    [ { "text": "許多自來水管都是在高度經濟成長期建置的，不少早已超過預設的使用年限。", "word": "耐用年数" } ],
    [ { "text": "若放任老化的管線不管，漏水與斷水的風險必然提高，但要在全國同時進行更新工程需要龐大的費用，因此也出現了被迫將費用反映到水費上的地方政府。", "word": "余儀なくされる" } ],
    [ { "text": "人口減少越嚴重的地區，自來水事業的收入基礎越脆弱，也有人指出僅靠收費收入恐怕無法籌出更新費用。", "word": "捻出する" } ],
    [ { "text": "考量到這樣的狀況，也出現了多個地方政府透過跨區域合作共同營運自來水事業的動向，但由於達成共識需要時間，實際情況是尚未達到根本性的解決。", "word": "広域連携" } ],
    [ { "text": "支撐生活基礎的自來水，該以何種可持續的形式維持下去，這需要舉國上下的討論。", "word": "持続可能" } ]
