  "translations": [
    [ { "text": "在人力不足日益嚴重之際，擴大接納外籍勞工的趨勢正在加速。", "word": "外国人労働者" } ],
    [ { "text": "尤其在照護、建設等領域，承擔人力的不足日益嚴重，「沒有外籍人才，現場就無法運作」的說法也不罕見。", "word": "現場" } ],
    [ { "text": "然而，接納制度的完善與現場的實際狀況相結合，依然存在諸多課題。", "word": "相まる" } ],
    [ { "text": "由於語言隔閡與生活支援不足，不少勞工加深了孤立感，也因此與地區社會產生摩擦。", "word": "孤立感" } ],
    [ { "text": "雖然有些地方自治體正推動日語教室、住房支援等獨自的措施，但並非所有自治體都有充裕的財政餘裕。", "word": "独自" } ],
    [ { "text": "若不能以共同生活的居民、而非單純的勞動力來迎接他們，這項制度恐怕終將被迫流於形式。", "word": "余儀なくされる" } ]
  ],
