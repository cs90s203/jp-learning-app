  "translations": [
    [ { "text": "週末去了爺爺家，下了將棋。", "word": "将棋" } ],
    [ { "text": "爺爺將棋下得非常厲害，我怎麼也贏不了。", "word": "できる" } ],
    [ { "text": "有輸有贏，大概玩了三個小時。", "word": "遊ぶ" } ],
    [ { "text": "因為累了，休息時喝了茶、吃了點心。", "word": "休憩" } ],
    [ { "text": "爺爺一邊說著以前的事，一邊仔細教我怎麼移動棋子。", "word": "教える" } ],
    [ { "text": "雖然很難，但和爺爺下將棋總是很開心。", "word": "楽しい" } ],
    [ { "text": "下週也想一起下棋。", "word": "指す" } ]
