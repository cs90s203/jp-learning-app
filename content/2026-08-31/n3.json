  "translations": [
    [ { "text": "我開始學劍道的契機，是在電視上看到的一場比賽。", "word": "きっかけ" } ],
    [ { "text": "選手們喊出「一本」時那股氣勢十足的模樣，深深打動了我的心。", "word": "打つ" } ],
    [ { "text": "原本以為自己不擅長運動，實際嘗試後才發現活動身體意外地讓人開心。", "word": "楽しい" } ],
    [ { "text": "雖然每週去道場兩次，但光是穿上不習慣的護具就費了一番功夫。", "word": "防具" } ],
    [ { "text": "練習雖然嚴格，前輩們卻會溫柔地跟我搭話。", "word": "優しい" } ],
    [ { "text": "因為也要學正坐和禮儀規矩，所以我覺得劍道與其說是單純的運動，不如說是鍛鍊精神的場所。", "word": "精神" } ],
    [ { "text": "雖然還是初學者，但希望總有一天能請前輩指點、一起練習。", "word": "先輩" } ]
  ],
