  "translations": [
    [ { "text": "近年，隨著高齡化與單身家庭的增加，讓地區居民能輕鬆聚會的社區咖啡館正逐漸在各地擴展開來。", "word": "コミュニティカフェ" } ],
    [ { "text": "這類活用空置店鋪的行動，即使不依賴行政補助金，也有不少是靠居民彼此合作經營的案例。", "word": "協力" } ],
    [ { "text": "一位經營者表示，自己是因為察覺到鄰里往來逐漸減少而感到危機，才以此為契機開設了這間咖啡館。", "word": "危機感" } ],
    [ { "text": "「我想找回那種彼此認識的關係」，這位經營者這樣說道。", "word": "関係" } ],
    [ { "text": "雖然營業僅限於每週幾次，對常客來說卻是珍貴的交流場所。", "word": "交流" } ],
    [ { "text": "儘管如此，仍面臨接班人高齡化與資金不足等課題，如何傳承給下一個世代似乎將成為今後的焦點。", "word": "引き継ぐ" } ]
  ],
