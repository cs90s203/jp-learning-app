  "translations": [
    [ { "text": "近年，隨著網路購物的擴大，使用「置き配（宅配置於門口）」的人增加了。", "word": "置き配" } ],
    [ { "text": "這是指配送員把包裹放在玄關前等地方的方式，特徵是即使收件人不在家也能收到包裹。", "word": "受け取る" } ],
    [ { "text": "對工作的世代來說，減少再次配送的麻煩是一大優點。", "word": "メリット" } ],
    [ { "text": "另一方面，擔心遭竊或包裹破損的聲音也不少。", "word": "心配する" } ],
    [ { "text": "因此，最近設置宅配置物袋或置物箱的家庭也增加了。", "word": "設置する" } ],
    [ { "text": "此外，網路超市的食品配送也漸漸能夠選擇置き配了。", "word": "選ぶ" } ],
    [ { "text": "今後，應該會需要更安全的機制。", "word": "安全" } ]
