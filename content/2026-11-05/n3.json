  "translations": [
    [ { "text": "開始學將棋，是受到祖父的影響。", "word": "影響" } ],
    [ { "text": "小時候，看到祖父總是一個人看將棋的書，覺得很不可思議。", "word": "不思議" } ],
    [ { "text": "有一天，祖父邀我「要不要一起玩看看」，教了我規則。", "word": "誘う" } ],
    [ { "text": "一開始連棋子的移動方法都不太懂，但隨著對局累積，漸漸看得懂戰略了。", "word": "対局" } ],
    [ { "text": "對祖父來說，將棋是多年的愛好；對我來說，則是新的挑戰。", "word": "とって" } ],
    [ { "text": "另一方面，輸的時候還是常常感到不甘心。", "word": "一方" } ],
    [ { "text": "今後也想繼續向祖父挑戰。", "word": "挑む" } ]
