  "translations": [
    [ { "text": "在少子高齡化不斷發展的日本，以勞動力不足為背景，認為應進一步擴大接受外籍勞工的意見正在增強。", "word": "外国人労働者" } ],
    [ { "text": "與人口減少相結合，建築、照護、農業等領域的人力不足已達到無法再忽視的程度。", "word": "相まる" } ],
    [ { "text": "推動派主張，只要擴大接受外籍勞工，就能確保足以維持經濟活力的勞動力。", "word": "足る" } ],
    [ { "text": "另一方面，若接受體制尚未完善就只增加人數，也有人根深蒂固地擔心這會招致勞動條件惡化及與地區社會的摩擦。", "word": "懸念" } ],
    [ { "text": "實際上，據指出，因語言障礙與生活習慣差異而陷入孤立的勞工也不少。", "word": "孤立する" } ],
    [ { "text": "考量到這些課題，不應只是擴大接受人數，也理應同時推動日語教育、居住支援等生活基礎的完善。", "word": "しかるべきだ" } ],
    [ { "text": "就國家整體而言，不應只把外國人視為單純的勞動力，而應以共同生活者的身分來接納他們——這樣的態度正受到檢視。", "word": "姿勢" } ]
  ],
