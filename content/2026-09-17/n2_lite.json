  "translations": [
    [ { "text": "近年，透過網路即使在家也能上課的線上家教服務逐漸普及。", "word": "オンライン家庭教師サービス" } ],
    [ { "text": "與傳統面對面授課不同，講師和學生能透過視訊通話共享畫面學習，因此就算住在地方的學生，也能接受來自都市優秀講師的指導。", "word": "対面授業" } ],
    [ { "text": "收費制度也趨於多樣化，除了月費制之外，選擇只依需要次數上課方案的使用者也在增加。", "word": "多様化する" } ],
    [ { "text": "另一方面，也有人指出因網路環境差異，導致授課品質參差不齊的課題。", "word": "指摘する" } ],
    [ { "text": "儘管如此，由於較不受時間和地點限制這項優點，預計今後使用者仍會持續增加。", "word": "利点" } ]
  ],
