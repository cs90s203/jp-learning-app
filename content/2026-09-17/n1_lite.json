  "translations": [
    [ { "text": "近年，大學畢業後為償還獎學金所苦的年輕人的存在，正逐漸被視為一項社會問題。", "word": "認識する" } ],
    [ { "text": "尤其隨著升學率上升，獎學金使用人數本身也呈現增加的趨勢。", "word": "増加傾向" } ],
    [ { "text": "獎學金原本應該是支援因經濟因素而不得不放棄升學的學生的制度，但由於畢業後就業不穩定，停留在非正式雇用的人也不少，導致償還成為沉重的負擔，這是現實存在的問題。", "word": "のしかかる" } ],
    [ { "text": "一旦拖欠償還，信用資訊便會受到影響，甚至有結婚、購屋等人生選項因此受限的案例被報導出來。", "word": "狭める" } ],
    [ { "text": "因應這樣的狀況，要求擴充給付型獎學金與宣導償還緩期制度的呼聲雖然高漲，但礙於財源限制，尚未達到根本性的改善。", "word": "高まる" } ],
    [ { "text": "重新檢視獎學金制度應有的樣貌，可以說是左右年輕人未來規劃的重要課題。", "word": "見直す" } ]
