  "translations": [
    [ { "text": "夫妻可以在結婚時選擇任一方姓氏的「選擇性夫妻別姓制度」，其引進與否的議論近年再度活躍起來。", "word": "選択的夫婦別姓制度" } ],
    [ { "text": "現行民法規定夫妻必須同姓，因改姓而衍生的手續繁瑣，以及職涯因此中斷所帶來的不滿，長年以來一直被指出，尤以女性為甚。", "word": "義務付ける" } ],
    [ { "text": "贊成派主張，不想改姓這種個人的自我認同理應受到尊重，而且在家庭形式日趨多元的時代，堅持舊有制度的合理理由已經很難找到了。", "word": "尊重する" } ],
    [ { "text": "另一方面，反對派則擔憂家庭的一體感與子女姓氏可能引發的混亂，主張對於制度的引進應保持慎重。", "word": "懸念する" } ],
    [ { "text": "民意調查顯示贊成選擇性夫妻別姓的聲音逐年增加，但國會的修法討論遲遲沒有進展，至今已一再被擱置。", "word": "先送りにする" } ],
    [ { "text": "無視當事人的迫切心聲、議論一再空轉的現狀，不得不說是立法機關的失職。", "word": "怠慢" } ],
    [ { "text": "今後應如何實現一個容許多元家庭形式的社會，是再次被提出的課題。", "word": "許容する" } ]
  ],
