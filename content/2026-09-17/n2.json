  "translations": [
    [ { "text": "在全國各地人口減少與高齡化持續加劇之中，如何活用空屋已成為一大課題。", "word": "空き家" } ],
    [ { "text": "遭到放置的空屋不僅在防範犯罪與景觀方面讓周邊居民感到不安，有時還伴隨著倒塌的危險。", "word": "放置する" } ],
