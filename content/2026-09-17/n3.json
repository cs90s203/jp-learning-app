  "translations": [
    [ { "text": "小時候，每次去祖母家玩，她總是會在和室裡為我點茶。", "word": "点てる" } ],
    [ { "text": "我喜歡那段安靜的時光，一直想著長大後自己也要試著做做看。", "word": "好き" } ],
    [ { "text": "上個月，我得知附近的公民館要開茶道教室，就鼓起勇氣報名了。", "word": "申し込む" } ],
    [ { "text": "一開始光是記規矩就竭盡全力，但多虧老師仔細的指導，漸漸習慣了茶室的氣氛。", "word": "慣れる" } ],
    [ { "text": "得知點茶的每一個動作都有其意義後，我才發現這不只是一杯飲料而已。", "word": "気づく" } ],
    [ { "text": "我打算今後也繼續學下去。", "word": "つもり" } ],
    [ { "text": "透過茶道，我覺得自己漸漸能更用心地重新審視每天的生活。", "word": "見つめ直す" } ]
  ],
  "grammar_notes": [
