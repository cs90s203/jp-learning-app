  "translations": [
    [ { "text": "在地方城市，商店街的空店面正在增加，另一方面，以嶄新方式活用這些空間的動向也逐漸擴大。", "word": "空き店舗" } ],
    [ { "text": "以政府補助整修費用為契機，越來越多年輕創業者開設咖啡廳或雜貨店的案例逐漸引人注目。", "word": "きっかけ" } ],
    [ { "text": "與以往的商店不同，不少店家透過社群媒體發布資訊，成功吸引到遠方的顧客上門。", "word": "通じる" } ],
    [ { "text": "不過，也有不少人只因房租便宜而進駐，卻招攬不到顧客，開店幾個月就不得不撤退的例子層出不窮。", "word": "ものの" } ],
    [ { "text": "如果不選擇符合當地居民需求的經營型態，好不容易活用的空店面也可能只是曇花一現的流行而已。", "word": "終わる" } ],
    [ { "text": "若要以永續的方式讓商店街重生，行政機關與業者雙方持續的努力都不可或缺。", "word": "欠かす" } ]
  ],
