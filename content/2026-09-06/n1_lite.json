  "translations": [
    [ { "text": "車子曾經是年輕人憧憬的象徵，但近年這種價值觀正大幅改變。", "word": "価値観" } ],
    [ { "text": "由於都市地區的大眾交通工具發達，加上共享汽車和租車服務也日益完善，越來越多年輕人不覺得有必要特地擁有一輛車。", "word": "所有する" } ],
    [ { "text": "此外，維護費和保險費等經濟負擔之重，似乎也成了讓人猶豫購車的原因。", "word": "ためらう" } ],
    [ { "text": "透過社群媒體就能輕鬆獲得交通方式資訊，這一點也助長了不持有車子的選擇。", "word": "後押しする" } ],
    [ { "text": "不過，在地方，車子依然是生活中不可或缺的代步工具，都市和地方對車子的意識落差依然很大。", "word": "欠かす" } ],
    [ { "text": "今後，汽車業界要如何回應這種世代與地區之間的需求差異，仍是一大課題。", "word": "応える" } ]
  ],
  "grammar_notes": []
}
