  "translations": [
    [ { "text": "小時候身材矮小，常常在打架中輸掉。", "word": "負ける" } ],
    [ { "text": "每次感到不甘心，就會想著要變強。", "word": "強い" } ],
    [ { "text": "長大後偶然得知車站前開了一間合氣道道場，就鼓起勇氣去參觀了。", "word": "道場" } ],
    [ { "text": "對利用對方力量來摔投的招式深受感動，覺得這樣應該能持續下去。", "word": "感動する" } ],
    [ { "text": "不依賴蠻力、冷靜面對對手的這種想法也很吸引我。", "word": "惹く" } ],
    [ { "text": "道場的氣氛也很溫暖，容易持續下去。", "word": "雰囲気" } ],
    [ { "text": "現在每週去兩次，感覺不只是身體，連心態都漸漸改變了。", "word": "変わる" } ]
