  "translations": [
    [ { "text": "夫妻在結婚時能各自選擇想用的姓氏，也就是所謂選擇性夫婦別姓制度的引進，儘管在國會屢次被提出討論，卻遲遲無法定案。", "word": "選択的夫婦別姓制度" } ],
    [ { "text": "贊成派指出，因改姓而產生的職業上不利益及自我認同的喪失感，主張唯有尊重個人選擇的制度，才符合多樣的生活方式。", "word": "生き方" } ],
    [ { "text": "對此，反對派則認為夫婦同姓象徵著家庭的一體感，若承認別姓，家庭的羈絆恐將因此變弱，呼籲應重視與傳統價值觀的一致性。", "word": "絆" } ],
    [ { "text": "民調顯示贊成引進制度的回答占過半數，但另一方面，圍繞家庭觀的保守派抵抗依然根深蒂固，執政黨內部的意見整合並不容易。", "word": "保守層" } ],
    [ { "text": "該讓孩子的姓氏統一成哪一方，這種實務上的課題，也是使議論變得複雜的原因之一。", "word": "一因" } ],
    [ { "text": "最高法院雖一直以來判定現行夫婦同姓規定合憲，但質疑其與國際人權標準是否一致的聲音也不斷出現，也有人指出這不應只交由司法判斷。", "word": "司法判断" } ],
    [ { "text": "今後，切合當事人雙方實際情況的制度設計理應被加快推進，同時促使整個社會意識轉變的踏實對話也不可或缺。", "word": "制度設計" } ]
  ],
