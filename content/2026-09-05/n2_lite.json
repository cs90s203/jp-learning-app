  "translations": [
    [ { "text": "近年，隨著人手不足和人事成本上升，超市和便利商店引進自助結帳機的店鋪正快速增加。", "word": "セルフレジ" } ],
    [ { "text": "由於採用顧客自己掃描條碼、結完帳的機制，排隊等候的時間大幅縮短，這是其優點。", "word": "短縮される" } ],
    [ { "text": "以往和收銀員的交流也是購物樂趣之一，但如今越重視效率的顧客，越傾向選擇自助結帳。", "word": "傾向" } ],
    [ { "text": "對不熟悉操作的高齡者來說，也有不易使用的一面，因此店員在旁協助的機制也不可或缺。", "word": "欠かせない" } ],
    [ { "text": "另一方面，機器故障或順手牽羊等風險課題依然存在，如何在便利性之間取得平衡，可能會成為今後的焦點。", "word": "課題" } ]
  ],
  "grammar_notes": [
    { "sentence": 0, "pattern": "〜に伴って", "note": "「伴隨〜」，同步變化" }
