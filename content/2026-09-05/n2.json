  "translations": [
    [ { "text": "近年，隨著小學程式設計教育列為必修，放學後讓孩子去上程式設計教室的家庭，以都市地區為中心正在增加。", "word": "プログラミング教室" } ],
    [ { "text": "以往這類教室僅限於部分教育熱心的家庭，但隨著線上課程的普及，地方的孩子們也能輕鬆地上課了。", "word": "オンライン授業" } ],
    [ { "text": "教室裡多半透過遊戲製作來學習程式設計的基礎，據說孩子們一邊樂在其中，一邊培養了邏輯思考能力。", "word": "論理的思考力" } ],
    [ { "text": "不過，月費偏高、講師素質參差不齊等課題也被指出，因經濟狀況而導致能接受的教育出現差距的疑慮依然根深蒂固。", "word": "懸念" } ],
    [ { "text": "今後，需要透過擴充地方自治體的補助金制度等方式，打造一個人人都能平等學習的環境。", "word": "環境づくり" } ]
  ],
  "grammar_notes": [
