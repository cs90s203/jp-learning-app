  "translations": [
    [
      {
        "text": "近年，透過智慧型手機應用程式訂餐的外送服務使用越來越普及。",
        "word": "通じる"
      }
    ],
    [
      {
        "text": "過去能叫外送的店家有限，但現在許多餐飲店都加入了這類服務，選擇大幅增加。",
        "word": "限る"
      }
    ],
    [
      {
        "text": "外送員以自行車或機車把餐點送到的機制已經成形，在忙碌或不想外出時十分方便好用。",
        "word": "重宝する"
      }
    ],
    [
      {
        "text": "另一方面，也有人指出外送員的勞動環境、以及店家負擔的手續費過重等問題。",
        "word": "指摘する"
      }
    ],
    [
      {
        "text": "即便如此，隨著生活方式的改變，預期今後使用者仍會持續增加。",
        "word": "増える"
      }
    ]
  ],
