  "translations": [
    [ { "text": "近年，以地方為中心，藥劑師不足的問題日益嚴重。", "word": "不足" } ],
    [ { "text": "特別是在調劑藥局有限的人口稀少地區，有不少居民必須長途移動才能領到藥。", "word": "過疎地域" } ],
    [ { "text": "此外，藥劑師集中於都市地區的傾向也在加劇，據說這有可能動搖地方醫療體制本身。", "word": "揺るがす" } ],
    [ { "text": "其背景原因包括：比起都市地區工作條件更為嚴苛，以及容易對未來職涯發展感到不安等等。", "word": "キャリア形成" } ],
    [ { "text": "政府雖透過獎學金制度與住宅補助，推動藥劑師在地方就業，但也有不少人指出其效果有限。", "word": "後押しする" } ],
    [ { "text": "該如何確保有志從事藥劑師這項專業職務的人才，並讓他們在地方扎根，這將是今後持續引發議論的課題。", "word": "定着する" } ],
    [ { "text": "基於這樣的狀況，改善待遇與提升業務效率等綜合性對策已刻不容緩。", "word": "対策" } ]
