  "translations": [
    [ { "text": "近年，伴隨著人口減少與高齡化，全國各地空屋數量不斷增加，其活用方式也備受關注。", "word": "伴う" } ],
    [ { "text": "過去，空屋多半被放任不管、逐漸老舊，常在防範犯罪與景觀方面被視為問題。", "word": "問題視する" } ],
    [ { "text": "但近來，以地方政府與非營利組織為中心，將空屋翻修成咖啡廳、共享住宅，或作為地區居民的交流據點重新利用的做法正逐漸普及。", "word": "再生する" } ],
    [ { "text": "一邊保留老建築獨有的風趣一邊翻修，也能創造出新的價值，這一點同樣受到肯定。", "word": "生み出す" } ],
    [ { "text": "另一方面，儘管地方政府備有補助制度，但要取得屋主許可仍相當困難的案例也不少，許多地區因此遲遲無法推動活用。", "word": "にもかかわらず" } ],
    [ { "text": "話雖如此，將空屋重新視為地區資源的這股趨勢，預期今後會越來越普及。", "word": "動き" } ]
  ],
