  "translations": [
    [ { "text": "開始學茶道的原因，是受到祖母的影響。", "word": "きっかけ" } ],
    [ { "text": "從小就有很多機會喝祖母點的茶，一直想著自己將來也要試試看。", "word": "点てる" } ],
    [ { "text": "實際去教室上課後才發現，每一個動作都有它的意義，讓我對其中的深奧感到驚訝。", "word": "奥深さ" } ],
    [ { "text": "一開始跪坐很難受，有時腳還會發麻，但隨著漸漸習慣，那段時間變成了讓人平靜下來的片刻。", "word": "慣れる" } ],
    [ { "text": "說到茶道，容易讓人有一種拘謹嚴肅的印象，但實際上它是重視待人之心的溫暖文化。", "word": "がち" } ],
