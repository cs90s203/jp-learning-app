  "translations": [
    [ { "text": "近年，讓有意願的員工每週可以休三天假的所謂選擇性週休三日制，導入此制度的企業正逐漸增加。", "word": "増えつつある" } ],
    [ { "text": "推動派主張，依照育兒、照護、重新進修等各自的情況來選擇工作方式的這種彈性，正是留住並確保人才的關鍵。", "word": "柔軟性" } ],
    [ { "text": "事實上，在為人手不足所苦的業界，有一種根深蒂固的看法認為，有無這類制度恐怕會左右招募的成敗。", "word": "左右する" } ],
    [ { "text": "另一方面，謹慎派則指出，假期一旦增加，每人平均的工作量必然會隨之增加，結果反而可能助長長時間工作。", "word": "助長する" } ],
    [ { "text": "如果薪資是依休假天數而遭減額的機制，也有人擔心將會出現被迫面對生活不穩定的員工。", "word": "余儀なくされる" } ],
    [ { "text": "雙方的主張各有相應的依據，並非能簡單地論斷孰優孰劣。", "word": "論じられる" } ],
    [ { "text": "話雖如此，不顧勞動者價值觀日益多樣化的現狀，繼續維持傳統那種一律化的勤務體制，恐怕已經不再現實，不得不這麼說。", "word": "ものともせず" } ],
    [ { "text": "企業被要求推動符合自身事業特性的制度設計。", "word": "求める" } ]
  ],
