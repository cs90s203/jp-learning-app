  "translations": [
    [ { "text": "上週日，我和爸爸去海邊釣魚了。", "word": "釣り" } ],
    [ { "text": "因為很早出門，有點想睡。", "word": "早い" } ],
    [ { "text": "在防波堤上一邊拋線、一邊換餌，等了好幾個小時。", "word": "待つ" } ],
    [ { "text": "明明怎麼也釣不到魚，最後卻能釣到一隻大的，非常感動。", "word": "釣れる" } ],
    [ { "text": "爸爸從以前就常常釣魚，教了我很多技巧。", "word": "コツ" } ],
    [ { "text": "回程的車上，兩人邊笑邊聊。", "word": "笑う" } ]
