  "translations": [
    [ { "text": "在高齡化不斷加劇的日本，負責照護工作的人力不足已成為嚴重的社會問題。", "word": "高齢化" } ],
    [ { "text": "根據厚生勞動省的推估，未來十幾年內將出現數十萬人規模的照護員短缺，第一線的人力不足已經達到無法忽視的程度。", "word": "推計" } ],
    [ { "text": "背後的原因，有人指出薪資過低、與工作的辛苦程度不成比例，而居高不下的離職率也加劇了這個情況。", "word": "低賃金" } ],
    [ { "text": "近年來，雖然透過擴大接納外國勞工來確保人力的趨勢正在擴展，但因語言與文化的差異，留任率依然偏低。", "word": "定着率" } ],
    [ { "text": "要突破這樣的現狀，薪資的改善自不待言，職場環境的完善、社會評價的提升等多方面的努力，恐怕都是不可或缺的。", "word": "取り組み" } ],
    [ { "text": "若就這樣放任不管，恐怕連照護服務本身的品質都會變得難以維持。", "word": "維持する" } ]
  ],
  "grammar_notes": []
}
