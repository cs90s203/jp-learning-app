  "translations": [
    [ { "text": "我開始學盆栽的原因，是爺爺家裡擺著的一棵松樹。", "word": "盆栽" } ],
    [ { "text": "它雖然很小卻很有氣勢，我忍不住問「這是花了幾年做出來的？」，爺爺笑著回答「三十年喔」。", "word": "堂々と" } ],
    [ { "text": "這句話讓我受到衝擊，漸漸也想自己嘗試看看。", "word": "衝撃" } ],
    [ { "text": "實際開始之後，澆水的分量、修剪樹枝的方法等，要學的事情多得不得了，一開始淨是失敗。", "word": "水やり" } ],
    [ { "text": "另一方面，當漸漸能看出樹木的變化時，就愈來愈被它的深奧之處吸引。", "word": "一方で" } ],
    [ { "text": "最終讓我意識到，盆栽終究是一件需要花時間去面對的事。", "word": "気づく" } ]
