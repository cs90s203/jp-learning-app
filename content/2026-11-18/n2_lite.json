  "translations": [
    [ { "text": "近年來，不需要用鑰匙、用智慧型手機就能開關的「智慧門鎖」，導入的家庭正在增加。", "word": "スマートロック" } ],
    [ { "text": "和以往的鑰匙不同，因為可以用密碼或指紋解鎖，不用擔心忘記帶鑰匙。", "word": "解錠" } ],
    [ { "text": "此外，因為在外也能確認家人的出入情況，在有年邁父母的家庭中也逐漸普及開來。", "word": "出入り" } ],
    [ { "text": "另一方面，也有人擔心停電或電池耗盡時會打不開門，因此猶豫是否要導入的人也不少。", "word": "ためらう" } ],
    [ { "text": "即使如此，隨著防範意識的提升，一般認為今後需求仍會持續成長。", "word": "伴う" } ],
    [ { "text": "價格也降到數千日圓的水準，比以前更容易入手，這點也推動了普及。", "word": "普及" } ]
  ],
