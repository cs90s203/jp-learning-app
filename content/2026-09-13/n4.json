  "translations": [
    [ { "text": "上個月，在祖母家過夜，一起做了草木染。", "word": "草木染め" } ],
    [ { "text": "用院子裡摘的洋蔥皮和葉子熬煮，聽說可以煮出顏色。", "word": "出す" } ],
    [ { "text": "把布浸泡在染料裡、再用水清洗的作業，比想像中花時間。", "word": "かかる" } ],
    [ { "text": "聽說有時候也會染不好，不過這次染成了漂亮的黃色。", "word": "染まる" } ],
    [ { "text": "因為能用自己的雙手做出顏色很開心，所以還想再挑戰一次。", "word": "できる" } ]
