  "translations": [
    [ { "text": "為了支援因經濟因素無法獲得充分飲食的孩童，由地區居民免費或以低價提供餐點的「兒童食堂」，透過口耳相傳在全國各地擴展開來。", "word": "広がり" } ],
    [ { "text": "承擔營運核心的，多半是退休後的高齡者，或是育兒告一段落的主婦們的志工，很大程度上是靠他們的善意才得以成立。", "word": "ボランティア" } ],
    [ { "text": "然而，作為場地的公民館使用費及食材費等，營運資金的籌措絕非易事，實際情況是不得不仰賴捐款及地方政府的補助金。", "word": "頼る" } ],
    [ { "text": "除此之外，據指出，越是真正需要支援的家庭，越會因不想讓人知道經濟狀況的抗拒感，而遲遲不敢使用這項服務。", "word": "ためらう" } ],
    [ { "text": "今後，其角色被期待不僅止於提供餐點，也能擴展到學習支援與打造棲身之所等方面。", "word": "期待する" } ]
