  "translations": [
    [ { "text": "以計程車嚴重不足的地方城市為中心，要求全面解禁「共乘服務」的呼聲日益高漲——也就是讓一般駕駛用自用車有償載客的做法。", "word": "解禁" } ],
    [ { "text": "推進派認為，面對深夜及過疎地區缺乏交通工具這一迫切課題，現行做法有過度優先計程車業界利益的傾向，並主張只要完善安全管理，就沒有理由對放寬管制猶豫不決。", "word": "きらい" } ],
    [ { "text": "另一方面，慎重派則擔憂，若在駕駛資格審查及事故責任歸屬仍不明確的情況下就導入制度，恐怕會使使用者的安全被拋在腦後；並以多國曾相繼出現勞動環境惡化的前例為鑑，反駁草率導入應當避免。", "word": "置き去りにする" } ],
    [ { "text": "國土交通省目前的方針是，僅限於在計程車公司管理下運行的有限形式來實施，但批評聲浪依然強烈，認為這終究只是妥協方案，根本性的制度設計不過是被擱置延後而已。", "word": "妥協案" } ],
    [ { "text": "應當構建出符合各地實際情況的靈活制度，今後議論的走向備受關注。", "word": "しかるべき" } ]
  ],
