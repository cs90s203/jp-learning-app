  "translations": [
    [ { "text": "在過疎地區或都市裡的住宅區，附近沒有商店，連日常購物都很困難，這樣的「購物弱者」正逐漸增加。", "word": "弱者" } ],
    [ { "text": "過去在步行範圍內原本存在的商店街，因後繼無人及大型店進駐而被迫關門，無法開車的高齡者受到的影響尤其嚴重。", "word": "余儀なくされる" } ],
    [ { "text": "雖然地方政府及業者正推動引進行動販賣車、擴充宅配服務等對策，但也有不少因入不敷出而撤退的案例，尚未達到根本性的解決。", "word": "撤退する" } ],
    [ { "text": "不僅止於送達食物，將其視為關懷與交流機會的一面也重新受到重視，需要整個地區共同支撐的機制。", "word": "見直す" } ],
    [ { "text": "今後不能只依賴地方政府，還需要結合地區居民之間的互助及與民間企業的合作等多方面的努力。", "word": "頼る" } ]
  ],
