  "translations": [
    [ { "text": "醫師集中在都市地區的同時，地方及人口稀少地區的醫師不足問題日益嚴重，醫師分布不均是長年以來的課題。", "word": "医師偏在" } ],
    [ { "text": "即使增加醫學院的招生名額，畢業後選擇在都市醫院工作的醫師仍佔多數，尚未達到根本性的解決。", "word": "根本的" } ],
    [ { "text": "雖然有意見認為應該導入強制規定醫師到地方任職的制度，但也有不少專家擔心這可能侵害醫師的職業選擇自由，因而抱持謹慎立場。", "word": "職業選択" } ],
    [ { "text": "實際上，在偏遠地區的診所，往往一位醫師就得看診範圍廣大的患者，因過度勞動而離職的情況也層出不窮。", "word": "過重労働" } ],
