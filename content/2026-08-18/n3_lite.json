  "translations": [
    [ { "text": "最近開始在家附近的教室嘗試瑜珈。", "word": "ヨガ" } ],
    [ { "text": "原本覺得身體很僵硬會不好意思，但老師說「不用勉強，照自己的步調就好」，讓我放鬆了不少。", "word": "先生" } ],
    [ { "text": "配合呼吸慢慢活動身體的過程中，能感覺到多餘的力氣漸漸放鬆下來。", "word": "呼吸" } ],
    [ { "text": "上完課之後，不只是身體，連腦袋也感覺變得清爽。", "word": "すっきりする" } ],
    [ { "text": "雖然還有一些做不到的困難姿勢，但漸漸變得柔軟了一點，讓我很開心。", "word": "嬉しい" } ],
    [ { "text": "打算今後也每週去上一次課。", "word": "つもり" } ]
