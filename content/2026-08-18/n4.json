  "translations": [
    [ { "text": "上週末，我和哥哥一起去了當天來回的腳踏車旅行。", "word": "自転車旅行" } ],
    [ { "text": "因為天氣很好，我們沿著海邊的路騎車，途中也在咖啡店休息一下，就這樣一路前進。", "word": "走る" } ],
    [ { "text": "哥哥雖然說自己已經不年輕了，卻騎得比我還快。", "word": "速い" } ],
    [ { "text": "沿海的道路非常安靜，可以一路欣賞遠方的風景。", "word": "できる" } ],
    [ { "text": "中午吃了當地的魚料理，哥哥和我都非常滿足。", "word": "大満足" } ],
    [ { "text": "還想再跟哥哥兩個人一起去騎車。", "word": "思う" } ]
