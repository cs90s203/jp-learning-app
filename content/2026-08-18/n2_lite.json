  "translations": [
    [ { "text": "在醫院拿藥的時候，過去必須把紙本處方箋帶去藥局。", "word": "処方箋" } ],
    [ { "text": "然而近年來，一種透過網路交換處方資訊的機制「電子處方箋」正逐漸被導入。", "word": "電子処方箋" } ],
    [ { "text": "以健保卡整合的普及為契機，導入這套系統的醫療機構與藥局逐漸增加，患者不用隨身攜帶紙本也能領藥。", "word": "普及" } ],
    [ { "text": "對醫師和藥劑師來說，也有更容易確認重複用藥或藥物交互作用的優點。", "word": "利点" } ],
    [ { "text": "另一方面，系統的導入成本，以及對高齡者來說使用上的不便，這類課題也被指出。", "word": "課題" } ]
  ],
