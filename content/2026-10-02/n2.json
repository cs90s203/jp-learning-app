  "translations": [
    [ { "text": "希望孩子從小學階段就開始學程式設計的家庭增加了，各地也漸漸能看到針對兒童的程式設計教室擴展開來。", "word": "広がり" } ],
    [ { "text": "其中一個契機，是學校教育將程式設計列為必修課。", "word": "必修化する" } ],
    [ { "text": "有些家長覺得光靠學校課程進度跟不上，因而更傾向讓孩子去上民間的教室。", "word": "傾向" } ],
    [ { "text": "教室裡大多使用能像玩遊戲一樣學習的視覺化軟體，孩子們在玩樂中培養邏輯思考能力。", "word": "論理的思考力" } ],
    [ { "text": "另一方面，月費負擔較重，且教室數量因地區而有差異，這也被指出是一項課題。", "word": "課題" } ],
    [ { "text": "話雖如此，隨著線上課程的普及，城市與地方之間的教育機會差距，可以說正逐漸縮小。", "word": "伴う" } ]
  ],
  "grammar_notes": [
