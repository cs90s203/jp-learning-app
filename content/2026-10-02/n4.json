  "translations": [
    [ { "text": "前幾天，我和爸爸一起開始做盆栽。", "word": "盆栽づくり" } ],
    [ { "text": "在小樹上纏鐵絲、調整樹枝的形狀，作業了大約兩個小時。", "word": "整える" } ],
    [ { "text": "爸爸從以前就喜歡盆栽，所以教了我很多技巧。", "word": "好き" } ],
    [ { "text": "比想像中更需要力氣，手指都痛了，但看到完成的盆栽就有滿足感。", "word": "満足感" } ],
    [ { "text": "雖然是很困難的作業，但因為能一邊跟爸爸聊天一邊做，所以是很開心的時光。", "word": "楽しい" } ],
    [ { "text": "今後也想一點一點地繼續下去。", "word": "続ける" } ]
