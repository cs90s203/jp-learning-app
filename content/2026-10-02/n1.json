  "translations": [
    [ { "text": "高齡駕駛者接連發生交通事故的報導不斷出現，使得駕照歸還的議題再次變得熱絡。", "word": "議論" } ],
    [ { "text": "根據警察廳的說法，雖然達到一定年齡的駕駛人被要求接受認知功能檢測，但只要通過檢測就能繼續開車，因此也有人指出其實質的遏止效果有限。", "word": "実質的" } ],
    [ { "text": "歸還駕照雖然能降低事故風險，但在大眾交通不夠完善的地方，一旦沒有駕照，連看病、買東西都可能變得困難。", "word": "困難" } ],
    [ { "text": "面對懷有這類難處的高齡者，也有不少家人認為單方面催促歸還駕照未免太殘酷，而表現出近乎這麼說的反應。", "word": "酷" } ],
    [ { "text": "事實上，也有案例指出歸還駕照後生活品質急速下降，因為外出機會減少而加速了身心的衰退。", "word": "衰え" } ],
    [ { "text": "話雖如此，站在受害者的立場，也有強烈的聲音認為，不能以高齡者的處境為理由而一再拖延對策。", "word": "先送りにする" } ],
    [ { "text": "站在保護受害者的觀點來看，也有不少根深蒂固的意見認為對策應該盡快被強化。", "word": "しかるべきだ" } ],
    [ { "text": "說到底，不應該把駕照歸還這個選擇完全交由個人判斷，而是該建立替代交通方式的完善配套、擴充允許有限度駕駛的制度等由整個社會共同支撐的機制，這或許才是這場議論真正該解決的核心。", "word": "仕組みづくり" } ]
  ],
