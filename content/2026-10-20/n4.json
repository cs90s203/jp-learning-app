  "translations": [
    [ { "text": "上週末，我和父親去了附近的露營場。", "word": "キャンプ場" } ],
    [ { "text": "搭帳篷花了不少時間，但因為父親幫忙，所以順利完成了準備。", "word": "ので" } ],
    [ { "text": "晚上一邊生營火，一邊聊以前的事、看星星，度過了這段時光。", "word": "たり" } ],
    [ { "text": "明明聽得到蟲鳴聲，父親卻睡得很熟，讓我覺得有點好笑。", "word": "のに" } ],
    [ { "text": "早餐是我們兩人一起做了來吃。", "word": "朝ごはん" } ],
    [ { "text": "我還想再和父親兩人一起去一次。", "word": "思う" } ]
