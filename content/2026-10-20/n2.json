  "translations": [
    [ { "text": "隨著高齡化的推進，社區裡獨自生活的高齡者正在增加。", "word": "伴う" } ],
    [ { "text": "以這樣的現況為契機，利用空店舖改造而成的社區咖啡館正在各地逐漸擴展開來。", "word": "きっかけに" } ],
    [ { "text": "在咖啡館裡，住在附近的高齡者和育兒中的親子都能輕鬆前來，一邊喝茶一邊享受聊天的樂趣。", "word": "立ち寄る" } ],
    [ { "text": "營運大多靠志工進行，雖然資金不足的情況也不少，但透過當地居民的協助，仍有不少地方能一點一點地持續經營下去。", "word": "通じる" } ],
    [ { "text": "其中也有像開設讓使用者互相教導拿手技能的教室這類獨具用心的地方。", "word": "教え合う" } ],
    [ { "text": "來自行政機關的支援目前仍有限，但這類活動的重要性，今後應該會愈發提高。", "word": "高まる" } ]
  ],
