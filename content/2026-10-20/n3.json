  "translations": [
    [ { "text": "開始學圍棋的契機，是因為祖父的影響。", "word": "きっかけ" } ],
    [ { "text": "小時候，每次去祖父家，看到棋盤就會想「這個好難」。", "word": "たびに" } ],
    [ { "text": "上大學以後，突然產生了興趣，便開始去附近的圍棋教室上課。", "word": "通い始める" } ],
    [ { "text": "一開始連簡單的規則都記不住，吃了不少苦，但在老師和同伴的指導下不斷練習，漸漸體會到其中的樂趣。", "word": "ものの" } ],
    [ { "text": "平日因為工作很忙，但一到週末，就會滿腦子都想著圍棋的事。", "word": "一方で" } ],
    [ { "text": "今後我也想盡可能長久地繼續下圍棋。", "word": "続ける" } ]
