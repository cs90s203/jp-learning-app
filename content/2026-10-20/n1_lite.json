  "translations": [
    [ { "text": "近年，飼養寵物的家庭增加，但另一方面，地方的獸醫師不足問題正日益嚴重。", "word": "獣医師" } ],
    [ { "text": "相較於都市地區，地方的動物醫院數量較少，不少飼主為了看診不得不長途移動。", "word": "動物病院" } ],
    [ { "text": "據說獸醫師這個職業，除了長工時、休假日少之外，雖然需要專業技術，待遇卻不夠充分，因此有意從事的人越來越少。", "word": "伸び悩む" } ],
    [ { "text": "此外，許多在大學學習獸醫學的學生，畢業後大多選擇都市地區的醫院，使得與地方之間的差距愈發擴大。", "word": "傾向" } ],
    [ { "text": "要改善這樣的狀況，不只是重新檢視待遇，充實支援地方工作的制度也是不可或缺的。", "word": "拡充" } ],
    [ { "text": "為了維持守護動物生命的體制，行政機關與相關團體也必須攜手合作、致力於對策。", "word": "取り組む" } ]
