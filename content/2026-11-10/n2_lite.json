  "translations": [
    [ { "text": "近年，從音樂、影像，到衣服、家具，各種領域的訂閱制服務正在擴展。", "word": "サブスクリプションサービス" } ],
    [ { "text": "這是一種不用一次性購買，而是透過支付月費，只在需要時使用服務的機制。", "word": "仕組み" } ],
    [ { "text": "這種機制普及的背景之一，是以智慧型手機的普及為契機，使支付變得簡單。", "word": "きっかけ" } ],
    [ { "text": "此外，不執著於擁有的消費者增加，也是一個很大的因素。", "word": "消費者" } ],
    [ { "text": "另一方面，也有人指出，不知不覺間簽約越簽越多，導致支出增加的問題。", "word": "問題点" } ],
    [ { "text": "今後，使用者選擇適合自己生活方式的服務的能力，恐怕會越來越受到重視。", "word": "選ぶ" } ]
