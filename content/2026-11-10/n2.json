  "translations": [
    [ { "text": "日本各地的空屋持續增加，根據總務省的調查，這個數字逐年擴大。", "word": "空き家" } ],
    [ { "text": "伴隨人口減少與高齡化，屋主過世後住宅未被活用就遭放置的情況，是目前的現狀。", "word": "放置する" } ],
    [ { "text": "為了改善這種狀況，各地出現了將空屋便宜租下翻修，改造成咖啡廳或住宿設施重新利用的措施。", "word": "取り組み" } ],
    [ { "text": "依地方政府不同，有些設有補助空屋翻修費用的制度，對使用者來說是令人安心的支援。", "word": "支援" } ],
    [ { "text": "話雖如此，不少地區尚未建立起連結屋主與承租人的完善機制，不得不說空屋的活用仍處於發展階段。", "word": "言う" } ],
    [ { "text": "今後，將空屋視為地區資源重新看待的觀點，恐怕會變得越來越重要。", "word": "視点" } ]
  ],
