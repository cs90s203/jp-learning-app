  "translations": [
    [ { "text": "上週六，我和姊姊去附近的公園賞花了。", "word": "花見" } ],
    [ { "text": "滻花還沒盛開，但非常漂亮。", "word": "満開" } ],
    [ { "text": "鋪好野餐墊，吃便當、拍照。", "word": "食べる" } ],
    [ { "text": "風很大、有點冷，姊姊卻一直在笑。", "word": "笑う" } ],
    [ { "text": "明年想更早一點去，希望能看到盛開的滻花。", "word": "できる" } ],
    [ { "text": "姊姊一直很喜歡賞花，每年都很期待。", "word": "楽しみ" } ]
