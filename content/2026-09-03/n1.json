  "translations": [
    [ { "text": "在日本的勞動市場中，圍繞解僱規範修正的議論再度升溫。", "word": "再燃する" } ],
    [ { "text": "在現行制度下，企業解僱正式員工的門檻極高，這與僵化的僱用慣例相結合，被指出是導致薪資停滯的原因，此一看法根深蒂固。", "word": "と相まって" } ],
    [ { "text": "主張放寬管制的論者認為，只要建置解僱的金錢解決制度，企業就能更果斷地進行人才汰換，結果將提升整體勞動市場的流動性。", "word": "説く" } ],
    [ { "text": "另一方面，勞方與工會強烈反彈，認為解僱自由化恐怕會被資方利用，蘊藏著威脅生活基礎的危險。", "word": "反発する" } ],
    [ { "text": "實際上，過去在放寬管制的討論中，企業方的盤算往往搶先一步，勞工保護遭到忽視的案例也不少。", "word": "なおざり" } ],
    [ { "text": "在雙方主張正面對立之際，政府仍維持在參考專家會議討論的同時，避免草率下結論的態度。", "word": "踏まえる" } ],
    [ { "text": "這個問題與工作方式相關的價值觀變化也密切交織在一起，看來難以在短時間內得到解決。", "word": "絡み合う" } ]
  ],
