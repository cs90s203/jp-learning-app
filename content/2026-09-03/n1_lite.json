  "translations": [
    [ { "text": "近年，公立學校的教師短缺日趨嚴重，為教育現場投下了巨大的陰影。", "word": "深刻化する" } ],
    [ { "text": "找不到人來代理產假或病假的空缺，有些學校甚至不得已在沒有導師的情況下迎接新學期。", "word": "やむを得ず" } ],
