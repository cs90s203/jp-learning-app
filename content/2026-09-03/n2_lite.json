  "translations": [
    [ { "text": "最近，以都市地區為中心，電動滑板車的使用迅速普及。", "word": "広がる" } ],
    [ { "text": "不需要駕照的機型也陸續登場，逐漸成為年輕人通勤、購物的代步工具。", "word": "使う" } ],
    [ { "text": "便利雖然是它的魅力，但另一方面，人行道上的事故和違規停車等問題也接連發生。", "word": "一方で" } ],
    [ { "text": "尤其在公共交通不便的地方城市，作為新的交通方式，人們對它的期待也逐漸升高。", "word": "高まる" } ],
    [ { "text": "有些地方政府開始新設停車空間，或是加嚴使用規則。", "word": "整備する" } ],
    [ { "text": "隨著普及，交通規則與保險制度的建置也被加緊推動。", "word": "伴う" } ],
    [ { "text": "該如何在便利與安全之間取得平衡，恐怕是今後的課題。", "word": "課題" } ]
  ],
