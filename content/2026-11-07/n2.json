  "translations": [
    [ { "text": "近年，支援陷入困境家庭的食物銀行活動在各地逐漸擴展開來。", "word": "フードバンク" } ],
    [ { "text": "以食物浪費增加為契機，從企業與農家收取剩餘的食品，再送到真正需要的人手中，這樣的機制逐漸建立起來。", "word": "食品ロス" } ],
    [ { "text": "儘管經濟狀況嚴峻，仍有不少人對尋求援助感到抗拒，因此透過諮詢窗口慢慢推動利用的措施也在進行中。", "word": "抵抗" } ],
    [ { "text": "隨著物價上漲，據說使用者人數有逐年增加的傾向。", "word": "物価" } ],
    [ { "text": "地方政府也不得不依捐款狀況調整分配量，營運絕非一件輕鬆的事。", "word": "調整する" } ],
    [ { "text": "即便如此，正因為是深耕地方的活動，志工的協助仍不間斷地持續著。", "word": "ボランティア" } ],
    [ { "text": "今後恐怕還需要強化與行政機關之間的合作。", "word": "連携強化" } ]
  ],
