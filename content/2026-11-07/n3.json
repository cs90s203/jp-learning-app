  "translations": [
    [ { "text": "去年秋天，在祖母的建議下開始學習花道。", "word": "華道" } ],
    [ { "text": "一開始我心想：「插花而已，哪有那麼難？」", "word": "難しい" } ],
    [ { "text": "可是實際嘗試後才驚訝地發現，花的方向和留白的處理方式，會讓作品的印象大大不同。", "word": "驚く" } ],
    [ { "text": "老師常說：「對花來說，找到最自然的樣子才是最重要的。」", "word": "自然" } ],
    [ { "text": "另一方面，也要求展現出自己的個性，所以並不簡單。", "word": "個性" } ],
    [ { "text": "隨著不斷練習，漸漸覺得與花相對的這段時間本身，就是能讓內心平靜下來的事物。", "word": "落ち着く" } ],
    [ { "text": "之後也決定要繼續學下去。", "word": "続ける" } ]
  ],
