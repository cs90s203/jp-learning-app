  "translations": [
    [ { "text": "在高齡化持續加劇的日本，照護人員的人手不足已成為嚴重的課題。", "word": "人手不足" } ],
    [ { "text": "薪資偏低與勞動環境的嚴峻，再加上身心負擔沉重，據說也導致了離職問題。", "word": "離職" } ],
    [ { "text": "雖然也有擴大引進外籍勞工的動向，但由於語言障礙與制度複雜，許多情況仍未能真正穩定留任。", "word": "外国人労働者" } ],
    [ { "text": "雖然導入科技來提升業務效率的機構也增加了，但在人與人的互動不可或缺的照護現場，機器並非能取代一切。", "word": "介護" } ],
    [ { "text": "尤其在地方，確保人才更加困難，甚至出現機構本身難以維持運作的案例。", "word": "人材" } ],
    [ { "text": "有不少人指出，如果不改善待遇，就無法解決人才不足的問題。", "word": "待遇" } ],
    [ { "text": "今後恐怕得一邊重新檢視薪資水準，一邊打造能讓人持續工作下去的環境，這才是當務之急。", "word": "賃金水準" } ]
