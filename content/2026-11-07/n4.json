  "translations": [
    [ { "text": "星期天和哥哥一起去開車兜風了。", "word": "ドライブ" } ],
    [ { "text": "有時沿著海邊的路行駛，有時在途中的咖啡廳休息。", "word": "走る" } ],
    [ { "text": "因為天氣很好，所以開著窗開車。", "word": "良い" } ],
    [ { "text": "隔了好久能和哥哥好好聊天，真的很開心。", "word": "楽しい" } ],
    [ { "text": "回程的路上，雖然路很擠、有點累，但哥哥幫忙開車，讓我鬆了一口氣。", "word": "助かる" } ],
    [ { "text": "下個月也打算一起開到很遠的地方。", "word": "予定" } ]
