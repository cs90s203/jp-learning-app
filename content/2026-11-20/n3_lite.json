  "translations": [
    [ { "text": "一直很在意的書法，從上個月終於開始嘗試了。", "word": "始める" } ],
    [ { "text": "準備齊全道具比想像中花了更多時間，但因為找到了好老師而安心了。", "word": "安心する" } ],
    [ { "text": "一開始連握筆的方法都很難，失敗了好幾次。", "word": "失敗する" } ],
    [ { "text": "不過在持續練習的過程中，感覺字漸漸變得整齊了。", "word": "整う" } ],
    [ { "text": "老師對我說「不要著急，要享受過程」，心情就輕鬆了。", "word": "楽しむ" } ],
    [ { "text": "今後也打算不勉強自己，按照自己的步調繼續練習。", "word": "つもり" } ]
