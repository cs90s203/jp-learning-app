  "translations": [
    [ { "text": "婚後夫婦可以選擇各自保留不同姓氏，也就是所謂選擇性夫婦別姓制度的引進議題，長年以來始終存在著贊成與反對的分歧。", "word": "議論" } ],
    [ { "text": "贊成派主張，因改姓而產生的工作上的不便與身分認同的喪失不容忽視，尊重個人選擇的制度才更適合現代社會。", "word": "主張する" } ],
    [ { "text": "事實上，不少人曾被迫中斷職涯，或為繁瑣的改姓手續所苦。", "word": "余儀なくされる" } ],
    [ { "text": "另一方面，反對派則主張，夫婦同姓是支撐家庭凝聚感的傳統，不該輕易改變。", "word": "伝統" } ],
    [ { "text": "也有不少人根深蒂固地認為，家庭的連結正是建立在姓氏共有的前提之上，再加上少子化這項社會課題，對家庭觀轉變感到擔憂的聲音依然強烈。", "word": "相まる" } ],
    [ { "text": "雙方的主張各有一定的說服力，若斷定其中一方才是正確的，未免顯得太過草率。", "word": "きらい" } ],
    [ { "text": "話雖如此，在個人生活方式日趨多樣化的時代裡，現行制度恐怕難以說是回應了時代的需求，某種程度的檢討恐怕難以避免。", "word": "見直し" } ]
  ],
