が","reading":"が","pos":"助詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"最後","basic_form":"最後","reading":"さいご","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"二人","basic_form":"二人","reading":"ふたり","pos":"名詞"},{"surface_form":"とも","basic_form":"とも","reading":"とも","pos":"助詞"},{"surface_form":"大笑いした","basic_form":"大笑いする","reading":"おおわらいした","pos":"動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"休み":{"meaning":"休息、放假"},"日":{"meaning":"日子"},"久しぶり":{"meaning":"隔了好久、久違"},"娘":{"meaning":"女兒"},"トランプ":{"meaning":"撲克牌"},"遊ぶ":{"meaning":"玩"},"最初":{"meaning":"一開始"},"ルール":{"meaning":"規則"},"忘れる":{"meaning":"忘記"},"何度":{"meaning":"好幾次"},"聞き直す":{"meaning":"重新問、再問一次"},"丁寧":{"meaning":"仔細、周到"},"教える":{"meaning":"教導"},"だんだん":{"meaning":"漸漸"},"楽しい":{"meaning":"開心、快樂"},"なる":{"meaning":"變成"},"笑う":{"meaning":"笑"},"悔しがる":{"meaning":"覺得不甘心、不服氣"},"する":{"meaning":"做"},"何回":{"meaning":"好幾回"},"勝負する":{"meaning":"比賽、決勝負"},"うち":{"meaning":"…的時候、之中"},"気づく":{"meaning":"注意到、察覺"},"三時間":{"meaning":"三小時"},"経つ":{"meaning":"經過（時間）"},"負ける":{"meaning":"輸、敗"},"悔しい":{"meaning":"不甘心的、懊悔的"},"よう":{"meaning":"…的樣子、好像"},"最後":{"meaning":"最後"},"二人":{"meaning":"兩個人"},"大笑いする":{"meaning":"大笑"}},"particles":{"の":"表示所屬關係，或名詞修飾名詞；也作準體助詞，代替「事情」","に":"表示時間點、對象，或構成な形容詞的副詞形（〜に）","と":"表示一起做某事的對象","で":"表示動作發生的場所，或使用的方法/工具","を":"標示動作的受詞","も":"「也」，表示並列或強調，接數量詞表示「竟然有這麼多」","が":"標示句子的主語","ので":"表示客觀原因，比から更委婉","ながら":"表示兩個動作同時進行","とも":"「兩者都」，接在數量詞後強調全部"},"translations":[[{"text":"休假日，隔了好久和女兒玩了撲克牌。","word":"トランプ"}],[{"text":"一開始忘了規則，問了好幾次，但女兒仔細地教我，讓我漸漸覺得好玩起來。","word":"教える"}],[{"text":"一邊笑、一邊不甘心地對戰了好幾回，不知不覺三個小時就過去了。","word":"経つ"}],[{"text":"女兒好像因為輸了而不甘心，但最後兩個人都笑得很開心。","word":"悔しい"}]],"grammar_notes":[{"sentence":0,"pattern":"普通形（辞書形/ない形/た形/なかった形）","note":"常體，用於複句、思考/傳聞句型前接"},{"sentence":1,"pattern":"〜ので（因為）","note":"客觀原因，比から更委婉/書面"},{"sentence":1,"pattern":"〜てあげる／〜てくれる／〜てもらう","note":"授受表現（幫忙的方向性）"},{"sentence":3,"pattern":"〜ようだ／〜みたい","note":"主觀推測或比喻，「好像」"}]}