の","reading":"の","pos":"助詞"},{"surface_form":"感覚","basic_form":"感覚","reading":"かんかく","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"今","basic_form":"今","reading":"いま","pos":"名詞"},{"surface_form":"でも","basic_form":"でも","reading":"でも","pos":"助詞"},{"surface_form":"忘れられない","basic_form":"忘れる","reading":"わすれられない","pos":"動詞"},{"surface_form":"ほど","basic_form":"ほど","reading":"ほど","pos":"助詞"},{"surface_form":"で","basic_form":"で","reading":"で","pos":"助詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"来月","basic_form":"来月","reading":"らいげつ","pos":"名詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"初めて","basic_form":"初めて","reading":"はじめて","pos":"名詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"審査","basic_form":"審査","reading":"しんさ","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"受ける","basic_form":"受ける","reading":"うける","pos":"動詞"},{"surface_form":"予定","basic_form":"予定","reading":"よてい","pos":"名詞"},{"surface_form":"だ","basic_form":"だ","reading":"だ","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"学生時代":{"meaning":"學生時代"},"武道":{"meaning":"武道"},"憧れる":{"meaning":"憧憬、嚮往"},"弓道":{"meaning":"弓道"},"道具":{"meaning":"道具"},"多い":{"meaning":"多的"},"敷居":{"meaning":"門檻（敷居が高い=難以親近）"},"高い":{"meaning":"高的"},"感じる":{"meaning":"感覺"},"なかなか":{"meaning":"（後接否定）怎麼也不"},"踏み出す":{"meaning":"踏出、邁出"},"ところが":{"meaning":"然而、沒想到"},"先月":{"meaning":"上個月"},"近所":{"meaning":"附近、鄰近"},"弓道場":{"meaning":"弓道場"},"体験会":{"meaning":"體驗會"},"開かれる":{"meaning":"被舉辦、開辦"},"きっかけ":{"meaning":"契機、起因"},"思い切る":{"meaning":"下定決心、狠下心"},"入門する":{"meaning":"入門"},"こと":{"meaning":"事情（形式名詞）"},"する":{"meaning":"做"},"最初":{"meaning":"一開始"},"矢":{"meaning":"箭"},"正しい":{"meaning":"正確的"},"構える":{"meaning":"擺好姿勢、持構"},"肩":{"meaning":"肩膀"},"力":{"meaning":"力氣"},"入る":{"meaning":"進入（力が入る=使勁、用力）"},"的":{"meaning":"箭靶、目標"},"当てる":{"meaning":"射中、擊中"},"ほとんど":{"meaning":"幾乎"},"できる":{"meaning":"能夠、做得到"},"先生":{"meaning":"老師"},"姿勢":{"meaning":"姿勢"},"細かい":{"meaning":"細微的、仔細的"},"直す":{"meaning":"修正、改正"},"おかげ":{"meaning":"多虧、託…的福"},"少しずつ":{"meaning":"一點一點地"},"型":{"meaning":"型、招式"},"身につく":{"meaning":"學會、掌握（技能）"},"時":{"meaning":"…的時候"},"感覚":{"meaning":"感覺"},"今":{"meaning":"現在"},"忘れる":{"meaning":"忘記"},"来月":{"meaning":"下個月"},"初めて":{"meaning":"第一次"},"審査":{"meaning":"審查、考核"},"受ける":{"meaning":"接受"},"予定":{"meaning":"預定、計畫"}},"particles":{"から":"表示時間或地點的起點","に":"表示時間點、對象，或構成形容詞的副詞形","ものの":"「雖然〜」的逆接語氣","は":"主題標記","も":"「也」，表示並列或強調","が":"標示句子的主語","と":"用於引用（と感じる）","の":"表示所屬關係，或準體用法代替「事情」","を":"標示動作的受詞","で":"表示場所、方法，或原因（〜おかげで）","でも":"「即使是〜也」，強調極端例子","だけ":"「只有〜」，表示限定","ほど":"表示程度，「〜到…的程度」"},"translations":[[{"text":"雖然從學生時代就很憧憬武道，但覺得弓道的門檻很高，道具又多，一直沒能踏出第一步。","word":"敷居"}],[{"text":"沒想到上個月，附近的弓道場舉辦了體驗會，我才以此為契機，下定決心入門。","word":"きっかけ"}],[{"text":"一開始光是正確地持弓搭箭，肩膀就不自覺用力，幾乎射不中箭靶，但多虧老師仔細糾正我的姿勢，才漸漸掌握了招式要領。","word":"おかげ"}],[{"text":"箭射中箭靶時的感覺至今仍讓我難以忘懷，下個月打算參加第一次的審查。","word":"感覚"}]],"grammar_notes":[{"sentence":1,"pattern":"〜ことにする／〜ことになる","note":"決定／自然而然演變成的結果"},{"sentence":2,"pattern":"〜おかげで／〜せいで","note":"「多虧〜」／「都怪〜」，正負面歸因"}]}