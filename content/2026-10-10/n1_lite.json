"surface_form":"維持する","basic_form":"維持する","reading":"いじする","pos":"動詞"},{"surface_form":"ため","basic_form":"ため","reading":"ため","pos":"名詞"},{"surface_form":"に","basic_form":"に","reading":"に","pos":"助詞"},{"surface_form":"は","basic_form":"は","reading":"は","pos":"助詞"},{"surface_form":"、","basic_form":"、","reading":"、","pos":"記号"},{"surface_form":"料金体系","basic_form":"料金体系","reading":"りょうきんたいけい","pos":"名詞"},{"surface_form":"の","basic_form":"の","reading":"の","pos":"助詞"},{"surface_form":"見直し","basic_form":"見直し","reading":"みなおし","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"含めた","basic_form":"含める","reading":"ふくめた","pos":"動詞"},{"surface_form":"抜本的","basic_form":"抜本的","reading":"ばっぽんてき","pos":"形容詞"},{"surface_form":"な","basic_form":"な","reading":"な","pos":"助詞"},{"surface_form":"対策","basic_form":"対策","reading":"たいさく","pos":"名詞"},{"surface_form":"を","basic_form":"を","reading":"を","pos":"助詞"},{"surface_form":"講じる","basic_form":"講じる","reading":"こうじる","pos":"動詞"},{"surface_form":"必要","basic_form":"必要","reading":"ひつよう","pos":"名詞"},{"surface_form":"が","basic_form":"が","reading":"が","pos":"助詞"},{"surface_form":"ある","basic_form":"ある","reading":"ある","pos":"動詞"},{"surface_form":"だろう","basic_form":"だろう","reading":"だろう","pos":"助動詞"},{"surface_form":"。","basic_form":"。","reading":"。","pos":"記号"}],"vocab":{"高度経済成長期":{"meaning":"高度經濟成長期"},"整備する":{"meaning":"建設、整頓"},"水道管":{"meaning":"自來水管"},"多く":{"meaning":"大部分、多數"},"更新時期":{"meaning":"更新期限"},"迎える":{"meaning":"迎接、面臨"},"全国各地":{"meaning":"全國各地"},"漏水":{"meaning":"漏水"},"破損事故":{"meaning":"破損事故"},"相次ぐ":{"meaning":"接連發生"},"更新":{"meaning":"更新"},"莫大":{"meaning":"龐大、巨大"},"費用":{"meaning":"費用"},"かかる":{"meaning":"花費；可能發生"},"一方":{"meaning":"另一方面"},"人口減少":{"meaning":"人口減少"},"水道料金収入":{"meaning":"自來水費收入"},"減少":{"meaning":"減少"},"相まる":{"meaning":"相互作用、交織"},"財源":{"meaning":"財源"},"確保":{"meaning":"確保、確保取得"},"一層":{"meaning":"更加"},"難しい":{"meaning":"困難的"},"なる":{"meaning":"變成"},"自治体":{"meaning":"地方政府"},"対応":{"meaning":"應對"},"後手":{"meaning":"慢半步、落後"},"回る":{"meaning":"轉、落入（後手に回る＝陷入被動）"},"老朽化する":{"meaning":"老化、老舊化"},"設備":{"meaning":"設備"},"放置する":{"meaning":"放任、放置"},"断水":{"meaning":"斷水"},"濁水":{"meaning":"濁水"},"生活":{"meaning":"生活"},"直接的":{"meaning":"直接的"},"影響":{"meaning":"影響"},"ない":{"meaning":"沒有、不"},"災害時":{"meaning":"災害時"},"復旧":{"meaning":"修復、恢復"},"時間":{"meaning":"時間"},"国":{"meaning":"國家"},"広域連携":{"meaning":"跨區域合作"},"民間活用":{"meaning":"民間活用"},"促す":{"meaning":"促進"},"いる":{"meaning":"存在、在（表持續狀態）"},"人口":{"meaning":"人口"},"少ない":{"meaning":"少的"},"地域":{"meaning":"地區"},"そうした":{"meaning":"那樣的"},"仕組み":{"meaning":"機制、系統"},"導入する":{"meaning":"引進、導入"},"こと":{"meaning":"事情（形式名詞）"},"現状":{"meaning":"現狀"},"持続可能":{"meaning":"永續的、可持續的"},"水道事業":{"meaning":"自來水事業"},"維持する":{"meaning":"維持"},"ため":{"meaning":"為了（目的）"},"料金体系":{"meaning":"費率制度"},"見直し":{"meaning":"重新檢視"},"含める":{"meaning":"包含"},"抜本的":{"meaning":"根本性的"},"対策":{"meaning":"對策"},"講じる":{"meaning":"採取（對策）"},"必要":{"meaning":"必要"},"ある":{"meaning":"有、存在"}},"particles":{"に":"表示對象、時間點，或方面","が":"標示句子的主語","の":"表示所屬關係，或名詞修飾名詞","を":"標示動作的受詞","で":"表示場所、範圍","や":"列舉名詞時用的「和」","な":"な形容詞修飾名詞時的連接形式","は":"主題標記","だけ":"「只有〜」，表示限定","へ":"表示方向、對象","といった":"「像〜那樣的」，列舉代表性例子","さえ":"「甚至連…」，強調極端的例子","ものの":"「雖然〜」的逆接語氣","による":"表示原因或依據，「因〜」","と":"用於構成「と相まって」等結構，或引用"},"translations":[[{"text":"高度經濟成長期鋪設的自來水管，大部分都已到了更新的時期，全國各地接連發生漏水與破損事故。","word":"水道管"}],[{"text":"更新需要耗費龐大費用，另一方面，人口減少導致的自來水費收入減少與此相互作用，使財源的確保更加困難，地方政府的應對也容易陷入被動。","word":"相まる"}],[{"text":"若放任老化的設備不管，不僅會直接影響斷水、濁水等日常生活，發生災害時的修復恐怕也會花費更多時間。","word":"老朽化する"}],[{"text":"國家雖然在推動跨區域合作與民間活用，但在人口稀少的地區，就連引進這類機制本身都很困難，這就是現狀。","word":"仕組み"}],[{"text":"為了維持永續的自來水事業，有必要採取包括重新檢視費率制度等根本性的對策。","word":"対策"}]],"grammar_notes":[{"sentence":1,"pattern":"〜と相まって","note":"「與〜相結合」，書面因果"}]}