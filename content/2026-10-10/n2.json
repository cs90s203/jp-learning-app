eaning":"行政機關"},"補助":{"meaning":"補助"},"限る":{"meaning":"限制、限定"},"資金集め":{"meaning":"募款、籌集資金"},"人手不足":{"meaning":"人力不足"},"悩む":{"meaning":"煩惱、苦惱"},"団体":{"meaning":"團體"},"少ない":{"meaning":"少的"},"それでも":{"meaning":"即使如此"},"猫":{"meaning":"貓"},"通じる":{"meaning":"透過、通過"},"住民同士":{"meaning":"居民彼此"},"顔":{"meaning":"臉"},"合わせる":{"meaning":"合、對齊"},"協力し合う":{"meaning":"互相協助"},"姿":{"meaning":"身影、樣子"},"地域社会":{"meaning":"地區社會"},"新しい":{"meaning":"新的"},"つながり":{"meaning":"連結、聯繫"},"形":{"meaning":"形狀、型態"},"表れる":{"meaning":"顯現、展現"},"言う":{"meaning":"說"},"今後":{"meaning":"今後"},"連携":{"meaning":"合作、聯繫"},"強める":{"meaning":"強化"},"支える":{"meaning":"支撐、支持"},"仕組み":{"meaning":"機制、系統"},"整える":{"meaning":"整頓、建立"},"こと":{"meaning":"事情（形式名詞）"},"求める":{"meaning":"要求、尋求"}},"particles":{"と":"表示「和」，或用於引用（と言える）","の":"表示所屬關係，或名詞修飾名詞","を":"標示動作的受詞","で":"表示動作發生的場所","ながら":"表示兩個動作同時進行","が":"標示句子的主語","に":"表示對象、時間點，或方面","は":"主題標記","として":"「作為〜」的身分/立場","や":"列舉名詞時用的「和」","など":"「〜等」，列舉","も":"「也」，表示並列或強調"},"translations":[[{"text":"為了減少流浪貓與居民之間的糾紛，志工們為貓咪進行絕育手術，一邊在地區內看守、一邊以共生為目標的社區貓活動，正在全國各地擴展開來。","word":"地域猫活動"}],[{"text":"一開始常被認為只是單純的動物保護措施，但實際上它也扮演著緩和居民之間圍繞糞便、叫聲等對立的角色。","word":"和らげる"}],[{"text":"進行這項活動，手術費與飼料費等資金是不可或缺的，但行政的補助有限，不少團體都為籌款與人力不足而煩惱。","word":"資金集め"}],[{"text":"即使如此，透過貓咪讓居民彼此碰面、互相協助的身影，可以說展現出一種地區社會新的連結型態。","word":"つながり"}],[{"text":"今後，需要強化與行政機關的合作，建立起能支撐這項活動的機制才行。","word":"仕組み"}]],"grammar_notes":[{"sentence":3,"pattern":"〜を通じて／〜を通して","note":"「透過〜」，媒介或期間"}]}