  "translations": [
    [ { "text": "近年，用智慧型手機或平板就能輕鬆學習的線上學習服務正迅速普及。", "word": "広がる" } ],
    [ { "text": "即使沒有時間去補習班或升學補習學校，也能按照自己的步調，在喜歡的時間學習，這是很大的魅力。", "word": "魅力" } ],
    [ { "text": "價格也相對實惠，不少服務還提供免費教材。", "word": "無料" } ],
    [ { "text": "尤其是英語和證照考試對策的課程特別受歡迎，能有效利用零碎時間學習的這一點也受到好評。", "word": "人気" } ],
    [ { "text": "另一方面，也有人說比起面對面授課，比較難維持學習動力。", "word": "一方" } ],
    [ { "text": "即便如此，以邊工作邊考取證照的人為主，使用者仍年年持續增加。", "word": "増える" } ]
  ],
