    [ { "text": "一開始手指動得不靈活，苦戰了好一陣子，不過多虧老師耐心教導，漸漸地彈得起來了。", "word": "おかげ" } ],
    [ { "text": "每次練習的時候，心裡總覺得當年放棄的那份遺憾，好像漸漸地消散了一些。", "word": "たびに" } ],
    [ { "text": "說來不可思議，工作越累的那天，就越想彈鋼琴。", "word": "不思議" } ]
