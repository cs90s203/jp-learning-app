  "translations": [
    [ { "text": "有關最低工資上調的議論，近年來愈發活躍。", "word": "議論" } ],
    [ { "text": "隨著物價上升，生活費負擔也日益加重，主張必須上調工資以保障勞工生活的聲音日益增強。", "word": "相まる" } ],
    [ { "text": "另一方面，中小企業經營者則擔心，面對急劇上升的人力成本難以完全應對，可能被迫縮小事業規模甚至停業，這樣的憂慮根深蒂固。", "word": "余儀ない" } ],
    [ { "text": "事實上，對於地方中小企業而言，將與大都市圈相同水準的工資一律套用是否現實，不少人也提出了疑問。", "word": "現実的" } ],
    [ { "text": "政府試圖透過對加薪企業提供補助金、稅制優惠等支援措施來緩和這種對立，但也有人質疑這些支援的實際效果。", "word": "疑問視する" } ],
    [ { "text": "至於工資上調是否能刺激消費，進而帶動整體經濟活絡，形成良性循環，恐怕還要取決於今後的政策運作。", "word": "好循環" } ],
    [ { "text": "這場議論的走向，恐怕也將對日本整體社會的經濟結構帶來重大影響。", "word": "影響" } ]
