  "translations": [
    [ { "text": "為了讓因經濟因素等原因無法獲得充分飲食的孩子，能以免費或低價提供餐點的「兒童食堂」，正在全國各地擴展開來。", "word": "子ども食堂" } ],
    [ { "text": "負責營運的多半是地區志工、自治會、NPO法人等各式各樣的團體，但大多都是出於防止孩子獨自用餐、打造地區歸屬空間的想法而開始的。", "word": "居場所" } ],
    [ { "text": "起初主要以支援育兒家庭為目的，但隨著使用族群的擴大，最近高齡者、獨居大學生等更廣泛的族群也開始使用。", "word": "伴う" } ],
    [ { "text": "營運資金大多依賴捐款與補助金，如何確保穩定財源以持續營運，已成為一項課題。", "word": "頼る" } ],
    [ { "text": "由整個地區社會共同支撐的機制建構，今後想必會越來越受到需要。", "word": "仕組みづくり" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜に伴って", "note": "「伴隨〜」，同步變化" }
  ]
}
