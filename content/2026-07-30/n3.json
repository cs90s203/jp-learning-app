  "translations": [
    [ { "text": "開始學將棋的契機，是父親不經意的一句話。", "word": "きっかけ" } ],
    [ { "text": "他說「最好有個能用腦的興趣比較好喔」，我就不知怎麼地買了本書，這就是開始的緣由。", "word": "言う" } ],
    [ { "text": "光是記規則就很辛苦，但隨著對局的累積，漸漸能預判後面的棋路了。", "word": "重ねる" } ],
    [ { "text": "雖然老是輸、也稱不上厲害，卻不知為何很有趣，讓人根本停不下來。", "word": "わけではない" } ],
    [ { "text": "那段時期工作壓力很大，所以只有專注在將棋上的時候能忘記其他事情，這讓我很感激。", "word": "集中する" } ],
    [ { "text": "現在已經成了週末的樂趣之一。", "word": "楽しみ" } ]
