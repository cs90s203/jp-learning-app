  "translations": [
    [ { "text": "從去年秋天開始，去了附近的書法教室上課。", "word": "通う" } ],
    [ { "text": "本來字就寫得不好，一直很自卑。", "word": "下手" } ],
    [ { "text": "老師人很溫柔，從基本姿勢開始仔細教。", "word": "教える" } ],
    [ { "text": "一開始連握筆的方法都不懂，現在已經相當習慣了。", "word": "慣れる" } ],
    [ { "text": "每週一次，安靜地磨墨的時間總覺得讓人平靜下來。", "word": "落ち着く" } ],
    [ { "text": "如果字能變漂亮，也想試著寫寫看信。", "word": "書く" } ],
    [ { "text": "就算不擅長，我覺得繼續下去本身就是有意義的。", "word": "続ける" } ]
