  "translations": [
    [ { "text": "動物園長久以來透過強調自身作為保育稀有動物與推廣教育的場所所具有的意義，來為自身的存在正當化。", "word": "正当化する" } ],
    [ { "text": "然而近年來，從動物福祉的觀點出發，批判飼養環境是否不符合動物原本的生態與行為模式的聲浪不斷出現，動物園本身應有的樣貌也正被重新檢視。", "word": "問い直す" } ],
    [ { "text": "尤其是被迫在有限空間中過著單調生活的動物，常可見到被稱為「刻板行為」的壓力反應，這一點恐怕無法被忽視。", "word": "余儀なくされる" } ],
    [ { "text": "另一方面，瀕危物種的繁殖計畫以及回歸野外的相關努力等，唯有動物園才能承擔的角色也確實存在，因此這並非能單純以存廢與否來討論的問題。", "word": "担う" } ],
    [ { "text": "今後所需要的，是在保留娛樂設施這一面向的同時，將動物福祉置於最優先地位的營運轉型，而為此，除了飼養設備的投資自不待言，職員專業性的提升以及對來園遊客的宣導活動也是不可或缺的。", "word": "転換する" } ]
  ],
  "grammar_notes": [
    { "pattern": "〜を余儀なくされる", "note": "「被迫〜」，書面被動" }
  ]
