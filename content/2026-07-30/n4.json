  "translations": [
    [ { "text": "上週日，和爸爸去爬了附近的山。", "word": "登る" } ],
    [ { "text": "因為天氣很好，山頂的景色非常漂亮。", "word": "景色" } ],
    [ { "text": "山上的空氣非常新鮮，心情也變得很暢快。", "word": "すっきりする" } ],
    [ { "text": "途中一邊休息、一邊拍照，慢慢地走著。", "word": "撮る" } ],
    [ { "text": "爬山雖然很累，但到達山頂時很有成就感。", "word": "達成感" } ],
    [ { "text": "我想下次如果能爬別的山就好了。", "word": "思う" } ]
