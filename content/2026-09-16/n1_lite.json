    [ { "text": "醫師集中在都市，另一方面，地方因工作環境嚴苛，年輕醫師難以留任，也有人指出這已陷入惡性循環。", "word": "悪循環" } ],
    [ { "text": "政府雖然推動擴大醫學系地方名額、派遣實習醫師到地方等對策，但預計要看到成效仍需要相當的時間。", "word": "対策" } ],
    [ { "text": "正因為醫療是與居民生命直接相關的社會基礎建設，這個課題不容延後處理。", "word": "だけに" } ],
    [ { "text": "專家之間也出現聲音認為，推廣遠距診療、分擔醫師業務等減輕醫師負擔的機制建立同樣是當務之急，今後該如何支撐地區醫療將愈發受到關注。", "word": "仕組みづくり" } ]
  ],
  "grammar_notes": []
}
