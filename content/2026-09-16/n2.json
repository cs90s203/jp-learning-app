  "translations": [
    [ { "text": "曾經與人們的生活密切相連的里山，隨著務農人口減少而疏於整理，荒廢情況日益嚴重。", "word": "里山" } ],
    [ { "text": "面對這樣的狀況，近年來都市居民以志工身分參與里山保育活動的風潮正在各地擴散。", "word": "ボランティア" } ],
    [ { "text": "雖然除草、疏伐都是不起眼的工作，但參加者常表示「與自然接觸的時間能療癒心靈」。", "word": "ものの" } ],
    [ { "text": "此外，對當地農家來說，這不僅能確保勞動力，也透過與都市的交流，成為重新發現地區魅力的契機。", "word": "通じる" } ],
    [ { "text": "今後的課題可以說是不讓這項活動只是曇花一現，而是讓它成為能持續下去的機制。", "word": "継続的だ" } ]
  ],
