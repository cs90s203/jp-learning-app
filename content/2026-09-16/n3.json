  "translations": [
    [ { "text": "被公司同事邀請，從去年春天開始學習合氣道。", "word": "合気道" } ],
    [ { "text": "本來不太擅長運動，但因為對同事說的『活動身體心情會很暢快』這句話產生興趣而成為契機。", "word": "興味" } ],
    [ { "text": "實際去道場之後才發現，不是靠蠻力去摔，而是利用對方的力量來使出招式，這才是合氣道有趣的地方。", "word": "利用する" } ],
    [ { "text": "一開始每次受身摔倒身體都很痛，老實說也曾想過要放棄。", "word": "痛い" } ],
    [ { "text": "但是持續練習後動作漸漸融入了身體，現在甚至沉迷到每個週末都讓人望眼欲穿。", "word": "夢中" } ]
  ],
