  "translations": [
    [ { "text": "隨著少子高齡化的進展，醫療費逐年持續增加，圍繞健康保險費調漲的議論在各方面日趨活絡。", "word": "健康保険料" } ],
    [ { "text": "加上少子化的進行，雖有人指出現役世代的負擔已接近極限，但也有一種根深蒂固的看法認為，為了維持給付水準，確保一定的財源是不可或缺的。", "word": "財源確保" } ],
    [ { "text": "政府一方面試圖兼顧世代間的公平性，一方面又想提高制度的永續性，因而表明將重新檢討負擔方式的方針，但在具體的制度設計上，意見仍存在很大分歧。", "word": "隔たり" } ],
    [ { "text": "尤其是「將負擔集中在高所得者身上是否是現實可行的選項，還是應該藉由抑制給付來因應」這一點，專家之間的見解也並不一致。", "word": "見解" } ],
    [ { "text": "為了維持國民對制度的信賴，也少不了以淺顯易懂的方式向國民說明負擔與給付之間關係的努力。", "word": "信頼" } ],
    [ { "text": "無論如何，若不能盡到讓全體國民理解的說明責任，就將這個問題往後拖延，是不被允許的。", "word": "説明責任" } ]
  ],
