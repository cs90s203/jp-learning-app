  "translations": [
    [ { "text": "在人口減少顯著的地方，維持公共交通已成為無法迴避的課題。", "word": "公共交通" } ],
    [ { "text": "隨著使用者的減少，巴士路線與鐵路被迫接連停駛，對無法開車的高齡者來說，生活的根基本身都可能因此動搖。", "word": "高齢者" } ],
    [ { "text": "雖然有些地方自治體看得到透過導入需求反應式交通來提升效率的動向，但財源的確保並不容易。", "word": "効率化" } ],
    [ { "text": "若不採取符合地區實際情況的支援措施，移動手段的差距恐怕會愈發擴大。", "word": "格差" } ],
