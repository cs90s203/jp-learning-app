  "translations": [
    [ { "text": "在過疎化持續進展的地方，光是要親自前往圖書館這件事本身，對許多高齡者來說就很困難。", "word": "過疎化" } ],
    [ { "text": "在這樣的背景下，載滿書籍的車輛巡迴各聚落的「移動圖書館」措施正逐漸在各地展開。", "word": "移動図書館" } ],
