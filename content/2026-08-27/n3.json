  "translations": [
    [ { "text": "去年秋天，因為祖父邀約而開始上俳句課。", "word": "俳句" } ],
    [ { "text": "一開始覺得「季語什麼的好像很難」，但實際嘗試之後，發現用簡短的詞語表達季節與心情很有趣。", "word": "面白さ" } ],
    [ { "text": "教室裡雖然年長者較多，但最近年輕人似乎也在漸漸增加。", "word": "年配" } ],
    [ { "text": "每當創作俳句時，總會開始留意身邊細微的變化。", "word": "変化" } ],
    [ { "text": "平凡的景色裡也有新發現，覺得日常生活變得稍微豐富了一些。", "word": "発見" } ],
    [ { "text": "在忙碌的日子裡，能有這樣的時間，對自己來說是很值得感激的事。", "word": "ありがたい" } ]
