  "translations": [
    [ { "text": "近年，在公寓或車站前設置宅配置物櫃的情況正在增加。", "word": "宅配ロッカー" } ],
    [ { "text": "隨著雙薪家庭的增加，過去有許多人因為收不到貨物而必須申請重新配送，但置物櫃的普及大幅減少了這種麻煩。", "word": "普及" } ],
    [ { "text": "對使用者來說，能在喜歡的時間領取貨物固然值得感激，但也存在無法應對大型貨物的課題。", "word": "ありがたい" } ],
    [ { "text": "此外，地方上的設置台數還很少，也有人指出與都市地區的差距。", "word": "都市部" } ],
    [ { "text": "特別是單身家庭的使用者，滿意的聲音較多。", "word": "満足" } ],
    [ { "text": "今後恐怕需要擴大容量並重新檢討設置地點。", "word": "拡大" } ]
