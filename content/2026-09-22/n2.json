  "translations": [
    [ { "text": "在人口稀少或高齡化的住宅區，附近沒有商店，不少居民為日常購物所苦。", "word": "困る" } ],
    [ { "text": "以這樣的狀況為背景，裝載生鮮食品和日用品的移動販賣車正在各地擴展開來。", "word": "移動販売車" } ],
    [ { "text": "它會在事先決定好的星期幾和時間巡迴住宅街，居民能在自家門前選購商品。", "word": "巡回する" } ],
    [ { "text": "不少業者會透過在地居民的意見調整商品種類，也有使用者表示不必搬運沉重的行李，很方便。", "word": "通じる" } ],
    [ { "text": "另一方面，儘管燃料成本上漲、人手不足，仍有不少業者努力持續經營，但要維持下去絕非易事，這也成了一大課題。", "word": "にもかかわらず" } ],
    [ { "text": "今後應在活用地方政府補助金制度的同時，建立起可持續的營運體制。", "word": "活用する" } ]
  ],
