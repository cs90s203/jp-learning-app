  "translations": [
    [ { "text": "小時候身體瘦小，常常被同班同學捉弄。", "word": "からかう" } ],
    [ { "text": "每次感到不甘心，就想著要變強。", "word": "たびに" } ],
    [ { "text": "上高中的時候，被朋友邀去參觀柔道社，這就是契機。", "word": "きっかけ" } ],
    [ { "text": "實際去參觀練習時，看到學長姐即使被摔倒也馬上站起來笑著，讓我很感動。", "word": "感動する" } ],
    [ { "text": "「即使痛也不放棄」這句學長的話留在心裡，我當場決定入社。", "word": "諦める" } ],
    [ { "text": "現在回想起來，多虧當時鼓起勇氣去參觀，我才變得對自己有自信。", "word": "おかげで" } ]
