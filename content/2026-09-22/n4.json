    [ { "text": "一開始完全贏不了，有點不甘心。", "word": "勝つ" } ],
    [ { "text": "不過，爺爺鼓勵我說練習就能變厲害，讓我很開心。", "word": "励ます" } ],
    [ { "text": "將棋比想像中難，但非常有趣。", "word": "難しい" } ],
    [ { "text": "下週也約好要一起下棋。", "word": "指す" } ]
