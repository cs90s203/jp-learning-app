    [ { "text": "最近開始嘗試種盆栽。", "word": "盆栽" } ],
    [ { "text": "在小花盆裡種樹，修整形狀，是一種興趣。", "word": "趣味" } ],
    [ { "text": "因為這是第一次養植物，所以邊失敗邊學習。", "word": "育てる" } ],
    [ { "text": "一開始覺得應該很難，實際做了之後意外地很開心。", "word": "楽しい" } ],
    [ { "text": "每天早上邊澆水邊觀察葉子的狀態，成了每天的例行公事。", "word": "観察する" } ],
    [ { "text": "雖然還很不熟練，但看到樹的形狀一點一點改變，讓人開心。", "word": "変わる" } ],
