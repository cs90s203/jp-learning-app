  "translations": [
    [ { "text": "近年，將宅配包裹放在玄關前的「置き配」服務正快速普及。", "word": "置き配" } ],
    [ { "text": "以往必須在家才能收貨，但利用置き配的話，即使外出也能收到包裹。", "word": "置き配" } ],
    [ { "text": "對雙薪家庭和一個人住的人來說，能有效運用時間，因此很受歡迎。", "word": "有効に" } ],
    [ { "text": "隨著宅配包裹使用人數的增加，選擇置き配的人也逐年增加。", "word": "に伴って" } ],
    [ { "text": "另一方面，也有人指出遭竊或送錯貨的風險，設置監視器的家庭也在增加。", "word": "盗難" } ],
