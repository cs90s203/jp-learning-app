  "translations": [
    [ { "text": "近年，公立學校教師不足的情況日益嚴重，教育現場傳出不少抱怨聲。", "word": "教員不足" } ],
    [ { "text": "儘管少子化，但有意從事教職的人數卻持續減少，錄取考試的競爭率也逐年下降。", "word": "にもかかわらず" } ],
    [ { "text": "背景在於長時間勞動和過重的業務負擔，許多現任教師都訴說身心俱疲。", "word": "疲労" } ],
    [ { "text": "事實上，找不到能代理產假或病假的教師，甚至有學校不得不減少課程。", "word": "減らす" } ],
    [ { "text": "若放任這種狀況不管，恐怕會導致教育品質下降。", "word": "招く" } ],
    [ { "text": "專家指出，有必要透過改善待遇和提升業務效率，重新找回教師這份工作的魅力。", "word": "通じる" } ]
