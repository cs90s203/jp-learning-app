  "translations": [
    [ { "text": "在人口過疏化不斷推進的地區，作為日常購物地點的商店與超市紛紛撤出，被稱為「購物難民」的居民正在增加。", "word": "増加する" } ],
    [ { "text": "在這樣的背景下，各地正逐漸普及讓載滿生鮮食品與日用品的行動販賣車巡迴聚落的做法。", "word": "広まる" } ],
    [ { "text": "車子在固定的星期到固定的地點前來，這種機制不僅成了高齡者外出的契機，據說也不僅止於單純的商品販售，同時也發揮著居民之間交流場合的功能。", "word": "機能する" } ],
    [ { "text": "不過，由於燃料費上漲、司機難以確保等原因，作為事業要達到收支平衡並不容易，不少業者不得不依賴自治團體的補助金。", "word": "頼る" } ],
    [ { "text": "為了讓這套機制作為永續的制度扎根下來，恐怕有必要讓行政機關與民間攜手合作，建立起因應地區實際情況的支援體制。", "word": "定着する" } ]
  ]
}
