  "translations": [
    [ { "text": "去年春天，受公司前輩邀請開始接觸盆栽。", "word": "始める" } ],
    [ { "text": "老實說，一開始覺得這是個樸素不起眼的興趣，但實際拿起花盆嘗試後，才發現遠比想像中還要深奧。", "word": "気づく" } ],
    [ { "text": "一邊細細修整每一根樹枝、整理形狀的作業，簡直像是親手打造出一座專屬於自己的小庭院，時間一轉眼就過去了。", "word": "作り上げる" } ],
    [ { "text": "因為澆水的時機不同，樹木的精神狀態就會改變，所以每天早上觀察狀況成了我的每日功課。", "word": "日課" } ],
    [ { "text": "在忙碌的日子裡，這樣與小小的樹木面對面的時間，成了無可取代的心靈休息。", "word": "向き合う" } ]
  ]
