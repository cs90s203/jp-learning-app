  "translations": [
    [ { "text": "上週六，我和妹妹去了水族館。", "word": "行く" } ],
    [ { "text": "海豚在大水槽前游來游去、跳來跳去，妹妹非常開心。", "word": "大喜び" } ],
    [ { "text": "水母區的燈光很美，我們兩個都不禁看得入迷了好一會兒。", "word": "見とれる" } ],
