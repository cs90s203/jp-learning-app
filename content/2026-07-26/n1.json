  "translations": [
    [ { "text": "隨著生成式AI作為能創造文章、圖像、音樂等內容的技術急速普及，其學習過程中所使用的資料與著作權之間的關係，不分國內外都成了一大論點浮現出來。", "word": "浮上する" } ],
    [ { "text": "許多開發企業將網路上公開的龐大作品群作為學習資料利用，但據認為其中也不少包含未經許可的著作物，創作者方面也出現了自己的作品在未獲對價也未獲同意的情況下就被利用的反彈聲浪。", "word": "反発" } ],
    [ { "text": "另一方面，若對學習階段的利用一律加以規範，也有可能阻礙技術革新本身的疑慮根深蒂固，法律制度的建置並不容易。", "word": "懸念" } ],
    [ { "text": "實際上，既有的著作權法有著以人類創作活動為前提建構而成的來龍去脈，缺乏預想到機器學習這種嶄新利用形式的規定，這就是實際情況。", "word": "欠く" } ],
    [ { "text": "今後，恐怕有必要在區分學習階段與生成階段之後，探討因應各個局面的權利保護方式。", "word": "区別する" } ],
    [ { "text": "此外，關於生成物與既有著作物極為相似時的權利侵害判斷基準，也是有待司法場域討論之處。", "word": "酷似する" } ]
  ]
