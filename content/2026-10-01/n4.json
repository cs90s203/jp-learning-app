  "translations": [
    [ { "text": "上週末，我們全家在附近的河邊烤肉。", "word": "バーベキュー" } ],
    [ { "text": "爸爸烤肉、媽媽切菜，大家一起準備。", "word": "準備する" } ],
    [ { "text": "因為天氣很好，所以能在戶外悠閒地用餐。", "word": "できる" } ],
    [ { "text": "妹妹第一次幫忙生火，看起來有點困難。", "word": "難しい" } ],
    [ { "text": "河水很乾淨，飯後大家還稍微玩了一下。", "word": "遊ぶ" } ],
    [ { "text": "最後大家一起玩遊戲，變成了非常開心的一天。", "word": "なる" } ]
