  "translations": [
    [ { "text": "最近對皮革工藝產生了興趣，準備好工具後就嘗試著開始了。", "word": "革細工" } ],
    [ { "text": "一開始連怎麼拿針都不知道，光是做一個簡單的小東西就花了一個多小時。", "word": "わかる" } ],
    [ { "text": "裁切皮革這項作業也比想像中更費力，甚至手臂都痠了起來。", "word": "力" } ],
    [ { "text": "即便如此，看著作品一點一點成形的過程很有趣，不知不覺就入迷了。", "word": "夢中" } ],
    [ { "text": "做得順利時的成就感，是其他興趣無法體會到的。", "word": "達成感" } ],
    [ { "text": "下次決定要挑戰做稍微複雜一點的錢包。", "word": "挑戦する" } ]
