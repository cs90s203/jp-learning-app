  "translations": [
    [ { "text": "關於學校中學生使用智慧型手機的問題，向來眾說紛紜、正反意見交織。", "word": "賛否両論" } ],
    [ { "text": "部分地方政府已提出方針，不僅上課時間，就連下課時間也一律禁止在校內使用，這樣的措施背後，是「恐怕會助長學力下降或霸凌」的疑慮，再加上社群網路的普及，進一步推動了這類限制。", "word": "相まる" } ],
    [ { "text": "然而，也有人堅持反駁：無論是作為災害發生時的聯絡方式，還是為了運用學習應用程式展開課程，都不能一概排除智慧型手機。", "word": "根強い" } ],
    [ { "text": "事實上，也有斷然實施一律禁止的學校傳出報告，指出緊急時刻聯絡不上家長、反而招致混亂；因此不論規範的做法如何，培養學生自身判斷力的指導才是本質性的課題，這樣的看法也不在少數。", "word": "いかんによらず" } ],
    [ { "text": "教育現場需要的，並非不由分說地一味禁止，而是校方也應當更加傾聽學生的心聲——這樣的意見在有識之士之間也絕不算少。", "word": "しかるべき" } ]
  ],
