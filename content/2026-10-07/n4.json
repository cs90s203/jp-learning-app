  "translations": [
    [ { "text": "今天放假，所以我和媽媽一起做了晚餐。", "word": "作る" } ],
    [ { "text": "媽媽切切菜、煎煎肉，手腳非常俐落。", "word": "手際" } ],
    [ { "text": "連鍋子的爐火大小也調整得很好。", "word": "調節する" } ],
    [ { "text": "我雖然不擅長用菜刀，還是努力幫忙了。", "word": "苦手" } ],
    [ { "text": "比平常更快就把菜做好了。", "word": "できる" } ],
    [ { "text": "吃了一口，比想像中好吃，很開心。", "word": "おいしい" } ],
    [ { "text": "下個月也打算再跟媽媽一起做菜。", "word": "予定" } ]
