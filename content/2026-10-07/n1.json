  "translations": [
    [ { "text": "近年，隨著訪日外國遊客暴增，部分觀光地居民生活受到的影響已經到了不容忽視的程度。", "word": "支障" } ],
    [ { "text": "交通擁擠、噪音、垃圾問題等弊端多到不勝枚舉，不少地方政府都為此傷透腦筋。", "word": "弊害" } ],
    [ { "text": "面對這樣的情況，部分地方政府不顧觀光業界的反彈，實施了入境費與調漲住宿稅。", "word": "をものともせず" } ],
    [ { "text": "然而，這些限制措施可能壓迫觀光業收益，對地方經濟而言可說是一把雙面刃。", "word": "諸刃の剣" } ],
    [ { "text": "「也應該要求遊客負擔相應成本」的意見日益增強，同時也有人指出限制越嚴格、遊客流失就越嚴重，使得行政機關不得不謹慎應對。", "word": "てしかるべきだ" } ],
    [ { "text": "不少有識之士主張，比起數量更應該轉向重視品質的觀光政策，這才是當務之急。", "word": "重視する" } ],
    [ { "text": "與其依賴一時的人氣，不如建立能持續傳遞地方魅力的機制，這才能稱得上是真正需要的政策。", "word": "構築する" } ]
  ],
