  "translations": [
    [ { "text": "最近開始在陽台嘗試小小的園藝。", "word": "ガーデニング" } ],
    [ { "text": "契機是被在朋友家看到的漂亮花朵吸引了心。", "word": "惹かれる" } ],
    [ { "text": "一開始連怎麼澆水都不懂，常常忘記澆水，但邊查書和網路邊漸漸習慣了。", "word": "忘れがち" } ],
    [ { "text": "每天早上看植物的狀況，成了愉快的日常功課。", "word": "日課" } ],
    [ { "text": "小小的芽冒出來時的喜悅，比想像中還要多。", "word": "嬉しさ" } ],
    [ { "text": "雖然也會有蟲子讓人困擾的時候，但今後也想繼續用心栽培下去。", "word": "育てていく" } ]
