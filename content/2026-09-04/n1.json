  "translations": [
    [ { "text": "近年，基於矯正一票票值不均、促進年輕世代政治參與等觀點，要求根本性檢討選舉制度的呼聲日益高漲。", "word": "選挙制度" } ],
    [ { "text": "針對現行的小選區比例代表並立制，一直以來都有批評指出容易產生大量廢票，民意難以正確反映在議席數上。", "word": "死票" } ],
    [ { "text": "對此，雖有意見認為應該提高比例代表的比重，但另一方面，也有人擔心擴大比例代表制可能招致小黨林立；這種疑慮加上選民根深蒂固的政治不信，使改革論議瀰漫著謹慎的氣氛。", "word": "相まって" } ],
    [ { "text": "此外，為了糾正選區間的人口差距，勢必得重新檢討議席名額，但若地方議席遭到削減，也可能引發「地方的聲音將難以傳達到中央政治」的反彈。", "word": "削減される" } ],
    [ { "text": "這樣的議論背後，不僅僅是制度技術層面的問題，更橫亙著「該把什麼視為公正的代表」這種價值觀上的對立。", "word": "価値観" } ],
    [ { "text": "在檢討改革時，也需要參考其他國家的制度，避免陷入黨派私利，致力形成廣泛的共識。", "word": "合意形成" } ],
    [ { "text": "不應急於求成、草率下結論，花時間進行全民性的討論，或許才是提升對制度信賴的途徑。", "word": "国民的" } ]
  ],
  "grammar_notes": [
    { "sentence": 2, "pattern": "〜と相まって", "note": "「與〜相結合」，書面因果" }
