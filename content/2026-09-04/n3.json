  "translations": [
    [ { "text": "小時候在祭典上聽到的尺八音色一直忘不了，長大後就開始學了。", "word": "尺八" } ],
    [ { "text": "一開始連發出聲音都很難，好幾次差點想放棄。", "word": "難しい" } ],
