    [ { "text": "此外，也有人指出，保育員的薪資水準比其他行業低，離職率偏高更加劇了人手不足的問題。", "word": "拍車" } ],
    [ { "text": "依地區而異，也有待機兒童人數接近零的自治體，對策成效存在很大的地區差異，這一點也不容忽視。", "word": "見過ごせる" } ],
    [ { "text": "雖然行政單位正推動保育費補助與保育員待遇改善，但成效顯現仍需要時間。", "word": "ものの" } ],
