  "translations": [
    [ { "text": "上週末，我和兒子一起去山上賞楓。", "word": "紅葉狩り" } ],
    [ { "text": "因為天氣很好，所以去健行、還吃了便當。", "word": "ハイキング" } ],
    [ { "text": "能從山上看風景，感覺非常舒服。", "word": "景色" } ],
    [ { "text": "兒子明明很累，卻說「還想再來」。", "word": "疲れる" } ],
    [ { "text": "回程的電車上，我們兩個都馬上就睡著了。", "word": "眠る" } ],
    [ { "text": "我們約定明年也要再一起去賞楓。", "word": "約束する" } ]
