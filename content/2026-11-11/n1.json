  "translations": [
    [ { "text": "圍繞選擇性夫婦別姓制度的引進，議論已經持續多年，至今仍未得出結論。", "word": "議論" } ],
    [ { "text": "贊成派提出因改姓而產生的不便，以及職業上的實際成績可能中斷等問題，主張應該尊重個人選擇的自由。", "word": "主張する" } ],
    [ { "text": "另一方面，反對派則以擔心家族的一體感會受損為由，不改變謹慎的態度。", "word": "おそれ" } ],
    [ { "text": "隨著價值觀的多樣化，議論變得越來越複雜。", "word": "多様化" } ],
    [ { "text": "不必看民意調查結果也能明顯看出，世代之間的意見存在很大分歧，即使在政治場域也尚未得出結論。", "word": "見るまでもなく" } ],
    [ { "text": "正因為背後有這個國家特有的家族觀，這恐怕不是能輕易得出結論的問題。", "word": "ならでは" } ],
    [ { "text": "話雖如此，在多元生活方式擴展的現代社會中，也有人指出遲早會被迫重新檢討制度，今後議論的走向備受關注。", "word": "注目される" } ],
    [ { "text": "也有不少人堅持認為，不應該急於得出結論。", "word": "根強い" } ]
