  "translations": [
    [ { "text": "醫療現場的護理師不足，依然是嚴重的問題。", "word": "看護師不足" } ],
    [ { "text": "隨著高齡化的推進，醫療需求增加的同時，也有不少人因為嚴苛的工作環境或偏低的薪資水準而離職。", "word": "過酷" } ],
    [ { "text": "由於人力不足，部分病房據說被迫限制收治病患。", "word": "余儀なくされる" } ],
    [ { "text": "為了減輕現場的負擔，也有人推動以ICT取代部分業務的措施，但要說這是足以確保充分人才的對策，實情並非如此。", "word": "に足る" } ],
    [ { "text": "可以說，不僅是薪資的改善，打造容易工作的環境也是不可或缺的。", "word": "環境づくり" } ],
    [ { "text": "至今國家與地方政府已經推出了各種支援措施，但尚未達到根本性的解決。", "word": "支援策" } ],
    [ { "text": "只要待遇改善沒有進展，要阻止人員離開現場恐怕很困難。", "word": "食い止める" } ],
    [ { "text": "今後仍是需要持續關注的課題。", "word": "注視" } ]
  ],
