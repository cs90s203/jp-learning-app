  "translations": [
    [ { "text": "隨著工作方式的自由度提高，不把住所固定在一個地方，而是在多個地區間移動生活的「多據點生活」，選擇的人正在增加。", "word": "多拠点生活" } ],
    [ { "text": "有些地方政府以提供利用空屋的住所為契機，試圖吸引來自城市的移居者。", "word": "きっかけに" } ],
    [ { "text": "能透過網路工作的環境逐漸完善，這也推動了這種生活方式。", "word": "通じる" } ],
    [ { "text": "另一方面，生活費容易增加，以及每個據點都必須重新建立人際關係等負擔也不小。", "word": "がち" } ],
    [ { "text": "儘管如此，根據基於使用者意見的調查，滿意度似乎絕對不低。", "word": "基づく" } ],
    [ { "text": "多據點生活雖然目前還只是一部分人的選項，但正逐漸成為一種生活方式而紮根下來。", "word": "ものの" } ]
  ],
